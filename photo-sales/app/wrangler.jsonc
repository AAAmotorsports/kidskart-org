/**
 * A-ONE 走行写真販売 — Cloudflare Workers 設定
 *
 * ★ aone (予約システム) とは別の Worker / 別の Supabase / 別の R2。
 *   aone/app/wrangler.jsonc の値を**コピーしない** (Supabase URL が違う)。
 * ★ `vars` は常に全キー入りで維持する (空にすると deploy 時に Dashboard の
 *   非機密変数が全削除される。aone/CLAUDE.md の事故再発防止と同じ)。
 * ★ 秘密値 (SERVICE_ROLE_KEY / STRIPE_* / R2 の鍵) は Dashboard の
 *   「シークレット」型。リポジトリは公開なので vars に置かない。
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aone-photo",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./dist", "binding": "ASSETS" },
  "observability": { "enabled": true },

  // D1 (SQLite)。作成: npx wrangler d1 create aone-photo → database_id を下に貼る
  //   マイグレーション: npx wrangler d1 migrations apply aone-photo --remote
  "d1_databases": [
    { "binding": "DB", "database_name": "aone-photo", "database_id": "REPLACE_WITH_D1_ID",
      "migrations_dir": "migrations" }
  ],

  // R2 バケット (どちらも非公開。プレビューも Worker 経由で配信する)
  //   aone-photo-originals : 元画像。注文の paid 確認後にだけ Worker が返す
  //   aone-photo-previews  : 透かし入りプレビュー・サムネ
  //   aone-photo-backups   : D1 の日次バックアップ (SQL ダンプ)
  "r2_buckets": [
    { "binding": "ORIGINALS", "bucket_name": "aone-photo-originals" },
    { "binding": "PREVIEWS",  "bucket_name": "aone-photo-previews" },
    { "binding": "BACKUPS",   "bucket_name": "aone-photo-backups" }
  ],

  // 毎日 JST 4:00 の cron (期限切れ写真の削除・未決済注文の失効・D1 バックアップ) は M7 で追加する。
  // scheduled ハンドラを実装する前に "triggers" を書くと空振りのエラーになるため、ここには置かない。

  "vars": {
    "PUBLIC_SITE_NAME": "A-ONE CIRCUIT フォト",
    // 当面は仮ドメイン (workers.dev)。本番ドメインは後から設定する
    "PUBLIC_BASE_URL": "",
    "STRIPE_MODE": "test",
    // ログインメールの送信元 (Resend でドメイン認証済みのアドレス)
    "MAIL_FROM_ADDRESS": "",
    "MAIL_FROM_NAME": "A-ONE CIRCUIT フォト"
  }
  // Secrets:
  //   CF_API_TOKEN (D1 エクスポート用・D1 読み取りのみ) / CF_ACCOUNT_ID
  //   STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET   (M4 以降。まずテストモード)
  //   RESEND_API_KEY                              (ログイン・購入確認・期限案内メール)
  //   CRON_SECRET
}
