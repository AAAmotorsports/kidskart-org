# =========================================================================
# A-ONE 予約システム — 環境変数
# =========================================================================
# ローカル開発は aone/app/.env.local にコピーして使う (git 管理外)。
# 本番は wrangler.jsonc の vars と Cloudflare Dashboard のシークレット。
# =========================================================================

# ---- Supabase ----
PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
PUBLIC_SUPABASE_ANON_KEY="sb_publishable_..."
SUPABASE_SERVICE_ROLE_KEY="..."      # サーバ側のみ。RLS をバイパスする

# ---- メール送信 (Resend) ----
RESEND_API_KEY="re_..."
MAIL_FROM_ADDRESS="noreply@kidskart.org"
MAIL_FROM_NAME="A-ONE サーキット"
MAIL_REPLY_TO="info@kidskart.org"
MAIL_ADMIN_TO="info@kidskart.org"

# ---- 管理画面 (Basic 認証) ----
# printf '<password>' | sha256sum
ADMIN_USERNAME="aone"
ADMIN_PASSWORD_HASH=""

# ---- 施設情報 ----
PUBLIC_SITE_NAME="A-ONE サーキット"
PUBLIC_SITE_TEL="092-919-7186"

# ---- 気象庁 予報エリア (福岡県 = 400000) ----
JMA_AREA_CODE="400000"
JMA_AREA_NAME="福岡県"

# ---- cron 共有シークレット ----
CRON_SECRET=""

# ---- GA4 (空なら計測タグを出さない) ----
PUBLIC_GA4_MEASUREMENT_ID=""
