---
import { envFrom } from '@lib/supabase';

interface Props {
  title: string;
  description?: string;
  /** 管理画面は共通ヘッダーを出す */
  admin?: boolean;
  wide?: boolean;
  /**
   * rk-a1.com の中に枠 (iframe) で貼るときの表示。
   * ヘッダー・フッターを出さず、高さを親ページに知らせる。
   * 画面遷移も親ページ側で行う (枠の中に閉じ込めない)。
   */
  embed?: boolean;
}

const { title, description = 'A-ONE サーキット 予約・営業案内', admin = false, wide = false,
        embed = false } = Astro.props;
const env = envFrom(Astro.locals);
const siteName = env.PUBLIC_SITE_NAME || 'A-ONE サーキット';
const gaId = (env.PUBLIC_GA4_MEASUREMENT_ID ?? '').trim();
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#12233a" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  {(admin || embed) && <meta name="robots" content="noindex,nofollow" />}
  <title>{title}</title>
  {gaId && (
    <>
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
      <script is:inline define:vars={{ gaId }}>
        window.dataLayer = window.dataLayer || [];
        function gtag(){ window.dataLayer.push(arguments); }
        window.gtag = gtag;
        gtag('js', new Date());
        gtag('config', gaId, { send_page_view: true });
        window.aoneTrack = function (name, params) {
          try { if (typeof window.gtag === 'function') window.gtag('event', name, params || {}); }
          catch (_e) { /* noop */ }
        };
      </script>
    </>
  )}
  {!gaId && <script is:inline>window.aoneTrack = function () {};</script>}
  <style is:global>
    :root {
      --ink:#12233a; --ink-2:#33475f; --ink-3:#6d8095; --ink-4:#9fb0c1;
      --bg:#fff; --bg-2:#f2f5f8; --bg-3:#e5ebf1;
      --line:#d7e0e8; --line-2:#bcc9d6;
      --red:#d7263d; --red-deep:#a81a2d;
      --amber:#f5a623; --green:#1e9e62; --green-soft:#e6f5ee;
      --blue:#2f6fb5; --blue-soft:#e8f1fb;
      --jp:'Hiragino Sans','Yu Gothic UI','Noto Sans JP',-apple-system,BlinkMacSystemFont,sans-serif;
      --mono:'SF Mono','JetBrains Mono',Menlo,Consolas,monospace;
      --radius:12px;
    }
    *{box-sizing:border-box}
    html,body{margin:0;padding:0}
    [hidden]{display:none !important}
    body{
      font-family:var(--jp); background:var(--bg-2); color:var(--ink);
      line-height:1.7; -webkit-font-smoothing:antialiased; font-feature-settings:"palt";
    }
    a{color:var(--blue)}
    h1,h2,h3{line-height:1.35;margin:0 0 .6em}
    h1{font-size:1.5rem} h2{font-size:1.18rem} h3{font-size:1rem}
    .wrap{max-width:820px;margin:0 auto;padding:1rem 1rem 4rem}
    .wrap.wide{max-width:1180px}
    /* 枠 (iframe) で貼るとき。ホームページ側の余白の中に置かれるので、
       こちら側の背景と余白は最小限にする */
    body.aone-embed{background:#fff}
    body.aone-embed .wrap{padding:0 0 .5rem;max-width:none}
    .card{background:var(--bg);border:1px solid var(--line);border-radius:var(--radius);padding:1rem;margin:0 0 1rem}
    .card h2{margin-top:0}
    .muted{color:var(--ink-3)}
    .small{font-size:.85rem}
    .tiny{font-size:.76rem}
    .row{display:flex;gap:.6rem;flex-wrap:wrap;align-items:center}
    .spread{display:flex;justify-content:space-between;align-items:center;gap:.6rem;flex-wrap:wrap}
    .grid{display:grid;gap:.8rem}
    .stack>*+*{margin-top:.6rem}

    /* ---- ヘッダー ---- */
    .site-head{background:var(--ink);color:#fff}
    .site-head .inner{max-width:1180px;margin:0 auto;padding:.7rem 1rem;display:flex;justify-content:space-between;align-items:center;gap:.8rem;flex-wrap:wrap}
    .site-head a{color:#fff;text-decoration:none}
    .brand{font-weight:800;letter-spacing:.04em;display:flex;align-items:center;gap:.5rem}
    .brand .flag{display:inline-block;width:18px;height:18px;background:
      linear-gradient(45deg,#fff 25%,transparent 25%,transparent 75%,#fff 75%),
      linear-gradient(45deg,#fff 25%,#12233a 25%,#12233a 75%,#fff 75%);
      background-size:10px 10px;background-position:0 0,5px 5px;border-radius:3px}
    .site-nav{display:flex;gap:.9rem;font-size:.86rem;flex-wrap:wrap}
    .site-nav a{opacity:.85} .site-nav a:hover{opacity:1;text-decoration:underline}

    /* ---- ボタン ---- */
    .btn{display:inline-flex;align-items:center;justify-content:center;gap:.4rem;
      padding:.6rem 1.1rem;border-radius:100px;border:1px solid var(--line-2);
      background:var(--bg);color:var(--ink);font-weight:700;font-size:.92rem;
      cursor:pointer;text-decoration:none;font-family:var(--jp);transition:transform .05s,box-shadow .15s}
    .btn:hover{box-shadow:0 3px 10px rgba(0,0,0,.09)}
    .btn:active{transform:scale(.98)}
    .btn.primary{background:var(--red);border-color:var(--red);color:#fff}
    .btn.dark{background:var(--ink);border-color:var(--ink);color:#fff}
    .btn.ghost{background:transparent}
    .btn.sm{padding:.35rem .8rem;font-size:.8rem}
    .btn:disabled{opacity:.45;cursor:not-allowed}

    /* ---- フォーム ---- */
    label{display:block;font-weight:700;font-size:.86rem;margin:0 0 .25rem}
    input[type=text],input[type=tel],input[type=email],input[type=date],input[type=number],
    input[type=time],select,textarea{
      width:100%;padding:.6rem .7rem;border:1px solid var(--line-2);border-radius:9px;
      font-family:var(--jp);font-size:1rem;background:#fff;color:var(--ink)}
    textarea{min-height:5rem;resize:vertical}
    .field{margin:0 0 .9rem}
    .field .hint{font-size:.78rem;color:var(--ink-3);margin-top:.2rem}
    fieldset{border:1px solid var(--line);border-radius:10px;padding:.8rem;margin:0 0 1rem}
    legend{font-weight:800;font-size:.85rem;padding:0 .4rem}
    .choice{display:flex;gap:.5rem;flex-wrap:wrap}
    .choice label{display:inline-flex;align-items:center;gap:.4rem;border:1px solid var(--line-2);
      border-radius:100px;padding:.45rem .9rem;font-weight:700;font-size:.88rem;cursor:pointer;background:#fff}
    .choice input{accent-color:var(--red)}
    .choice label:has(input:checked){border-color:var(--red);background:#fdeef0;color:var(--red-deep)}
    .choice label:has(input:disabled){opacity:.4;cursor:not-allowed}

    /* ---- バッジ / 記号 ---- */
    .badge{display:inline-flex;align-items:center;gap:.25rem;padding:.12rem .55rem;border-radius:100px;
      font-size:.74rem;font-weight:800;border:1px solid var(--line-2);background:var(--bg-2);color:var(--ink-2)}
    .badge.ok{background:var(--green-soft);border-color:#b9e3cf;color:#14724a}
    .badge.warn{background:#fff5e2;border-color:#f2d69b;color:#8a5a06}
    .badge.ng{background:#fdeef0;border-color:#f2bcc4;color:var(--red-deep)}
    .badge.info{background:var(--blue-soft);border-color:#bcd6ef;color:#1d5386}
    .mark{font-weight:800;font-size:1.35rem;line-height:1}
    .mark.open{color:var(--green)} .mark.limited{color:var(--amber)}
    .mark.closed{color:var(--red)} .mark.off{color:var(--ink-4)}

    /* ---- テーブル ---- */
    table{width:100%;border-collapse:collapse;font-size:.88rem}
    th,td{padding:.45rem .5rem;border-bottom:1px solid var(--line);text-align:left;vertical-align:top}
    th{font-size:.78rem;color:var(--ink-3);font-weight:700;white-space:nowrap}
    .table-scroll{overflow-x:auto}

    /* ---- 時間スロット (RP の開始時間など) ----
       ★ JavaScript で後から生成する要素にも当てる必要があるため、
          必ずここ (グローバル) に置く。ページ内の <style> は Astro が
          スコープ化するので、動的生成要素にはスタイルが一切当たらない。 */
    .slots{display:grid;grid-template-columns:repeat(auto-fill,minmax(88px,1fr));gap:.4rem}
    .slot{display:flex;flex-direction:column;align-items:center;gap:.1rem;
      padding:.5rem .2rem;border:1px solid var(--line-2);border-radius:9px;background:#fff;
      font-weight:700;font-size:.88rem;font-family:var(--jp);color:var(--ink);cursor:pointer;
      transition:transform .05s}
    .slot:hover:not(:disabled){box-shadow:0 3px 8px rgba(0,0,0,.1)}
    .slot:active:not(:disabled){transform:scale(.97)}
    .slot.free{border-color:#b9e3cf;background:var(--green-soft);color:#14724a}
    .slot.limited{border-color:#f2d69b;background:#fff5e2;color:#8a5a06}
    .slot.full{background:var(--bg-3);color:var(--ink-4);cursor:not-allowed;text-decoration:line-through}
    .slot.picked{background:var(--red);border-color:var(--red);color:#fff;
      box-shadow:0 0 0 3px rgba(215,38,61,.25)}
    .slot.picked .tiny{color:#fff}

    /* 2 列レイアウトとチェックボックス付きラベル (フォームで多用) */
    .two{display:grid;grid-template-columns:1fr 1fr;gap:.8rem}
    .agree{display:inline-flex;align-items:center;gap:.45rem;font-weight:700}
    @media (max-width:560px){ .two{grid-template-columns:1fr} }

    /* ---- 戻るリンク (予約フォームの先頭に置く) ---- */
    .back-link{display:inline-flex;align-items:center;gap:.3rem;font-size:.85rem;font-weight:700;
      color:var(--ink-2);text-decoration:none;margin:0 0 .5rem;padding:.3rem .8rem .3rem .6rem;
      border:1px solid var(--line-2);border-radius:100px;background:#fff}
    .back-link:hover{box-shadow:0 2px 6px rgba(0,0,0,.07)}

    /* ---- 通知 ---- */
    .notice{border-radius:10px;padding:.7rem .9rem;font-size:.9rem;border:1px solid var(--line-2);background:var(--bg-2)}
    .notice.ok{background:var(--green-soft);border-color:#b9e3cf}
    .notice.warn{background:#fff5e2;border-color:#f2d69b}
    .notice.ng{background:#fdeef0;border-color:#f2bcc4}
    .notice.info{background:var(--blue-soft);border-color:#bcd6ef}

    footer.site-foot{background:var(--ink);color:#cfdbe7;font-size:.82rem;padding:1.4rem 1rem;margin-top:2rem}
    footer.site-foot .inner{max-width:1180px;margin:0 auto;display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap}
    footer.site-foot a{color:#fff}
    @media (max-width:560px){
      h1{font-size:1.28rem}
      .wrap{padding:.8rem .8rem 3rem}
    }
  </style>
</head>
<body class:list={[embed && 'aone-embed']}>
  {!embed && (
  <header class="site-head">
    <div class="inner">
      <a href={admin ? '/admin' : '/'} class="brand"><span class="flag"></span>{siteName}{admin && ' 管理'}</a>
      {admin ? (
        <nav class="site-nav">
          <a href="/admin">今日</a>
          <a href="/admin/sheet">受付シート</a>
          <a href="/admin/calendar">カレンダー</a>
          <a href="/admin/reservations">予約一覧</a>
          <a href="/admin/customers">顧客</a>
          <a href="/admin/settings">設定</a>
          <a href="/">公開ページ</a>
        </nav>
      ) : (
        <nav class="site-nav">
          <a href="/">今日走れる？</a>
          <a href="/schedule">スケジュール</a>
          <a href="/reserve">予約する</a>
        </nav>
      )}
    </div>
  </header>
  )}

  <main class:list={['wrap', wide && 'wide']}>
    <slot />
  </main>

  {!admin && !embed && (
    <footer class="site-foot">
      <div class="inner">
        <div>
          <strong>{siteName}</strong><br />
          お電話でのご予約・お問い合わせ: {env.PUBLIC_SITE_TEL || '092-919-7186'}
        </div>
        <div>
          <a href="/">今日走れる？</a> ／ <a href="/schedule">スケジュール</a> ／ <a href="/reserve">予約</a>
        </div>
      </div>
    </footer>
  )}

  {/* 画面の移動は必ずここを通す。枠の中に貼られているときは、枠の中で移動すると
      予約完了ページの URL がお客様に見えず、控えをブックマークできない。
      親ページに知らせて、ホームページごと移動してもらう。 */}
  <script is:inline define:vars={{ embed }}>
    window.aoneEmbed = embed;
    window.aoneGo = function (path) {
      if (!embed || window.parent === window) { location.href = path; return; }
      try { window.parent.postMessage({ aone: 'navigate', url: location.origin + path }, '*'); } catch (e) { /* noop */ }
      // 親ページに貼り付けスクリプトが無いときの保険。少し待って動かなければ枠の中で移動する
      setTimeout(function () { location.href = path; }, 1200);
    };
  </script>

  {embed && (
    <script is:inline>
      // 中身の高さを親ページに知らせる。これで枠の中にスクロールバーが出ない
      (function () {
        var last = 0;
        function send() {
          var h = Math.ceil(document.documentElement.getBoundingClientRect().height);
          if (h && Math.abs(h - last) > 1) {
            last = h;
            try { window.parent.postMessage({ aone: 'height', value: h }, '*'); } catch (e) { /* noop */ }
          }
        }
        if (window.ResizeObserver) new ResizeObserver(send).observe(document.documentElement);
        window.addEventListener('load', send);
        // 画像の読み込みなど ResizeObserver で拾えない変化への保険
        setInterval(send, 1000);
        send();
      })();
    </script>
  )}
</body>
</html>
