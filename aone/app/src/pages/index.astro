---
import Base from '@layouts/Base.astro';
import { envFrom } from '@lib/supabase';
import { dayState, settings, type DayState } from '@lib/queries';
import {
  STATUS_MARK, BUSINESS_LABELS, SURFACE_LABELS, SURFACE_EMOJI, categoryText,
  jaDate, todayJst, addDays, blockLabel, dayFocus, openBadge, openNote,
} from '@lib/domain';

export const prerender = false;

// 「今日走れる？」— 予約サイトで一番大事な画面 (仕様 7)。
// 利用者がスケジュール表を読み解かなくても、今日行って走れるかが一目で分かる。
const env = envFrom(Astro.locals);
const today = todayJst();

// 18 時 (コースクローズの 30 分後) を過ぎたら、主役を翌日に切り替える。
// 営業が終わったあとに今日の空きを出しても、もう誰も来られない。
const cfg = await settings(env);
const focus = dayFocus({
  course_open: cfg?.course_open_time,
  course_close: cfg?.course_close_time,
}, today);
const dayWord = focus.is_tomorrow ? '明日' : '本日';

const [state, next] = await Promise.all([
  dayState(env, focus.date),
  dayState(env, addDays(focus.date, 1)),
]);

/**
 * RP の空きを「14:00〜 空きあり」の形にまとめる。
 *
 * 休業・走行中止の日は空文字を返す。枠が 0 なのは「満枠」ではなく
 * 「その日はやっていない」からで、満枠と書くと誤解される
 * (2026-08 オーナー指摘)。呼ぶ側は空なら行ごと出さないこと。
 */
function rpSummary(s: DayState | null): string {
  if (!s) return '';
  if (['cancelled', 'closed'].includes(s.business.status)) return '';
  const open = s.rp.slots.filter((x) => x.accepting);
  if (open.length === 0) return 'RP はすべて満枠です';
  const first = open[0].time;
  const last = open[open.length - 1].time;
  return open.length === s.rp.slots.length
    ? `${first}〜${last} 空きあり`
    : `${first}〜 空きあり`;
}

const sessions: Array<['am' | 'pm', string]> = [['am', 'AM'], ['pm', 'PM']];

// 「今日走れる？」に出すカテゴリーの絞り込み。
//
// カート・ミニバイクは予約なしで走れるので常に表示する。
// キッズカート・その他 (大型バイク等) は事前予約制で、普段は走っていない。
// 毎日「要予約」と並べても利用者の判断材料にならないので、
// **その日に予約が入っているときだけ**出す (= その日は実際に走っている)。
// 予約したい人は予約フォームからいつでも申し込める。
function visibleCats<T extends { requires_reservation: boolean; running: boolean }>(list: T[]): T[] {
  return list.filter((c) => !c.requires_reservation || c.running);
}
const publicBlocks = (state?.blocks ?? []).filter((b) => b.is_public);
// 走行中止・休業の日は「走れない」。営業確認中はまだ走れる可能性がある
const closedToday = ['cancelled', 'closed'].includes(state?.business.status ?? '');

// 予約不要のレンタルカート走行。走れるかどうかは
//   ・営業しているか
//   ・終日止める予定 (レース・イベント・臨時休業) が入っていないか
// で決まる。時間帯を区切る貸切は「その時間だけ」なので ✕ にはしない。
// /api/public/today の rental と同じ判定 (ウィジェットと食い違わせない)
const fullDayBlock = publicBlocks.find((b) => b.scope === 'all');
const rental = {
  available: !closedToday && !fullDayBlock,
  price: (cfg?.rental_heat_price as number) ?? 2200,
  minutes: (cfg?.rental_heat_minutes as number) ?? 7,
  note: closedToday
    ? `${BUSINESS_LABELS[state?.business.status ?? ''] ?? 'お休み'}のためご利用いただけません`
    : fullDayBlock
      ? `${fullDayBlock.public_label}のためご利用いただけません`
      : state?.charter.confirmed_charter
        ? '貸切の時間帯はご利用いただけません'
        : null,
};
const surfaceToday = state?.surface.status ?? null;
// 営業状況 (休業・中止) と、時間帯 (準備中・営業中・終了) を 1 つのバッジにまとめる
const nextClosed = ['cancelled', 'closed'].includes(next?.business.status ?? '');
const badge = openBadge(state?.business.status ?? 'open', focus.phase);
const note = openNote(state?.business.status ?? 'open', focus, state?.hours?.course_open);
---
<Base title="今日走れる？ | A-ONE サーキット" description="A-ONE サーキットの本日の走行状況・空き状況をリアルタイムで表示します。">
  {!state && (
    <div class="card">
      <h1>準備中</h1>
      <p class="muted">
        予約システムのデータベース接続がまだ設定されていません。<br />
        <code>wrangler.jsonc</code> の <code>PUBLIC_SUPABASE_URL</code> /
        <code>PUBLIC_SUPABASE_ANON_KEY</code> と、Cloudflare Dashboard の
        <code>SUPABASE_SERVICE_ROLE_KEY</code> を設定してください。
      </p>
      <p><a class="btn" href="/reserve">予約メニューを見る</a></p>
    </div>
  )}

  {state && (
    <>
      <div class="today-head">
        <div>
          <div class="tiny muted">{dayWord}の走行状況</div>
          <h1 style="margin:0">{jaDate(state.date)}</h1>
        </div>
        <div class="head-tags">
          <div class={`weather ${badge.tone}`}>
            <span class="wx-emoji">{badge.emoji}</span>
            <span>{badge.label}</span>
          </div>
          {surfaceToday && (
            <div class="surface">
              <span class="wx-emoji">{SURFACE_EMOJI[surfaceToday] ?? '💧'}</span>
              <span>路面 {SURFACE_LABELS[surfaceToday] ?? surfaceToday}</span>
            </div>
          )}
        </div>
      </div>

      {note && <p class="open-note">{note}</p>}

      {state.business.message && (
        <div class:list={['notice', closedToday ? 'ng' : 'warn']} style="margin-bottom:1rem">
          {state.business.message}
        </div>
      )}

      {/* 休業 (もともとやっていない日) と 走行中止 (天候などでその日だけ止めた)
          は別物。同じ文面にすると、休業日に「回復したら再開します」と
          言ってしまう (2026-09 に発生) */}
      {closedToday ? (
        <div class="card">
          {state.business.status === 'closed' ? (
            <>
              <h2>{dayWord}はお休みです</h2>
              <p class="muted">
                この日はご予約・走行を承っておりません。
                <a href="/schedule">今月のスケジュール</a>で営業日をご確認ください。
              </p>
            </>
          ) : (
            <>
              <h2>{dayWord}は走行を中止しています</h2>
              <p class="muted">
                天候の回復状況によっては再開する場合があります。お急ぎの場合は
                お電話 ({env.PUBLIC_SITE_TEL || '092-919-7186'}) でご確認ください。
              </p>
            </>
          )}
        </div>
      ) : (
        <div class="card">
          <h2 class="sr-head">スポーツ走行</h2>
          {sessions.map(([key, label]) => {
            const sess = state.sport[key];
            return (
              <div class="sess">
                {/* 「0 / 2 クラス」は運営の都合の数字で、お客様には意味が伝わらない。
                    出すのは管理画面だけにする (2026-08 オーナー指摘) */}
                <div class="sess-head">
                  <strong>{label}</strong>
                  <span class="tiny muted">{sess.start_time}〜{sess.end_time}</span>
                </div>
                <div class="cats">
                  {visibleCats(sess.categories).map((c) => (
                    <div class:list={['cat', c.walk_in_ok && 'walkin']} title={c.message}>
                      <div class="cat-name">{c.short_name}</div>
                      <div class:list={['mark', c.status]}>{STATUS_MARK[c.status]}</div>
                      <div class:list={['tiny', c.walk_in_ok ? 'walkin-txt' : 'muted']}>
                        {categoryText(c)}
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            );
          })}
          <p class="tiny muted" style="margin:.4rem 0 0">
            <strong>○ 走れます</strong>= ご予約なしでお越しいただけます ／
            <strong>✕</strong> 受付停止 ／ <strong>—</strong> 対象外。<br />
            その他（大型バイク等）は<strong>事前予約制</strong>のため、
            ご予約が入っている日のみ表示しています。ご希望の方は
            <a href="/reserve/sport">こちらからご予約</a>ください。<br />
            <strong>小学生以下のお子様</strong>は
            <a href="https://kidskart.org/" target="_blank" rel="noopener">
              キッズカートアカデミー (kidskart.org) →</a>
            をご覧ください。
          </p>
        </div>
      )}

      {/* 予約不要のレンタルカート走行。いちばん多いお問い合わせなのに、
          これまでどこにも出していなかった (2026-09 オーナー指摘)。
          スポーツ走行の ○✕ と混ざらないよう、独立した枠で出す。
          休業・走行中止の日は出さない — 見出しで「お休みです」と伝えているし、
          休業日に ✕ を並べると「埋まっている」に見える (2026-08 オーナー指摘) */}
      {!closedToday && (
      <div class:list={['card', 'rental-card', rental.available && 'ok']}>
        <h2>レンタルカート走行 <span class="tag">ご予約不要</span></h2>
        {rental.available ? (
          <p class="rental-line"><strong class="mark">○</strong> 走れます
            <span class="muted"> — 営業時間内にお越しください</span></p>
        ) : (
          <p class="rental-line"><strong class="mark ng">✕</strong>
            <span> {rental.note}</span></p>
        )}
      {!closedToday && (
        <div class="card">
          <h2>レースパック (RP)</h2>
          <p style="margin:.2rem 0">{rpSummary(state)}</p>
          <div class="rp-strip">
            {state.rp.slots.map((s) => (
              s.accepting
                ? <a class:list={['rp-slot', s.groups > 0 ? 'part' : 'free']}
                     href={`/reserve/rp?date=${state.date}&time=${s.time}`}
                     title={`${s.time} で予約する`}>{s.time}</a>
                : <span class="rp-slot full" title={s.message}>{s.time}</span>
            ))}
          </div>
          <p class="tiny muted" style="margin:.35rem 0 0">
            時間をタップすると、その開始時間でレースパックのご予約に進めます。
          </p>
          <p class="tiny muted" style="margin:.5rem 0 0">
            {state.rp.min_party} 名以上・30 分刻み。{state.rp.last_start} 以降の開始は要相談です。
          </p>
        </div>
      )}

        {rental.available && rental.note && (
          <p class="tiny warn-note" style="margin:.3rem 0 0">※ {rental.note}</p>
        )}
        <p class="tiny muted" style="margin:.35rem 0 0">
          1 ヒート {rental.price.toLocaleString('ja-JP')} 円 / {rental.minutes} 分。
          ヘルメット・グローブは無料でお貸しします。
          グループでレースをしたい方は下のレースパックをご覧ください。
        </p>
      </div>
      )}

      {publicBlocks.length > 0 && (
        <div class="card">
          <h2>{dayWord}の予定</h2>
          <ul class="plain">
            {publicBlocks.map((b) => (
              <li>
                <span class="badge info">{blockLabel(b.kind, b.public_label)}</span>
                {b.start_time && <span class="tiny muted"> ({b.start_time}〜{b.end_time ?? ''})</span>}
              </li>
            ))}
          </ul>
        </div>
      )}

      <div class="cta">
        <a class="btn primary big" href="/reserve/rp">
          レースパックを予約 <span class="cta-sub">3名以上のグループに</span>
        </a>
        <a class="btn" href="/reserve/sport">スポーツ走行を予約</a>
        <a class="btn" href="/reserve/charter">貸切を申し込む</a>
        <a class="btn ghost" href="/reserve/night">ナイターを相談する</a>
      </div>

      {next && (
        <div class="card">
          <h2>{focus.is_tomorrow ? '翌日' : '明日'} {jaDate(next.date)}</h2>
          {next.business.status !== 'open' && (
            <p class="badge warn">{BUSINESS_LABELS[next.business.status] ?? next.business.status}</p>
          )}
          {/* 休業・走行中止の日に ✕ の一覧や「満枠」を出すと、
              「枠が埋まっている」と誤解される。お休みとだけ伝える */}
          {nextClosed ? (
            <p class="tiny muted" style="margin:.4rem 0 0">
              {next.business.status === 'closed'
                ? 'この日はお休みです。ご予約は承っておりません。'
                : 'この日は走行を中止しています。お急ぎの場合はお電話ください。'}
            </p>
          ) : (
            <>
              <div class="next-grid">
                {sessions.map(([key, label]) => (
                  <div>
                    <div class="tiny muted">{label}</div>
                    <div class="row">
                      {visibleCats(next.sport[key].categories).map((c) => (
                        <span class="next-cat" title={categoryText(c)}>
                          {c.short_name}
                          <span class:list={['mark', c.status]} style="font-size:1rem">{STATUS_MARK[c.status]}</span>
                          {c.requires_reservation && !c.walk_in_ok && <span class="tiny muted">要予約</span>}
                        </span>
                      ))}
                    </div>
                  </div>
                ))}
              </div>
              {rpSummary(next) && (
                <p class="tiny muted" style="margin:.5rem 0 0">RP: {rpSummary(next)}</p>
              )}
            </>
          )}
          <p style="margin:.6rem 0 0"><a href="/schedule">今月のスケジュールを見る →</a></p>
        </div>
      )}
    </>
  )}
</Base>

<style>
  .today-head{display:flex;justify-content:space-between;align-items:flex-end;gap:1rem;flex-wrap:wrap;margin:.4rem 0 1rem}
  .weather{display:inline-flex;align-items:center;gap:.4rem;font-weight:800;padding:.4rem .9rem;
    border-radius:100px;background:var(--green-soft);color:#14724a;border:1px solid #b9e3cf}
  .weather.warn{background:#fff5e2;color:#8a5a06;border-color:#f2d69b}
  .weather.ng{background:#fdeef0;color:var(--red-deep);border-color:#f2bcc4}
  /* 準備中・本日は終了。異常ではないので警告色にはしない */
  .weather.soft{background:var(--bg-2);color:var(--ink-2);border-color:var(--line-2)}
  .open-note{margin:.2rem 0 .9rem;font-weight:700;color:var(--ink-2)}
  .head-tags{display:flex;align-items:center;gap:.5rem;flex-wrap:wrap}
  /* 路面状況は「走れるかどうか」ではないので、色を持たせず控えめに出す */
  .surface{display:inline-flex;align-items:center;gap:.4rem;font-weight:700;padding:.4rem .9rem;
    border-radius:100px;background:var(--bg-2);color:var(--muted);border:1px solid var(--line)}
  .wx-emoji{font-size:1.1rem}
  .sess+.sess{margin-top:1rem;padding-top:1rem;border-top:1px dashed var(--line)}
  .sess-head{display:flex;align-items:center;gap:.6rem;flex-wrap:wrap;margin-bottom:.5rem}
  .cats{display:grid;grid-template-columns:repeat(auto-fit,minmax(110px,1fr));gap:.5rem}
  .cat{text-align:center;border:1px solid var(--line);border-radius:10px;padding:.5rem .2rem;background:var(--bg-2)}
  .cat.walkin{background:var(--green-soft);border-color:#b9e3cf}
  /* 予約不要のレンタルカート走行。ここを見に来る人がいちばん多い */
  .rental-card.ok{border-color:#b9e3cf;background:var(--green-soft)}
  .rental-line{margin:.2rem 0;font-size:1.02rem;font-weight:700}
  .rental-line .mark{font-size:1.25rem;color:#14724a;margin-right:.3rem}
  .rental-line .mark.ng{color:var(--red)}
  .warn-note{color:var(--red-deep);font-weight:700}
  .walkin-txt{color:#14724a;font-weight:700}
  .cat-name{font-size:.78rem;font-weight:700;color:var(--ink-2);margin-bottom:.2rem}
  .rp-strip{display:flex;flex-wrap:wrap;gap:.3rem;margin-top:.5rem}
  .rp-slot{display:inline-block;font-size:.82rem;font-weight:700;padding:.3rem .6rem;border-radius:6px;
    border:1px solid var(--line-2);background:var(--bg-2);color:var(--ink-3);text-decoration:none}
  a.rp-slot:hover{box-shadow:0 2px 8px rgba(0,0,0,.12)}
  a.rp-slot:active{transform:scale(.97)}
  .rp-slot.free{background:var(--green-soft);border-color:#b9e3cf;color:#14724a}
  .rp-slot.part{background:#fff5e2;border-color:#f2d69b;color:#8a5a06}
  .rp-slot.full{background:#fdeef0;border-color:#f2bcc4;color:var(--red-deep);text-decoration:line-through}
  .cta{display:flex;gap:.6rem;flex-wrap:wrap;align-items:center;margin:1.2rem 0}
  /* RP は単価も満足度も高く一番伸ばしたいメニューなので、他より大きく置く */
  .cta .btn.big{padding:.8rem 1.5rem;font-size:1.02rem;flex-direction:column;gap:.1rem;line-height:1.3}
  .cta-sub{font-size:.72rem;font-weight:700;opacity:.85}
  .next-grid{display:grid;grid-template-columns:1fr 1fr;gap:.8rem}
  .next-cat{display:inline-flex;align-items:center;gap:.2rem;font-size:.8rem;font-weight:700;color:var(--ink-2)}
  ul.plain{list-style:none;margin:0;padding:0}
  ul.plain li+li{margin-top:.4rem}
  @media (max-width:560px){
    .cats{grid-template-columns:repeat(2,1fr)}
    .next-grid{grid-template-columns:1fr}
  }
</style>
