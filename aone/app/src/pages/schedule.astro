---
import Base from '@layouts/Base.astro';
import { envFrom } from '@lib/supabase';
import { monthState, rentalBookings, openEvents } from '@lib/queries';
import { todayJst, BUSINESS_LABELS, SURFACE_LABELS, blockLabel, BLOCK_KIND_LABELS, monthOptions } from '@lib/domain';

export const prerender = false;

// 公開スケジュール (仕様 19)。
// 管理カレンダーに登録された予定から自動生成する — 別途ページを手で書かない。
const env = envFrom(Astro.locals);
const today = todayJst();
const ymParam = Astro.url.searchParams.get('ym') ?? today.slice(0, 7);
const [y, m] = ymParam.split('-').map(Number);
const year = Number.isFinite(y) ? y : Number(today.slice(0, 4));
const month = Number.isFinite(m) && m >= 1 && m <= 12 ? m : Number(today.slice(5, 7));

// 表示モード: レンタル (RP・貸切) / スポーツ走行 (持ち込み) / 両方
// A-ONE のお客さんは「レンタルで遊びに来る人」と「マイマシンを持ち込む人」に
// はっきり分かれるので、見たい情報だけに切り替えられるようにする。
const modeParam = Astro.url.searchParams.get('mode');
const mode: 'rental' | 'sport' | 'both' =
  modeParam === 'rental' ? 'rental' : modeParam === 'sport' ? 'sport' : 'both';
const showRental = mode === 'rental' || mode === 'both';
const showSport = mode === 'sport' || mode === 'both';
const reserveHref =
  mode === 'rental' ? '/reserve/rp' : mode === 'sport' ? '/reserve/sport' : '/reserve';

const days = await monthState(env, year, month);

// レンタル (RP・貸切) の予約を出す。旧 WordPress スケジュールが
// 「AM10:00〜 RP パットリ様」と出していた運用に合わせる。
// 出るのは時間・人数・表示名だけで、名前の粒度は /admin/settings で変えられる。
const lastDay = new Date(Date.UTC(year, month, 0)).getUTCDate();
const bookings = showRental
  ? await rentalBookings(env,
      `${year}-${String(month).padStart(2, '0')}-01`,
      `${year}-${String(month).padStart(2, '0')}-${String(lastDay).padStart(2, '0')}`)
  : {};

// 参加申込を受け付けているイベントは、その日からイベントの案内ページへ飛ばす。
// 申込フォームに直行させると、エントリーリスト・タイムスケジュール・規則書に
// たどり着く道が無くなる (案内ページに申し込むボタンがある)
const openEvs = await openEvents(env);
const entryByDate = new Map(openEvs.map((e) => [e.date, `/event/${e.id}`]));

const prev = month === 1 ? `${year - 1}-12` : `${year}-${String(month - 1).padStart(2, '0')}`;
const next = month === 12 ? `${year + 1}-01` : `${year}-${String(month + 1).padStart(2, '0')}`;
const ymNow = `${year}-${String(month).padStart(2, '0')}`;
const months = monthOptions(ymNow, today);
const nextMonthNo = month === 12 ? 1 : month + 1;

// スマホは 1 日 1 行の縦長なので、今月を開くと過ぎた日を延々スクロールすることになる。
// 過ぎた日は最初からたたんでおき、今日から始まるようにする (PC は 7 列のままなので変えない)。
const pastCount = ymNow === today.slice(0, 7) ? Number(today.slice(8, 10)) - 1 : 0;

// カレンダーは月曜はじまり (日本のサーキット運営では週末が右端に来る方が読みやすい)。
// getUTCDay() は 日=0 なので、月曜を 0 とする並びに直してから空セルを置く。
const firstDow = (new Date(Date.UTC(year, month - 1, 1)).getUTCDay() + 6) % 7;
const WD = ['月', '火', '水', '木', '金', '土', '日'];
// getUTCDay() 順 (日=0) の曜日名。スマホの縦長表示で日付の横に出す。
const WD_BY_DOW = ['日', '月', '火', '水', '木', '金', '土'];
const isOpen = (v: string) => v === 'true';

// その時間帯に **予約が入っている** クラス。
// 旧スケジュール表と同じ考え方: 毎日「カート・ミニバイク」と並べても情報量が無い。
// 実際に走るクラスが入っている日だけそれを出し、空いている日は予約を促す。
function bookedClasses(cats: { short_name: string; running: boolean }[]): string[] {
  return (cats ?? []).filter((c) => c.running).map((c) => c.short_name);
}

/**
 * RP・貸切が AM の枠か PM の枠か。
 * 12:00 開始は PM 扱い (A-ONE の午前走行は 12:00 まで)。
 */
function isPmBooking(time: string): boolean {
  return (time ?? '') >= '12:00';
}

/** その時間帯が受付できるか (1 つでも受付可のカテゴリーがあるか) */
function sessionOpen(cats: { status: string; requires_reservation: boolean; running: boolean }[]): boolean {
  return (cats ?? []).some((c) => c.status === 'open' && (!c.requires_reservation || c.running));
}
---
<Base title={`${year}年${month}月のスケジュール | A-ONE サーキット`} wide>
  <div class="spread" style="margin-bottom:.8rem">
    {/* 見出しの年月をそのまま選べるようにする。「8 月に 12 月を見る」が
        前の月・次の月ボタンだけだと 4 回押しになるため */}
    <h1 style="margin:0" class="ym-h1">
      <select id="ym-jump" class="ym-select" aria-label="表示する月を選ぶ">
        {months.map((o) => <option value={o.ym} selected={o.ym === ymNow}>{o.label}</option>)}
      </select>
      のスケジュール
    </h1>
    <div class="row">
      <a class="btn sm" href={`/schedule?ym=${prev}&mode=${mode}`}>← 前の月</a>
      <a class="btn sm" href={`/schedule?ym=${next}&mode=${mode}`}>次の月 →</a>
    </div>
  </div>

  <div class="modes">
    <a class:list={['mode-btn', mode === 'rental' && 'on']} href={`/schedule?ym=${ymParam}&mode=rental`}>
      レンタル
    </a>
    <a class:list={['mode-btn', mode === 'sport' && 'on']} href={`/schedule?ym=${ymParam}&mode=sport`}>
      スポーツ走行
    </a>
    <a class:list={['mode-btn', mode === 'both' && 'on']} href={`/schedule?ym=${ymParam}&mode=both`}>
      両方
    </a>
  </div>
  <p class="tiny muted" style="margin:.2rem 0 .8rem">
    {mode === 'rental'
      ? 'レンタルカートのレースパック・貸切の空き状況です。通常のレンタル走行はご予約不要です。'
      : mode === 'sport'
        ? 'マイマシン持ち込みのスポーツ走行枠です。'
        : 'レンタル（レースパック・貸切）と、持ち込みのスポーツ走行の両方を表示しています。'}
  </p>

  {!days ? (
    <div class="card"><p class="muted">スケジュールを取得できませんでした。</p></div>
  ) : (
    <>
      {pastCount > 0 && (
        <button type="button" id="past-toggle" class="past-toggle">
          ▼ {month}月1日〜{pastCount}日 も表示する
        </button>
      )}
      <div class:list={['cal', pastCount > 0 && 'hide-past']} id="cal">
        {WD.map((w, i) => <div class:list={['cal-head', i === 6 && 'sun', i === 5 && 'sat']}>{w}</div>)}
        {Array.from({ length: firstDow }).map(() => <div class="cal-cell empty"></div>)}
        {days.map((d) => {
          const dnum = Number(d.date.slice(8, 10));
          const publicBlocks = (d.blocks ?? []).filter((b) => b.is_public);
          const closed = d.business === 'cancelled' || d.business === 'closed';
          // 過ぎた日は空にする (「受付停止」が並ぶと休業日のように見えてしまう)
          const isPast = d.date < today;
          // 予約できる日はセルごとリンクにする。「ご予約受付中」の文字を
          // 全セルに出すとうるさいので、押せることは色と hover で示す。
          // 参加申込を受け付けているイベントの日は申込フォームへ。
          // イベント日は終日ブロックされていて走行の予約はできないので、
          // 「ご予約へ」に飛ばすと行き止まりになる
          const entryHref = entryByDate.get(d.date);
          const linkable = !!entryHref || (!isPast && !closed);
          const Cell = linkable ? 'a' : 'div';
          return (
            <Cell
              href={entryHref ?? (linkable ? `${reserveHref}?date=${d.date}` : undefined)}
              title={entryHref ? 'イベントの詳細・参加申込へ' : linkable ? 'この日のご予約へ' : undefined}
              class:list={[
              'cal-cell',
              d.date === today && 'today',
              d.dow === 0 && 'sun', d.dow === 6 && 'sat', d.is_holiday && 'holiday',
              closed && 'closed',
              isPast && 'past',
              linkable && 'linkable',
            ]}>
              <div class="cal-day">
                {dnum}<span class="dow-label"> ({WD_BY_DOW[d.dow]})</span>
              </div>
              <div class="cell-body">
              {d.business !== 'open' && (
                <div class="tiny wx">{BUSINESS_LABELS[d.business] ?? d.business}</div>
              )}
              {d.surface && !isPast && (
                <div class="tiny sf">{SURFACE_LABELS[d.surface] ?? d.surface}</div>
              )}
              {publicBlocks.map((b) => (
                /* 「イベント」と名前を 2 行に。種別を頭に付けないもの (臨時休業など) は 1 行 */
                <div class="tiny ev">
                  {blockLabel(b.kind, b.public_label) !== b.public_label && (
                    <span class="l1">{BLOCK_KIND_LABELS[b.kind] ?? b.kind}</span>
                  )}
                  <span class="l2">{b.public_label}</span>
                </div>
              ))}
              {/* 何のイベントかを先に出してから申込へ誘う。
                  貼り付けウィジェットと並び順を揃える (食い違って見えるため) */}
              {entryHref && <div class="tiny entry">参加申込 受付中 →</div>}
              {isPast ? null : (
                <div class="tiny sessions">
                  {([['AM', d.am_categories, false], ['PM', d.pm_categories, true]] as const).map(
                    ([label, cats, pm]) => {
                      // その時間帯に入っている RP・貸切 (12:00 開始からは PM)
                      const list = showRental
                        ? (bookings[d.date] ?? []).filter((b) => isPmBooking(b.time) === pm)
                        : [];
                      const names = showSport && !closed ? bookedClasses(cats as any) : [];
                      const showMark = showSport && !closed;
                      if (list.length === 0 && !showMark) return null;
                      return (
                        <div class="sess-row">
                          <b>{label}</b>
                          <div class="sess-items">
                            {list.map((b) => (
                              /* 「13:00 RP」と名前を 2 行に分ける (1 行だと区切りが読みづらい) */
                              <div class:list={['bk', b.kind]}>
                                <span class="l1">{b.kind === 'rp'
                                  ? `${b.time} RP`
                                  : `貸切 ${b.time}${b.end_time ? '〜' + b.end_time : ''}`}</span>
                                {b.name && <span class="l2">{b.name}</span>}
                              </div>
                            ))}
                            {showMark && (
                              names.length > 0
                                ? <div class="ok">{names.join('・')}</div>
                                : sessionOpen(cats as any)
                                  ? <div class="ok">○</div>
                                  /* 何の受付が止まっているのかを書く。「受付停止」だけだと、
                                     レンタルカートのお客様まで予約できないと思ってしまう
                                     (2026-09 オーナー指摘) */
                                  : <div class="ng">
                                      <span class="l1">スポーツ走行</span>
                                      <span class="l2">受付停止</span>
                                    </div>
                            )}
                          </div>
                        </div>
                      );
                    })}
                </div>
              )}
              </div>
            </Cell>
          );
        })}
      </div>

      {/* スマホは縦長なので、月末まで見たあと上に戻らなくても次の月へ行けるようにする */}
      <div class="row bottom-nav">
        <a class="btn sm" href={`/schedule?ym=${prev}&mode=${mode}`}>← 前の月</a>
        <a class="btn sm" href={`/schedule?ym=${next}&mode=${mode}`}>{nextMonthNo}月のスケジュール →</a>
      </div>

      <p class="tiny muted" style="margin-top:.6rem">
        <strong>日付をクリックするとご予約に進めます。</strong>
        <strong>○</strong> = 受付可、クラス名が出ている枠は<strong>すでにご予約が入っています</strong>
        （{showSport && 'AM / PM = 午前 / 午後'}{showSport && showRental && '、'}
        {showRental && 'RP・貸切は時間と代表者名'}）。
        何も出ていない日はどなたでもご予約いただけます。
        受付停止はレース・イベント・貸切・満枠などによるものです。
        当日の最新状況は <a href="/">「今日走れる？」</a> をご確認ください。
      </p>

      {showSport && (
        <p class="tiny notice info" style="margin-top:.4rem">
          <strong>AM / PM の ○・受付停止は、お持ち込み車両（スポーツ走行）の走行枠です。</strong>
          <strong>レンタルカート</strong>のご利用（1 ヒート走行・レースパック・貸切）は
          この表示とは別で、<strong>営業日であればご利用いただけます</strong>。
          「受付停止」と出ている日でも、レンタルカートは走れることがあります。
          <a href="/">今日走れる？</a> でその日の状況をご確認いただくか、
          お電話でお問い合わせください。
        </p>
      )}

      <div class="card" style="margin-top:1rem">
        <h2>営業時間</h2>
        <ul class="small">
          <li>コースオープン 8:30 ／ 午前走行 9:00〜12:00</li>
          <li>午後走行 13:00〜16:30 ／ コースクローズ 17:30</li>
          <li>レースパック 10:00〜18:00 (30 分刻み・通常の最終受付 17:00)</li>
          <li>ナイター走行は事前予約・要相談です</li>
        </ul>
        <h2 style="margin-top:1rem">ご予約について</h2>
        <ul class="small">
          <li>カート・ミニバイクは、ご予約なしでもお越しいただけます (○ の日)</li>
          <li>その他 (大型バイク等) は<strong>事前のご予約が必要</strong>です</li>
          <li>
            <strong>小学生以下のお子様</strong>は
            <a href="https://kidskart.org/" target="_blank" rel="noopener">
              キッズカートアカデミー (kidskart.org)</a> で承っています
          </li>
          <li>レースパック・貸切・ナイターはご予約制です</li>
        </ul>
      </div>
    </>
  )}
</Base>

<script is:inline define:vars={{ mode }}>
  // 月のプルダウン
  const jump = document.getElementById('ym-jump');
  if (jump) {
    jump.addEventListener('change', () => {
      location.href = '/schedule?ym=' + encodeURIComponent(jump.value) + '&mode=' + mode;
    });
  }
  // 過ぎた日の開閉 (スマホだけボタンが見えている)
  const toggle = document.getElementById('past-toggle');
  const cal = document.getElementById('cal');
  if (toggle && cal) {
    toggle.addEventListener('click', () => {
      const hidden = cal.classList.toggle('hide-past');
      toggle.textContent = hidden
        ? toggle.dataset.show
        : '▲ 過ぎた日を閉じる';
    });
    toggle.dataset.show = toggle.textContent.trim();
  }
</script>

<style>
  /* minmax(0,1fr) + min-width:0 が無いと、長い予約名が列幅を押し広げて
     土日の列が画面外に出てしまう */
  .cal{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:2px;background:var(--line);
    border:1px solid var(--line);border-radius:10px;overflow:hidden}
  .cal-head{background:var(--ink);color:#fff;text-align:center;font-size:.76rem;font-weight:800;padding:.3rem 0}
  .cal-head.sun{color:#ffb3bd} .cal-head.sat{color:#b7d8ff}
  .cal-cell{background:#fff;min-height:92px;padding:.3rem;display:flex;flex-direction:column;gap:.15rem;
    min-width:0;overflow:hidden}
  .cal-cell.empty{background:var(--bg-2)}
  .cal-cell.today{outline:2px solid var(--red);outline-offset:-2px}
  .cal-cell.closed{background:#fdeef0}
  .cal-cell.linkable{cursor:pointer;text-decoration:none;color:inherit}
  .cal-cell.linkable:hover{background:#fff8f9;box-shadow:inset 0 0 0 2px var(--red)}
  .cal-cell.past{background:var(--bg-2)}
  .cal-cell.past .cal-day{color:var(--ink-4)}
  .cal-day{font-weight:800;font-size:.86rem}
  .cal-cell.sun .cal-day,.cal-cell.holiday .cal-day{color:var(--red)}
  .cal-cell.sat .cal-day{color:var(--blue)}
  .wx{color:#8a5a06;font-weight:700}
  .sf{color:var(--muted)}
  /* 押せることが分からないとクリックされないので、はっきり出す */
  .entry{background:var(--red);color:#fff;border-radius:4px;padding:.05rem .25rem;
    font-weight:800;text-align:center;margin-bottom:.1rem}
  .ev{background:var(--blue-soft);border-radius:4px;padding:0 .2rem;color:#1d5386;font-weight:700;
    max-width:100%}
  .ev .l1{display:block;opacity:.85}
  .ev .l2{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;
    overflow:hidden;overflow-wrap:anywhere}
  /* カレンダーセル内の ○✕ 行 (Base の .slots とは別物なので名前を分ける) */
  .modes{display:inline-flex;border:1px solid var(--line-2);border-radius:99px;overflow:hidden;
    background:#fff;margin-bottom:.2rem}
  .mode-btn{padding:.4rem 1rem;font-size:.85rem;font-weight:700;text-decoration:none;color:var(--ink-2)}
  .mode-btn+.mode-btn{border-left:1px solid var(--line)}
  .mode-btn.on{background:var(--ink);color:#fff}
  .day-slots{display:flex;flex-wrap:wrap;gap:.2rem}
  .day-slots:last-of-type{margin-top:auto}
  /* 「前 カート・ミニバイク」のように、その時間帯に走れるカテゴリーを出す */
  /* AM / PM ごとに「予約 → 受付状況」の順で並べる。
     RP・貸切は開始時刻で AM / PM に振り分ける (12:00 開始からは PM)。 */
  .sessions{display:flex;flex-direction:column;gap:.2rem;margin-top:auto}
  .sess-row{display:flex;gap:.35rem;align-items:flex-start}
  .sess-row>b{flex:0 0 1.9em;color:var(--ink-3);font-weight:800}
  .sess-items{flex:1;min-width:0;display:flex;flex-direction:column;gap:.1rem}
  .sess-items .ok{color:#14724a}
  .sess-items .ng{color:var(--ink-4)}
  /* 「スポーツ走行 / 受付停止」の 2 行。何が止まっているのかを分かるようにする */
  .sess-items .ng .l1{display:block;font-size:.9em;opacity:.85}
  .sess-items .ng .l2{display:block}
  /* すでに入っている RP・貸切 (旧スケジュールページの「RP ○○様」に相当) */
  .bk{line-height:1.35;border-left:3px solid var(--red);padding-left:.25rem;font-weight:700;
    color:var(--red-deep);max-width:100%}
  /* 1 行目 = 時刻と種別、2 行目 = 名前。2 行まで折り返してから省略する */
  .bk .l1{display:block;opacity:.85}
  .bk .l2{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;
    overflow:hidden;overflow-wrap:anywhere}
  .bk.charter{border-left-color:#7c6fdb;color:#5646b8}
  .day-slots .ok{color:#14724a} .day-slots .ng{color:var(--ink-4)}
  .dow-label{display:none}
  /* 見出しの年月をプルダウンにする。押せることが分かるよう枠と ▼ を出す */
  .ym-h1{display:flex;align-items:center;gap:.4rem;flex-wrap:wrap}
  .ym-select{width:auto;max-width:100%;font:inherit;font-weight:800;color:inherit;background:#fff;
    border:1px solid var(--line-2);border-radius:8px;padding:.15rem 1.6rem .15rem .5rem;
    cursor:pointer;appearance:none;
    background-image:linear-gradient(45deg,transparent 50%,var(--ink-3) 50%),
      linear-gradient(135deg,var(--ink-3) 50%,transparent 50%);
    background-position:calc(100% - 15px) 55%,calc(100% - 10px) 55%;
    background-size:5px 5px,5px 5px;background-repeat:no-repeat}
  .ym-select:hover{border-color:var(--red)}
  /* 過ぎた日をたたむのはスマホの縦長表示だけ (PC の 7 列は穴が空くと読めない) */
  .past-toggle{display:none}
  .bottom-nav{margin-top:.6rem;justify-content:space-between}
  .cell-body{display:flex;flex-direction:column;gap:.15rem;min-width:0;width:100%}

  /* スマホでは 7 列だと 1 セルが狭すぎて読めないので、旧スケジュール表と同じ
     「1 日 = 1 行、AM / PM は左右」の縦長レイアウトに切り替える。 */
  @media (max-width:640px){
    .cal{grid-template-columns:1fr;gap:0;border-radius:10px}
    .cal-head{display:none}
    .cal-cell.empty{display:none}
    .cal-cell{
      flex-direction:row;align-items:flex-start;gap:.6rem;
      min-height:0;padding:.5rem .6rem;border-bottom:1px solid var(--line);
      font-size:.82rem;
    }
    .cal-cell:last-child{border-bottom:none}
    .cal-day{flex:0 0 3.6rem;font-size:.9rem}
    .dow-label{display:inline;font-size:.8em}
    .cell-body{gap:.2rem}
    .sessions{margin-top:0;gap:.25rem}
    .bk{white-space:normal}
    /* 今月を開いたときに、1 日からではなく今日から始まるようにする */
    .past-toggle{display:block;width:100%;margin:0 0 .5rem;padding:.5rem;
