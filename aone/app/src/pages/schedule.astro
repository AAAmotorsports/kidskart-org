---
import Base from '@layouts/Base.astro';
import { envFrom } from '@lib/supabase';
import { monthState } from '@lib/queries';
import { todayJst, WEATHER_LABELS, BLOCK_KIND_LABELS } from '@lib/domain';

export const prerender = false;

// 公開スケジュール (仕様 19)。
// 管理カレンダーに登録された予定から自動生成する — 別途ページを手で書かない。
const env = envFrom(Astro.locals);
const today = todayJst();
const ymParam = Astro.url.searchParams.get('ym') ?? today.slice(0, 7);
const [y, m] = ymParam.split('-').map(Number);
const year = Number.isFinite(y) ? y : Number(today.slice(0, 4));
const month = Number.isFinite(m) && m >= 1 && m <= 12 ? m : Number(today.slice(5, 7));

// 表示モード: レンタル (RP・貸切) / スポーツ走行 (持ち込み) / 両方
// A-ONE のお客さんは「レンタルで遊びに来る人」と「マイマシンを持ち込む人」に
// はっきり分かれるので、見たい情報だけに切り替えられるようにする。
const modeParam = Astro.url.searchParams.get('mode');
const mode: 'rental' | 'sport' | 'both' =
  modeParam === 'rental' ? 'rental' : modeParam === 'sport' ? 'sport' : 'both';
const showRental = mode === 'rental' || mode === 'both';
const showSport = mode === 'sport' || mode === 'both';
const reserveHref =
  mode === 'rental' ? '/reserve/rp' : mode === 'sport' ? '/reserve/sport' : '/reserve';

const days = await monthState(env, year, month);

const prev = month === 1 ? `${year - 1}-12` : `${year}-${String(month - 1).padStart(2, '0')}`;
const next = month === 12 ? `${year + 1}-01` : `${year}-${String(month + 1).padStart(2, '0')}`;

// 月初の曜日ぶんだけ空セルを置く
const firstDow = new Date(Date.UTC(year, month - 1, 1)).getUTCDay();
const WD = ['日', '月', '火', '水', '木', '金', '土'];
const isOpen = (v: string) => v === 'true';
---
<Base title={`${year}年${month}月のスケジュール | A-ONE サーキット`} wide>
  <div class="spread" style="margin-bottom:.8rem">
    <h1 style="margin:0">{year}年{month}月のスケジュール</h1>
    <div class="row">
      <a class="btn sm" href={`/schedule?ym=${prev}&mode=${mode}`}>← 前の月</a>
      <a class="btn sm" href={`/schedule?ym=${next}&mode=${mode}`}>次の月 →</a>
    </div>
  </div>

  <div class="modes">
    <a class:list={['mode-btn', mode === 'rental' && 'on']} href={`/schedule?ym=${ymParam}&mode=rental`}>
      レンタル
    </a>
    <a class:list={['mode-btn', mode === 'sport' && 'on']} href={`/schedule?ym=${ymParam}&mode=sport`}>
      スポーツ走行
    </a>
    <a class:list={['mode-btn', mode === 'both' && 'on']} href={`/schedule?ym=${ymParam}&mode=both`}>
      両方
    </a>
  </div>
  <p class="tiny muted" style="margin:.2rem 0 .8rem">
    {mode === 'rental'
      ? 'レンタルカートのレースパック・貸切の空き状況です。通常のレンタル走行はご予約不要です。'
      : mode === 'sport'
        ? 'マイマシン持ち込みのスポーツ走行枠です。'
        : 'レンタル（レースパック・貸切）と、持ち込みのスポーツ走行の両方を表示しています。'}
  </p>

  {!days ? (
    <div class="card"><p class="muted">スケジュールを取得できませんでした。</p></div>
  ) : (
    <>
      <div class="cal">
        {WD.map((w, i) => <div class:list={['cal-head', i === 0 && 'sun', i === 6 && 'sat']}>{w}</div>)}
        {Array.from({ length: firstDow }).map(() => <div class="cal-cell empty"></div>)}
        {days.map((d) => {
          const dnum = Number(d.date.slice(8, 10));
          const publicBlocks = (d.blocks ?? []).filter((b) => b.is_public);
          const closed = d.weather === 'cancelled';
          return (
            <div class:list={[
              'cal-cell',
              d.date === today && 'today',
              d.dow === 0 && 'sun', d.dow === 6 && 'sat', d.is_holiday && 'holiday',
              closed && 'closed',
            ]}>
              <div class="cal-day">{dnum}</div>
              {d.weather !== 'normal' && (
                <div class="tiny wx">{WEATHER_LABELS[d.weather] ?? d.weather}</div>
              )}
              {publicBlocks.map((b) => (
                <div class="tiny ev">{BLOCK_KIND_LABELS[b.kind] ?? ''} {b.public_label}</div>
              ))}
              {!closed && showRental && (
                <div class="tiny day-slots">
                  <span class={d.rp_free > 0 ? 'ok' : 'ng'}>RP {d.rp_free > 0 ? '○' : '✕'}</span>
                  {d.counts.charter > 0 && <span class="ng">貸切あり</span>}
                </div>
              )}
              {!closed && showSport && (
                <div class="tiny day-slots">
                  <span class={isOpen(d.sport_am) ? 'ok' : 'ng'}>前 {isOpen(d.sport_am) ? '○' : '✕'}</span>
                  <span class={isOpen(d.sport_pm) ? 'ok' : 'ng'}>後 {isOpen(d.sport_pm) ? '○' : '✕'}</span>
                </div>
              )}
              {d.date >= today && !closed && (
                <a class="tiny book" href={`${reserveHref}?date=${d.date}`}>予約</a>
              )}
            </div>
          );
        })}
      </div>

      <p class="tiny muted" style="margin-top:.6rem">
        {showRental && 'RP ○ = レースパックの受付可。'}
        {showSport && '前/後 ○ = 午前/午後のスポーツ走行の受付可。'}
        ✕ = 受付停止 (レース・イベント・貸切・満枠など)。
        当日の最新状況は <a href="/">「今日走れる？」</a> をご確認ください。
      </p>

      <div class="card" style="margin-top:1rem">
        <h2>営業時間</h2>
        <ul class="small">
          <li>コースオープン 8:30 ／ 午前走行 9:00〜12:00</li>
          <li>午後走行 13:00〜16:30 ／ コースクローズ 17:30</li>
          <li>レースパック 10:00〜18:00 (30 分刻み・通常の最終受付 17:00)</li>
          <li>ナイター走行は事前予約・要相談です</li>
        </ul>
        <h2 style="margin-top:1rem">ご予約について</h2>
        <ul class="small">
          <li>カート・ミニバイクは、ご予約なしでもお越しいただけます (○ の日)</li>
          <li>キッズカート・その他 (大型バイク等) は<strong>事前のご予約が必要</strong>です</li>
          <li>レースパック・貸切・ナイターはご予約制です</li>
        </ul>
      </div>
    </>
  )}
</Base>

<style>
  .cal{display:grid;grid-template-columns:repeat(7,1fr);gap:2px;background:var(--line);border:1px solid var(--line);border-radius:10px;overflow:hidden}
  .cal-head{background:var(--ink);color:#fff;text-align:center;font-size:.76rem;font-weight:800;padding:.3rem 0}
  .cal-head.sun{color:#ffb3bd} .cal-head.sat{color:#b7d8ff}
  .cal-cell{background:#fff;min-height:92px;padding:.3rem;display:flex;flex-direction:column;gap:.15rem}
  .cal-cell.empty{background:var(--bg-2)}
  .cal-cell.today{outline:2px solid var(--red);outline-offset:-2px}
  .cal-cell.closed{background:#fdeef0}
  .cal-day{font-weight:800;font-size:.86rem}
  .cal-cell.sun .cal-day,.cal-cell.holiday .cal-day{color:var(--red)}
  .cal-cell.sat .cal-day{color:var(--blue)}
  .wx{color:#8a5a06;font-weight:700}
  .ev{background:var(--blue-soft);border-radius:4px;padding:0 .2rem;color:#1d5386;font-weight:700;
    overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  /* カレンダーセル内の ○✕ 行 (Base の .slots とは別物なので名前を分ける) */
  .modes{display:inline-flex;border:1px solid var(--line-2);border-radius:99px;overflow:hidden;
    background:#fff;margin-bottom:.2rem}
  .mode-btn{padding:.4rem 1rem;font-size:.85rem;font-weight:700;text-decoration:none;color:var(--ink-2)}
  .mode-btn+.mode-btn{border-left:1px solid var(--line)}
  .mode-btn.on{background:var(--ink);color:#fff}
  .day-slots{display:flex;flex-wrap:wrap;gap:.2rem}
  .day-slots:last-of-type{margin-top:auto}
  .day-slots .ok{color:#14724a} .day-slots .ng{color:var(--ink-4)}
  .book{margin-top:.1rem;text-decoration:none;font-weight:800;color:var(--red)}
  @media (max-width:640px){
    .cal-cell{min-height:74px;font-size:.72rem}
    .cal-day{font-size:.78rem}
  }
</style>
