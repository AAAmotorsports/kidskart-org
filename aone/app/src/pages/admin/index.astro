---
import Base from '@layouts/Base.astro';
import { envFrom } from '@lib/supabase';
import {
  dayState, reservationsOfDay, pendingReservations, pendingCallbacks, cronHealth,
} from '@lib/queries';
import {
  jaDate, jaDateShort, todayJst, addDays, timeRangeLabel,
  KIND_SHORT, STATUS_LABELS, STATUS_MARK,
  BUSINESS_LABELS, BUSINESS_EMOJI, BUSINESS_ORDER, SURFACE_LABELS, SURFACE_EMOJI, SURFACE_ORDER,
  nameWithHonorific,
} from '@lib/domain';

export const prerender = false;

// 管理トップ = 今日の運営ダッシュボード。
// 「今日どうなってる / 何を対応すべきか」だけを 1 画面に出す。
const env = envFrom(Astro.locals);
const today = todayJst();

const [state, rows, pending, stale, cron] = await Promise.all([
  dayState(env, today),
  reservationsOfDay(env, today),
  pendingReservations(env, today),
  // 受付から 24 時間たっても折り返していないもの。放置すると失注する
  pendingCallbacks(env, 24),
  // 自動メールの cron が動いているか。止まったことにここで気づけるようにする
  cronHealth(env),
]);

const live = rows.filter((r) => !['cancelled', 'no_show'].includes(r.status));
const people = live.reduce((a, r) => a + (r.party_size ?? 0), 0);
const week = Array.from({ length: 7 }, (_, i) => addDays(today, i));
const weekStates = await Promise.all(week.map((d) => dayState(env, d)));
const sessions: Array<['am' | 'pm', string]> = [['am', 'AM'], ['pm', 'PM']];

// 雨が降った瞬間に 1 タップで営業状況・路面状況を変えられるようにする。
// ここを押すと「今日走れる？」と公開スケジュールに即反映される。
// ★ 押してもお客様へのメールは飛ばない (急な休みは電話で連絡する運用)。
// 自動メールの見出し。最後に動いた時刻を「1 時間前」のように出す
function sinceLabel(iso: string | null): string {
  if (!iso) return '一度も動いていません';
  const mins = Math.floor((Date.now() - new Date(iso).getTime()) / 60000);
  if (mins < 2) return 'たった今';
  if (mins < 60) return `${mins} 分前`;
  const hours = Math.floor(mins / 60);
  if (hours < 24) return `${hours} 時間前`;
  return `${Math.floor(hours / 24)} 日前`;
}

const currentBusiness = state?.business.status ?? 'open';
const currentSurface = state?.surface.status ?? '';
const mailTargets = live.filter((r) => (r.contact_email ?? '').includes('@')).length;
---
<Base title="A-ONE 管理" admin wide>
  <div class="spread" style="margin-bottom:.8rem">
    <h1 style="margin:0">{jaDate(today)}</h1>
    <div class="row">
      {/* 電話が鳴ったら押すボタン。いちばん左・いちばん目立つ場所に置く
          (日別画面まで降りなくても、ここから登録を始められる。2026-09 オーナー依頼) */}
      <a class="btn primary sm" href="/admin/reserve">📞 予約を登録</a>
      <a class="btn sm" href={`/admin/day/${today}`}>今日の運営画面</a>
      <a class="btn sm" href={`/admin/sheet?date=${today}`}>受付シート</a>
      <a class="btn sm" href="/admin/calendar">カレンダー</a>
      <a class="btn sm" href="/admin/entries">参加申込</a>
    </div>
  </div>

  <div class="kpis">
    <div class="kpi"><div class="n">{live.length}</div><div class="l">本日の予約</div></div>
    <div class="kpi"><div class="n">{people}</div><div class="l">本日の人数</div></div>
    <div class="kpi"><div class="n">{live.filter((r) => r.kind === 'rp').length}</div><div class="l">RP</div></div>
    <div class="kpi"><div class="n">{pending.length}</div><div class="l">要対応</div></div>
    <div class="kpi wx">
      <div class="n small">{BUSINESS_LABELS[currentBusiness] ?? currentBusiness}</div>
      <div class="l">営業状況{currentSurface && ` / ${SURFACE_LABELS[currentSurface] ?? currentSurface}`}</div>
    </div>
  </div>

  <!-- ============ 営業状況 / 路面状況のワンタップ ============ -->
  <div class="card wx-card">
    <div class="spread" style="margin-bottom:.5rem">
      <h2 style="margin:0"><span class="ic">🏁</span> 本日の営業状況</h2>
      <span class="tiny muted">押すとすぐ公開ページに反映されます（メールは飛びません）</span>
    </div>
    <div class="wx-buttons">
      {BUSINESS_ORDER.map((code) => (
        <button type="button" class:list={['wx-btn', code, currentBusiness === code && 'on']}
                data-wx={code}>
          <span class="wx-emoji">{BUSINESS_EMOJI[code]}</span>
          {BUSINESS_LABELS[code]}
        </button>
      ))}
    </div>

    <div class="spread" style="margin:.9rem 0 .5rem">
      <h2 style="margin:0"><span class="ic">💧</span> 路面状況</h2>
      <span class="tiny muted">表示だけ。予約は止まりません</span>
    </div>
    <div class="wx-buttons">
      <button type="button" class:list={['wx-btn', 'sf', !currentSurface && 'on']} data-sf="">
        表示しない
      </button>
      {SURFACE_ORDER.map((code) => (
        <button type="button" class:list={['wx-btn', 'sf', currentSurface === code && 'on']}
                data-sf={code}>
          <span class="wx-emoji">{SURFACE_EMOJI[code]}</span>
          {SURFACE_LABELS[code]}
        </button>
      ))}
    </div>

    <div class="row" style="margin-top:.6rem">
      <input type="text" id="wx-msg" placeholder="公開メッセージ (例: 11 時に再判断します)"
             value={state?.business.message ?? ''} style="max-width:26rem" />
      <button class="btn sm" id="wx-msg-save">メッセージだけ保存</button>
      <span id="wx-out" class="small"></span>
    </div>

    <details style="margin-top:.7rem">
      <summary class="small">
        本日の予約者に一括連絡する（メールのある {mailTargets} 件）
      </summary>
      <div class="field" style="margin-top:.5rem">
        <label for="bc-subject">件名</label>
        <input type="text" id="bc-subject"
               value={`【A-ONE】${today.slice(5).replace('-', '/')} の営業について`} />
      </div>
      <div class="field">
        <label for="bc-body">本文</label>
        <textarea id="bc-body" placeholder="本日は雨天のため走行を中止いたします。&#10;振替をご希望の方はお電話ください。"></textarea>
      </div>
      <button class="btn sm" id="bc-send" disabled={mailTargets === 0}>一括送信する</button>
      <span id="bc-out" class="small"></span>
    </details>
  </div>

  {stale.length > 0 && (
    <div class="notice ng" style="margin-bottom:1rem">
      <strong>🔴 24 時間以上、折り返していない予約が {stale.length} 件あります</strong>
      <div class="table-scroll" style="margin-top:.5rem">
        <table>
          <thead><tr><th>経過</th><th>受付日</th><th>種別</th><th>希望日</th><th>お名前</th><th>電話</th><th></th></tr></thead>
          <tbody>
            {stale.map((r) => (
              <tr>
                <td><strong>{r.hours_waiting} 時間</strong></td>
                <td class="tiny">{jaDateShort(r.created_at.slice(0, 10))}</td>
                <td>{KIND_SHORT[r.kind as keyof typeof KIND_SHORT] ?? r.kind}</td>
                <td>{jaDateShort(r.date)} {timeRangeLabel(r)}</td>
                <td>{nameWithHonorific(r.contact_name)} ({r.party_size}名)</td>
                <td><a href={`tel:${(r.contact_phone ?? '').replace(/[^0-9+]/g, '')}`}>{r.contact_phone ?? '—'}</a></td>
                <td><a class="btn sm" href={`/admin/day/${r.date}`}>開く</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  )}

  {pending.length > 0 && (
    <div class="card">
      <h2><span class="ic">⚠️</span> 要対応 (連絡待ち・確認中)</h2>
      <div class="table-scroll">
        <table>
          <thead><tr><th>日付</th><th>種別</th><th>時間</th><th>お名前</th><th>連絡先</th><th>状態</th><th></th></tr></thead>
          <tbody>
            {pending.map((r) => (
              <tr>
                <td>{jaDateShort(r.date)}</td>
                <td>{KIND_SHORT[r.kind as keyof typeof KIND_SHORT] ?? r.kind}</td>
                <td>{timeRangeLabel(r)}</td>
                <td>{nameWithHonorific(r.contact_name)} ({r.party_size}名)</td>
                <td class="tiny">
                  {r.preferred_contact === 'phone' ? '☎ ' : '✉ '}
                  {r.preferred_contact === 'phone' ? (r.contact_phone ?? '—') : (r.contact_email ?? '—')}
                </td>
                <td><span class="badge warn">{STATUS_LABELS[r.status]}</span></td>
                <td><a class="btn sm" href={`/admin/day/${r.date}`}>開く</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  )}

  <div class="card">
    <h2><span class="ic">🏁</span> 今日の受付状況</h2>
    {state ? (
      <div class="row" style="gap:1.4rem">
        {sessions.map(([key, label]) => (
          <div>
            <div class="tiny muted">{label} ({state.sport[key].used_classes}/{state.sport[key].max_classes} クラス)</div>
            <div class="row">
              {state.sport[key].categories.map((c) => (
                <span class="tiny">{c.short_name}
                  <span class:list={['mark', c.status]} style="font-size:.95rem">{STATUS_MARK[c.status]}</span>
                </span>
              ))}
            </div>
          </div>
        ))}
        <div>
          <div class="tiny muted">RP 空き</div>
          <div class="tiny">{state.rp.slots.filter((s) => s.accepting).length} / {state.rp.slots.length} 枠</div>
        </div>
      </div>
    ) : (
      <p class="muted small">
        Supabase の接続設定が未完了です。<code>wrangler.jsonc</code> の
        <code>PUBLIC_SUPABASE_URL</code> / <code>PUBLIC_SUPABASE_ANON_KEY</code> と
        Dashboard の <code>SUPABASE_SERVICE_ROLE_KEY</code> をご確認ください。
      </p>
    )}
  </div>

  {cron && (
    <div class:list={['card', 'cron-card', cron.stale && 'ng']}>
      <h2><span class="ic">✉️</span> 自動メール</h2>
      <div class="cron-row">
        <div>
          <div class="tiny muted">最終実行</div>
          <div class="cron-big">{sinceLabel(cron.last_run_at)}</div>
          {cron.last_run_at && (
            <div class="tiny muted">
              {new Date(cron.last_run_at).toLocaleString('ja-JP', { timeZone: 'Asia/Tokyo' })}
              {cron.last_tasks === 0 && ' (この回は送るものなし)'}
            </div>
          )}
        </div>
        <div>
          <div class="tiny muted">今日 送ったメール</div>
          <div class="cron-big">{cron.mails_today} 通</div>
          {cron.mails_failed_today > 0 && (
            <div class="tiny ng-text">送れなかったもの {cron.mails_failed_today} 通</div>
          )}
        </div>
      </div>

      {cron.stale ? (
        <p class="tiny ng-text" style="margin:.5rem 0 0">
          <strong>1 時間半以上動いていません。</strong>
          ふだんは毎時 0 分に動きます。リマインド (前日) ・お礼 (当日) ・
          フォロー (3 か月後) が止まっているかもしれません。
          Cloudflare の Worker → Observability → ログで <code>cron</code> を検索すると
          様子が見られます。
        </p>
      ) : (
        <p class="tiny muted" style="margin:.5rem 0 0">
          毎時 0 分に動いています。8:00 リマインド ／ 12:00 拾い直し ／
          18:00 お礼 ／ 毎月 1 日 9:00 バックアップ。
          {cron.last_ok === false && ' 直前の回にエラーが出ています。'}
        </p>
      )}
    </div>
  )}

  <div class="card">
    <h2><span class="ic">📅</span> 今週</h2>
    <div class="week">
      {week.map((d, i) => {
        const s = weekStates[i];
        return (
          <a class:list={['wday', d === today && 'is-today']} href={`/admin/day/${d}`}>
            <div class="wd">{jaDateShort(d)}</div>
            {s ? (
              <>
                {s.business.status !== 'open' && (
                  <div class="tiny wx-tag">{BUSINESS_LABELS[s.business.status] ?? s.business.status}</div>
                )}
                {s.surface.status && (
                  <div class="tiny muted">{SURFACE_LABELS[s.surface.status] ?? s.surface.status}</div>
                )}
                <div class="tiny">走行 {s.counts.sport} / RP {s.counts.rp}</div>
                <div class="tiny muted">{s.counts.people} 名</div>
                {(s.blocks ?? []).slice(0, 2).map((b) => <div class="tiny ev">{b.title}</div>)}
              </>
            ) : <div class="tiny muted">—</div>}
          </a>
        );
      })}
    </div>
  </div>
</Base>

<script is:inline define:vars={{ today }}>
  const $ = (id) => document.getElementById(id);

  async function post(url, body) {
    const res = await fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body),
    });
    const data = await res.json().catch(() => ({}));
    if (!res.ok) throw new Error(data.error || '失敗しました');
    return data;
  }

  // 送らなかった項目は API 側で据え置かれる。
  // 営業状況のボタンを押しても、日別画面で入れた路面状況やメモは消えない。
  async function saveDay(patch) {
    const out = $('wx-out');
    out.textContent = ' 保存中…';
    try {
      await post('/api/admin/day', Object.assign({ date: today }, patch));
      out.textContent = ' 保存しました';
      setTimeout(() => location.reload(), 500);
    } catch (e) {
      out.textContent = ' ' + e.message;
    }
  }

  // 片方のボタンを押したときに、もう片方を巻き添えで消さないよう毎回両方送る
  const currentBusiness = () => {
    const on = document.querySelector('.wx-btn.on:not(.sf)');
    return on ? on.dataset.wx : 'open';
  };
  const currentSurface = () => {
    const on = document.querySelector('.wx-btn.sf.on');
    return on ? on.dataset.sf : '';
  };

  document.querySelectorAll('[data-wx]').forEach((b) => {
    b.addEventListener('click', () => saveDay({
      business_status: b.dataset.wx,
      surface_status: currentSurface(),
    }));
  });

  document.querySelectorAll('[data-sf]').forEach((b) => {
    b.addEventListener('click', () => saveDay({
      business_status: currentBusiness(),
      surface_status: b.dataset.sf,
    }));
  });

  $('wx-msg-save').addEventListener('click', () => {
    saveDay({
      business_status: currentBusiness(),
      surface_status: currentSurface(),
      status_message: $('wx-msg').value,
    });
  });

  const bc = $('bc-send');
  if (bc) bc.addEventListener('click', async () => {
    if (!confirm('本日の予約者全員にメールを送信します。よろしいですか？')) return;
    bc.disabled = true;
    try {
      const r = await post('/api/admin/broadcast', {
        date: today, subject: $('bc-subject').value, body: $('bc-body').value,
      });
      $('bc-out').textContent = ` ${r.recipients} 件に送信しました`;
    } catch (e) {
      $('bc-out').textContent = ' ' + e.message;
    }
    bc.disabled = false;
  });
</script>

<style>
  /* 天候ワンタップ: 雨が降った瞬間に押せることが最優先なので、
     ボタンを大きく・色で状態が分かるようにする */
  .ic{font-size:1.05em;margin-right:.15rem}
  .wx-card{border-left:4px solid var(--amber)}
  /* 自動メールが止まったことに気づけるようにする (止まっても誰も見に行かないので) */
  .cron-card{border-left:4px solid var(--green)}
  .cron-card.ng{border-left-color:var(--red);background:#fdf5f6}
  .cron-row{display:flex;gap:2rem;flex-wrap:wrap}
  .cron-big{font-size:1.15rem;font-weight:800}
  .ng-text{color:var(--red-deep)}
  .wx-buttons{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:.5rem}
  .wx-btn{display:flex;align-items:center;justify-content:center;gap:.35rem;
    padding:.7rem .5rem;border:1px solid var(--line-2);border-radius:10px;background:#fff;
    font-family:var(--jp);font-size:.9rem;font-weight:700;color:var(--ink);cursor:pointer;
    transition:transform .05s,box-shadow .15s}
  .wx-btn:hover{box-shadow:0 3px 10px rgba(0,0,0,.1)}
  .wx-btn:active{transform:scale(.98)}
  .wx-emoji{font-size:1.1rem}
  .wx-btn.on{color:#fff;border-color:transparent}
  .wx-btn.on.open{background:var(--green)}
  .wx-btn.on.checking{background:var(--amber);color:var(--ink)}
  .wx-btn.on.cancelled,.wx-btn.on.closed{background:var(--red)}
  /* 路面は営業状況と別軸だとひと目で分かるように色を変える */
  .wx-btn.on.sf{background:var(--ink);color:#fff}
  .kpis{display:grid;grid-template-columns:repeat(5,1fr);gap:.6rem;margin-bottom:1rem}
  .kpi{background:#fff;border:1px solid var(--line);border-radius:10px;padding:.6rem;text-align:center}
  .kpi .n{font-size:1.6rem;font-weight:800;line-height:1.1}
  .kpi .n.small{font-size:1rem}
  .kpi .l{font-size:.72rem;color:var(--ink-3);font-weight:700}
  .week{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:.4rem}
  .wday{display:block;background:var(--bg-2);border:1px solid var(--line);border-radius:9px;
    padding:.4rem;text-decoration:none;color:inherit;min-height:80px;min-width:0;overflow:hidden}
  .wday:hover{box-shadow:0 3px 8px rgba(0,0,0,.08)}
  .wday.is-today{border-color:var(--red);outline:1px solid var(--red)}
  .wd{font-weight:800;font-size:.8rem;margin-bottom:.2rem}
  .wx-tag{color:#8a5a06;font-weight:700}
  .ev{background:var(--blue-soft);border-radius:4px;padding:0 .2rem;color:#1d5386;
    overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  @media (max-width:900px){
    .kpis{grid-template-columns:repeat(3,1fr)}
    .week{grid-template-columns:repeat(4,1fr)}
  }
</style>
