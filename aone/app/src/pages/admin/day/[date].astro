---
import Base from '@layouts/Base.astro';
import { envFrom } from '@lib/supabase';
import { dayState, reservationsOfDay, categories, settings, blocksOfDay } from '@lib/queries';
import { fetchTodayForecast } from '@lib/weather';
import {
  jaDate, todayJst, addDays, hhmm, timeRangeLabel,
  KIND_LABELS, KIND_SHORT, STATUS_LABELS, SOURCE_LABELS,
  BUSINESS_LABELS, BUSINESS_EMOJI, BUSINESS_ORDER, SURFACE_LABELS, SURFACE_EMOJI, SURFACE_ORDER,
  BLOCK_KIND_LABELS, BLOCK_SCOPE_LABELS, STATUS_MARK, blockLabel,
  CONTACT_METHOD_LABELS, CHARTER_TYPE_LABELS, jaDateTime,
  nameWithHonorific, ENTRY_TYPE_LABELS, ENTRY_TYPE_ORDER, RACE_CLASSES,
} from '@lib/domain';

export const prerender = false;

// 日別の運営画面 (仕様 12 / 13 / 15)。
// スタッフはこの 1 画面で「営業状況・路面状況 → 連絡 → 予約確認 → 代理入力 →
// 強制受付 → 会計・無断キャンセル記録」まで完結できる。
const env = envFrom(Astro.locals);
const date = Astro.params.date!;
const today = todayJst();

if (!/^\d{4}-\d{2}-\d{2}$/.test(date)) {
  return Astro.redirect(`/admin/day/${today}`);
}

// 予定は day_state の表示用ではなくテーブルから読む。
// 「走れるカテゴリー」や参加申込の設定は day_state に入っていないため
// (編集するには元の行が要る)。
const [state, rows, cats, cfg, blocks] = await Promise.all([
  dayState(env, date),
  reservationsOfDay(env, date),
  categories(env),
  settings(env),
  blocksOfDay(env, date),
]);
const catName = (code: string) => cats.find((c) => c.code === code)?.name ?? code;

// 天気予報は当日ぶんのみ気象庁から取得 (参考情報 — 自動中止はしない)
const forecast = date === today ? await fetchTodayForecast(env.JMA_AREA_CODE || '400000') : null;

const live = rows.filter((r) => !['cancelled', 'no_show'].includes(r.status));
const dead = rows.filter((r) => ['cancelled', 'no_show'].includes(r.status));
const needsAction = live.filter((r) => ['contact_wait', 'checking'].includes(r.status));
// 折り返しが要るもののうち、まだ誰も対応していないものを最優先で出す
const waitingCallback = needsAction.filter((r) => !r.contacted_at);
const contacted = needsAction.filter((r) => r.contacted_at);
const mailTargets = live.filter((r) => (r.contact_email ?? '').includes('@')).length;
const sessions: Array<['am' | 'pm', string]> = [['am', 'AM'], ['pm', 'PM']];

// 営業状況は「臨時休業の予定」から自動で休業になることがある (source='block')
const business = state?.business.status ?? 'open';
const businessFromBlock = state?.business.source === 'block';
const surface = state?.surface.status ?? '';
---
<Base title={`${date} の運営 | A-ONE 管理`} admin wide>
  <div class="spread" style="margin-bottom:.6rem">
    <h1 style="margin:0">{jaDate(date)}</h1>
    <div class="row">
      <a class="btn sm" href={`/admin/day/${addDays(date, -1)}`}>← 前日</a>
      <a class="btn sm" href={`/admin/day/${today}`}>今日</a>
      <a class="btn sm" href={`/admin/day/${addDays(date, 1)}`}>翌日 →</a>
      <a class="btn sm" href={`/admin/sheet?date=${date}`}>受付シート</a>
      <a class="btn sm ghost" href={`/admin/entries?date=${date}`}>参加申込</a>
      <a class="btn sm ghost" href={`/admin/calendar?ym=${date.slice(0, 7)}`}>カレンダー</a>
    </div>
  </div>

  {waitingCallback.length > 0 && (
    <div class="notice ng" style="margin-bottom:1rem">
      <strong>🔴 折り返し未対応 {waitingCallback.length} 件</strong> —
      {waitingCallback.map((r) => ` ${nameWithHonorific(r.contact_name)} (${STATUS_LABELS[r.status]} / ${r.contact_phone ?? '電話なし'})`).join(' /')}
    </div>
  )}
  {contacted.length > 0 && (
    <div class="notice warn" style="margin-bottom:1rem">
      <strong>対応済み・返事待ち {contacted.length} 件</strong> —
      {contacted.map((r) => ` ${nameWithHonorific(r.contact_name)} (${STATUS_LABELS[r.status]})`).join(' /')}
    </div>
  )}

  <div class="cols">
    <div>
      <!-- ============ 営業状況 / 路面状況 ============ -->
      <div class="card">
        <h2><span class="ic">🏁</span> 営業状況</h2>
        <div class="choice" id="wx-choice">
          {BUSINESS_ORDER.map((code) => (
            <label>
              <input type="radio" name="wx" value={code} checked={business === code} />
              <span class="wx-emoji">{BUSINESS_EMOJI[code]}</span> {BUSINESS_LABELS[code]}
            </label>
          ))}
        </div>
        {businessFromBlock && (
          <p class="tiny muted" style="margin:.4rem 0 0">
            臨時休業の予定が登録されているので「休業」になっています
            (ここで別の状況を選べば、そちらが優先されます)。
          </p>
        )}

        <h2 style="margin-top:1.1rem"><span class="ic">💧</span> 路面状況</h2>
        <p class="tiny muted" style="margin:0 0 .4rem">
          表示だけの情報です。ここを変えても予約は止まりません。
        </p>
        <div class="choice" id="sf-choice">
          <label>
            <input type="radio" name="sf" value="" checked={!surface} /> 表示しない
          </label>
          {SURFACE_ORDER.map((code) => (
            <label>
              <input type="radio" name="sf" value={code} checked={surface === code} />
              <span class="wx-emoji">{SURFACE_EMOJI[code]}</span> {SURFACE_LABELS[code]}
            </label>
          ))}
        </div>

        <div class="field" style="margin-top:.6rem">
          <label for="wx-msg">公開メッセージ (「今日走れる？」に表示)</label>
          <input type="text" id="wx-msg" value={state?.business.message ?? ''}
                 placeholder="11 時に再判断します など" />
        </div>
        <div class="field">
          <label for="wx-note">スタッフメモ (非公開)</label>
          <input type="text" id="wx-note" value={state?.business.staff_note ?? ''} />
        </div>
        <button class="btn primary sm" id="wx-save">保存する</button>
        <span id="wx-msg-out" class="small"></span>
        <p class="tiny muted" style="margin:.5rem 0 0">
          ※ 保存してもお客様へのメールは送られません。お知らせが要るときは下の連絡欄から送ってください。
        </p>

        {forecast && (
          <div class="forecast">
            <div class="tiny muted">
              参考: {forecast.publishingOffice} / {forecast.areaName} の予報
            </div>
            <div><strong>{forecast.weather}</strong></div>
            <div class="row tiny">
              {forecast.pops.map((p) => <span class="badge">{p.label} {p.pop}%</span>)}
              {forecast.tempMin && <span class="badge">最低 {forecast.tempMin}℃</span>}
              {forecast.tempMax && <span class="badge">最高 {forecast.tempMax}℃</span>}
            </div>
            <div class="tiny muted">天気予報だけでは自動中止にしません。最終判断は A-ONE 側で行ってください。</div>
          </div>
        )}
      </div>

      <!-- ============ 一括連絡 ============ -->
      <div class="card">
        <h2><span class="ic">✉️</span> この日の予約者へ一括連絡</h2>
        <p class="tiny muted">メールアドレスのある {mailTargets} 件に送信します (キャンセル済みを除く)。</p>
        <div class="field">
          <label for="bc-subject">件名</label>
          <input type="text" id="bc-subject" value={`【A-ONE】${date.slice(5).replace('-', '/')} の営業について`} />
        </div>
        <div class="field">
          <label for="bc-body">本文</label>
          <textarea id="bc-body" placeholder="本日は雨天のため走行を中止いたします。&#10;振替をご希望の方はお電話ください。"></textarea>
        </div>
        <button class="btn sm" id="bc-send" disabled={mailTargets === 0}>一括送信する</button>
        <span id="bc-out" class="small"></span>
      </div>

      <!-- ============ 予約一覧 ============ -->
      <div class="card">
        <h2><span class="ic">📋</span> 予約 ({live.length} 件 / {live.reduce((a, r) => a + (r.party_size ?? 0), 0)} 名)</h2>
        {live.length === 0 && <p class="muted small">この日の予約はまだありません。</p>}
        {live.map((r) => (
          <div class="res" data-id={r.id}>
            <div class="spread">
              <div>
                <span class="badge info">{KIND_SHORT[r.kind as keyof typeof KIND_SHORT] ?? r.kind}</span>
                <strong> {nameWithHonorific(r.contact_name)}</strong>
                <span class="small muted"> {timeRangeLabel(r)} / {r.party_size}名
                  {r.vehicle_count ? ` / ${r.vehicle_count}台` : ''}
                  {r.category_code ? ` / ${cats.find((c) => c.code === r.category_code)?.name ?? r.category_code}` : ''}
                </span>
              </div>
              <div class="row">
                <span class:list={['badge', r.status === 'confirmed' ? 'ok' : 'warn']}>{STATUS_LABELS[r.status]}</span>
                <span class="badge">{SOURCE_LABELS[r.source] ?? r.source}</span>
                {r.charter_type && <span class="badge">{CHARTER_TYPE_LABELS[r.charter_type] ?? r.charter_type}</span>}
                {r.amount_manual && <span class="badge">金額を手入力</span>}
                {r.forced && <span class="badge ng">強制</span>}
                {r.is_paid && <span class="badge ok">会計済</span>}
                {['contact_wait', 'checking'].includes(r.status) && (
                  r.contacted_at
                    ? <span class="badge ok">対応済</span>
                    : <span class="badge ng">要折り返し</span>
                )}
              </div>
            </div>
            <div class="tiny muted">
              {r.reservation_number} ／ {r.contact_phone ?? '電話なし'} ／ {r.contact_email ?? 'メールなし'}
              {r.preferred_contact && ` ／ 希望連絡: ${r.preferred_contact === 'phone' ? '電話' : 'メール'}`}
            </div>
            {r.contacted_at && (
              <div class="tiny memo">
                対応済み: {jaDateTime(r.contacted_at)}
                {r.contact_method ? ` / ${CONTACT_METHOD_LABELS[r.contact_method] ?? r.contact_method}` : ''}
                {r.contacted_by ? ` / ${r.contacted_by}` : ''}
                {r.contact_result ? ` / ${r.contact_result}` : ''}
              </div>
            )}
            {r.request_note && <div class="tiny note">要望: {r.request_note}</div>}
            {r.staff_memo && <div class="tiny memo">メモ: {r.staff_memo}</div>}
            <div class="row acts">
              <select class="st" data-id={r.id}>
                {['confirmed', 'contact_wait', 'checking', 'completed'].map((s) => (
                  <option value={s} selected={r.status === s}>{STATUS_LABELS[s]}</option>
                ))}
              </select>
              <button class="btn sm act-status" data-id={r.id}>状態を保存</button>
              <button class="btn sm act-paid" data-id={r.id} data-paid={String(!r.is_paid)}>
                {r.is_paid ? '会計を取消' : '会計済にする'}
              </button>
              {['contact_wait', 'checking'].includes(r.status) && (
                r.contacted_at
                  ? <button class="btn sm act-uncontact" data-id={r.id}>対応済を取消</button>
                  : <>
                      <button class="btn sm primary act-contact" data-id={r.id} data-method="phone">📞 電話で対応済</button>
                      <button class="btn sm act-contact" data-id={r.id} data-method="email">✉️ メールで対応済</button>
                    </>
              )}
              <button class="btn sm act-memo" data-id={r.id}>メモ</button>
              <button class="btn sm act-cancel" data-id={r.id}>キャンセル</button>
              <button class="btn sm act-noshow" data-id={r.id}>無断キャンセル</button>
              <a class="btn sm ghost" href={`/r/${r.access_token}`} target="_blank">予約者ページ</a>
            </div>

            <!-- 日時・人数の変更 (電話で「やっぱり来週に」と言われたときに使う) -->
            <details class="edit">
              <summary class="small">✏️ 日時・人数を変更</summary>
              <div class="editbox" data-id={r.id}>
                <div class="grid4">
                  <label class="fld">日付
                    <input type="date" class="e-date" value={r.date} />
                  </label>
                  {r.kind === 'sport' ? (
                    <label class="fld">時間帯
                      <select class="e-session">
                        <option value="am" selected={r.session === 'am'}>AM</option>
                        <option value="pm" selected={r.session === 'pm'}>PM</option>
                      </select>
                    </label>
                  ) : (
                    <label class="fld">開始
                      <input type="time" class="e-start" step="1800" value={hhmm(r.start_time)} />
                    </label>
                  )}
                  {r.kind === 'sport' ? (
                    <label class="fld">カテゴリー
                      <select class="e-cat">
                        {cats.map((c) => (
                          <option value={c.code} selected={r.category_code === c.code}>{c.name}</option>
                        ))}
                      </select>
                    </label>
                  ) : (
                    <label class="fld">終了
                      <input type="time" class="e-end" step="1800" value={r.end_time ? hhmm(r.end_time) : ''} />
                    </label>
                  )}
                  <label class="fld">人数
                    <input type="number" class="e-party" min="1" max="200" value={r.party_size} />
                  </label>
                  {(r.kind === 'charter' || r.night_kind === 'charter') && (
                    <label class="fld">カート台数
                      <input type="number" class="e-karts" min="1" max="30" value={r.vehicle_count ?? ''} />
                    </label>
                  )}
                  {/* 電話で受けたあとに「この方は特別料金」を入れられるようにする。
                      空欄のままなら金額は変えない (自動計算のまま) */}
                  <label class="fld">料金 (円)
                    <input type="number" class="e-amount" min="0" step="100"
                           value={r.amount ?? ''} placeholder="空欄なら変更しません" />
                  </label>
                </div>
                <div class="tiny muted" style="margin:-.2rem 0 .4rem">
                  料金を自動計算と違う額にすると「金額を手入力」の印が付き、
                  人数や台数を変えても上書きされなくなります。
                </div>

                {/* 電話で受けたあとに「メールアドレスも教えてもらった」が起きる。
                    ここで登録すれば、下の「変更をメールで送信」が押せるようになる */}
                <div class="grid4">
                  <label class="fld">お名前
                    <input type="text" class="e-name" value={r.contact_name ?? ''} />
                  </label>
                  <label class="fld">電話
                    <input type="tel" class="e-phone" value={r.contact_phone ?? ''} />
                  </label>
                  <label class="fld">メールアドレス
                    <input type="email" class="e-email" value={r.contact_email ?? ''}
                           placeholder="あとから登録できます" />
                  </label>
                </div>
                <div class="tiny muted" style="margin:-.2rem 0 .4rem">
                  空欄にしても消えません (いまの値のまま)。メールアドレスを登録して保存すると、
                  リマインド・お礼などの自動メールも届くようになります。
                </div>
                {/* 既定はオフ。電話で話しながら直すことが多く、
                    そのたびにメールが飛ぶほうが困る (2026-08 オーナー確認)。
                    あとから知らせたくなったら下の「変更をメールで送信」を押す */}
                <label class="small mailchk">
                  <input type="checkbox" class="e-mail" disabled={!r.contact_email} />
                  保存と同時にお客様へメールで知らせる
                  {!r.contact_email && ' (メールアドレスが未登録です。上の欄で登録して保存すると押せるようになります)'}
                </label>
                <div class="row">
                  <button class="btn sm primary act-save" data-id={r.id}>この内容に変更する</button>
                  <button class="btn sm act-notify" data-id={r.id} disabled={!r.contact_email}>
                    ✉️ 変更をメールで送信
                  </button>
                </div>
                <div class="tiny muted">
                  受付ルールは無視して保存します (管理者の強制受付)。
                  「変更をメールで送信」は<strong>いま入っている内容</strong>を
                  そのままお送りします (料金も入ります)。
                </div>
              </div>
            </details>

            <!-- この方だけに連絡 (一括連絡と同じ 1 本の API を宛先 1 件で叩く) -->
            <details class="edit">
              <summary class="small">✉️ この方だけに連絡</summary>
              <div class="edit-body">
                {(r.contact_email ?? '').includes('@') ? (
                  <>
                    <div class="field">
                      <label>件名</label>
                      <input type="text" class="m-subject"
                             value={`【A-ONE】${date.slice(5).replace('-', '/')} のご予約について`} />
                    </div>
                    <div class="field">
                      <label>本文</label>
                      <textarea class="m-body" rows="3"
                        placeholder="本日は路面がヘビーウェットのため、走行時間を短縮しております。"></textarea>
                    </div>
                    <div class="row">
                      <button class="btn sm act-mail" data-id={r.id}>{r.contact_name} 様に送信</button>
                      <span class="tiny muted">{r.contact_email}</span>
                    </div>
                  </>
                ) : (
                  <p class="small muted" style="margin:0">
                    メールアドレスの登録がありません。
                    {r.contact_phone ? ` お電話 (${r.contact_phone}) でご連絡ください。` : ' 連絡先が登録されていません。'}
                  </p>
                )}
              </div>
            </details>
          </div>
        ))}

        {dead.length > 0 && (
          <details style="margin-top:.8rem">
            <summary class="small muted">キャンセル済み {dead.length} 件</summary>
            {dead.map((r) => (
              <div class="tiny muted" style="padding:.2rem 0">
                {STATUS_LABELS[r.status]} — {nameWithHonorific(r.contact_name)} / {KIND_SHORT[r.kind as keyof typeof KIND_SHORT]} /
                {timeRangeLabel(r)} {r.cancel_reason ? `(${r.cancel_reason})` : ''}
              </div>
            ))}
          </details>
        )}
      </div>
    </div>

    <div>
      <!-- ============ 受付状況 ============ -->
      <div class="card">
        <h2><span class="ic">🏁</span> 受付状況</h2>
        {state ? (
          <>
            {sessions.map(([key, label]) => (
              <div class="sess">
                <div class="spread">
                  <strong>{label}</strong>
                  <span class="tiny muted">{state.sport[key].used_classes} / {state.sport[key].max_classes} クラス
                    {state.sport[key].rp_groups > 0 && ` ・RP ${state.sport[key].rp_groups} 組`}</span>
                </div>
                <div class="row">
                  {state.sport[key].categories.map((c) => (
                    <span class="tiny">{c.short_name}
                      <span class:list={['mark', c.status]} style="font-size:.95rem">{STATUS_MARK[c.status]}</span>
                    </span>
                  ))}
                </div>
              </div>
            ))}
            <div class="tiny muted" style="margin-top:.5rem">RP 空き開始時間</div>
            <div class="row">
              {state.rp.slots.map((s) => (
                <span class:list={['badge', s.accepting ? 'ok' : 'ng']}>{s.time}
                  {s.groups > 0 && ` (${s.groups})`}</span>
              ))}
            </div>
          </>
        ) : <p class="muted small">状況を取得できませんでした。</p>}
      </div>

      <!-- ============ 代理入力 ============ -->
      <div class="card entry-card">
        <h2 class="entry-head"><span class="ic">📞</span> 電話・店頭予約の入力</h2>
        <p class="tiny muted">Web 予約と同じ台帳に入ります。入力した瞬間に Web 側の空きへ反映されます。</p>
        <div class="field">
          <label for="n-kind">種別</label>
          <select id="n-kind">
            {Object.entries(KIND_LABELS).map(([code, label]) => <option value={code}>{label}</option>)}
          </select>
        </div>
        <div class="field">
          <label>対象日 <span class="tiny muted">(複数可 — 連日・毎週のまとめ登録に)</span></label>
          <div class="row" style="margin-bottom:.35rem">
            <input type="date" id="n-date-add" style="max-width:11rem" />
            <button type="button" class="btn sm" id="n-date-btn">日を追加</button>
          </div>
          <div id="n-dates" class="row"></div>
        </div>

        <div class="field" id="wrap-session">
          <label>時間帯 <span class="tiny muted">(複数可)</span></label>
          <div class="choice">
            <label><input type="checkbox" class="n-sess" value="am" checked /> AM</label>
            <label><input type="checkbox" class="n-sess" value="pm" /> PM</label>
          </div>
        </div>
        <div class="field" id="wrap-category">
          <label for="n-category">カテゴリー</label>
          <select id="n-category">{cats.map((c) => <option value={c.code}>{c.name}</option>)}</select>
        </div>
        <div class="field" id="wrap-nightkind">
          <label for="n-nightkind">ナイターの内訳</label>
          <select id="n-nightkind">
            <option value="rp">レースパック</option>
            <option value="charter">貸切</option>
          </select>
          <div class="tiny muted">ナイターはレンタル (RP・貸切) のみお受けします。</div>
        </div>
        <div class="two" id="wrap-times">
          <div class="field">
            <label for="n-start">開始</label>
            <input type="time" id="n-start" step="1800" value="14:00" />
          </div>
          <div class="field" id="wrap-end">
            <label for="n-end">終了</label>
            <input type="time" id="n-end" step="1800" />
          </div>
        </div>
        <div class="two" id="wrap-counts">
          <div class="field">
            <label for="n-party">人数</label>
            <input type="number" id="n-party" min="1" value="1" />
          </div>
          <div class="field" id="wrap-vehicles">
            <label for="n-vehicles">カート台数</label>
            <input type="number" id="n-vehicles" min="1" />
            <div class="tiny muted">5 台以上から</div>
          </div>
        </div>
        <div class="field">
          <label for="n-name">お名前</label>
          <input type="text" id="n-name" placeholder="山田 太郎" />
          <div class="tiny muted">「様」は付けなくて大丈夫です (表示するときに付きます)</div>
        </div>
        <div class="two">
          <div class="field">
            <label for="n-phone">電話</label>
            <input type="tel" id="n-phone" />
          </div>
          <div class="field">
            <label for="n-email">メール (任意)</label>
            <input type="email" id="n-email" />
          </div>
        </div>
        <div class="field">
          <label for="n-memo">スタッフメモ</label>
          <input type="text" id="n-memo" placeholder="初走行 / 常連 / 支払済 など" />
        </div>
        <div class="two">
          <div class="field">
            <label for="n-source">入力経路</label>
            <select id="n-source">
              <option value="phone">電話</option>
              <option value="counter">店頭</option>
              <option value="admin">管理</option>
            </select>
          </div>
          <div class="field">
            <label for="n-amount">料金 (任意)</label>
            <input type="number" id="n-amount" min="0" step="100" />
          </div>
        </div>
        <label class="tiny"><input type="checkbox" id="n-mail" /> 予約控えメールを送る</label><br />
        <label class="tiny"><input type="checkbox" id="n-forced" /> 受付上限を無視して強制受付する</label>
        <div class="field" style="margin-top:.4rem">
          <input type="text" id="n-forced-reason" placeholder="強制受付の理由 (記録に残ります)" />
        </div>
        <div id="n-out" class="notice" hidden></div>
        <button class="btn primary sm" id="n-save">この内容で登録</button>
      </div>

      <!-- ============ ブロック予定 ============ -->
      <div class="card">
        <h2><span class="ic">📅</span> この日の予定・受付停止</h2>
        {blocks.map((b) => (
          <div class="spread blk">
            <div>
              <span class="badge">{blockLabel(b.kind, b.title)}</span>
              <div class="tiny muted">{BLOCK_SCOPE_LABELS[b.scope] ?? b.scope}
                {b.start_time && ` ${hhmm(b.start_time)}〜${hhmm(b.end_time) || ''}`}
                {b.category_code && ` / ${catName(b.category_code)}`}
                {!b.is_public && ' / 非公開'}</div>
              {/* なぜ止まっているのかが一目で分かるように、許可したカテゴリーを出す */}
              {b.scope === 'only_category' && (
                <div class="tiny allow">
                  {(b.allow_categories ?? []).length > 0
                    ? `走れる: ${(b.allow_categories ?? []).map(catName).join('・')} (ほかは停止)`
                    : '⚠ 走れるカテゴリーが未選択です。この予定は何も止めていません'}
                </div>
              )}
            </div>
            <div class="row">
              <button class="btn sm blk-edit" data-b={JSON.stringify({
                id: b.id, title: b.title, kind: b.kind, scope: b.scope,
                start_time: hhmm(b.start_time), end_time: hhmm(b.end_time),
                category_code: b.category_code ?? '',
                allow_categories: b.allow_categories ?? [],
                is_public: b.is_public, memo: b.memo ?? '',
                // 参加申込の設定。ここに載せ忘れると編集欄が空で開き、
                // 保存した時点で受付が切れて規則書の URL も消える
                entry_open: b.entry_open ?? false,
                entry_type: b.entry_type ?? '',
                entry_price: b.entry_price ?? null,
                entry_unit: b.entry_unit ?? 'person',
                entry_deadline: b.entry_deadline ?? '',
                entry_classes: b.entry_classes ?? [],
                entry_rules_url: b.entry_rules_url ?? '',
                entry_vehicle_rules_url: b.entry_vehicle_rules_url ?? '',
                entry_note: b.entry_note ?? '',
              })}>編集</button>
              <button class="btn sm blk-del" data-id={b.id}>削除</button>
            </div>
          </div>
        ))}
        {blocks.length === 0 && <p class="muted small">登録された予定はありません。</p>}

        <details style="margin-top:.6rem" id="b-details">
          <summary class="small" id="b-summary">予定を追加する</summary>
          <div class="field" style="margin-top:.5rem">
            <label for="b-title">予定名</label>
            <input type="text" id="b-title" placeholder="A-ONE シリーズ第 3 戦" />
          </div>
          <div class="two">
            <div class="field">
              <label for="b-kind">種類</label>
              <select id="b-kind">
                {Object.entries(BLOCK_KIND_LABELS).map(([c, l]) => <option value={c}>{l}</option>)}
              </select>
            </div>
            <div class="field">
              <label for="b-scope">停止範囲</label>
              <select id="b-scope">
                {Object.entries(BLOCK_SCOPE_LABELS).map(([c, l]) => <option value={c}>{l}</option>)}
              </select>
            </div>
          </div>
          <div class="two">
            <div class="field">
              <label for="b-start">開始 (時間指定のとき)</label>
              <input type="time" id="b-start" step="1800" />
            </div>
            <div class="field">
              <label for="b-end">終了</label>
              <input type="time" id="b-end" step="1800" />
            </div>
          </div>
          <div class="field" id="b-wrap-category">
            <label for="b-category">対象カテゴリー (カテゴリー停止のとき)</label>
            <select id="b-category">
              <option value="">—</option>
              {cats.map((c) => <option value={c.code}>{c.name}</option>)}
            </select>
          </div>
          {/* 「指定したカテゴリーだけ走れる」を選んだときだけ聞く。
              ここを聞かないと、選んでも何も止まらない予定ができてしまう */}
          <div class="field" id="b-wrap-allow" hidden>
            <label>走れるカテゴリー (チェックしたものだけ受け付けます)</label>
            <div class="choice">
              {cats.map((c) => (
                <label><input type="checkbox" class="b-allow" value={c.code} /> {c.name}</label>
              ))}
            </div>
            <div class="hint">
              例: レース前日はカートだけチェック → ミニバイク・キッズカート・その他が止まります。
            </div>
          </div>
          <label class="tiny"><input type="checkbox" id="b-public" checked /> 公開スケジュールに掲載する</label>

          {/* 参加申込の受付。ここを出していなかったため、この画面で予定を編集すると
              受付設定と規則書の URL が消えていた (2026-09 オーナー指摘) */}
          <div class="entry-box">
            <label class="tiny"><input type="checkbox" id="b-entry" /> <strong>この予定の参加申込を受け付ける</strong></label>
            <div id="b-entry-fields" hidden>
              <div class="two" style="margin-top:.5rem">
                <div class="field">
                  <label for="b-entry-type">申込の様式</label>
                  <select id="b-entry-type">
                    {ENTRY_TYPE_ORDER.map((t) => <option value={t}>{ENTRY_TYPE_LABELS[t]}</option>)}
                  </select>
                </div>
                <div class="field">
                  <label for="b-entry-deadline">申込締切</label>
                  <input type="date" id="b-entry-deadline" />
                  <div class="tiny muted">空欄なら開催日の前日</div>
                </div>
              </div>
              <div class="two">
                <div class="field">
                  <label for="b-entry-price">参加費 (円)</label>
                  <input type="number" id="b-entry-price" min="0" step="100" placeholder="空欄 = 要問合せ" />
                </div>
                <div class="field">
                  <label for="b-entry-unit">単位</label>
                  <select id="b-entry-unit">
                    <option value="team">1 チームあたり</option>
                    <option value="person">1 人あたり</option>
                  </select>
                </div>
              </div>
              <div class="field" id="b-wrap-entry-classes">
                <label>参加クラス</label>
                <div class="choice">
                  {RACE_CLASSES.map((c) => (
                    <label><input type="checkbox" class="b-entry-class" value={c} /> {c}</label>
                  ))}
                </div>
                <div class="tiny muted">申込フォームで選べるクラスです。</div>
              </div>
              <div class="field">
                <label for="b-entry-rules">特別規則書 PDF の URL</label>
                <input type="url" id="b-entry-rules" placeholder="https://rk-a1.com/wp-content/uploads/..." />
              </div>
              <div class="field">
                <label for="b-entry-vrules">車輌規則 PDF の URL</label>
                <input type="url" id="b-entry-vrules" placeholder="https://rk-a1.com/wp-content/uploads/..." />
              </div>
              <div class="field">
                <label for="b-entry-note">申込フォームに出す補足 (任意)</label>
                <input type="text" id="b-entry-note" placeholder="レンタルカートは A-ONE でご用意します など" />
              </div>
            </div>
          </div>

          <div class="field" style="margin-top:.4rem">
            <input type="text" id="b-memo" placeholder="スタッフメモ (任意)" />
          </div>
          <div id="b-out" class="notice" hidden></div>
          <div class="row">
            <button class="btn sm" id="b-save">予定を追加</button>
            <button class="btn sm ghost" id="b-cancel" hidden>編集をやめる</button>
          </div>
        </details>
      </div>
    </div>
  </div>
</Base>

<script is:inline define:vars={{ date }}>
  const $ = (id) => document.getElementById(id);

  async function post(url, body) {
    const res = await fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body),
    });
    const data = await res.json().catch(() => ({}));
    if (!res.ok) throw new Error(data.error || '失敗しました');
    return data;
  }

  // ---- 営業状況 / 路面状況 ----
  // 保存してもお客様へのメールは飛ばさない (急な休みは電話で連絡する運用)。
  $('wx-save').addEventListener('click', async () => {
    const out = $('wx-msg-out');
    const wx = document.querySelector('input[name=wx]:checked');
    const sf = document.querySelector('input[name=sf]:checked');
    try {
      await post('/api/admin/day', {
        date,
        business_status: wx ? wx.value : 'open',
        surface_status: sf ? sf.value : '',
        status_message: $('wx-msg').value,
        staff_note: $('wx-note').value,
      });
      out.textContent = ' 保存しました';
      setTimeout(() => location.reload(), 600);
    } catch (e) { out.textContent = ' ' + e.message; }
  });

  // ---- 一括連絡 ----
  const bc = $('bc-send');
  if (bc) bc.addEventListener('click', async () => {
    if (!confirm('この日の予約者全員にメールを送信します。よろしいですか？')) return;
    bc.disabled = true;
    try {
      const r = await post('/api/admin/broadcast', {
        date, subject: $('bc-subject').value, body: $('bc-body').value,
      });
      $('bc-out').textContent = ` ${r.recipients} 件に送信しました`;
    } catch (e) {
      $('bc-out').textContent = ' ' + e.message;
    }
    bc.disabled = false;
  });

  // ---- 予約の操作 ----
  document.querySelectorAll('.act-status').forEach((b) => b.addEventListener('click', async () => {
    const id = b.dataset.id;
    const sel = document.querySelector('select.st[data-id="' + id + '"]');
    try {
      await post('/api/admin/reservation', { action: 'status', id, status: sel.value });
      location.reload();
    } catch (e) { alert(e.message); }
  }));

  // 折り返し対応の記録。ステータスは変えない (電話済みだが返事待ち、があるため)
  document.querySelectorAll('.act-contact').forEach((b) => b.addEventListener('click', async () => {
    const method = b.dataset.method;
    const result = prompt(
      (method === 'phone' ? '電話' : 'メール') + 'で対応しました。内容をメモできます (空欄可)',
      '',
    );
    if (result === null) return;
    b.disabled = true;
    try {
      await post('/api/admin/reservation', {
        action: 'contacted', id: b.dataset.id, method, result,
      });
      location.reload();
    } catch (e) { alert(e.message); b.disabled = false; }
  }));

  document.querySelectorAll('.act-uncontact').forEach((b) => b.addEventListener('click', async () => {
    if (!confirm('対応済みの記録を取り消します。よろしいですか？')) return;
    try {
      await post('/api/admin/reservation', { action: 'contacted', id: b.dataset.id, undo: true });
      location.reload();
    } catch (e) { alert(e.message); }
  }));

  // 日時・人数の変更。管理画面からは受付ルールを無視して保存する (forced)
  // 「変更をメールで送信」— 保存とは別に、いまの内容をそのまま知らせる
  document.querySelectorAll('.act-notify').forEach((b) => b.addEventListener('click', async () => {
    if (!confirm('いま入っている予約内容 (料金を含む) をお客様にメールで送ります。よろしいですか？')) return;
    const label = b.textContent;
    b.disabled = true;
    b.textContent = '送信中…';
    try {
      const r = await post('/api/admin/reservation', { action: 'notify', id: b.dataset.id });
      b.textContent = '✓ 送信しました';
      alert((r && r.sent_to ? r.sent_to : 'お客様') + ' に送信しました。');
    } catch (e) {
      alert(e.message);
      b.textContent = label;
    } finally {
      b.disabled = false;
      setTimeout(() => { b.textContent = label; }, 4000);
    }
  }));

  document.querySelectorAll('.act-save').forEach((b) => b.addEventListener('click', async () => {
    const box = b.closest('.editbox');
    const pick = (cls) => box.querySelector('.' + cls);
    const val = (cls) => { const el = pick(cls); return el && el.value !== '' ? el.value : undefined; };

    const payload = {
      action: 'update',
      id: b.dataset.id,
      date: val('e-date'),
      session: val('e-session'),
      category_code: val('e-cat'),
      start_time: val('e-start'),
      end_time: val('e-end'),
      party_size: val('e-party'),
      vehicle_count: val('e-karts'),
      amount: val('e-amount'),
      name: val('e-name'),
      phone: val('e-phone'),
      email: val('e-email'),
      send_mail: !!(pick('e-mail') && pick('e-mail').checked && !pick('e-mail').disabled),
    };

    b.disabled = true;
    b.textContent = '保存中…';
    try {
      await post('/api/admin/reservation', payload);
      location.reload();
    } catch (e) {
      alert(e.message);
      b.disabled = false;
      b.textContent = 'この内容に変更する';
    }
  }));

  // 個別連絡。一括連絡と同じ /api/admin/broadcast を宛先 1 件で叩く
  document.querySelectorAll('.act-mail').forEach((b) => b.addEventListener('click', async () => {
    const box = b.closest('.edit-body');
    const subject = box.querySelector('.m-subject').value.trim();
    const message = box.querySelector('.m-body').value.trim();
    if (!subject || !message) { alert('件名と本文を入力してください'); return; }
    if (!confirm('この方 1 名にメールを送信します。よろしいですか？')) return;

    const label = b.textContent;
    b.disabled = true;
    b.textContent = '送信中…';
    try {
      const r = await post('/api/admin/broadcast', {
        date, subject, body: message, reservation_ids: [b.dataset.id],
      });
      b.textContent = r.recipients > 0 ? '送信しました' : '送信できませんでした';
    } catch (e) {
      alert(e.message);
      b.disabled = false;
      b.textContent = label;
    }
  }));

  document.querySelectorAll('.act-paid').forEach((b) => b.addEventListener('click', async () => {
    try {
      await post('/api/admin/reservation', {
        action: 'memo', id: b.dataset.id, is_paid: b.dataset.paid === 'true',
      });
      location.reload();
    } catch (e) { alert(e.message); }
  }));

  document.querySelectorAll('.act-memo').forEach((b) => b.addEventListener('click', async () => {
    const memo = prompt('スタッフメモ (顧客には表示されません)');
    if (memo === null) return;
    try {
      await post('/api/admin/reservation', { action: 'memo', id: b.dataset.id, staff_memo: memo });
      location.reload();
    } catch (e) { alert(e.message); }
  }));

  document.querySelectorAll('.act-cancel').forEach((b) => b.addEventListener('click', async () => {
    const reason = prompt('キャンセル理由 (任意)');
    if (reason === null) return;
    const mail = confirm('お客様にキャンセル通知メールを送りますか？');
    try {
      await post('/api/admin/reservation', {
        action: 'cancel', id: b.dataset.id, reason, send_mail: mail,
      });
      location.reload();
    } catch (e) { alert(e.message); }
  }));

  document.querySelectorAll('.act-noshow').forEach((b) => b.addEventListener('click', async () => {
    if (!confirm('無断キャンセルとして記録します。よろしいですか？')) return;
    try {
      await post('/api/admin/reservation', {
        action: 'cancel', id: b.dataset.id, no_show: true, reason: '無断キャンセル',
      });
      location.reload();
    } catch (e) { alert(e.message); }
  }));

  // ---- 代理入力 ----
  // 電話口で「土日どっちも」「毎週土曜で 3 回」と言われることがあるので、
  // 日付と時間帯を複数選んでまとめて登録できるようにする。
  // カテゴリー・人数・連絡先は共通、予約は 1 日 1 件ずつ独立して作る
  // (1 日だけキャンセル・変更できるようにするため)。
  var pickedDates = [date];

  function renderDates() {
    var wrap = $('n-dates');
    wrap.innerHTML = '';
    pickedDates.sort();
    pickedDates.forEach(function (d) {
      var chip = document.createElement('span');
      chip.className = 'badge info date-chip';
      chip.innerHTML = d.slice(5).replace('-', '/') +
        (pickedDates.length > 1 ? ' <b data-del="' + d + '" style="cursor:pointer">×</b>' : '');
      wrap.appendChild(chip);
    });
    wrap.querySelectorAll('[data-del]').forEach(function (b) {
      b.addEventListener('click', function () {
        pickedDates = pickedDates.filter(function (x) { return x !== b.dataset.del; });
        renderDates();
      });
    });
  }

  $('n-date-btn').addEventListener('click', function () {
    var v = $('n-date-add').value;
    if (!v) return;
    if (pickedDates.indexOf(v) === -1) pickedDates.push(v);
    $('n-date-add').value = '';
    renderDates();
  });
  renderDates();

  function syncKindFields() {
    const kind = $('n-kind').value;
    $('wrap-session').hidden = kind !== 'sport';
    // ナイターはレンタル (RP・貸切) のみなので、カテゴリーではなく内訳を選ぶ
    $('wrap-category').hidden = kind !== 'sport';
    $('wrap-nightkind').hidden = kind !== 'night';
    $('wrap-times').hidden = kind === 'sport';

    // 終了時刻とカート台数は貸切だけの項目。
    // レースパックは人数だけ選べばよく、出しておくと入れる物だと思われる
    const isCharter = kind === 'charter'
      || (kind === 'night' && $('n-nightkind').value === 'charter');
    $('wrap-end').hidden = !isCharter;
    $('wrap-vehicles').hidden = !isCharter;
    // 片方だけになったら 1 列にして、空欄が並んでいるように見せない
    $('wrap-times').classList.toggle('one', !isCharter);
    $('wrap-counts').classList.toggle('one', !isCharter);
    if (!isCharter) { $('n-end').value = ''; $('n-vehicles').value = ''; }
  }
  $('n-kind').addEventListener('change', syncKindFields);
  $('n-nightkind').addEventListener('change', syncKindFields);
  syncKindFields();

  $('n-save').addEventListener('click', async () => {
    const out = $('n-out');
    out.hidden = true;
    const kind = $('n-kind').value;
    const btn = $('n-save');

    if (pickedDates.length === 0) {
      out.hidden = false; out.className = 'notice ng';
      out.textContent = '対象日を 1 つ以上選んでください';
      return;
    }

    // 登録する組み合わせを作る (スポーツ走行は 日付 × 時間帯)
    const sessions = Array.from(document.querySelectorAll('.n-sess:checked'))
      .map((el) => el.value);
    if (kind === 'sport' && sessions.length === 0) {
      out.hidden = false; out.className = 'notice ng';
      out.textContent = '時間帯を 1 つ以上選んでください';
      return;
    }
    const combos = [];
    pickedDates.forEach((d) => {
      if (kind === 'sport') sessions.forEach((s) => combos.push({ date: d, session: s }));
      else combos.push({ date: d, session: undefined });
    });

    btn.disabled = true;
    btn.textContent = '登録中…';
    const okList = [];
    const ngList = [];

    for (const c of combos) {
      const label = c.date.slice(5).replace('-', '/') +
        (c.session ? (c.session === 'am' ? ' AM' : ' PM') : '');
      try {
        const r = await post('/api/admin/reservation', {
          action: 'create',
          kind,
          date: c.date,
          session: c.session,
          category_code: kind === 'sport' ? $('n-category').value : undefined,
          night_kind: kind === 'night' ? $('n-nightkind').value : undefined,
          start_time: kind === 'sport' ? undefined : $('n-start').value,
          end_time: (kind === 'charter' || (kind === 'night' && $('n-nightkind').value === 'charter'))
            ? $('n-end').value : undefined,
          party_size: Number($('n-party').value || 1),
          vehicle_count: $('n-vehicles').value ? Number($('n-vehicles').value) : undefined,
          name: $('n-name').value,
          phone: $('n-phone').value,
          email: $('n-email').value,
          staff_memo: $('n-memo').value,
          source: $('n-source').value,
          amount: $('n-amount').value ? Number($('n-amount').value) : undefined,
          forced: $('n-forced').checked,
          forced_reason: $('n-forced-reason').value,
          send_mail: $('n-mail').checked,
        });
        okList.push(label + ' (' + r.reservation_number + ')');
      } catch (e) {
        ngList.push(label + ': ' + e.message);
      }
    }

    btn.disabled = false;
    btn.textContent = 'この内容で登録';
    out.hidden = false;
    if (ngList.length === 0) {
      out.className = 'notice ok';
      out.textContent = okList.length + ' 件登録しました — ' + okList.join(' / ');
      setTimeout(() => location.reload(), 900);
    } else {
      out.className = okList.length ? 'notice warn' : 'notice ng';
      out.innerHTML =
        (okList.length ? '<strong>' + okList.length + ' 件登録しました</strong>: ' + okList.join(' / ') + '<br>' : '') +
        '<strong>登録できなかった日</strong>: ' + ngList.join(' / ') +
        '<br><span class="tiny">「受付上限を無視して強制受付する」にチェックすると登録できます</span>';
      if (okList.length) setTimeout(() => location.reload(), 3500);
    }
  });

  // ---- ブロック予定 ----
  // 停止範囲で聞くことが変わる。「指定したカテゴリーだけ走れる」を選んだのに
  // カテゴリーを聞かないと、何も止めない予定ができてしまう
  function bSyncScope() {
    const v = $('b-scope').value;
    $('b-wrap-allow').hidden = v !== 'only_category';
    $('b-wrap-category').hidden = v !== 'category';
  }
  $('b-scope').addEventListener('change', bSyncScope);
  bSyncScope();

  // 参加申込。様式で聞くことが変わる (耐久はチーム単位 / クラスはシリーズ戦だけ)
  function bSyncEntry() {
    $('b-entry-fields').hidden = !$('b-entry').checked;
    const t = $('b-entry-type').value;
    $('b-entry-unit').value = t === 'endurance' ? 'team' : 'person';
    $('b-wrap-entry-classes').hidden = t !== 'series';
  }
  $('b-entry').addEventListener('change', bSyncEntry);
  $('b-entry-type').addEventListener('change', bSyncEntry);
  bSyncEntry();

  // 編集中の予定 id。null なら新規追加
  let bEditId = null;
  function bReset() {
    bEditId = null;
    $('b-title').value = ''; $('b-kind').value = 'event'; $('b-scope').value = 'all';
    $('b-start').value = ''; $('b-end').value = ''; $('b-category').value = '';
    $('b-public').checked = true; $('b-memo').value = '';
    document.querySelectorAll('.b-allow').forEach((el) => { el.checked = false; });
    $('b-entry').checked = false;
    $('b-entry-type').value = 'sprint';
    $('b-entry-price').value = ''; $('b-entry-deadline').value = '';
    $('b-entry-rules').value = ''; $('b-entry-vrules').value = ''; $('b-entry-note').value = '';
    document.querySelectorAll('.b-entry-class').forEach((el) => { el.checked = true; });
    bSyncEntry();
    $('b-save').textContent = '予定を追加';
    $('b-summary').textContent = '予定を追加する';
    $('b-cancel').hidden = true;
    $('b-out').hidden = true;
    bSyncScope();
  }
  $('b-cancel').addEventListener('click', bReset);

  document.querySelectorAll('.blk-edit').forEach((btn) => btn.addEventListener('click', () => {
    const b = JSON.parse(btn.dataset.b);
    bEditId = b.id;
    $('b-title').value = b.title || ''; $('b-kind').value = b.kind; $('b-scope').value = b.scope;
    $('b-start').value = b.start_time || ''; $('b-end').value = b.end_time || '';
    $('b-category').value = b.category_code || '';
    $('b-public').checked = !!b.is_public; $('b-memo').value = b.memo || '';
    document.querySelectorAll('.b-allow').forEach((el) => {
      el.checked = (b.allow_categories || []).indexOf(el.value) >= 0;
    });
    // 参加申込の設定も出す。出さないまま保存すると受付が切れて規則書も消える
    $('b-entry').checked = !!b.entry_open;
    $('b-entry-type').value = b.entry_type || 'sprint';
    $('b-entry-price').value = b.entry_price == null ? '' : String(b.entry_price);
    $('b-entry-unit').value = b.entry_unit || 'person';
    $('b-entry-deadline').value = b.entry_deadline || '';
    $('b-entry-rules').value = b.entry_rules_url || '';
    $('b-entry-vrules').value = b.entry_vehicle_rules_url || '';
    $('b-entry-note').value = b.entry_note || '';
    document.querySelectorAll('.b-entry-class').forEach((el) => {
      el.checked = (b.entry_classes || []).indexOf(el.value) >= 0;
    });
    bSyncEntry();
    $('b-save').textContent = '変更を保存';
    $('b-summary').textContent = '予定を編集する: ' + (b.title || '');
    $('b-cancel').hidden = false;
    bSyncScope();
    $('b-details').open = true;
    $('b-title').focus();
  }));

  $('b-save').addEventListener('click', async () => {
    const out = $('b-out');
    out.hidden = true;
    try {
      await post('/api/admin/block', {
        action: bEditId ? 'update' : 'create',
        id: bEditId,
        date,
        title: $('b-title').value,
        kind: $('b-kind').value,
        scope: $('b-scope').value,
        start_time: $('b-start').value,
        end_time: $('b-end').value,
        category_code: $('b-category').value,
        allow_categories: Array.from(document.querySelectorAll('.b-allow:checked'))
          .map((el) => el.value).join(','),
        is_public: $('b-public').checked,
        memo: $('b-memo').value,
        entry_open: $('b-entry').checked,
        entry_type: $('b-entry-type').value,
        entry_price: $('b-entry-price').value,
        entry_unit: $('b-entry-unit').value,
        entry_deadline: $('b-entry-deadline').value,
        entry_classes: Array.from(document.querySelectorAll('.b-entry-class:checked'))
          .map((el) => el.value).join(','),
        entry_rules_url: $('b-entry-rules').value,
        entry_vehicle_rules_url: $('b-entry-vrules').value,
        entry_note: $('b-entry-note').value,
      });
      location.reload();
    } catch (e) {
      out.hidden = false;
      out.className = 'notice ng';
      out.textContent = e.message;
    }
  });

  document.querySelectorAll('.blk-del').forEach((b) => b.addEventListener('click', async () => {
    if (!confirm('この予定を削除します。よろしいですか？')) return;
    try {
      await post('/api/admin/block', { action: 'delete', id: b.dataset.id });
      location.reload();
    } catch (e) { alert(e.message); }
  }));
</script>

<style>
  .allow{color:var(--ink-2);font-weight:700;margin-top:.1rem}
  .cols{display:grid;grid-template-columns:1.35fr 1fr;gap:1rem;align-items:start}
  .ic{font-size:1.05em;margin-right:.15rem}
  /* 電話が鳴ったらまずここ。1 画面の中で一番見つけやすくしておく */
  .entry-card{border:2px solid var(--red);box-shadow:0 4px 14px rgba(215,38,61,.12)}
  /* 予定の「参加申込の受付」まとまり (カレンダー画面と同じ見た目) */
  .entry-box{border:1px solid var(--line);border-left:3px solid var(--red);border-radius:0 6px 6px 0;
    padding:.7rem .9rem;margin:.7rem 0 .3rem;background:var(--bg-2)}
  .entry-head{background:var(--red);color:#fff;margin:-1rem -1rem .7rem;padding:.6rem 1rem;
    border-radius:10px 10px 0 0;font-size:1.05rem}
  .two{display:grid;grid-template-columns:1fr 1fr;gap:.6rem}
  .two.one{grid-template-columns:1fr}
  .res{border:1px solid var(--line);border-radius:10px;padding:.6rem;margin-bottom:.6rem;background:var(--bg-2)}
  .res .acts{margin-top:.4rem}
  .res .note{color:var(--ink-2)}
  .res .memo{color:#8a5a06}
  .res select.st{width:auto;padding:.25rem .5rem;font-size:.8rem}
  .sess+.sess{margin-top:.6rem;padding-top:.6rem;border-top:1px dashed var(--line)}
  .blk{padding:.3rem 0;border-bottom:1px dashed var(--line)}
  .forecast{margin-top:.8rem;padding:.6rem;border:1px dashed var(--line-2);border-radius:9px;background:var(--bg-2)}
  .forecast .row{margin:.3rem 0}
  /* 日時・人数の変更フォーム (普段は畳んでおく) */
  .res .edit{margin-top:.4rem;border-top:1px dashed var(--line);padding-top:.4rem}
  .res .edit summary{cursor:pointer;color:var(--ink-2)}
  .editbox{margin-top:.5rem}
  .grid4{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:.5rem}
  .fld{display:flex;flex-direction:column;gap:.15rem;font-size:.8rem;color:var(--ink-2)}
  .fld input,.fld select{padding:.35rem .5rem;font-size:.85rem}
  .mailchk{display:flex;align-items:center;gap:.35rem;margin:.5rem 0}
  .mailchk input{width:auto;margin:0}
  @media (max-width:900px){ .cols{grid-template-columns:1fr} }
</style>
