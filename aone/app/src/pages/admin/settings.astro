---
import Base from '@layouts/Base.astro';
import { envFrom } from '@lib/supabase';
import { settings, categories } from '@lib/queries';

export const prerender = false;

// 通常ルールの数値設定 (仕様 20)。
// 「ルールを固定化しすぎない」ための逃げ道。ここを変えると受付判定が変わる。
const env = envFrom(Astro.locals);
const [cfg, cats] = await Promise.all([settings(env), categories(env)]);

const NUM = [
  ['max_classes_weekday_am', '平日 午前の最大クラス数'],
  ['max_classes_weekday_pm', '平日 午後の最大クラス数'],
  ['max_classes_holiday_am', '土日祝 午前の最大クラス数'],
  ['max_classes_holiday_pm', '土日祝 午後の最大クラス数'],
  ['rp_min_party', 'RP の最少人数'],
  ['rp_slot_minutes', 'RP の開始時間の刻み (分)'],
  ['rp_duration_minutes', 'RP 1 グループの占有時間 (分)'],
  ['rp_max_groups_per_start', '同一開始時刻の最大グループ数'],
  ['rp_groups_block_sport', 'スポーツ走行を止める RP 同時グループ数'],
] as const;

const PRICE = [
  ['rp_price_per_person', 'レースパック 1 人あたり (円)'],
  ['charter_base_price', '貸切 基本料 (円)'],
  ['charter_price_per_kart', '貸切 カート 1 台あたり (円)'],
  ['charter_min_karts', '貸切 最小台数'],
  ['rental_heat_price', 'レンタル走行 1 ヒート (円)'],
  ['rental_heat_minutes', 'レンタル走行 1 ヒートの分数'],
] as const;

const TIME = [
  ['course_open_time', 'コースオープン'],
  ['am_start_time', '午前走行 開始'],
  ['am_end_time', '午前走行 終了'],
  ['pm_start_time', '午後走行 開始'],
  ['pm_end_time', '午後走行 終了'],
  ['course_close_time', 'コースクローズ'],
  ['rp_first_start_time', 'RP 最初の開始時間'],
  ['rp_last_start_time', 'RP 通常の最終受付'],
  ['rp_late_limit_time', 'RP 受付可能な最終時刻 (これ以降は不可)'],
  ['charter_first_start_time', '貸切 受付開始時刻'],
  ['charter_last_end_time', '貸切 受付終了時刻'],
] as const;
---
<Base title="設定 | A-ONE 管理" admin>
  <h1>受付ルールの設定</h1>
  <p class="small muted">
    ここを変更すると、予約フォーム・「今日走れる？」・公開スケジュールの判定が
    すべて変わります。通常ルールをここで決めておき、個別の例外は日別画面の
    「強制受付」で対応してください。
  </p>

  {!cfg ? (
    <div class="card"><p class="muted">設定を取得できませんでした。Supabase の接続をご確認ください。</p></div>
  ) : (
    <>
      <div class="card">
        <h2>受付枠</h2>
        <div class="grid2">
          {NUM.map(([key, label]) => (
            <div class="field">
              <label for={key}>{label}</label>
              <input type="number" id={key} data-key={key} value={cfg[key]} min="0" />
            </div>
          ))}
        </div>
      </div>

      <div class="card">
        <h2>予約者名の公開</h2>
        <p class="tiny muted">
          レースパックの予約画面に「この日のご予約」として、すでに入っている予約の
          時間と名前を出します。管理画面には設定に関わらずフルネームが出ます。
        </p>
        <div class="field" style="max-width:22rem">
          <label for="public_name_display">公開する名前</label>
          <select id="public_name_display" data-key="public_name_display">
            <option value="family" selected={cfg.public_name_display === 'family'}>姓のみ (山田 様)</option>
            <option value="full" selected={cfg.public_name_display === 'full'}>入力されたお名前 (山田 太郎 様)</option>
            <option value="hidden" selected={cfg.public_name_display === 'hidden'}>名前は出さない (時間のみ)</option>
          </select>
          <div class="hint">
            姓のみは「山田 太郎」→「山田 様」、空白が無い場合は先頭 2 文字を姓とみなします。
            3 文字姓 (佐々木 等) を正確に出したい場合は「入力されたお名前」を選んでください。
          </div>
        </div>
      </div>

      <div class="card">
        <h2>料金</h2>
        <p class="tiny muted">
          予約時に自動計算して予約に記録します（レースパック = 人数 × 単価、
          貸切 = 基本料 ＋ 台数 × 単価）。金額を変えると<strong>これ以降の予約</strong>に反映されます。
          既存の予約金額は変わりません。個別の金額はスタッフが予約ごとに上書きできます。
        </p>
        <div class="grid2">
          {PRICE.map(([key, label]) => (
            <div class="field">
              <label for={key}>{label}</label>
              <input type="number" id={key} data-key={key} value={cfg[key]} min="0" step="100" />
            </div>
          ))}
        </div>
      </div>

      <div class="card">
        <h2>時間</h2>
        <div class="grid2">
          {TIME.map(([key, label]) => (
            <div class="field">
              <label for={key}>{label}</label>
              <input type="time" id={key} data-key={key} value={String(cfg[key]).slice(0, 5)} step="1800" />
            </div>
          ))}
        </div>
      </div>

      <div class="card">
        <h2>カテゴリー</h2>
        <p class="tiny muted">
          <strong>要予約</strong>: ✔があると事前予約が無いと走行できない扱いになり、
          「今日走れる？」には予約が入っている日だけ表示されます。✔が無ければ
          「走れます」（予約なしの飛び込みOK）と常時表示されます。<br />
          <strong>管理のみ</strong>: ✔があると顧客向けの予約フォームに出しません
          （電話で相談を受けてスタッフが代理入力する運用）。管理画面の代理入力には出ます。<br />
          <strong>色</strong>: 管理カレンダーでの色分けに使います。
        </p>
        <table>
          <thead><tr><th>カテゴリー</th><th>色</th><th>要予約</th><th>管理のみ</th><th>受付する</th></tr></thead>
          <tbody>
            {cats.map((c) => (
              <tr>
                <td>{c.name}</td>
                <td>
                  <input type="color" class="cat-color" data-code={c.code} value={c.color}
                         style="width:3rem;height:1.8rem;padding:0" />
                </td>
                <td>
                  <input type="checkbox" class="cat-req" data-code={c.code} checked={c.requires_reservation} />
                </td>
                <td>
                  <input type="checkbox" class="cat-admin" data-code={c.code} checked={c.admin_only} />
                </td>
                <td>
                  <input type="checkbox" class="cat-active" data-code={c.code} checked={c.is_active} />
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div id="out" class="notice" hidden></div>
      <button class="btn primary" id="save">設定を保存</button>
    </>
  )}
</Base>

{cfg && (
  <script is:inline>
    document.getElementById('save').addEventListener('click', async () => {
      const out = document.getElementById('out');
      out.hidden = true;
      const payload = { categories: [] };
      document.querySelectorAll('[data-key]').forEach((el) => { payload[el.dataset.key] = el.value; });

      const byCode = {};
      document.querySelectorAll('.cat-req').forEach((el) => {
        byCode[el.dataset.code] = byCode[el.dataset.code] || { code: el.dataset.code };
        byCode[el.dataset.code].requires_reservation = el.checked;
      });
      document.querySelectorAll('.cat-color').forEach((el) => {
        byCode[el.dataset.code] = byCode[el.dataset.code] || { code: el.dataset.code };
        byCode[el.dataset.code].color = el.value;
      });
      document.querySelectorAll('.cat-admin').forEach((el) => {
        byCode[el.dataset.code] = byCode[el.dataset.code] || { code: el.dataset.code };
        byCode[el.dataset.code].admin_only = el.checked;
      });
      document.querySelectorAll('.cat-active').forEach((el) => {
        byCode[el.dataset.code] = byCode[el.dataset.code] || { code: el.dataset.code };
        byCode[el.dataset.code].is_active = el.checked;
      });
      payload.categories = Object.values(byCode);
      try {
        const res = await fetch('/api/admin/settings', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || '保存できませんでした');
        out.hidden = false; out.className = 'notice ok'; out.textContent = '保存しました';
      } catch (e) {
        out.hidden = false; out.className = 'notice ng'; out.textContent = e.message;
      }
    });
  </script>
)}

<style>
  .grid2{display:grid;grid-template-columns:1fr 1fr;gap:.6rem}
  @media (max-width:560px){ .grid2{grid-template-columns:1fr} }
</style>
