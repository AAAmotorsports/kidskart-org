---
import Base from '@layouts/Base.astro';
import { envFrom } from '@lib/supabase';
import { dayState, settings } from '@lib/queries';
import { todayJst, jaDate, BUSINESS_LABELS } from '@lib/domain';

export const prerender = false;

// 予約メニュー。
// RP (レースパック) を最優先で見せる — 単価も満足度も高く、A-ONE として
// 一番伸ばしたいメニューなので、他の 3 つとは扱いを分けて大きく置く。
const env = envFrom(Astro.locals);
const today = todayJst();
const [state, cfg] = await Promise.all([dayState(env, today), settings(env)]);
const rpPrice: number = cfg?.rp_price_per_person ?? 6600;
const charterBase: number = cfg?.charter_base_price ?? 11000;
const charterPerKart: number = cfg?.charter_price_per_kart ?? 11000;
const charterMinKarts: number = cfg?.charter_min_karts ?? 5;
const heatPrice: number = cfg?.rental_heat_price ?? 2200;
const heatMinutes: number = cfg?.rental_heat_minutes ?? 7;
const yen = (n: number) => `${n.toLocaleString('ja-JP')} 円`;

const rpOpen = state ? state.rp.slots.filter((s) => s.accepting) : [];
// 休業・走行中止の日は「満枠」ではなく「お休み」。枠の話をすると誤解される
const closedToday = ['cancelled', 'closed'].includes(state?.business.status ?? '');
const rpSummary = !state
  ? ''
  : closedToday
    ? '本日はお休みです（別の日はご予約いただけます）'
    : rpOpen.length === 0
      ? '本日は満枠です（別の日はご予約いただけます）'
      : rpOpen.length === state.rp.slots.length
        ? `本日は ${rpOpen[0].time}〜${rpOpen[rpOpen.length - 1].time} 空きあり`
        : `本日は ${rpOpen[0].time}〜 空きあり`;
// ?embed=1 … rk-a1.com の中に枠で貼るときの表示 (ヘッダー・フッターを出さない)
const embed = Astro.url.searchParams.get('embed') === '1';
// 埋め込み先のページには、たいてい同じ見出しが既にある。二重に出さない。
// ホームページ側に見出しが無いときは ?embed=1&title=1 で出せる
const showTitle = !embed || Astro.url.searchParams.get('title') === '1';
---
<Base title="予約する | A-ONE サーキット" description="A-ONE サーキットのレースパック・スポーツ走行・貸切・ナイターの予約メニュー" embed={embed}>
  {!embed && <a class="back-link" href="/">← トップに戻る</a>}
  {showTitle && <h1>ご予約</h1>}

  {state && state.business.status !== 'open' && (
    <div class="notice warn" style="margin-bottom:1rem">
      本日 ({jaDate(today)}) は <strong>{BUSINESS_LABELS[state.business.status] ?? state.business.status}</strong> です。
      {state.business.message}
      <a href="/">本日の走行状況を見る →</a>
    </div>
  )}

  <!-- ============ RP を最優先で見せる ============ -->
  <a class="hero" href="/reserve/rp">
    <div class="hero-badge">いちばん人気</div>
    <div class="hero-body">
      <div class="hero-title">レースパック <span class="hero-abbr">RP</span></div>
      <div class="hero-price">{yen(rpPrice)} <span>/ 人</span></div>
      <p class="hero-lead">
        3 名以上のグループ向け。みんなでタイムを競って、いちばん盛り上がるプランです。
        代表者 1 名がまとめてご予約ください。
      </p>
      <ul class="hero-points">
        <li>練習 → 予選 → レース。表彰台で記念撮影ができます</li>
        <li>10:00〜17:00 の 30 分刻みで開始時間を選べます</li>
        <li>ご予約後も、人数・時間は専用ページからいつでも変更できます</li>
        <li>会社の懇親会・部活・お友達同士のグループに</li>
      </ul>
      {rpSummary && <div class="hero-avail">{rpSummary}</div>}
    </div>
    <div class="hero-cta">
      <span class="btn primary">レースパックを予約する</span>
    </div>
  </a>

  <!-- ============ その他のメニュー ============ -->
  <h2 class="sub-head">そのほかのご予約</h2>
  <div class="menu">
    <a class="menu-card" href="/reserve/sport">
      <div class="menu-title">スポーツ走行 <span class="tag">持ち込み</span></div>
      <p class="small muted">
        マイマシンでの走行です。<strong>前日までに走行枠のご予約</strong>をされてご来場ください。
        当日、走行枠に空きがあればご予約なしでの走行も可能です。
      </p>
      <span class="btn sm">予約する</span>
    </a>

    {/* 小学生以下はキッズカートアカデミー (kidskart.org) の受付。
        ここから /reserve/sport に飛ばすと別のものを予約させてしまう
        (2026-08 オーナー指摘)。メニューカードではなく外部リンクにする */}
    <a class="menu-card" href="https://kidskart.org/" target="_blank" rel="noopener">
      <div class="menu-title">小学生以下のお子様 <span class="tag">別サイト</span></div>
      <p class="small muted">
        小学生以下のお子様の走行は<strong>キッズカートアカデミー</strong>で承っています。
        専用の車両とインストラクターをご用意しています。
      </p>
      <span class="btn sm">kidskart.org へ →</span>
    </a>

    <a class="menu-card" href="/reserve/charter">
      <div class="menu-title">貸切</div>
      <div class="card-price">レンタルカート付き<br />
        {yen(charterBase)} ＋ {yen(charterPerKart)} × カート台数 × 時間<br />
        <span class="muted">（最小 {charterMinKarts} 台。3 時間なら {yen(charterBase + charterPerKart * charterMinKarts * 3)}）</span>
      </div>
      <p class="small muted">
        <strong>コース貸切のみ</strong>もお選びいただけます (お持ち込み車両でのご利用)。
        料金は内容により変わるため、お申し込み後に A-ONE より折り返しご連絡します。<br />
        前日までのお申し込みとなります。
      </p>
      <span class="btn sm">申し込む</span>
    </a>

    <a class="menu-card" href="/reserve/event">
      <div class="menu-title">イベント参加申込 <span class="tag">レース</span></div>
      <p class="small muted">
        耐久・スプリント・シリーズ戦の<strong>参加お申し込み</strong>です。
        受付中のイベントからお選びください。走行のご予約とは別のお申し込みになります。
      </p>
      <span class="btn sm">申し込む</span>
    </a>

    <a class="menu-card" href="/reserve/night">
      <div class="menu-title">ナイター走行</div>
      <p class="small muted">
        <strong>レースパックまたは貸切</strong>でのご利用となります（持ち込み車両は対象外）。
        事前予約・要相談です。ご希望の日時をお知らせいただければ、A-ONE より折り返しご連絡します。
      </p>
      <span class="btn sm">相談する</span>
    </a>
  </div>

  <div class="card walkin-card">
    <h2>レンタルカート走行（1 ヒート {yen(heatPrice)} / {heatMinutes} 分）</h2>
    <p class="small">
      通常のレンタルカート走行は<strong>ご予約不要</strong>です。営業時間内にお越しいただければ、
      その場で受付して走行できます。本日走れるかどうかは
      <a href="/">「今日走れる？」</a>でご確認ください。
    </p>
    <p class="small muted">
      グループでレースをしたい方は上のレースパック、コースを独占したい方は貸切をご利用ください。
    </p>
  </div>

  <div class="card">
    <h2>ご予約にあたって</h2>
    <ul class="small">
      <li>お支払いは原則として当日現地でのお支払いです（レースパック {yen(rpPrice)}／人、貸切 {yen(charterBase)} ＋ {yen(charterPerKart)}×台数×時間）。</li>
      <li>レンタル (レースパック・貸切・ナイター) のキャンセルは、
        <strong>前日 18 時まで</strong>のご連絡なら無料、
        <strong>当日は料金の 50%</strong> を申し受けます。</li>
      <li>持ち込みのスポーツ走行は、天候の影響が大きいため当日でもご連絡いただければ無料です。</li>
      <li>ご連絡のないキャンセル (無断キャンセル) は、いずれも料金 100% を申し受けます。</li>
      <li>ご予約後は、予約完了メールに記載の専用 URL からいつでも内容の確認・変更・キャンセルができます。</li>
      <li>お電話でのご予約も承っています ({env.PUBLIC_SITE_TEL || '092-919-7186'})。</li>
    </ul>
  </div>
</Base>

<style>
  .hero{
    display:block;position:relative;text-decoration:none;color:#fff;
    background:linear-gradient(135deg,#12233a 0%,#24405f 100%);
    border-radius:16px;padding:1.3rem 1.2rem 1.1rem;margin:0 0 1.4rem;
    box-shadow:0 6px 20px rgba(18,35,58,.22);
    border:2px solid var(--red);
    transition:transform .06s, box-shadow .18s;
  }
  .hero:hover{box-shadow:0 10px 28px rgba(18,35,58,.3)}
  .hero:active{transform:scale(.995)}
  .hero-badge{
    position:absolute;top:-.7rem;left:1.1rem;background:var(--red);color:#fff;
    font-size:.74rem;font-weight:800;padding:.2rem .8rem;border-radius:99px;
    letter-spacing:.04em;
  }
  .hero-title{font-size:1.5rem;font-weight:800;letter-spacing:.02em;margin:.2rem 0 .4rem}
  .hero-abbr{
    font-size:.8rem;background:var(--red);border-radius:6px;padding:.1rem .45rem;
    vertical-align:middle;margin-left:.3rem;letter-spacing:.06em;
  }
  .hero-price{font-size:1.15rem;font-weight:800;color:#ffd7dd;margin:0 0 .5rem}
  .hero-price span{font-size:.8rem;font-weight:700;opacity:.85}
  .hero-lead{margin:0 0 .6rem;font-size:.94rem;color:#dbe6f0}
  .hero-points{margin:0 0 .8rem;padding-left:1.1rem;font-size:.85rem;color:#c3d3e2}
  .hero-points li{margin:.15rem 0}
  .hero-avail{
    display:inline-block;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.25);
    border-radius:8px;padding:.35rem .7rem;font-size:.85rem;font-weight:700;margin-bottom:.9rem;
  }
  .hero-cta .btn{font-size:1rem;padding:.7rem 1.6rem}
  .sub-head{font-size:1rem;color:var(--ink-3);margin:0 0 .6rem}
  .menu{display:grid;grid-template-columns:repeat(3,1fr);gap:.8rem;margin-bottom:1.2rem}
  .menu-card{display:block;background:#fff;border:1px solid var(--line);border-radius:var(--radius);
    padding:1rem;text-decoration:none;color:inherit;transition:box-shadow .15s,transform .05s}
  .menu-card:hover{box-shadow:0 4px 14px rgba(0,0,0,.08)}
  .menu-card:active{transform:scale(.995)}
  .menu-title{font-weight:800;font-size:1.02rem;margin-bottom:.3rem}
  .menu-title .tag{font-size:.66rem;background:var(--bg-3);color:var(--ink-3);border-radius:5px;
    padding:.1rem .4rem;vertical-align:middle;font-weight:700}
  .card-price{font-size:.82rem;font-weight:700;color:var(--red-deep);margin-bottom:.3rem;line-height:1.45}
  .walkin-card{border-left:4px solid var(--green)}
  .menu-card p{margin:.2rem 0 .7rem}
  @media (max-width:760px){ .menu{grid-template-columns:1fr} }
</style>
