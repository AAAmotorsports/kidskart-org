---
import Base from '@layouts/Base.astro';
import { envFrom } from '@lib/supabase';
import { settings } from '@lib/queries';
import { todayJst, addDays, dayFocus } from '@lib/domain';

export const prerender = false;

const cfg = await settings(envFrom(Astro.locals));
const pricePerPerson: number = cfg?.rp_price_per_person ?? 6600;

// レースパック (RP) の予約フォーム (仕様 3)。
// 同一開始時刻は 2 グループまで、17:00 以降は要相談 — 判定は DB 側。
const today = todayJst();
const maxDate = addDays(today, 180);
// 18 時を過ぎたら翌日を初期値にする (「今日走れる？」の切り替えと揃える)。
// 選べる範囲は今日のまま — 当日でも電話でご相談いただくことはある
const focus = dayFocus({
  course_open: cfg?.course_open_time,
  course_close: cfg?.course_close_time,
}, today);
const initialDate = Astro.url.searchParams.get('date') ?? focus.date;
// 「今日走れる？」の RP 枠から飛んできたときは、その時間を選択済みにする
const initialTime = (Astro.url.searchParams.get('time') ?? '').match(/^\d{2}:\d{2}$/)
  ? Astro.url.searchParams.get('time')!
  : '';
// ?embed=1 … rk-a1.com の中に枠で貼るときの表示 (ヘッダー・フッターを出さない)
const embed = Astro.url.searchParams.get('embed') === '1';
// 埋め込み先のページには、たいてい同じ見出しが既にある。二重に出さない。
// ホームページ側に見出しが無いときは ?embed=1&title=1 で出せる
const showTitle = !embed || Astro.url.searchParams.get('title') === '1';
---
<Base title="レースパックのご予約 | A-ONE サーキット" embed={embed}>
  {!embed && <a class="back-link" href="/reserve">← 予約メニューに戻る</a>}
  {showTitle && <h1>レースパック (RP) のご予約</h1>}
  <p class="small muted">
    3 名以上のグループでお楽しみいただけるレースパックです。代表者 1 名がご予約ください。
    開始時間は 10:00〜17:00 の 30 分刻み。17:00 以降のご希望は要相談として承ります。
  </p>
  <div class="notice info small" style="margin-bottom:1rem">
    <strong>料金 {pricePerPerson.toLocaleString('ja-JP')} 円 / 人</strong>
    （練習 → 予選 → レース。表彰台で記念撮影あり）<br />
    お支払いは当日現地でお願いします。
  </div>

  <form id="form" class="card" novalidate>
    <div class="field">
      <label for="date">ご希望日</label>
      <input type="date" id="date" name="date" value={initialDate} min={today} max={maxDate} required />
    </div>

    <div id="day-info" class="notice info small" style="margin-bottom:1rem">空き状況を確認しています…</div>

    <div class="field">
      <label>開始時間</label>
      <div id="slots" class="slots"></div>
      <div id="rp-booked" class="booked" hidden></div>
      <div class="hint">
        <span id="picked-label" class="picked-label">開始時間を選んでください</span>
        <span id="slot-hint"> ／ △ = 残り 1 グループ ／ ✕ = 満枠 ／ — = 受付時間外</span>
      </div>
    </div>

    <div class="two">
      <div class="field">
        <label for="party">ご参加人数</label>
        <input type="number" id="party" name="party_size" min="3" max="40" value="3" required />
        <div class="hint">3 名以上で承ります。人数は後から専用ページで変更できます。</div>
        <div class="price-box">お支払い予定額 <b id="price">—</b></div>
      </div>
      <div class="field">
        <label for="tel-note">ご希望の連絡方法</label>
        <select id="contact-method" name="preferred_contact">
          <option value="email">メール</option>
          <option value="phone">電話</option>
        </select>
      </div>
    </div>

    <fieldset>
      <legend>代表者様のご連絡先</legend>
      <div class="two">
        <div class="field">
          <label for="name">お名前</label>
          <input type="text" id="name" name="name" autocomplete="name" required />
        </div>
        <div class="field">
          <label for="kana">フリガナ</label>
          <input type="text" id="kana" name="kana" />
        </div>
      </div>
      <div class="two">
        <div class="field">
          <label for="phone">お電話番号</label>
          <input type="tel" id="phone" name="phone" autocomplete="tel" required />
        </div>
        <div class="field">
          <label for="email">メールアドレス</label>
          <input type="email" id="email" name="email" autocomplete="email" required />
          <div class="hint">予約完了メールに、変更・キャンセル用の専用 URL をお送りします。</div>
        </div>
      </div>
      <div class="field">
        <label for="note">ご要望・備考 (任意)</label>
        <textarea id="note" name="request_note" placeholder="初めてのメンバーが多いです／表彰式の希望 など"></textarea>
      </div>
    </fieldset>

    <div class="notice warn small" style="margin-bottom:1rem">
      <strong>キャンセル規定</strong><br />
      前日 18 時までにご連絡いただければ、キャンセル料はいただきません。<br />
      <strong>当日のキャンセルは、料金の 50% を申し受けます。</strong><br />
      ご連絡のないキャンセル (無断キャンセル) は、料金 100% を申し受けます。<br />
      日時・人数の変更は、予約完了メールの専用 URL からいつでも可能です。
    </div>

    <div class="field">
      <label class="agree">
        <input type="checkbox" id="agree" required />
        キャンセル規定に同意します
      </label>
    </div>

    <div id="error" class="notice ng" hidden></div>

    <button type="submit" class="btn primary" id="submit">この内容で予約する</button>
  </form>
</Base>

<script is:inline define:vars={{ PRICE_PER_PERSON: pricePerPerson, INITIAL_TIME: initialTime }}>
  const $ = (id) => document.getElementById(id);
  let state = null;
  let picked = null;
  // URL で指定された開始時間 (最初の 1 回だけ自動選択する)
  let pendingPick = INITIAL_TIME || null;

  async function loadBooked(date) {
    const box = $('rp-booked');
    try {
      const res = await fetch('/api/rp/bookings?date=' + encodeURIComponent(date));
      const data = await res.json();
      const list = (data.bookings || []);
      if (list.length === 0) { box.hidden = true; box.innerHTML = ''; return; }
      box.hidden = false;
      box.innerHTML = '<b>この日のご予約</b>' + list.map(function (b) {
        return '<span class="booked-item">' + b.time +
          (b.name ? ' ' + b.name : '') +
          ' <span class="tiny">' + b.party_size + '名</span></span>';
      }).join('');
    } catch (e) {
      box.hidden = true;
    }
  }

  async function loadDay() {
    const date = $('date').value;
    if (!date) return;
    loadBooked(date);
    $('slots').innerHTML = '<span class="muted small">読み込み中…</span>';
    try {
      const res = await fetch('/api/availability?date=' + encodeURIComponent(date));
      state = await res.json();
      if (!res.ok) throw new Error(state.error || '取得に失敗しました');
    } catch (e) {
      $('day-info').className = 'notice ng small';
      $('day-info').textContent = '空き状況を取得できませんでした。時間をおいて再度お試しください。';
      $('slots').innerHTML = '';
      return;
    }
    picked = null;
    $('picked-label').textContent = '開始時間を選んでください';
    render();
    pendingPick = null;   // 自動選択は最初の 1 回だけ
  }

  function render() {
    const info = $('day-info');
    const biz = state.business || {};
    if (biz.status === 'cancelled' || biz.status === 'closed') {
      info.className = 'notice ng small';
      info.textContent = (biz.status === 'closed' ? 'この日は休業日です。' : 'この日は走行中止となっています。')
        + (biz.message || '');
    } else {
      const blocks = (state.blocks || []).filter((b) => b.is_public).map((b) => b.public_label);
      info.className = blocks.length ? 'notice warn small' : 'notice info small';
      info.textContent = blocks.length
        ? '当日の予定: ' + blocks.join(' / ')
        : 'この日は通常営業の予定です。';
    }

    const wrap = $('slots');
    wrap.innerHTML = '';
    (state.rp.slots || []).forEach((s) => {
      const b = document.createElement('button');
      b.type = 'button';
      // 満枠 (✕) と、当日の受付時間外など枠以外の理由 (—) を区別する
      const closed = !s.accepting && s.reason !== 'rp_start_full';
      b.className = 'slot ' + (s.accepting ? (s.groups >= s.max_groups - 1 ? 'limited' : 'free') : 'full');
      b.disabled = !s.accepting;
      b.title = s.message || '';
      b.innerHTML = s.time + '<span class="tiny">' +
        (s.accepting ? (s.status === 'checking' ? '要相談' : (s.groups >= s.max_groups - 1 ? '△' : '○')) : (closed ? '—' : '✕')) +
        '</span>';
      b.addEventListener('click', () => {
        picked = s.time;
        wrap.querySelectorAll('.slot').forEach((x) => x.classList.remove('picked'));
        b.classList.add('picked');
        $('picked-label').textContent = s.time + ' で予約する';
        $('slot-hint').textContent = s.message ? ' ／ ' + s.message : '';
      });
      wrap.appendChild(b);
      // 「今日走れる？」から時間指定で来た場合は、その枠を選択済みにする
      if (pendingPick === s.time && s.accepting) {
        b.click();
        b.scrollIntoView({ block: 'center', behavior: 'smooth' });
      }
    });
    $('party').min = String(state.rp.min_party || 3);
  }

  function renderPrice() {
    const n = Number($('party').value || 0);
    $('price').textContent = n >= 1
      ? '¥' + (n * PRICE_PER_PERSON).toLocaleString('ja-JP') + ' （' + n + '名 × ¥' +
        PRICE_PER_PERSON.toLocaleString('ja-JP') + '）'
      : '—';
  }
  $('party').addEventListener('input', renderPrice);
  renderPrice();

  $('date').addEventListener('change', loadDay);
  loadDay();
  window.aoneTrack && window.aoneTrack('reserve_start', { kind: 'rp' });

  // 入力し直したらエラー表示を消す (直したのにエラーが残って見えるのを防ぐ)
  $('form').addEventListener('input', () => { $('error').hidden = true; });

  $('form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const err = $('error');
    err.hidden = true;
    if (!picked) { err.hidden = false; err.textContent = '開始時間を選択してください'; return; }
    if (!$('agree').checked) { err.hidden = false; err.textContent = 'キャンセル規定へのご同意が必要です'; return; }

    const btn = $('submit');
    btn.disabled = true;
    btn.textContent = '送信中…';

    try {
      const res = await fetch('/api/reserve/create', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          kind: 'rp',
          date: $('date').value,
          start_time: picked,
          party_size: Number($('party').value || 3),
          preferred_contact: $('contact-method').value,
          name: $('name').value,
          kana: $('kana').value,
          phone: $('phone').value,
          email: $('email').value,
          request_note: $('note').value,
          terms_agreed: true,
        }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || '予約できませんでした');
      window.aoneTrack && window.aoneTrack('booking_complete', { kind: 'rp' });
      // 枠で貼られているときは、枠の中ではなくホームページごと完了ページへ移動する
      window.aoneGo('/reserve/complete/' + data.id + '?t=' + data.access_token);
    } catch (e2) {
      err.hidden = false;
      err.textContent = e2.message;
      btn.disabled = false;
      btn.textContent = 'この内容で予約する';
      loadDay();
    }
  });
</script>

<style>
  /* スロットや 2 列レイアウトのスタイルは Base.astro のグローバル側にある。
     JS で生成する要素にはスコープ CSS が当たらないため。 */
  .picked-label{font-weight:800;color:var(--red-deep)}
  .price-box{margin-top:.4rem;padding:.5rem .7rem;background:var(--bg-3);border-radius:8px;
    font-size:.9rem;font-weight:700}
  .price-box b{color:var(--red-deep);font-size:1.05rem}
  /* すでに入っている予約 (旧スケジュールページの「RP ○○様」に相当) */
  .booked{margin-top:.5rem;padding:.5rem .7rem;background:var(--bg-2);border:1px dashed var(--line-2);
    border-radius:8px;font-size:.85rem}
  .booked b{display:block;font-size:.78rem;color:var(--ink-3);margin-bottom:.2rem}
  .booked-item{display:inline-block;background:#fff;border:1px solid var(--line);border-radius:6px;
    padding:.1rem .5rem;margin:.15rem .3rem .15rem 0;font-weight:700}
  .booked-item .tiny{font-weight:400;color:var(--ink-3)}
</style>
