---
import Base from '@layouts/Base.astro';
import { todayJst, addDays } from '@lib/domain';

export const prerender = false;

// 貸切の申込フォーム (仕様 5)。
// 他予約が無ければそのまま確定、あっても申込は受け付けて「連絡待ち」にする。
const today = todayJst();
const maxDate = addDays(today, 365);
---
<Base title="貸切のお申し込み | A-ONE サーキット">
  <h1>貸切のお申し込み</h1>
  <p class="small muted">
    コースを貸切でご利用いただけます。他のご予約が入っている時間帯の場合も
    お申し込み自体は承り、A-ONE より折り返しご連絡いたします。
  </p>

  <form id="form" class="card" novalidate>
    <div class="field">
      <label for="date">ご希望日</label>
      <input type="date" id="date" name="date" min={today} max={maxDate} value={today} required />
    </div>

    <div id="day-info" class="notice info small" style="margin-bottom:1rem">空き状況を確認しています…</div>

    <div class="two">
      <div class="field">
        <label for="start">開始時間</label>
        <input type="time" id="start" value="09:00" step="1800" required />
      </div>
      <div class="field">
        <label for="end">終了時間</label>
        <input type="time" id="end" value="12:00" step="1800" required />
      </div>
    </div>

    <div class="two">
      <div class="field">
        <label for="party">ご参加人数 (概算)</label>
        <input type="number" id="party" min="1" max="200" value="10" required />
      </div>
      <div class="field">
        <label for="contact-method">ご希望の連絡方法</label>
        <select id="contact-method">
          <option value="email">メール</option>
          <option value="phone">電話</option>
        </select>
        <div class="hint">確認のご連絡はこちらの方法で差し上げます。</div>
      </div>
    </div>

    <fieldset>
      <legend>ご連絡先</legend>
      <div class="two">
        <div class="field">
          <label for="name">お名前 / 団体名</label>
          <input type="text" id="name" autocomplete="organization" required />
        </div>
        <div class="field">
          <label for="kana">フリガナ</label>
          <input type="text" id="kana" />
        </div>
      </div>
      <div class="two">
        <div class="field">
          <label for="phone">お電話番号</label>
          <input type="tel" id="phone" autocomplete="tel" required />
        </div>
        <div class="field">
          <label for="email">メールアドレス</label>
          <input type="email" id="email" autocomplete="email" required />
        </div>
      </div>
      <div class="field">
        <label for="note">ご利用内容・ご要望</label>
        <textarea id="note" placeholder="社内イベントで使いたい／カートは何台必要 など"></textarea>
      </div>
    </fieldset>

    <div class="notice warn small" style="margin-bottom:1rem">
      <strong>キャンセル規定</strong><br />
      ご利用開始 24 時間前以降のキャンセルは、料金 100% を申し受けます。
    </div>

    <div class="field">
      <label class="agree"><input type="checkbox" id="agree" required /> キャンセル規定に同意します</label>
    </div>

    <div id="error" class="notice ng" hidden></div>

    <button type="submit" class="btn primary" id="submit">この内容で申し込む</button>
  </form>
</Base>

<script is:inline>
  const $ = (id) => document.getElementById(id);

  async function loadDay() {
    const date = $('date').value;
    if (!date) return;
    const info = $('day-info');
    try {
      const res = await fetch('/api/availability?date=' + encodeURIComponent(date));
      const state = await res.json();
      if (!res.ok) throw new Error(state.error || '');
      const others = state.counts.sport + state.counts.rp + state.counts.charter;
      const blocks = (state.blocks || []).filter((b) => b.is_public).map((b) => b.public_label);
      if (!state.charter.accepting || blocks.length) {
        info.className = 'notice warn small';
        info.textContent = 'この日は ' + (blocks.join(' / ') || '受付停止の予定') +
          ' があります。お申し込みは承りますが、A-ONE より折り返しご連絡いたします。';
      } else if (others > 0) {
        info.className = 'notice warn small';
        info.textContent = 'この日は既に ' + others +
          ' 件のご予約があります。お申し込みは承りますが、A-ONE より折り返しご連絡いたします。';
      } else {
        info.className = 'notice ok small';
        info.textContent = 'この日は他のご予約がありません。そのまま貸切をお受けできる見込みです。';
      }
    } catch (e) {
      info.className = 'notice small';
      info.textContent = '空き状況を確認できませんでした。お申し込みは承ります。';
    }
  }

  $('date').addEventListener('change', loadDay);
  loadDay();
  window.aoneTrack && window.aoneTrack('reserve_start', { kind: 'charter' });

  $('form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const err = $('error');
    err.hidden = true;
    if ($('end').value <= $('start').value) {
      err.hidden = false; err.textContent = '終了時間は開始時間より後にしてください'; return;
    }
    if (!$('agree').checked) {
      err.hidden = false; err.textContent = 'キャンセル規定へのご同意が必要です'; return;
    }

    const btn = $('submit');
    btn.disabled = true;
    btn.textContent = '送信中…';
    try {
      const res = await fetch('/api/reserve/create', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          kind: 'charter',
          date: $('date').value,
          start_time: $('start').value,
          end_time: $('end').value,
          party_size: Number($('party').value || 1),
          preferred_contact: $('contact-method').value,
          name: $('name').value,
          kana: $('kana').value,
          phone: $('phone').value,
          email: $('email').value,
          request_note: $('note').value,
          terms_agreed: true,
        }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || '申し込みできませんでした');
      window.aoneTrack && window.aoneTrack('booking_complete', { kind: 'charter' });
      location.href = '/reserve/complete/' + data.id + '?t=' + data.access_token;
    } catch (e2) {
      err.hidden = false;
      err.textContent = e2.message;
      btn.disabled = false;
      btn.textContent = 'この内容で申し込む';
    }
  });
</script>

<style>
  .two{display:grid;grid-template-columns:1fr 1fr;gap:.8rem}
  .agree{display:inline-flex;align-items:center;gap:.45rem;font-weight:700}
  @media (max-width:560px){ .two{grid-template-columns:1fr} }
</style>
