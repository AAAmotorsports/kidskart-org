---
import Base from '@layouts/Base.astro';
---
<Base title="福岡キッズカートアカデミー WEB予約">
  <main>
    <header class="hd">
      <div class="hd-brand">🏁 福岡キッズカートアカデミー</div>
      <h1>WEB予約</h1>
      <p class="sub">エーワンサーキット</p>
    </header>

    <section class="cards">
      <a class="card card-primary" href="/reserve/">
        <div class="c-ico">📅</div>
        <div class="c-body">
          <h2>予約する</h2>
          <p>体験教室・リピート練習・チャレンジクラスの予約はこちら</p>
        </div>
        <div class="c-arrow">→</div>
      </a>

      <a class="card card-ghost" href="https://kidskart.org/">
        <div class="c-ico">🌐</div>
        <div class="c-body">
          <h2>公式サイト</h2>
          <p>kidskart.org — スクール案内・アクセス・お問い合わせ</p>
        </div>
        <div class="c-arrow">↗</div>
      </a>
    </section>

    <footer class="ft">
      <p class="ft-contact">📞 <a href="tel:0929271177">092-927-1177</a> · 🌐 <a href="https://kidskart.org/">kidskart.org</a></p>
      <p class="ft-staff"><a href="/admin">スタッフログイン</a></p>
    </footer>
  </main>
</Base>

<style>
  main {
    max-width: 560px; margin: 0 auto;
    padding: 3rem 1.25rem 3rem;
  }
  .hd {
    text-align: center;
    padding-bottom: 1.5rem;
    margin-bottom: 1.8rem;
    border-bottom: 1px solid var(--line);
  }
  .hd-brand {
    font-size: .95rem; font-weight: 800;
    color: var(--sky-deep); margin-bottom: .4rem;
  }
  h1 {
    margin: 0 0 .3rem; font-size: 1.5rem; font-weight: 800;
    color: var(--ink);
  }
  .sub {
    margin: 0; color: var(--ink-3);
    font-size: .78rem; font-family: var(--mono);
  }

  .cards {
    display: flex; flex-direction: column; gap: .7rem;
    margin-bottom: 2.5rem;
  }
  .card {
    display: flex; align-items: center; gap: 1rem;
    padding: 1.1rem 1.2rem;
    border-radius: 14px;
    text-decoration: none;
    transition: transform .1s, box-shadow .15s;
    border: 1.5px solid transparent;
  }
  .card:hover { transform: translateY(-1px); }
  .card:active { transform: translateY(1px); }
  .c-ico { font-size: 1.8rem; flex-shrink: 0; }
  .c-body { flex: 1; }
  .c-body h2 {
    margin: 0 0 .2rem; font-size: 1rem; font-weight: 800;
  }
  .c-body p {
    margin: 0; font-size: .78rem; opacity: .9;
    line-height: 1.5;
  }
  .c-arrow {
    font-size: 1.2rem; opacity: .7; flex-shrink: 0;
  }

  .card-primary {
    background: linear-gradient(135deg, var(--orange), var(--orange-deep));
    color: #fff;
    box-shadow: 0 4px 14px rgba(229,99,26,.28);
    padding: 1.4rem 1.3rem;
  }
  .card-primary .c-ico { font-size: 2rem; }
  .card-primary .c-body h2 { font-size: 1.1rem; }
  .card-primary:hover { box-shadow: 0 6px 18px rgba(229,99,26,.4); }

  .card-ghost {
    background: var(--bg);
    border-color: var(--sky-light);
    color: var(--ink);
  }
  .card-ghost:hover {
    background: var(--sky-mist);
    border-color: var(--sky);
  }
  .card-ghost .c-body p { color: var(--ink-2); }
  .card-ghost .c-arrow { color: var(--sky-deep); }

  .ft {
    text-align: center; padding-top: 1.2rem;
    border-top: 1px dashed var(--line);
  }
  .ft-contact {
    margin: 0 0 1.2rem;
    font-size: .78rem; color: var(--ink-3);
  }
  .ft-contact a {
    color: var(--sky-deep); text-decoration: none; margin: 0 .3rem;
  }
  .ft-contact a:hover { text-decoration: underline; }
  .ft-staff {
    margin: 0; font-size: .68rem;
    font-family: var(--mono); color: var(--ink-4);
  }
  .ft-staff a {
    color: var(--ink-4); text-decoration: none;
    border-bottom: 1px dotted var(--ink-4);
  }
  .ft-staff a:hover {
    color: var(--ink-3); border-bottom-color: var(--ink-3);
  }
</style>