---
import Base from '@layouts/Base.astro';
import { envFrom, getSupabase } from '@lib/supabase';

const env = envFrom(Astro.locals);
const supabase = getSupabase(env);

function stringifyError(e: unknown): string {
  if (!e) return 'unknown error';
  if (typeof e === 'string') return e;
  if (e instanceof Error) return e.message;
  if (typeof e === 'object') {
    const obj = e as Record<string, unknown>;
    const parts: string[] = [];
    if ('code' in obj && obj.code) parts.push(`code=${String(obj.code)}`);
    if ('message' in obj && obj.message) parts.push(String(obj.message));
    if ('details' in obj && obj.details) parts.push(`details=${String(obj.details)}`);
    if ('hint' in obj && obj.hint) parts.push(`hint=${String(obj.hint)}`);
    if (parts.length) return parts.join(' · ');
    try { return JSON.stringify(e); } catch { return String(e); }
  }
  return String(e);
}

function mask(s: string, keep = 8): string {
  if (!s) return '(unset)';
  if (s.length <= keep + 4) return `${s.slice(0, keep)}…`;
  return `${s.slice(0, keep)}…${s.slice(-4)} (len=${s.length})`;
}

const debug = {
  url: env.PUBLIC_SUPABASE_URL || '(unset)',
  anonKey: mask(env.PUBLIC_SUPABASE_ANON_KEY),
  serviceKey: mask(env.SUPABASE_SERVICE_ROLE_KEY),
};

let coursesCount: number | null = null;
let dbError: string | null = null;
try {
  const { count, error } = await supabase
    .from('courses')
    .select('*', { count: 'exact', head: true })
    .eq('is_active', true);
  if (error) throw error;
  coursesCount = count ?? 0;
} catch (e) {
  dbError = stringifyError(e);
}
---
<Base title="ASMS β — 福岡キッズカートアカデミー">
  <main>
    <div class="hero">
      <span class="badge">ASMS · β</span>
      <h1>予約・安全管理システム</h1>
      <p class="sub">福岡キッズカートアカデミーの新予約システム（開発中）</p>

      <div class="status">
        {coursesCount !== null ? (
          <>
            <div class="ok">✓ Supabase 接続 OK</div>
            <div class="meta">アクティブなコース: <strong>{coursesCount}</strong></div>
          </>
        ) : (
          <>
            <div class="err">✗ Supabase 接続エラー</div>
            <div class="meta">{dbError ?? '環境変数が未設定です。'}</div>
          </>
        )}
      </div>

      <details class="debug">
        <summary>接続情報 (debug)</summary>
        <div class="dbg-row"><span>URL</span><code>{debug.url}</code></div>
        <div class="dbg-row"><span>anon</span><code>{debug.anonKey}</code></div>
        <div class="dbg-row"><span>service</span><code>{debug.serviceKey}</code></div>
      </details>

      <div class="links">
        <a href="/reserve/" class="btn btn-primary">予約フローを試す →</a>
        <a href="https://github.com/AAAmotorsports/kidskart-org/tree/main/asms" class="btn btn-ghost">GitHub</a>
      </div>

      <div class="footer">
        Build: {new Date().toISOString().slice(0, 10)} ·
        <a href="https://kidskart.org/">← kidskart.org</a>
      </div>
    </div>
  </main>
</Base>

<style>
  main {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem 1.25rem;
    background: linear-gradient(135deg, var(--sky-mist) 0%, var(--bg) 60%);
  }
  .hero {
    max-width: 480px;
    width: 100%;
    background: var(--bg);
    border-radius: 24px;
    padding: 2.5rem 2rem;
    box-shadow: 0 12px 40px rgba(58, 169, 232, 0.18);
    text-align: center;
  }
  .badge {
    display: inline-block;
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.15em;
    color: var(--sky-deep);
    background: var(--sky-mist);
    padding: 0.3rem 0.8rem;
    border-radius: 100px;
    margin-bottom: 1.2rem;
    font-weight: 700;
  }
  h1 {
    font-size: 1.6rem;
    letter-spacing: -0.01em;
    margin: 0 0 0.5rem;
    text-wrap: balance;
  }
  .sub {
    color: var(--ink-2);
    font-size: 0.9rem;
    margin: 0 0 1.6rem;
  }
  .status {
    background: var(--bg-2);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 0.9rem 1rem;
    margin-bottom: 0.8rem;
    font-size: 0.82rem;
    text-align: left;
  }
  .status .ok { color: var(--lime-deep); font-weight: 800; }
  .status .err { color: var(--rose-deep); font-weight: 800; }
  .status .meta {
    color: var(--ink-2); font-size: 0.74rem; margin-top: 0.3rem;
    font-family: var(--mono); word-break: break-all;
  }
  .debug {
    background: var(--bg-2);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 0.6rem 0.9rem;
    margin-bottom: 1.4rem;
    font-size: 0.72rem;
    text-align: left;
  }
  .debug summary {
    cursor: pointer;
    font-weight: 700;
    color: var(--ink-3);
    font-family: var(--mono);
    font-size: 0.68rem;
  }
  .dbg-row {
    display: grid;
    grid-template-columns: 60px 1fr;
    gap: 0.5rem;
    padding: 0.3rem 0;
    border-top: 1px dashed var(--line);
    margin-top: 0.3rem;
  }
  .dbg-row span {
    color: var(--ink-3);
    font-family: var(--mono);
    font-size: 0.66rem;
  }
  .dbg-row code {
    color: var(--ink);
    font-family: var(--mono);
    font-size: 0.66rem;
    word-break: break-all;
  }
  .links {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 1.6rem;
  }
  .btn {
    display: block;
    text-decoration: none;
    padding: 0.85rem 1.4rem;
    border-radius: 12px;
    font-weight: 800;
    font-size: 0.9rem;
    transition: transform 0.15s;
  }
  .btn:active { transform: translateY(1px); }
  .btn-primary {
    background: linear-gradient(135deg, var(--orange), var(--orange-deep));
    color: #fff;
    box-shadow: 0 4px 12px rgba(229, 99, 26, 0.3);
  }
  .btn-ghost {
    background: var(--bg-2);
    color: var(--ink-2);
    border: 1.5px solid var(--line);
  }
  .footer {
    font-size: 0.68rem;
    color: var(--ink-3);
    font-family: var(--mono);
  }
  .footer a { color: var(--sky-deep); text-decoration: none; }
</style>
