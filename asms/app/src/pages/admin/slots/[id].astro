---
import Base from '@layouts/Base.astro';
import { envFrom, getSupabaseAdmin } from '@lib/supabase';
import {
  ATTENDANCE_STATUSES,
  SKILL_LEVELS,
  SYSTEM_ADMIN_UUID,
  ageOn,
  attendanceClass,
  attendanceLabel,
  jaDateLabel,
  skillLabel,
} from '@lib/admin';

const env = envFrom(Astro.locals);
const supabase = getSupabaseAdmin(env);

const { id } = Astro.params;
if (!id) return new Response('missing id', { status: 400 });

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const op = form.get('op') as string;

  const back = (msg = '', err = '') => {
    const q = new URLSearchParams();
    if (msg) q.set('msg', msg);
    if (err) q.set('err', err);
    return Astro.redirect(`/admin/slots/${id}${q.toString() ? '?' + q.toString() : ''}`);
  };
  const fmt = (e: any) =>
    `${e?.code ?? ''} ${e?.message ?? ''} ${e?.details ?? ''}`.trim();

  if (op === 'set_attendance') {
    const partId = form.get('participant_id') as string;
    const status = form.get('status') as string;
    if (!partId || !status) return back('', 'participant_id と status は必須です');
    const { error } = await supabase
      .from('reservation_participants')
      .update({ attendance_status: status })
      .eq('id', partId);
    return error ? back('', fmt(error)) : back(`出欠を「${attendanceLabel(status)}」に更新しました`);
  }

  if (op === 'set_slot_status') {
    const newStatus = form.get('slot_status') as string;
    const cascade = form.get('cascade') === '1';
    if (!['open', 'closed', 'cancelled'].includes(newStatus)) {
      return back('', '無効な状態です');
    }
    const { error: sErr } = await supabase
      .from('slots')
      .update({ status: newStatus })
      .eq('id', id);
    if (sErr) return back('', fmt(sErr));

    let cascadeMsg = '';
    if (cascade && newStatus === 'cancelled') {
      // Cascade the cancellation to all reservations on this slot that
      // aren't already terminal. Snapshot the affected reservations
      // first so we can email each guardian after the UPDATE succeeds.
      const cancelReason = ((form.get('cancel_reason') as string) || '運営側キャンセル（雨天・車両不備・スタッフ都合等）').trim();
      const { data: targetRes, error: fetchErr } = await supabase
        .from('reservations')
        .select(`
          id, reservation_number, price_tier, total_amount,
          guardians(name, email, phone),
          reservation_participants(name_snapshot),
          slots(date, start_time, end_time, courses(name))
        `)
        .eq('slot_id', id)
        .not('status', 'in', '(cancelled,attended,no_show)');
      if (fetchErr) return back('', `対象予約の取得に失敗: ${fmt(fetchErr)}`);

      const nowIso = new Date().toISOString();
      const { error: rErr } = await supabase
        .from('reservations')
        .update({ status: 'cancelled', cancelled_at: nowIso, cancelled_reason: cancelReason })
        .eq('slot_id', id)
        .not('status', 'in', '(cancelled,attended,no_show)');
      if (rErr) return back(`枠を「${newStatus}」に変更しましたが、予約側の更新でエラー: ${fmt(rErr)}`, '');

      // Fire-and-forget cancellation emails per reservation.
      const apiUrl = new URL(Astro.request.url);
      const origin = `${apiUrl.protocol}//${apiUrl.host}`;
      const runtimeCtx = (Astro.locals as any).runtime?.ctx;
      let mailQueued = 0;
      for (const r of (targetRes ?? []) as any[]) {
        const slot = r.slots ?? {};
        const guardian = r.guardians ?? {};
        const parts = (r.reservation_participants ?? []).map((p: any) => p.name_snapshot);
        if (!guardian.email) continue;
        const p = sendSlotCancelEmail(env, {
          to: guardian.email,
          guardianName: guardian.name ?? '',
          reservationNumber: r.reservation_number,
          dateIso: slot.date,
          startTime: slot.start_time,
          endTime: slot.end_time,
          courseName: slot.courses?.name ?? '',
          participants: parts,
          totalAmount: r.total_amount ?? 0,
          priceTier: r.price_tier ?? 'regular',
          reason: cancelReason,
          origin,
          phone: guardian.phone ?? '',
        }).catch((e) => console.warn('[slot-cancel] email failed', r.reservation_number, e));
        if (runtimeCtx?.waitUntil) runtimeCtx.waitUntil(p);
        mailQueued++;
      }
      cascadeMsg = `（既存予約 ${(targetRes ?? []).length} 件も cancelled に更新、${mailQueued} 件へ通知メール送信）`;
    }
    const label = { open: '受付中', closed: '募集停止', cancelled: 'キャンセル' }[newStatus];
    return back(`枠を「${label}」に変更しました ${cascadeMsg}`);
  }

  if (op === 'cancel_reservation') {
    const reservationId = form.get('reservation_id') as string;
    const reason = ((form.get('cancel_reason') as string) || '電話でのキャンセル受付').trim();
    const notify = form.get('notify_email') === '1';
    if (!reservationId) return back('', 'reservation_id は必須です');

    // Snapshot for email before mutating
    const { data: r, error: fErr } = await supabase
      .from('reservations')
      .select(`
        id, reservation_number, status, price_tier, total_amount,
        guardians(name, email, phone),
        reservation_participants(id, name_snapshot),
        slots(date, start_time, end_time, courses(name))
      `)
      .eq('id', reservationId)
      .maybeSingle();
    if (fErr) return back('', `予約取得に失敗: ${fmt(fErr)}`);
    if (!r) return back('', '予約が見つかりません');
    if (r.status === 'cancelled') return back('', 'この予約はすでにキャンセル済みです');

    const nowIso = new Date().toISOString();
    const { error: uErr } = await supabase
      .from('reservations')
      .update({ status: 'cancelled', cancelled_at: nowIso, cancelled_reason: reason })
      .eq('id', reservationId);
    if (uErr) return back('', `予約更新に失敗: ${fmt(uErr)}`);

    // Cascade participant attendance → cancelled (only those still expected)
    const { error: pErr } = await supabase
      .from('reservation_participants')
      .update({ attendance_status: 'cancelled' })
      .eq('reservation_id', reservationId)
      .eq('attendance_status', 'expected');
    if (pErr) return back(`予約をキャンセルしましたが、参加者ステータス更新でエラー: ${fmt(pErr)}`, '');

    let mailMsg = '（メール送信なし）';
    const guardian = (r as any).guardians ?? {};
    if (notify && guardian.email) {
      const slot = (r as any).slots ?? {};
      const parts = ((r as any).reservation_participants ?? []).map((p: any) => p.name_snapshot);
      const apiUrl = new URL(Astro.request.url);
      const origin = `${apiUrl.protocol}//${apiUrl.host}`;
      const runtimeCtx = (Astro.locals as any).runtime?.ctx;
      const p = sendReservationCancelEmail(env, {
        to: guardian.email,
        guardianName: guardian.name ?? '',
        reservationNumber: (r as any).reservation_number,
        dateIso: slot.date,
        startTime: slot.start_time,
        endTime: slot.end_time,
        courseName: slot.courses?.name ?? '',
        participants: parts,
        totalAmount: (r as any).total_amount ?? 0,
        priceTier: (r as any).price_tier ?? 'regular',
        reason,
        origin,
      }).catch((e) => console.warn('[admin-cancel] email failed', (r as any).reservation_number, e));
      if (runtimeCtx?.waitUntil) runtimeCtx.waitUntil(p);
      mailMsg = `（保護者 ${guardian.email} へ通知メール送信）`;
    } else if (notify && !guardian.email) {
      mailMsg = '（保護者メールが未登録のため送信スキップ）';
    }
    return back(`予約 ${(r as any).reservation_number} をキャンセルしました ${mailMsg}`);
  }

  if (op === 'set_level') {
    const partId = form.get('participant_id') as string;
    const customerId = form.get('customer_id') as string;
    const fromLevel = ((form.get('from_level') as string) || '') || null;
    const toLevel = form.get('to_level') as string;
    const reason = ((form.get('reason') as string) || '').trim() || null;
    if (!partId || !customerId || !toLevel) return back('', '必要な項目が不足しています');

    const { error: pErr } = await supabase.from('customer_progressions').insert({
      customer_id: customerId,
      reservation_participant_id: partId,
      from_level: fromLevel,
      to_level: toLevel,
      reason,
      changed_by: SYSTEM_ADMIN_UUID,
    });
    if (pErr) return back('', fmt(pErr));

    const { error: cErr } = await supabase
      .from('customers')
      .update({ current_skill_level: toLevel })
      .eq('id', customerId);
    if (cErr) return back('', fmt(cErr));

    return back(`習熟度を「${skillLabel(toLevel)}」に更新しました`);
  }

  return back('', `未対応の操作: ${op}`);
}

const url = new URL(Astro.request.url);
const msg = url.searchParams.get('msg');
const err = url.searchParams.get('err');

// Load slot
const { data: slot } = await supabase
  .from('slots')
  .select('id, date, start_time, end_time, capacity, status, note, courses(id, name, code, vehicle)')
  .eq('id', id)
  .maybeSingle();

if (!slot) {
  return new Response(null, { status: 302, headers: { Location: '/admin/reservations' } });
}

// All reservations on this slot (not cancelled)
const { data: reservations } = await supabase
  .from('reservations')
  .select(`
    id, reservation_number, status, price_tier, total_amount,
    guardians(name, kana, phone, email),
    reservation_participants(id, customer_id, name_snapshot, kana_snapshot,
                             birth_date_snapshot, age_at_booking, height_cm,
                             gender_snapshot, photo_consent, attendance_status,
                             kart_experience_note,
                             customers(id, current_skill_level, next_recommendation,
                                       staff_notes, total_participations))
  `)
  .eq('slot_id', id)
  .neq('status', 'cancelled')
  .order('created_at');

const course: any = slot.courses ?? {};
const dateLabel = jaDateLabel(slot.date);
const timeLabel = `${slot.start_time.slice(0, 5)}${slot.end_time ? '–' + slot.end_time.slice(0, 5) : ''}`;

const allParts: any[] = [];
for (const r of (reservations ?? []) as any[]) {
  for (const p of r.reservation_participants ?? []) {
    allParts.push({ ...p, reservation: r });
  }
}

const summary = {
  total: allParts.length,
  expected: allParts.filter((p) => p.attendance_status === 'expected').length,
  attended: allParts.filter((p) => p.attendance_status === 'attended').length,
  no_show: allParts.filter((p) => p.attendance_status === 'no_show').length,
  cancelled: allParts.filter((p) => p.attendance_status === 'cancelled').length,
};

const genderJa = (g: string) => ({ male: '男', female: '女', other: 'その他' } as any)[g] ?? g;
const photoJa = (p: string) => ({ allow: 'OK', face_blur_only: '顔ぼかしのみ', deny: '不可' } as any)[p] ?? p;

// Fire-and-forget: notify the guardian that their reservation was
// cancelled by staff (slot-wide cancellation). Kept inline to avoid a
// cross-file dependency for one email template.
async function sendSlotCancelEmail(env: Env, args: {
  to: string;
  guardianName: string;
  reservationNumber: string;
  dateIso: string;
  startTime: string;
  endTime: string | null;
  courseName: string;
  participants: string[];
  totalAmount: number;
  priceTier: string;
  reason: string;
  origin: string;
  phone: string;
}) {
  const apiKey = env.RESEND_API_KEY;
  if (!apiKey || !args.to) return;
  const from = env.MAIL_FROM_ADDRESS || 'noreply@kidskart.org';
  const fromName = env.MAIL_FROM_NAME || '福岡キッズカートアカデミー';

  const weekdayJa = ['日', '月', '火', '水', '木', '金', '土'];
  const d = new Date(args.dateIso + 'T00:00:00');
  const dateLabel = `${d.getFullYear()}年${d.getMonth() + 1}月${d.getDate()}日 (${weekdayJa[d.getDay()]})`;
  const timeLabel = `${args.startTime.slice(0, 5)}${args.endTime ? '–' + args.endTime.slice(0, 5) : ''}`;
  const subject = `【重要・お詫び】${dateLabel} ${args.startTime.slice(0, 5)} ${args.courseName} 開催中止のお知らせ`;

  const esc = (s: string) => String(s ?? '').replace(/[&<>"']/g, (c) => (
    { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' } as Record<string, string>
  )[c]);

  const text = [
    `${args.guardianName} 様`,
    '',
    'ご予約いただいた開催枠を、運営側都合により中止させていただきます。',
    'ご迷惑をおかけし、誠に申し訳ございません。',
    '',
    `▼ 中止となった予約`,
    `予約番号: ${args.reservationNumber}`,
    `コース  : ${args.courseName}`,
    `日時   : ${dateLabel} ${timeLabel}`,
    `参加者  : ${args.participants.join('・')} (${args.participants.length}名)`,
    '',
    `▼ 中止理由`,
    args.reason,
    '',
    '運営側都合による中止のため、キャンセル料は発生いたしません。',
    'また改めての開催をお待ちいただけますと幸いです。',
    'ご不明な点は 092-927-1177 までお問い合わせください。',
    '',
    '━━━━━━━━━━━━━━━━━━━━',
    '福岡キッズカートアカデミー / エーワンサーキット',
    '📞 092-927-1177',
    '🌐 https://kidskart.org/',
    '━━━━━━━━━━━━━━━━━━━━',
  ].join('\n');

  const html = `<!DOCTYPE html>
<html lang="ja"><head><meta charset="UTF-8"><title>${esc(subject)}</title></head>
<body style="font-family:'Hiragino Sans',sans-serif;color:#163048;line-height:1.7;margin:0;padding:1.5rem;background:#f4f9fc">
  <div style="max-width:520px;margin:0 auto;background:#fff;border-radius:12px;padding:1.5rem 1.3rem;border:1px solid #d8e6f0">
    <div style="text-align:center;font-size:2rem;margin-bottom:.4rem">⚠️</div>
    <h2 style="text-align:center;margin:0 0 .4rem;font-size:1.1rem;color:#c73854">開催中止のお知らせ</h2>
    <p style="text-align:center;margin:0 0 1rem;color:#3d556f;font-size:.88rem">${esc(args.guardianName)} 様</p>
    <p style="font-size:.86rem;color:#163048;margin:0 0 1rem">ご予約いただいた開催枠を、<strong>運営側都合により中止</strong>させていただきます。<br>ご迷惑をおかけし、誠に申し訳ございません。</p>
    <table style="width:100%;border-collapse:collapse;font-size:.86rem;margin-bottom:1rem">
      <tr><td style="padding:.4rem 0;color:#7d8fa0;font-size:.72rem;font-weight:700">予約番号</td><td style="padding:.4rem 0;text-align:right;font-family:monospace">${esc(args.reservationNumber)}</td></tr>
      <tr><td style="padding:.4rem 0;color:#7d8fa0;font-size:.72rem;font-weight:700;border-top:1px dashed #d8e6f0">コース</td><td style="padding:.4rem 0;text-align:right;border-top:1px dashed #d8e6f0">${esc(args.courseName)}</td></tr>
      <tr><td style="padding:.4rem 0;color:#7d8fa0;font-size:.72rem;font-weight:700;border-top:1px dashed #d8e6f0">日時</td><td style="padding:.4rem 0;text-align:right;font-family:monospace;border-top:1px dashed #d8e6f0">${esc(dateLabel)} ${esc(timeLabel)}</td></tr>
      <tr><td style="padding:.4rem 0;color:#7d8fa0;font-size:.72rem;font-weight:700;border-top:1px dashed #d8e6f0">参加者</td><td style="padding:.4rem 0;text-align:right;border-top:1px dashed #d8e6f0">${esc(args.participants.join('・'))} (${args.participants.length}名)</td></tr>
    </table>
    <p style="font-size:.82rem;color:#3d556f;background:rgba(229,85,111,.08);padding:.7rem;border-radius:8px;border:1px solid rgba(229,85,111,.3);margin:0 0 1rem"><strong>中止理由</strong><br>${esc(args.reason)}</p>
    <p style="font-size:.82rem;color:#3d556f;background:rgba(164,214,94,.12);padding:.7rem;border-radius:8px;border:1px solid #a4d65e;margin:0 0 1rem">✅ 運営側都合による中止のため、<strong>キャンセル料は発生いたしません</strong>。</p>
    <p style="text-align:center;margin:1.5rem 0 0">
      <a href="${args.origin}/reserve/" style="display:inline-block;padding:.7rem 1.4rem;background:linear-gradient(135deg,#ff8a3d,#e5631a);color:#fff;text-decoration:none;border-radius:8px;font-weight:800">別の日程を予約する</a>
    </p>
    <p style="text-align:center;font-size:.72rem;color:#7d8fa0;margin:1.5rem 0 0;border-top:1px solid #d8e6f0;padding-top:1rem">
      福岡キッズカートアカデミー / エーワンサーキット<br>
      📞 <a href="tel:0929271177" style="color:#1a7fb8;text-decoration:none">092-927-1177</a> / 🌐 <a href="https://kidskart.org/" style="color:#1a7fb8;text-decoration:none">kidskart.org</a>
    </p>
  </div>
</body></html>`;

  const r = await fetch('https://api.resend.com/emails', {
    method: 'POST',
    headers: { Authorization: `Bearer ${apiKey}`, 'Content-Type': 'application/json' },
    body: JSON.stringify({
      from: `${fromName} <${from}>`,
      to: [args.to],
      subject,
      text,
      html,
      reply_to: env.MAIL_REPLY_TO || undefined,
    }),
  });
  if (!r.ok) throw new Error(`Resend slot-cancel ${r.status}: ${(await r.text()).slice(0, 200)}`);
}

// Fire-and-forget: notify the guardian that their reservation was
// cancelled at their request (typically staff processing a phone
// cancellation). Tone is "承りました" rather than "中止のお詫び".
async function sendReservationCancelEmail(env: Env, args: {
  to: string;
  guardianName: string;
  reservationNumber: string;
  dateIso: string;
  startTime: string;
  endTime: string | null;
  courseName: string;
  participants: string[];
  totalAmount: number;
  priceTier: string;
  reason: string;
  origin: string;
}) {
  const apiKey = env.RESEND_API_KEY;
  if (!apiKey || !args.to) return;
  const from = env.MAIL_FROM_ADDRESS || 'noreply@kidskart.org';
  const fromName = env.MAIL_FROM_NAME || '福岡キッズカートアカデミー';

  const weekdayJa = ['日', '月', '火', '水', '木', '金', '土'];
  const d = new Date(args.dateIso + 'T00:00:00');
  const dateLabel = `${d.getFullYear()}年${d.getMonth() + 1}月${d.getDate()}日 (${weekdayJa[d.getDay()]})`;
  const timeLabel = `${args.startTime.slice(0, 5)}${args.endTime ? '–' + args.endTime.slice(0, 5) : ''}`;
  const subject = `【キャンセル承りました】${dateLabel} ${args.startTime.slice(0, 5)} ${args.courseName}`;

  const esc = (s: string) => String(s ?? '').replace(/[&<>"']/g, (c) => (
    { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' } as Record<string, string>
  )[c]);

  const text = [
    `${args.guardianName} 様`,
    '',
    'ご予約のキャンセルを承りました。',
    'またのご利用を心よりお待ちしております。',
    '',
    `▼ キャンセルされた予約`,
    `予約番号: ${args.reservationNumber}`,
    `コース  : ${args.courseName}`,
    `日時   : ${dateLabel} ${timeLabel}`,
    `参加者  : ${args.participants.join('・')} (${args.participants.length}名)`,
    '',
    `▼ 受付内容`,
    args.reason,
    '',
    'キャンセル料が発生する場合は別途ご連絡いたします。',
    'ご不明な点は 092-927-1177 までお問い合わせください。',
    '',
    '━━━━━━━━━━━━━━━━━━━━',
    '福岡キッズカートアカデミー / エーワンサーキット',
    '📞 092-927-1177',
    '🌐 https://kidskart.org/',
    '━━━━━━━━━━━━━━━━━━━━',
  ].join('\n');

  const html = `<!DOCTYPE html>
<html lang="ja"><head><meta charset="UTF-8"><title>${esc(subject)}</title></head>
<body style="font-family:'Hiragino Sans',sans-serif;color:#163048;line-height:1.7;margin:0;padding:1.5rem;background:#f4f9fc">
  <div style="max-width:520px;margin:0 auto;background:#fff;border-radius:12px;padding:1.5rem 1.3rem;border:1px solid #d8e6f0">
    <div style="text-align:center;font-size:2rem;margin-bottom:.4rem">✅</div>
    <h2 style="text-align:center;margin:0 0 .4rem;font-size:1.1rem;color:#1a7fb8">キャンセル承りました</h2>
    <p style="text-align:center;margin:0 0 1rem;color:#3d556f;font-size:.88rem">${esc(args.guardianName)} 様</p>
    <p style="font-size:.86rem;color:#163048;margin:0 0 1rem">ご予約のキャンセルを承りました。<br>またのご利用を心よりお待ちしております。</p>
    <table style="width:100%;border-collapse:collapse;font-size:.86rem;margin-bottom:1rem">
      <tr><td style="padding:.4rem 0;color:#7d8fa0;font-size:.72rem;font-weight:700">予約番号</td><td style="padding:.4rem 0;text-align:right;font-family:monospace">${esc(args.reservationNumber)}</td></tr>
      <tr><td style="padding:.4rem 0;color:#7d8fa0;font-size:.72rem;font-weight:700;border-top:1px dashed #d8e6f0">コース</td><td style="padding:.4rem 0;text-align:right;border-top:1px dashed #d8e6f0">${esc(args.courseName)}</td></tr>
      <tr><td style="padding:.4rem 0;color:#7d8fa0;font-size:.72rem;font-weight:700;border-top:1px dashed #d8e6f0">日時</td><td style="padding:.4rem 0;text-align:right;font-family:monospace;border-top:1px dashed #d8e6f0">${esc(dateLabel)} ${esc(timeLabel)}</td></tr>
      <tr><td style="padding:.4rem 0;color:#7d8fa0;font-size:.72rem;font-weight:700;border-top:1px dashed #d8e6f0">参加者</td><td style="padding:.4rem 0;text-align:right;border-top:1px dashed #d8e6f0">${esc(args.participants.join('・'))} (${args.participants.length}名)</td></tr>
    </table>
    <p style="font-size:.82rem;color:#3d556f;background:var(--bg-2,#f4f9fc);padding:.7rem;border-radius:8px;border:1px solid #d8e6f0;margin:0 0 1rem"><strong>受付内容</strong><br>${esc(args.reason)}</p>
    <p style="font-size:.78rem;color:#7d8fa0;margin:0 0 1rem">※ キャンセル料が発生する場合は別途ご連絡いたします。</p>
    <p style="text-align:center;margin:1.5rem 0 0">
      <a href="${args.origin}/reserve/" style="display:inline-block;padding:.7rem 1.4rem;background:linear-gradient(135deg,#ff8a3d,#e5631a);color:#fff;text-decoration:none;border-radius:8px;font-weight:800">別の日程を予約する</a>
    </p>
    <p style="text-align:center;font-size:.72rem;color:#7d8fa0;margin:1.5rem 0 0;border-top:1px solid #d8e6f0;padding-top:1rem">
      福岡キッズカートアカデミー / エーワンサーキット<br>
      📞 <a href="tel:0929271177" style="color:#1a7fb8;text-decoration:none">092-927-1177</a> / 🌐 <a href="https://kidskart.org/" style="color:#1a7fb8;text-decoration:none">kidskart.org</a>
    </p>
  </div>
</body></html>`;

  const r = await fetch('https://api.resend.com/emails', {
    method: 'POST',
    headers: { Authorization: `Bearer ${apiKey}`, 'Content-Type': 'application/json' },
    body: JSON.stringify({
      from: `${fromName} <${from}>`,
      to: [args.to],
      subject,
      text,
      html,
      reply_to: env.MAIL_REPLY_TO || undefined,
    }),
  });
  if (!r.ok) throw new Error(`Resend reservation-cancel ${r.status}: ${(await r.text()).slice(0, 200)}`);
}
---
<Base title={`${dateLabel} ${timeLabel} · ${course.name} — ASMS`}>
  <main>
    <header class="hd">
      <a class="back" href="/admin/reservations">← 予約一覧へ</a>
      <h1>スロット詳細 · 参加者管理</h1>
      <div class="slot-summary">
        <div class="ss-course">{course.name}</div>
        <div class="ss-meta">
          <span class="mono">{dateLabel}</span>
          <span class="sep">·</span>
          <span class="mono">{timeLabel}</span>
        </div>
        <div class="ss-caps">
          <span>定員 <strong>{slot.capacity}</strong> 名</span>
          <span>予約 <strong>{summary.total}</strong> 名</span>
          {summary.attended > 0 && <span class="chip chip-ok">✓ 出席 {summary.attended}</span>}
          {summary.expected > 0 && <span class="chip chip-wait">予約中 {summary.expected}</span>}
          {summary.no_show > 0 && <span class="chip chip-warn">無断欠席 {summary.no_show}</span>}
        </div>
      </div>
    </header>

    {msg && <div class="ok-banner">{msg}</div>}
    {err && <div class="err">{err}</div>}

    <section class="slot-actions">
      <div class="sa-hd">
        <span class="sa-label">現在の枠状態:</span>
        <span class={`sa-status sa-${slot.status}`}>
          {slot.status === 'open' ? '🟢 受付中'
            : slot.status === 'closed' ? '🟡 募集停止'
            : '🔴 キャンセル'}
        </span>
      </div>
      <div class="sa-btns">
        {slot.status !== 'closed' && (
          <form method="post" class="sa-form"
                onsubmit="return confirm('この枠を「募集停止」にしますか？（新規予約が入らなくなります。既存予約はそのままです）');">
            <input type="hidden" name="op" value="set_slot_status" />
            <input type="hidden" name="slot_status" value="closed" />
            <button type="submit" class="btn-close">🟡 募集を停止する</button>
          </form>
        )}
        {slot.status !== 'cancelled' && (
          <details class="cancel-details">
            <summary class="btn-cancel-summary">🔴 枠をキャンセル（既存予約も cancel + 保護者へ通知メール）</summary>
            <form method="post" class="sa-form cancel-form"
                  onsubmit="return confirm('この枠をキャンセルし、既存予約者に通知メールを送信しますか？');">
              <input type="hidden" name="op" value="set_slot_status" />
              <input type="hidden" name="slot_status" value="cancelled" />
              <input type="hidden" name="cascade" value="1" />
              <label>
                <span class="cf-label">キャンセル理由（メール本文に載ります）</span>
                <input type="text" name="cancel_reason" maxlength="120"
                  placeholder="例: 雨天による中止、車両不備、スタッフ都合 など"
                  value="運営側キャンセル（雨天・車両不備・スタッフ都合等）" />
              </label>
              <button type="submit" class="btn-cancel">🚫 この理由でキャンセル通知を送信</button>
            </form>
          </details>
        )}
        {slot.status !== 'open' && (
          <form method="post" class="sa-form"
                onsubmit="return confirm('この枠を「受付中」に戻しますか？');">
            <input type="hidden" name="op" value="set_slot_status" />
            <input type="hidden" name="slot_status" value="open" />
            <button type="submit" class="btn-reopen">🟢 受付を再開する</button>
          </form>
        )}
      </div>
      {slot.status === 'cancelled' && (
        <p class="sa-note">
          ⚠️ この枠はキャンセル状態です。既存予約者への通知メールはキャンセル操作時に送信済みです。
        </p>
      )}
    </section>

    {allParts.length === 0 ? (
      <p class="empty">この枠にはまだ予約がありません。</p>
    ) : (
      <ul class="p-list">
        {allParts.map((p) => {
          const c = p.customers ?? {};
          const r = p.reservation;
          const g = r.guardians ?? {};
          return (
            <li class="p-card">
              <div class="p-head">
                <div class="p-nm">
                  <span class="p-name">{p.name_snapshot}</span>
                  <span class="p-kana">（{p.kana_snapshot}）</span>
                  <span class="p-age">{p.age_at_booking}歳 · {genderJa(p.gender_snapshot)}</span>
                  <span class="p-height">{p.height_cm}cm</span>
                </div>
                <a class="p-detail" href={`/admin/customers/${p.customer_id}`}>カルテ →</a>
              </div>

              <div class="p-status">
                <span class={`badge badge-${attendanceClass(p.attendance_status)}`}>
                  {attendanceLabel(p.attendance_status)}
                </span>
                <span class="p-cur-level">{skillLabel(c.current_skill_level)}</span>
                <span class="p-parts">🏁 {c.total_participations ?? 0}回目</span>
              </div>

              {c.next_recommendation && (
                <div class="p-rec">💡 <strong>申し送り:</strong> {c.next_recommendation}</div>
              )}
              {c.staff_notes && (
                <div class="p-notes">📝 {c.staff_notes}</div>
              )}
              {p.kart_experience_note && (
                <div class="p-exp">🚙 経験: {p.kart_experience_note}</div>
              )}

              <div class="p-actions">
                <form method="post" class="a-form">
                  <input type="hidden" name="op" value="set_attendance" />
                  <input type="hidden" name="participant_id" value={p.id} />
                  <div class="btn-group">
                    {ATTENDANCE_STATUSES.map((s) => (
                      <button type="submit" name="status" value={s.code}
                              class={`btn-attend ${p.attendance_status === s.code ? 'active' : ''}`}>
                        {s.label}
                      </button>
                    ))}
                  </div>
                </form>

                <details class="lvl-details">
                  <summary>🎯 習熟度を更新</summary>
                  <form method="post" class="lvl-form">
                    <input type="hidden" name="op" value="set_level" />
                    <input type="hidden" name="participant_id" value={p.id} />
                    <input type="hidden" name="customer_id" value={p.customer_id} />
                    <input type="hidden" name="from_level" value={c.current_skill_level ?? ''} />
                    <div class="field">
                      <label>新しい習熟度</label>
                      <select name="to_level" required>
                        <option value="">— 選択 —</option>
                        {SKILL_LEVELS.map((s) => (
                          <option value={s.code} disabled={s.code === c.current_skill_level}>
                            {s.emoji} {s.label}
                          </option>
                        ))}
                      </select>
                    </div>
                    <div class="field">
                      <label>理由（任意）</label>
                      <input type="text" name="reason" maxlength="200" placeholder="今日の走行での判断" />
                    </div>
                    <button type="submit" class="btn btn-primary">更新</button>
                  </form>
                </details>

                {r.status !== 'cancelled' && (
                  <details class="rc-details">
                    <summary>🚫 この予約全体をキャンセル（保護者へメール通知）</summary>
                    <form method="post" class="rc-form"
                          onsubmit="return confirm('この予約をキャンセルし、保護者へ通知メールを送信しますか？');">
                      <input type="hidden" name="op" value="cancel_reservation" />
                      <input type="hidden" name="reservation_id" value={r.id} />
                      <div class="field">
                        <label>受付内容（メール本文に載ります）</label>
                        <input type="text" name="cancel_reason" maxlength="120"
                          placeholder="例: お子様の体調不良により電話でキャンセル受付"
                          value="電話でのキャンセル受付" />
                      </div>
                      <label class="chk">
                        <input type="checkbox" name="notify_email" value="1" checked />
                        <span>保護者（{g.email || 'メール未登録'}）へキャンセル確認メールを送信する</span>
                      </label>
                      <button type="submit" class="btn-rc">🚫 予約をキャンセル</button>
                    </form>
                  </details>
                )}
              </div>

              <div class="p-guardian">
                <span>👤 {g.name}（{g.kana}）</span>
                {g.phone && <a href={`tel:${g.phone.replace(/[^0-9+]/g, '')}`}>📞 {g.phone}</a>}
                <span class="p-num mono">{r.reservation_number}</span>
              </div>

              <div class="p-photo mono">写真: {photoJa(p.photo_consent)}</div>
            </li>
          );
        })}
      </ul>
    )}
  </main>
</Base>

<style>
