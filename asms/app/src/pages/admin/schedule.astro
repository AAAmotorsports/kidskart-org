---
import Base from '@layouts/Base.astro';
import { envFrom, getSupabaseAdmin } from '@lib/supabase';
import { getJapaneseHolidays, hasHolidayTable } from '@lib/jp_holidays';

const env = envFrom(Astro.locals);
const supabase = getSupabaseAdmin(env);

const now = new Date();
const defaultYear = now.getMonth() === 11 ? now.getFullYear() + 1 : now.getFullYear();
const defaultMonth = now.getMonth() === 11 ? 1 : now.getMonth() + 2;

const url = new URL(Astro.request.url);
const year = parseInt(url.searchParams.get('year') ?? String(defaultYear), 10);
const month = parseInt(url.searchParams.get('month') ?? String(defaultMonth), 10);
const mode = url.searchParams.get('mode') ?? '';

// POST — schedule_exceptions CRUD. Uses PRG pattern so refresh doesn't
// re-submit the form.
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const op = form.get('op') as string;
  const backYear = (form.get('year') as string) || String(year);
  const backMonth = (form.get('month') as string) || String(month);
  const backMode = (form.get('mode') as string) || '';

  const finalize = (msg: string, err: string) => {
    const q = new URLSearchParams({ year: backYear, month: backMonth });
    if (backMode) q.set('mode', backMode);
    if (msg) q.set('msg', msg);
    if (err) q.set('err', err);
    return Astro.redirect(`/admin/schedule?${q.toString()}`);
  };

  const fmtErr = (e: any) =>
    `${e?.code ?? ''} ${e?.message ?? ''} ${e?.details ?? ''}`.trim();

  if (op === 'add_exception') {
    const type = form.get('type') as string;
    const date = form.get('date') as string;
    const title = ((form.get('title') as string) || '').trim() || null;
    const rawStart = ((form.get('start_time') as string) || '').trim();
    const rawCourse = ((form.get('course_id') as string) || '').trim();
    const rawCapacity = ((form.get('capacity') as string) || '').trim();

    if (!type || !date) {
      return finalize('', '種別と日付は必須です');
    }
    if (type !== 'closure' && !rawCourse) {
      return finalize('', 'この種別ではコース選択が必須です');
    }
    if (type !== 'closure' && !rawStart) {
      return finalize('', 'この種別では開始時刻が必須です');
    }

    const payload: Record<string, unknown> = { type, date };
    if (title) payload.title = title;
    if (type !== 'closure') {
      payload.start_time = rawStart;
      payload.course_id = rawCourse;
      if (rawCapacity) payload.capacity = parseInt(rawCapacity, 10);
    }

    const { error } = await supabase.from('schedule_exceptions').insert(payload);
    return error
      ? finalize('', fmtErr(error))
      : finalize(`${date} を「${labelType(type)}」として追加しました`, '');
  }

  if (op === 'delete_exception') {
    const id = form.get('id') as string;
    if (!id) return finalize('', 'ID が指定されていません');
    const { error } = await supabase.from('schedule_exceptions').delete().eq('id', id);
    return error ? finalize('', fmtErr(error)) : finalize('例外設定を削除しました', '');
  }

  if (op === 'add_closure_range') {
    const fromDate = (form.get('from_date') as string) || '';
    const toDate = (form.get('to_date') as string) || '';
    const title = ((form.get('title') as string) || '').trim() || null;
    if (!fromDate || !toDate) return finalize('', '開始日と終了日は必須です');
    if (fromDate > toDate) return finalize('', '終了日は開始日以降にしてください');

    // Enumerate every day in [fromDate, toDate] and dedupe against existing closures.
    const days: string[] = [];
    const cur = new Date(fromDate + 'T00:00:00');
    const end = new Date(toDate + 'T00:00:00');
    while (cur <= end) {
      const y = cur.getFullYear();
      const m = String(cur.getMonth() + 1).padStart(2, '0');
      const d = String(cur.getDate()).padStart(2, '0');
      days.push(`${y}-${m}-${d}`);
      cur.setDate(cur.getDate() + 1);
    }
    if (days.length > 62) return finalize('', '一度に登録できるのは62日までです');

    const { data: existing } = await supabase
      .from('schedule_exceptions')
      .select('date')
      .eq('type', 'closure')
      .in('date', days);
    const seen = new Set((existing ?? []).map((r: any) => r.date));
    const rows = days
      .filter((day) => !seen.has(day))
      .map((day) => ({ type: 'closure', date: day, title }));

    if (rows.length === 0) {
      return finalize('この期間はすでに全て休業日として登録済みです', '');
    }
    const { error } = await supabase.from('schedule_exceptions').insert(rows);
    return error
      ? finalize('', fmtErr(error))
      : finalize(`${rows.length}日間を休業日として追加しました`, '');
  }

  if (op === 'suppress_slot') {
    const date = (form.get('date') as string) || '';
    const startTime = (form.get('start_time') as string) || '';
    const courseCode = (form.get('course_code') as string) || '';
    if (!date || !startTime || !courseCode) return finalize('', '抑止に必要な情報が不足しています');

    const { data: course, error: cErr } = await supabase
      .from('courses')
      .select('id')
      .eq('code', courseCode)
      .maybeSingle();
    if (cErr || !course) return finalize('', 'コースが見つかりません');

    const { error } = await supabase.from('schedule_exceptions').insert({
      type: 'suppress',
      date,
      start_time: startTime,
      course_id: course.id,
    });
    return error
      ? finalize('', fmtErr(error))
      : finalize(`${date} ${startTime.slice(0,5)} の枠を抑止しました`, '');
  }

  if (op === 'bulk_holidays') {
    const yr = parseInt(backYear, 10);
    const mo = parseInt(backMonth, 10);
    const holidays = getJapaneseHolidays(yr, mo);
    if (holidays.length === 0) {
      return finalize(`${yr}年${mo}月に該当する祝日はありません`, '');
    }

    // Skip dates already registered so we don't duplicate.
    const monthStart = `${yr}-${String(mo).padStart(2, '0')}-01`;
    const endDay = new Date(yr, mo, 0).getDate();
    const monthEnd = `${yr}-${String(mo).padStart(2, '0')}-${String(endDay).padStart(2, '0')}`;
    const { data: existing } = await supabase
      .from('schedule_exceptions')
      .select('date, type')
      .eq('type', 'closure')
      .gte('date', monthStart)
      .lte('date', monthEnd);
    const existingDates = new Set((existing ?? []).map((r: any) => r.date));

    const rows = holidays
      .filter((h) => !existingDates.has(h.date))
      .map((h) => ({ type: 'closure', date: h.date, title: h.name }));

    if (rows.length === 0) {
      return finalize('祝日はすでに全て休業日として登録されています', '');
    }

    const { error } = await supabase.from('schedule_exceptions').insert(rows);
    return error
      ? finalize('', fmtErr(error))
      : finalize(`${rows.length}件の祝日を休業日として追加しました`, '');
  }

  return finalize('', `未対応の操作: ${op}`);
}

function labelType(t: string): string {
  return (
    {
      closure: '休業日',
      challenge: 'チャレンジ日',
      event: '特別イベント',
      extra_slot: '追加枠',
      suppress: '枠抑止',
    } as Record<string, string>
  )[t] ?? t;
}

const msg = url.searchParams.get('msg');
const err = url.searchParams.get('err');

// Load courses for the "add exception" form
const { data: coursesData } = await supabase
  .from('courses')
  .select('id, code, name, default_capacity, display_order')
  .eq('is_active', true)
  .order('display_order');
const courses = coursesData ?? [];

let rows: Array<{
  action: string;
  slot_date: string;
  weekday: string;
  start_time: string | null;
  end_time: string | null;
  course_code: string | null;
  course_name: string | null;
  capacity: number | null;
  reason: string | null;
}> = [];
let fnError: string | null = null;
let applied = false;

if (mode === 'preview' || mode === 'apply') {
  const dryRun = mode === 'preview';
  const { data, error } = await supabase.rpc('generate_slots_for_month', {
    p_year: year,
    p_month: month,
    p_dry_run: dryRun,
  });
  if (error) {
    fnError = `${error.code ?? ''} ${error.message ?? ''} ${error.details ?? ''}`.trim();
  } else {
    rows = (data ?? []) as typeof rows;
    if (!dryRun) applied = true;
  }
}

// existing exceptions for the selected month
const monthStart = `${year}-${String(month).padStart(2, '0')}-01`;
const monthEndDate = new Date(year, month, 0);
const monthEnd = `${year}-${String(month).padStart(2, '0')}-${String(monthEndDate.getDate()).padStart(2, '0')}`;
const { data: exceptions } = await supabase
  .from('schedule_exceptions')
  .select('id, date, type, title, start_time, capacity, course_id, courses(name)')
  .gte('date', monthStart)
  .lte('date', monthEnd)
  .order('date')
  .order('start_time');

const holidaysAvailable = hasHolidayTable(year);
const monthlyHolidays = getJapaneseHolidays(year, month);

// summary of proposed / applied actions
const summary = rows.reduce<Record<string, number>>((acc, r) => {
  acc[r.action] = (acc[r.action] ?? 0) + 1;
  return acc;
}, {});

const actionLabel: Record<string, string> = {
  would_create: '📝 生成予定',
  created: '✅ 生成完了',
  skipped_exists: '⏭ 既存',
  skipped_closure: '🚫 休業',
  skipped_challenge_morning: '⛔ チャレンジ日午前抑止',
};
const actionColor: Record<string, string> = {
  would_create: 'proposed',
  created: 'created',
  skipped_exists: 'muted',
  skipped_closure: 'closed',
  skipped_challenge_morning: 'muted',
};

// Default date for the add form: first day of selected month
const addDefaultDate = monthStart;
---
<Base title="スケジュール管理 — ASMS">
  <main>
    <header class="hd">
      <a class="back" href="/admin">← 管理トップ</a>
      <h1>スケジュール管理</h1>
      <p class="sub">月次スロット生成・例外日管理</p>
    </header>

    <form class="month-form" method="get">
      <label>
        年
        <input type="number" name="year" min="2025" max="2030" value={year} />
      </label>
      <label>
        月
        <input type="number" name="month" min="1" max="12" value={month} />
      </label>
      <button type="submit" name="mode" value="preview" class="btn btn-primary">
        プレビュー
      </button>
    </form>

    {msg && <div class="ok-banner">{msg}</div>}
    {err && <div class="err">{err}</div>}

    {mode && (
      <div class="mode-banner">
        {mode === 'preview' && (
          <><strong>{year}年{month}月</strong>のプレビュー（DB 未変更）</>
        )}
        {mode === 'apply' && applied && (
          <><strong>{year}年{month}月</strong>のスロットを生成しました ✅</>
        )}
      </div>
    )}

    {fnError && (
      <div class="err">
        <strong>関数呼び出しエラー:</strong>
        <code>{fnError}</code>
      </div>
    )}

    {rows.length > 0 && (
      <>
        <section class="summary">
          {Object.entries(summary).map(([action, count]) => (
            <div class={`chip chip-${actionColor[action] ?? 'muted'}`}>
              {actionLabel[action] ?? action}: <strong>{count}</strong>
            </div>
          ))}
        </section>

        <section class="table-wrap">
          <table class="slot-table">
            <thead>
              <tr>
                <th>日付</th>
                <th>時間</th>
                <th>コース</th>
                <th class="num">定員</th>
                <th>状態</th>
                <th class="act-col"></th>
              </tr>
            </thead>
            <tbody>
              {rows.map((r) => (
                <tr class={`row-${actionColor[r.action] ?? 'muted'}`}>
                  <td class="mono">{r.slot_date} ({r.weekday})</td>
                  <td class="mono">
                    {r.start_time ? `${r.start_time.slice(0, 5)}` : '—'}
                    {r.end_time && `–${r.end_time.slice(0, 5)}`}
                  </td>
                  <td>{r.course_name ?? '—'}</td>
                  <td class="mono num">{r.capacity ?? '—'}</td>
                  <td class="status">
                    {actionLabel[r.action] ?? r.action}
                    {r.reason && <span class="reason"> · {r.reason}</span>}
                  </td>
                  <td class="act-col">
                    {r.action === 'would_create' && r.start_time && r.course_code && (
                      <form method="post" class="row-suppress"
                            onsubmit="return confirm('この枠を生成対象から外しますか？');">
                        <input type="hidden" name="op" value="suppress_slot" />
                        <input type="hidden" name="year" value={year} />
                        <input type="hidden" name="month" value={month} />
                        <input type="hidden" name="mode" value="preview" />
                        <input type="hidden" name="date" value={r.slot_date} />
                        <input type="hidden" name="start_time" value={r.start_time} />
                        <input type="hidden" name="course_code" value={r.course_code} />
                        <button type="submit" class="del-btn" title="この枠を抑止" aria-label="この枠を抑止">×</button>
                      </form>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </section>

        {mode === 'preview' && rows.some(r => r.action === 'would_create') && (
          <form class="apply-form" method="get">
            <input type="hidden" name="year" value={year} />
            <input type="hidden" name="month" value={month} />
            <button type="submit" name="mode" value="apply" class="btn btn-primary btn-big">
              ✅ この内容で {year}年{month}月 のスロットを生成する
            </button>
            <p class="warn">
              生成後は個別スロットの status を変更できますが、大量に消したい場合は SQL で直接扱ってください。
            </p>
          </form>
        )}
      </>
    )}

    <section class="exceptions">
      <div class="ex-hd">
        <h2>{year}年{month}月 の例外設定</h2>
        <div class="hd-actions">
          {holidaysAvailable && monthlyHolidays.length > 0 && (
            <form method="post" class="bulk-form">
              <input type="hidden" name="op" value="bulk_holidays" />
              <input type="hidden" name="year" value={year} />
              <input type="hidden" name="month" value={month} />
              <input type="hidden" name="mode" value={mode} />
              <button type="submit" class="btn-mini">
                🎌 {monthlyHolidays.length}件の祝日を休業日に一括追加
              </button>
            </form>
          )}
        </div>
      </div>

      <details class="add-range-wrap">
        <summary>📅 期間で休業日を一括追加（お盆・GW など）</summary>
        <form method="post" class="range-form">
          <input type="hidden" name="op" value="add_closure_range" />
          <input type="hidden" name="year" value={year} />
          <input type="hidden" name="month" value={month} />
          <input type="hidden" name="mode" value={mode} />
          <div class="range-row">
            <label>開始日
              <input type="date" name="from_date" value={monthStart} required />
            </label>
            <label>終了日
              <input type="date" name="to_date" value={monthStart} required />
            </label>
          </div>
          <div class="field">
            <label>タイトル（任意）</label>
            <input type="text" name="title" maxlength="80"
              placeholder="例: お盆休み、GW休業" />
          </div>
          <button type="submit" class="btn btn-primary">期間で休業日追加</button>
        </form>
      </details>

      {exceptions && exceptions.length > 0 ? (
        <ul class="ex-list">
          {exceptions.map((ex: any) => (
            <li>
              <span class="mono ex-date">{ex.date}</span>
              <span class={`ex-type ex-${ex.type}`}>{labelType(ex.type)}</span>
              {ex.start_time && <span class="mono ex-time">{ex.start_time.slice(0,5)}</span>}
              {ex.courses?.name && <span class="ex-course">{ex.courses.name}</span>}
              {ex.title && <span class="ex-title">{ex.title}</span>}
              <form method="post" class="del-form" onsubmit="return confirm('この例外設定を削除しますか？');">
                <input type="hidden" name="op" value="delete_exception" />
                <input type="hidden" name="id" value={ex.id} />
                <input type="hidden" name="year" value={year} />
                <input type="hidden" name="month" value={month} />
                <input type="hidden" name="mode" value={mode} />
                <button type="submit" class="del-btn" aria-label="削除">×</button>
              </form>
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty-ex">まだ例外設定はありません。下のフォームから追加できます。</p>
      )}

      <details class="add-ex-wrap" open={!(exceptions && exceptions.length > 0)}>
        <summary>➕ 例外設定を追加</summary>
        <form method="post" class="add-ex-form" id="addExForm">
          <input type="hidden" name="op" value="add_exception" />
          <input type="hidden" name="year" value={year} />
          <input type="hidden" name="month" value={month} />
          <input type="hidden" name="mode" value={mode} />

          <div class="field type-field">
            <label>種別 *</label>
            <div class="type-choices">
              <label class="type-choice">
                <input type="radio" name="type" value="closure" checked />
                <span>🚫 休業日</span>
                <em>その日のスロットを終日生成しない</em>
              </label>
              <label class="type-choice">
                <input type="radio" name="type" value="challenge" />
                <span>🏁 チャレンジ日</span>
                <em>午前ミニ枠を抑止しチャレンジ枠を追加</em>
              </label>
              <label class="type-choice">
                <input type="radio" name="type" value="event" />
                <span>🎉 特別イベント</span>
                <em>サマースクール等の単発イベント枠</em>
              </label>
              <label class="type-choice">
                <input type="radio" name="type" value="extra_slot" />
                <span>➕ 追加枠</span>
                <em>通常日にもう1枠だけ追加</em>
              </label>
            </div>
          </div>

          <div class="field">
            <label for="ex-date">日付 *</label>
            <input type="date" id="ex-date" name="date"
              min={`${year}-${String(month).padStart(2,'0')}-01`}
              max={monthEnd}
              value={addDefaultDate}
              required />
          </div>

          <div class="field course-field" data-conditional="hide-on-closure">
            <label for="ex-course">コース *</label>
            <select id="ex-course" name="course_id">
              <option value="">— 選択 —</option>
              {courses.map((c: any) => (
                <option value={c.id}>{c.name} ({c.code})</option>
              ))}
            </select>
          </div>

          <div class="field time-field" data-conditional="hide-on-closure">
            <label for="ex-time">開始時刻 *</label>
            <input type="time" id="ex-time" name="start_time" step="900" />
          </div>

          <div class="field capacity-field" data-conditional="hide-on-closure">
            <label for="ex-capacity">定員（空欄でコース既定値）</label>
            <input type="number" id="ex-capacity" name="capacity" min="1" max="30" />
          </div>

          <div class="field title-field">
            <label for="ex-title">タイトル・メモ</label>
            <input type="text" id="ex-title" name="title" maxlength="80"
              placeholder="例: サマースクール、GW休業 など" />
          </div>

          <button type="submit" class="btn btn-primary">追加</button>
        </form>
      </details>
    </section>

    <details class="help">
      <summary>ヘルプ</summary>
      <ul>
        <li><strong>プレビュー</strong>: DB を変更せず、生成される予定のスロットを表で確認。</li>
        <li><strong>生成</strong>: プレビュー内容を実際に <code>slots</code> に INSERT。既存重複は自動スキップ。</li>
        <li><strong>祝日一括追加</strong>: 表示中の月の日本の祝日を <code>closure</code>（休業日）として一括登録。すでに登録済みの祝日はスキップ。</li>
        <li>例外の種別:
          <ul>
            <li><strong>休業日</strong> → 終日スロット生成なし</li>
            <li><strong>チャレンジ日</strong> → 午前ミニ枠を抑止 + チャレンジ枠を追加</li>
            <li><strong>特別イベント</strong> → イベント枠を追加（サマースクール等）</li>
            <li><strong>追加枠</strong> → 通常日に追加スロット</li>
          </ul>
        </li>
        <li>例外設定を変更したら、<strong>プレビュー</strong>を再実行して反映を確認してから生成してください。</li>
      </ul>
    </details>
  </main>
</Base>

<script>
  // Progressive disclosure: hide course / time / capacity fields when
  // type = closure (休業日) since those columns are unused for that type.
  const form = document.getElementById('addExForm') as HTMLFormElement | null;
  if (form) {
    const typeInputs = form.querySelectorAll<HTMLInputElement>('input[name="type"]');
    const conditional = form.querySelectorAll<HTMLElement>('[data-conditional="hide-on-closure"]');
    const courseSelect = form.querySelector<HTMLSelectElement>('#ex-course');
    const timeInput = form.querySelector<HTMLInputElement>('#ex-time');

    const sync = () => {
      const selected = form.querySelector<HTMLInputElement>('input[name="type"]:checked')?.value;
      const isClosure = selected === 'closure';
      conditional.forEach((el) => {
        el.style.display = isClosure ? 'none' : '';
      });
      if (courseSelect) courseSelect.required = !isClosure;
      if (timeInput) timeInput.required = !isClosure;
    };

    typeInputs.forEach((r) => r.addEventListener('change', sync));
    sync();
  }
</script>

<style>
  main { max-width: 900px; margin: 0 auto; padding: 1.5rem 1.25rem 3rem; }
  .hd { padding-bottom: 1rem; border-bottom: 1px solid var(--line); margin-bottom: 1.5rem; }
  .back { display: inline-block; font-size: .78rem; color: var(--ink-3); text-decoration: none; margin-bottom: .5rem; }
  h1 { margin: 0 0 .3rem; font-size: 1.5rem; font-weight: 800; }
  .sub { margin: 0; color: var(--ink-2); font-size: .82rem; }

  .month-form {
    display: flex; gap: .8rem; align-items: end; flex-wrap: wrap;
    background: var(--bg); border: 1px solid var(--line); border-radius: 12px;
    padding: 1rem; margin-bottom: 1.2rem;
  }
  .month-form label {
    display: flex; flex-direction: column; gap: .3rem;
    font-size: .72rem; font-weight: 700; color: var(--ink-2);
  }
  .month-form input {
    padding: .5rem .7rem; font-size: .9rem;
    border: 1.5px solid var(--line); border-radius: 8px;
    font-family: var(--mono);
    width: 5rem;
