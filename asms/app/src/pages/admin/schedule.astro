---
import Base from '@layouts/Base.astro';
import { envFrom, getSupabaseAdmin } from '@lib/supabase';
import { getJapaneseHolidays, hasHolidayTable } from '@lib/jp_holidays';

const env = envFrom(Astro.locals);
const supabase = getSupabaseAdmin(env);

const now = new Date();
const defaultYear = now.getMonth() === 11 ? now.getFullYear() + 1 : now.getFullYear();
const defaultMonth = now.getMonth() === 11 ? 1 : now.getMonth() + 2;

const url = new URL(Astro.request.url);
const year = parseInt(url.searchParams.get('year') ?? String(defaultYear), 10);
const month = parseInt(url.searchParams.get('month') ?? String(defaultMonth), 10);
const mode = url.searchParams.get('mode') ?? '';

// POST — schedule_exceptions CRUD. Uses PRG pattern so refresh doesn't
// re-submit the form.
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const op = form.get('op') as string;
  const backYear = (form.get('year') as string) || String(year);
  const backMonth = (form.get('month') as string) || String(month);
  const backMode = (form.get('mode') as string) || '';

  const finalize = (msg: string, err: string) => {
    const q = new URLSearchParams({ year: backYear, month: backMonth });
    if (backMode) q.set('mode', backMode);
    if (msg) q.set('msg', msg);
    if (err) q.set('err', err);
    return Astro.redirect(`/admin/schedule?${q.toString()}`);
  };

  const fmtErr = (e: any) =>
    `${e?.code ?? ''} ${e?.message ?? ''} ${e?.details ?? ''}`.trim();

  if (op === 'add_exception') {
    const type = form.get('type') as string;
    const date = form.get('date') as string;
    const title = ((form.get('title') as string) || '').trim() || null;
    const rawStart = ((form.get('start_time') as string) || '').trim();
    const rawCourse = ((form.get('course_id') as string) || '').trim();
    const rawCapacity = ((form.get('capacity') as string) || '').trim();

    if (!type || !date) {
      return finalize('', '種別と日付は必須です');
    }
    if (type !== 'closure' && !rawCourse) {
      return finalize('', 'この種別ではコース選択が必須です');
    }
    if (type !== 'closure' && !rawStart) {
      return finalize('', 'この種別では開始時刻が必須です');
    }

    const payload: Record<string, unknown> = { type, date };
    if (title) payload.title = title;
    if (type !== 'closure') {
      payload.start_time = rawStart;
      payload.course_id = rawCourse;
      if (rawCapacity) payload.capacity = parseInt(rawCapacity, 10);
    }

    const { error } = await supabase.from('schedule_exceptions').insert(payload);
    return error
      ? finalize('', fmtErr(error))
      : finalize(`${date} を「${labelType(type)}」として追加しました`, '');
  }

  if (op === 'delete_exception') {
    const id = form.get('id') as string;
    if (!id) return finalize('', 'ID が指定されていません');
    const { error } = await supabase.from('schedule_exceptions').delete().eq('id', id);
    return error ? finalize('', fmtErr(error)) : finalize('例外設定を削除しました', '');
  }

  if (op === 'delete_slot') {
    // 生成済みスロットの個別削除。安全側: 予約 (cancelled 以外) が
    // 1 件でも紐付いていたら削除拒否。予約がある枠を捨てたい場合は
    // /admin/slots/[id] で先にキャンセル/一括通知してから戻ってくる。
    const slotId = form.get('slot_id') as string;
    if (!slotId) return finalize('', 'slot_id が指定されていません');
    const { data: existingRes } = await supabase
      .from('reservations')
      .select('id, reservation_number')
      .eq('slot_id', slotId)
      .neq('status', 'cancelled')
      .limit(1);
    if ((existingRes ?? []).length > 0) {
      return finalize('', `予約 (${(existingRes as any)[0].reservation_number}) がある枠は削除できません。先にスロット詳細でキャンセル操作を行ってください。`);
    }
    // ついでに cancelled 状態の reservations も physical delete しないと
    // slots FK 参照が残ってしまう → 実はしません: cancelled 予約は履歴と
    // して残すべきなので、slot だけ落とすには先に cancelled 側の slot_id
    // を NULL にはできない (NOT NULL 制約)。安全策: cancelled も含めて
    // 予約が 1 件でもあれば削除拒否 (cancelled 履歴は残る) にする。
    const { count: allResCount } = await supabase
      .from('reservations')
      .select('*', { count: 'exact', head: true })
      .eq('slot_id', slotId);
    if ((allResCount ?? 0) > 0) {
      return finalize('', `過去にキャンセル履歴を含む予約 ${allResCount} 件がある枠は削除できません (履歴保護)。`);
    }
    const { error } = await supabase.from('slots').delete().eq('id', slotId);
    return error ? finalize('', fmtErr(error)) : finalize('スロットを削除しました', '');
  }

  if (op === 'bulk_delete_slots') {
    // 複数スロットを一括削除。checkbox で選択された slot_id 群を受け取り、
    // 各スロットについて予約 (キャンセル履歴含む) が無いことを確認してから
    // まとめて削除する。予約ありは自動でスキップ、削除件数とスキップ件数を
    // まとめて報告。
    const raw = form.getAll('slot_ids') as string[];
    const slotIds = raw.map((s) => s.trim()).filter(Boolean);
    if (slotIds.length === 0) {
      return finalize('', '削除するスロットが選択されていません');
    }
    if (slotIds.length > 200) {
      return finalize('', `一度に削除できるのは 200 枠まで (現在 ${slotIds.length} 件)`);
    }

    // 予約がある slot_id をまとめて特定 (キャンセル履歴含む)
    const { data: usedRows, error: usedErr } = await supabase
      .from('reservations')
      .select('slot_id')
      .in('slot_id', slotIds);
    if (usedErr) return finalize('', fmtErr(usedErr));
    const lockedSet = new Set<string>((usedRows ?? []).map((r: any) => r.slot_id));
    const deletable = slotIds.filter((id) => !lockedSet.has(id));

    if (deletable.length === 0) {
      return finalize(
        '',
        `選択された ${slotIds.length} 枠すべてに予約履歴があるため削除できませんでした (履歴保護)`,
      );
    }

    const { error: delErr } = await supabase.from('slots').delete().in('id', deletable);
    if (delErr) return finalize('', fmtErr(delErr));

    const parts = [`✅ ${deletable.length} 枠を削除しました`];
    const skipped = slotIds.length - deletable.length;
    if (skipped > 0) parts.push(`(予約履歴あり ${skipped} 枠はスキップ)`);
    return finalize(parts.join(' '), '');
  }

  if (op === 'add_closure_range') {
    const fromDate = (form.get('from_date') as string) || '';
    const toDate = (form.get('to_date') as string) || '';
    const title = ((form.get('title') as string) || '').trim() || null;
    if (!fromDate || !toDate) return finalize('', '開始日と終了日は必須です');
    if (fromDate > toDate) return finalize('', '終了日は開始日以降にしてください');

    // Enumerate every day in [fromDate, toDate] and dedupe against existing closures.
    const days: string[] = [];
    const cur = new Date(fromDate + 'T00:00:00');
    const end = new Date(toDate + 'T00:00:00');
    while (cur <= end) {
      const y = cur.getFullYear();
      const m = String(cur.getMonth() + 1).padStart(2, '0');
      const d = String(cur.getDate()).padStart(2, '0');
      days.push(`${y}-${m}-${d}`);
      cur.setDate(cur.getDate() + 1);
    }
    if (days.length > 62) return finalize('', '一度に登録できるのは62日までです');

    const { data: existing } = await supabase
      .from('schedule_exceptions')
      .select('date')
      .eq('type', 'closure')
      .in('date', days);
    const seen = new Set((existing ?? []).map((r: any) => r.date));
    const rows = days
      .filter((day) => !seen.has(day))
      .map((day) => ({ type: 'closure', date: day, title }));

    if (rows.length === 0) {
      return finalize('この期間はすでに全て休業日として登録済みです', '');
    }
    const { error } = await supabase.from('schedule_exceptions').insert(rows);
    return error
      ? finalize('', fmtErr(error))
      : finalize(`${rows.length}日間を休業日として追加しました`, '');
  }

  if (op === 'suppress_slot') {
    const date = (form.get('date') as string) || '';
    const startTime = (form.get('start_time') as string) || '';
    const courseCode = (form.get('course_code') as string) || '';
    if (!date || !startTime || !courseCode) return finalize('', '抑止に必要な情報が不足しています');

    const { data: course, error: cErr } = await supabase
      .from('courses')
      .select('id')
      .eq('code', courseCode)
      .maybeSingle();
    if (cErr || !course) return finalize('', 'コースが見つかりません');

    const { error } = await supabase.from('schedule_exceptions').insert({
      type: 'suppress',
      date,
      start_time: startTime,
      course_id: course.id,
    });
    return error
      ? finalize('', fmtErr(error))
      : finalize(`${date} ${startTime.slice(0,5)} の枠を抑止しました`, '');
  }

  if (op === 'bulk_add_extra_slots') {
    // コース × 複数日 × 複数時間の掛け合わせで extra_slot を一括作成し、
    // その場で generate_slots_for_month を回してスロットまで実体化する。
    // 「例外追加 → プレビュー → 適用」の 3 ステップを 1 クリックにまとめるのが目的。
    const courseId = ((form.get('course_id') as string) || '').trim();
    const datesRaw = ((form.get('dates') as string) || '').trim();
    const timesRaw = ((form.get('times') as string) || '').trim();
    const rawCapacity = ((form.get('capacity') as string) || '').trim();
    const title = ((form.get('title') as string) || '').trim() || null;

    if (!courseId) return finalize('', 'コースを選んでください');
    const dates = datesRaw.split(',').map((s) => s.trim()).filter(Boolean);
    const times = timesRaw.split(',').map((s) => s.trim()).filter(Boolean);
    if (dates.length === 0) return finalize('', '日付を 1 つ以上選んでください');
    if (times.length === 0) return finalize('', '時間を 1 つ以上選んでください');
    if (dates.length * times.length > 200) {
      return finalize('', `一度に登録できるのは 200 枠まで (現在 ${dates.length * times.length} 枠)`);
    }

    const capacity = rawCapacity ? parseInt(rawCapacity, 10) : null;

    // Skip combinations already present so re-submit is idempotent
    const { data: existing } = await supabase
      .from('schedule_exceptions')
      .select('date, start_time, course_id')
      .eq('type', 'extra_slot')
      .eq('course_id', courseId)
      .in('date', dates);
    const dupKey = new Set(
      (existing ?? []).map((r: any) => `${r.date}|${(r.start_time ?? '').slice(0, 5)}`)
    );

    const rows: any[] = [];
    for (const date of dates) {
      for (const time of times) {
        const key = `${date}|${time.slice(0, 5)}`;
        if (dupKey.has(key)) continue;
        const row: any = {
          type: 'extra_slot',
          date,
          start_time: time,
          course_id: courseId,
        };
        if (capacity) row.capacity = capacity;
        if (title) row.title = title;
        rows.push(row);
      }
    }
    const dupCount = dates.length * times.length - rows.length;

    if (rows.length === 0) {
      return finalize(
        `指定された ${dates.length * times.length} 枠はすべて登録済みです`,
        ''
      );
    }

    const { error: insErr } = await supabase.from('schedule_exceptions').insert(rows);
    if (insErr) return finalize('', fmtErr(insErr));

    // Auto-apply: run generate_slots_for_month for each affected year-month
    const monthsSet = new Set<string>();
    for (const date of dates) monthsSet.add(date.slice(0, 7));
    let totalCreated = 0;
    let genErr: string | null = null;
    for (const ym of monthsSet) {
      const [y, m] = ym.split('-').map(Number);
      const { data: genResult, error: gErr } = await supabase.rpc('generate_slots_for_month', {
        p_year: y,
        p_month: m,
        p_dry_run: false,
      });
      if (gErr) {
        genErr = fmtErr(gErr);
        break;
      }
      if (genResult) {
        totalCreated += (genResult as any[]).filter((r) => r.action === 'created').length;
      }
    }
    if (genErr) {
      return finalize(
        `例外は ${rows.length} 件追加しましたが、スロット生成でエラー: ${genErr}`,
        ''
      );
    }

    const parts = [`✅ ${rows.length} 枠を追加`];
    if (dupCount > 0) parts.push(`(既存 ${dupCount} 件はスキップ)`);
    parts.push(`→ うち ${totalCreated} 枠を実体化`);
    return finalize(parts.join(' '), '');
  }

  if (op === 'bulk_holidays') {
    const yr = parseInt(backYear, 10);
    const mo = parseInt(backMonth, 10);
    const holidays = getJapaneseHolidays(yr, mo);
    if (holidays.length === 0) {
      return finalize(`${yr}年${mo}月に該当する祝日はありません`, '');
    }

    // Skip dates already registered so we don't duplicate.
    const monthStart = `${yr}-${String(mo).padStart(2, '0')}-01`;
    const endDay = new Date(yr, mo, 0).getDate();
    const monthEnd = `${yr}-${String(mo).padStart(2, '0')}-${String(endDay).padStart(2, '0')}`;
    const { data: existing } = await supabase
      .from('schedule_exceptions')
      .select('date, type')
      .eq('type', 'closure')
      .gte('date', monthStart)
      .lte('date', monthEnd);
    const existingDates = new Set((existing ?? []).map((r: any) => r.date));

    const rows = holidays
      .filter((h) => !existingDates.has(h.date))
      .map((h) => ({ type: 'closure', date: h.date, title: h.name }));

    if (rows.length === 0) {
      return finalize('祝日はすでに全て休業日として登録されています', '');
    }

    const { error } = await supabase.from('schedule_exceptions').insert(rows);
    return error
      ? finalize('', fmtErr(error))
      : finalize(`${rows.length}件の祝日を休業日として追加しました`, '');
  }

  return finalize('', `未対応の操作: ${op}`);
}

function labelType(t: string): string {
  return (
    {
      closure: '休業日',
      challenge: 'チャレンジ日',
      event: '特別イベント',
      extra_slot: '追加枠',
      suppress: '枠抑止',
    } as Record<string, string>
  )[t] ?? t;
}

const msg = url.searchParams.get('msg');
const err = url.searchParams.get('err');

// Load courses for the "add exception" form
const { data: coursesData } = await supabase
  .from('courses')
  .select('id, code, name, default_capacity, display_order')
  .eq('is_active', true)
  .order('display_order');
const courses = coursesData ?? [];

let rows: Array<{
  action: string;
  slot_date: string;
  weekday: string;
  start_time: string | null;
  end_time: string | null;
  course_code: string | null;
  course_name: string | null;
  capacity: number | null;
  reason: string | null;
}> = [];
let fnError: string | null = null;
let applied = false;

if (mode === 'preview' || mode === 'apply') {
  const dryRun = mode === 'preview';
  const { data, error } = await supabase.rpc('generate_slots_for_month', {
    p_year: year,
    p_month: month,
    p_dry_run: dryRun,
  });
  if (error) {
    fnError = `${error.code ?? ''} ${error.message ?? ''} ${error.details ?? ''}`.trim();
  } else {
    rows = (data ?? []) as typeof rows;
    if (!dryRun) applied = true;
  }
}

// existing exceptions for the selected month
const monthStart = `${year}-${String(month).padStart(2, '0')}-01`;
const monthEndDate = new Date(year, month, 0);
const monthEnd = `${year}-${String(month).padStart(2, '0')}-${String(monthEndDate.getDate()).padStart(2, '0')}`;
const { data: exceptions } = await supabase
  .from('schedule_exceptions')
  .select('id, date, type, title, start_time, capacity, course_id, courses(name)')
  .gte('date', monthStart)
  .lte('date', monthEnd)
  .order('date')
  .order('start_time');

// existing slots for the selected month (with reservation count)
const { data: monthSlots } = await supabase
  .from('slots')
  .select(`
    id, date, start_time, end_time, capacity, status,
    courses(name, code)
  `)
  .gte('date', monthStart)
  .lte('date', monthEnd)
  .order('date')
  .order('start_time');

const slotIds = (monthSlots ?? []).map((s: any) => s.id);
const resCountBySlot = new Map<string, { active: number; total: number }>();
if (slotIds.length > 0) {
  const { data: resRows } = await supabase
    .from('reservations')
    .select('slot_id, status')
    .in('slot_id', slotIds);
  for (const r of (resRows ?? []) as any[]) {
    const cur = resCountBySlot.get(r.slot_id) ?? { active: 0, total: 0 };
    cur.total++;
    if (r.status !== 'cancelled') cur.active++;
    resCountBySlot.set(r.slot_id, cur);
  }
}

const holidaysAvailable = hasHolidayTable(year);
const monthlyHolidays = getJapaneseHolidays(year, month);

// summary of proposed / applied actions
const summary = rows.reduce<Record<string, number>>((acc, r) => {
  acc[r.action] = (acc[r.action] ?? 0) + 1;
  return acc;
}, {});

const actionLabel: Record<string, string> = {
  would_create: '📝 生成予定',
  created: '✅ 生成完了',
  skipped_exists: '⏭ 既存',
  skipped_closure: '🚫 休業',
  skipped_challenge_morning: '⛔ チャレンジ日午前抑止',
};
const actionColor: Record<string, string> = {
  would_create: 'proposed',
  created: 'created',
  skipped_exists: 'muted',
  skipped_closure: 'closed',
  skipped_challenge_morning: 'muted',
};

// Default date for the add form: first day of selected month
const addDefaultDate = monthStart;

// -----------------------------------------------------------------------
// 「まとめて追加」のカレンダーグリッド用データ
// 選択中の年月について: 週始まりの日曜〜土曜配置で 7 x 6 行のセルを組む。
// 各日は date-string を data-date として、クリック時に client-side JS が
// selected トグルする (hidden input <bulkDates> にカンマ区切りで反映)。
// -----------------------------------------------------------------------
const closureDatesInMonth = new Set<string>(
  (exceptions ?? []).filter((e: any) => e.type === 'closure').map((e: any) => e.date)
);
const firstOfMonth = new Date(year, month - 1, 1);
const firstDayOfWeek = firstOfMonth.getDay(); // 0 = Sunday
const daysInMonth = new Date(year, month, 0).getDate();
const todayStr = (() => {
  const d = new Date();
  return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
})();
type CalCell =
  | { type: 'empty' }
  | { type: 'day'; date: string; day: number; weekday: number; isClosure: boolean; isToday: boolean; isPast: boolean };
const calCells: CalCell[] = [];
for (let i = 0; i < firstDayOfWeek; i++) calCells.push({ type: 'empty' });
for (let d = 1; d <= daysInMonth; d++) {
  const dt = new Date(year, month - 1, d);
  const date = `${year}-${String(month).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
  calCells.push({
    type: 'day',
    date,
    day: d,
    weekday: dt.getDay(),
    isClosure: closureDatesInMonth.has(date),
    isToday: date === todayStr,
    isPast: date < todayStr,
  });
}
const bulkTimeChoices = ['09:00', '10:00', '11:00', '13:00', '14:00', '15:00', '16:00', '17:00'];
---
<Base title="スケジュール管理 — ASMS">
  <main>
    <header class="hd">
      <a class="back" href="/admin">← 管理トップ</a>
      <h1>スケジュール管理</h1>
      <p class="sub">月次スロット生成・例外日管理</p>
    </header>

    <form class="month-form" method="get">
      <label>
        年
        <input type="number" name="year" min="2025" max="2030" value={year} />
      </label>
      <label>
        月
        <input type="number" name="month" min="1" max="12" value={month} />
      </label>
      <button type="submit" name="mode" value="preview" class="btn btn-primary">
        プレビュー
      </button>
    </form>

    {msg && <div class="ok-banner">{msg}</div>}
    {err && <div class="err">{err}</div>}

    <section class="bulk-add">
      <div class="bulk-hd">
        <h2>🎯 まとめて追加枠を作成</h2>
        <p class="bulk-sub">
          コース × 複数日 × 複数時間 の掛け合わせで、通常の繰り返しルールとは別に枠を追加します。
          追加した瞬間に自動で予約可能な状態になります（プレビュー/適用不要）。
        </p>
      </div>

      <form method="post" class="bulk-form" id="bulkForm">
        <input type="hidden" name="op" value="bulk_add_extra_slots" />
        <input type="hidden" name="year" value={year} />
        <input type="hidden" name="month" value={month} />
        <input type="hidden" name="dates" id="bulkDates" value="" />
        <input type="hidden" name="times" id="bulkTimes" value="" />

        <div class="bulk-step">
          <div class="bulk-step-label">
            <span class="step-num">1</span>
            <span>コースを選ぶ</span>
          </div>
          <div class="course-choices">
            {courses.map((c: any) => (
              <label class="course-choice">
                <input type="radio" name="course_id" value={c.id}
                       data-default-capacity={c.default_capacity}
                       data-name={c.name} />
                <div class="cc-body">
                  <span class="cc-name">{c.name}</span>
                  <span class="cc-cap">定員 {c.default_capacity}</span>
                </div>
              </label>
            ))}
          </div>
        </div>

        <div class="bulk-step">
          <div class="bulk-step-label">
            <span class="step-num">2</span>
            <span>日にちを選ぶ（複数可・{year}年{month}月）</span>
            <span class="bulk-count" id="datesCount">未選択</span>
          </div>
          <div class="cal-grid" id="calGrid">
            <div class="cal-wd cal-wd-sun">日</div>
            <div class="cal-wd">月</div>
            <div class="cal-wd">火</div>
            <div class="cal-wd">水</div>
            <div class="cal-wd">木</div>
            <div class="cal-wd">金</div>
            <div class="cal-wd cal-wd-sat">土</div>
            {calCells.map((c) => (
              c.type === 'empty'
                ? <div class="cal-empty"></div>
                : (
                  <button type="button"
                    class={`cal-day wd-${c.weekday} ${c.isClosure ? 'is-closure' : ''} ${c.isToday ? 'is-today' : ''} ${c.isPast ? 'is-past' : ''}`}
                    data-date={c.date}
                    disabled={c.isClosure || c.isPast}
                    title={c.isClosure ? '休業日 (選択不可)' : c.isPast ? '過去日 (選択不可)' : ''}>
                    <span class="cd-num">{c.day}</span>
                    {c.isClosure && <span class="cd-badge">休</span>}
                  </button>
                )
            ))}
          </div>
          <p class="bulk-inline-hint">🚫 休業日と過去日はタップできません（グレー表示）</p>
        </div>

        <div class="bulk-step">
          <div class="bulk-step-label">
            <span class="step-num">3</span>
            <span>時間を選ぶ（複数可）</span>
            <span class="bulk-count" id="timesCount">未選択</span>
          </div>
          <div class="time-chips" id="timeChips">
            {bulkTimeChoices.map((t) => (
              <button type="button" class="time-chip" data-time={t}>{t}</button>
            ))}
          </div>
          <div class="custom-time">
            <label for="customTime">その他の時間を追加</label>
            <input type="time" id="customTime" step="900" />
            <button type="button" id="addCustomTime" class="btn-mini">＋ 追加</button>
          </div>
        </div>

        <div class="bulk-step bulk-step-inline">
          <div class="bulk-step-label">
            <span class="step-num">4</span>
            <span>定員</span>
          </div>
          <div class="inline-input">
            <input type="number" name="capacity" id="bulkCapacity" min="1" max="30"
                   placeholder="コース既定値を使用" />
            <span class="bulk-hint">空欄にするとコース選択に応じた既定値で作成</span>
          </div>
        </div>

        <div class="bulk-step bulk-step-inline">
          <div class="bulk-step-label">
            <span class="step-num">5</span>
            <span>メモ（任意）</span>
          </div>
          <div class="inline-input">
            <input type="text" name="title" maxlength="80"
                   placeholder="例: テスト配信用、GWキャンペーン" />
          </div>
        </div>

        <button type="submit" class="btn btn-primary btn-big bulk-submit" id="bulkSubmit" disabled>
          コースを選んでください
        </button>
      </form>
    </section>

    {mode && (
      <div class="mode-banner">
        {mode === 'preview' && (
          <><strong>{year}年{month}月</strong>のプレビュー（DB 未変更）</>
        )}
        {mode === 'apply' && applied && (
          <><strong>{year}年{month}月</strong>のスロットを生成しました ✅</>
        )}
      </div>
    )}

    {fnError && (
      <div class="err">
        <strong>関数呼び出しエラー:</strong>
        <code>{fnError}</code>
      </div>
    )}

    {rows.length > 0 && (
      <>
        <section class="summary">
          {Object.entries(summary).map(([action, count]) => (
            <div class={`chip chip-${actionColor[action] ?? 'muted'}`}>
              {actionLabel[action] ?? action}: <strong>{count}</strong>
            </div>
          ))}
        </section>

        <section class="table-wrap">
          <table class="slot-table">
            <thead>
              <tr>
                <th>日付</th>
                <th>時間</th>
                <th>コース</th>
                <th class="num">定員</th>
                <th>状態</th>
                <th class="act-col"></th>
              </tr>
            </thead>
            <tbody>
              {rows.map((r) => (
                <tr class={`row-${actionColor[r.action] ?? 'muted'}`}>
                  <td class="mono">{r.slot_date} ({r.weekday})</td>
                  <td class="mono">
                    {r.start_time ? `${r.start_time.slice(0, 5)}` : '—'}
                    {r.end_time && `–${r.end_time.slice(0, 5)}`}
                  </td>
                  <td>{r.course_name ?? '—'}</td>
                  <td class="mono num">{r.capacity ?? '—'}</td>
                  <td class="status">
                    {actionLabel[r.action] ?? r.action}
                    {r.reason && <span class="reason"> · {r.reason}</span>}
                  </td>
                  <td class="act-col">
                    {r.action === 'would_create' && r.start_time && r.course_code && (
                      <form method="post" class="row-suppress"
                            onsubmit="return confirm('この枠を生成対象から外しますか？');">
                        <input type="hidden" name="op" value="suppress_slot" />
                        <input type="hidden" name="year" value={year} />
                        <input type="hidden" name="month" value={month} />
                        <input type="hidden" name="mode" value="preview" />
                        <input type="hidden" name="date" value={r.slot_date} />
                        <input type="hidden" name="start_time" value={r.start_time} />
                        <input type="hidden" name="course_code" value={r.course_code} />
                        <button type="submit" class="del-btn" title="この枠を抑止" aria-label="この枠を抑止">×</button>
                      </form>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </section>

        {mode === 'preview' && rows.some(r => r.action === 'would_create') && (
          <form class="apply-form" method="get">
            <input type="hidden" name="year" value={year} />
            <input type="hidden" name="month" value={month} />
            <button type="submit" name="mode" value="apply" class="btn btn-primary btn-big">
              ✅ この内容で {year}年{month}月 のスロットを生成する
            </button>
            <p class="warn">
              生成後は個別スロットの status を変更できますが、大量に消したい場合は SQL で直接扱ってください。
            </p>
          </form>
        )}
      </>
    )}

    <section class="exceptions">
      <div class="ex-hd">
        <h2>{year}年{month}月 の例外設定</h2>
        <div class="hd-actions">
          {holidaysAvailable && monthlyHolidays.length > 0 && (
            <form method="post" class="bulk-form">
              <input type="hidden" name="op" value="bulk_holidays" />
              <input type="hidden" name="year" value={year} />
              <input type="hidden" name="month" value={month} />
              <input type="hidden" name="mode" value={mode} />
              <button type="submit" class="btn-mini">
                🎌 {monthlyHolidays.length}件の祝日を休業日に一括追加
              </button>
            </form>
          )}
        </div>
      </div>

      <details class="add-range-wrap">
        <summary>📅 期間で休業日を一括追加（お盆・GW など）</summary>
        <form method="post" class="range-form">
          <input type="hidden" name="op" value="add_closure_range" />
          <input type="hidden" name="year" value={year} />
          <input type="hidden" name="month" value={month} />
          <input type="hidden" name="mode" value={mode} />
          <div class="range-row">
            <label>開始日
              <input type="date" name="from_date" value={monthStart} required />
            </label>
            <label>終了日
              <input type="date" name="to_date" value={monthStart} required />
            </label>
          </div>
          <div class="field">
            <label>タイトル（任意）</label>
            <input type="text" name="title" maxlength="80"
              placeholder="例: お盆休み、GW休業" />
          </div>
          <button type="submit" class="btn btn-primary">期間で休業日追加</button>
        </form>
      </details>

      {exceptions && exceptions.length > 0 ? (
        <ul class="ex-list">
          {exceptions.map((ex: any) => (
            <li>
              <span class="mono ex-date">{ex.date}</span>
              <span class={`ex-type ex-${ex.type}`}>{labelType(ex.type)}</span>
              {ex.start_time && <span class="mono ex-time">{ex.start_time.slice(0,5)}</span>}
              {ex.courses?.name && <span class="ex-course">{ex.courses.name}</span>}
              {ex.title && <span class="ex-title">{ex.title}</span>}
              <form method="post" class="del-form" onsubmit="return confirm('この例外設定を削除しますか？');">
                <input type="hidden" name="op" value="delete_exception" />
                <input type="hidden" name="id" value={ex.id} />
                <input type="hidden" name="year" value={year} />
                <input type="hidden" name="month" value={month} />
                <input type="hidden" name="mode" value={mode} />
                <button type="submit" class="del-btn" aria-label="削除">×</button>
              </form>
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty-ex">まだ例外設定はありません。下のフォームから追加できます。</p>
      )}

      <details class="add-ex-wrap" open={!(exceptions && exceptions.length > 0)}>
        <summary>➕ 例外設定を追加</summary>
        <form method="post" class="add-ex-form" id="addExForm">
          <input type="hidden" name="op" value="add_exception" />
          <input type="hidden" name="year" value={year} />
          <input type="hidden" name="month" value={month} />
          <input type="hidden" name="mode" value={mode} />

          <div class="field type-field">
            <label>種別 *</label>
            <div class="type-choices">
              <label class="type-choice">
                <input type="radio" name="type" value="closure" checked />
                <span>🚫 休業日</span>
                <em>その日のスロットを終日生成しない</em>
              </label>
              <label class="type-choice">
                <input type="radio" name="type" value="challenge" />
                <span>🏁 チャレンジ日</span>
                <em>午前ミニ枠を抑止しチャレンジ枠を追加</em>
              </label>
              <label class="type-choice">
                <input type="radio" name="type" value="event" />
                <span>🎉 特別イベント</span>
                <em>サマースクール等の単発イベント枠</em>
              </label>
              <label class="type-choice">
                <input type="radio" name="type" value="extra_slot" />
                <span>➕ 追加枠</span>
                <em>通常日にもう1枠だけ追加</em>
              </label>
            </div>
          </div>

          <div class="field">
            <label for="ex-date">日付 *</label>
            <input type="date" id="ex-date" name="date"
              min={`${year}-${String(month).padStart(2,'0')}-01`}
              max={monthEnd}
              value={addDefaultDate}
              required />
          </div>

          <div class="field course-field" data-conditional="hide-on-closure">
            <label for="ex-course">コース *</label>
            <select id="ex-course" name="course_id">
              <option value="">— 選択 —</option>
              {courses.map((c: any) => (
                <option value={c.id}>{c.name} ({c.code})</option>
              ))}
            </select>
          </div>

          <div class="field time-field" data-conditional="hide-on-closure">
            <label for="ex-time">開始時刻 *</label>
            <input type="time" id="ex-time" name="start_time" step="900" />
          </div>

          <div class="field capacity-field" data-conditional="hide-on-closure">
            <label for="ex-capacity">定員（空欄でコース既定値）</label>
            <input type="number" id="ex-capacity" name="capacity" min="1" max="30" />
          </div>

          <div class="field title-field">
            <label for="ex-title">タイトル・メモ</label>
            <input type="text" id="ex-title" name="title" maxlength="80"
              placeholder="例: サマースクール、GW休業 など" />
          </div>

          <button type="submit" class="btn btn-primary">追加</button>
        </form>
      </details>
    </section>

    <section class="month-slots">
      <div class="ms-hd">
        <h2>📆 {year}年{month}月の生成済みスロット</h2>
        <span class="ms-count">{monthSlots?.length ?? 0} 枠</span>
      </div>
      <p class="ms-hint">生成後に間違えたスロットや不要になった枠を削除できます。<strong>予約が 1 件でも紐付いていると削除できません</strong>（履歴保護のため）。予約がある枠を削除したい場合は、先に <a href="/admin/reservations">予約一覧</a> → スロット詳細でキャンセル操作を行ってから、それでも枠自体を捨てる必要があれば ここに戻ってください。</p>
      {(!monthSlots || monthSlots.length === 0) ? (
        <p class="ms-empty">この月にはまだスロットが生成されていません。上の「プレビュー → 生成」で作成してください。</p>
      ) : (
        <form method="post" id="msBulkForm" class="ms-bulk-form">
          <input type="hidden" name="op" value="bulk_delete_slots" />
          <input type="hidden" name="year" value={year} />
          <input type="hidden" name="month" value={month} />

          <div class="ms-bulk-bar">
            <label class="ms-bulk-selall">
              <input type="checkbox" id="msSelAll" />
              <span>削除可能な枠を全て選択</span>
            </label>
            <div class="ms-bulk-actions">
              <span class="ms-bulk-count" id="msBulkCount">未選択</span>
              <button type="submit" class="ms-bulk-del" id="msBulkDel" disabled>
                🗑 選択した枠をまとめて削除
              </button>
            </div>
          </div>

          <ul class="ms-list">
            {monthSlots.map((s: any) => {
              const rc = resCountBySlot.get(s.id) ?? { active: 0, total: 0 };
              const canDelete = rc.total === 0;
              const timeLabel = `${s.start_time?.slice(0, 5)}${s.end_time ? '–' + s.end_time.slice(0, 5) : ''}`;
              return (
                <li class={`ms-item ${canDelete ? '' : 'ms-locked'}`}>
                  <label class="ms-check">
                    {canDelete ? (
                      <input type="checkbox" name="slot_ids" value={s.id} class="ms-check-input" />
                    ) : (
                      <input type="checkbox" disabled title="予約履歴あり" />
                    )}
                  </label>
                  <div class="ms-body">
                    <div class="ms-line-1">
                      <span class="ms-date mono">{s.date}</span>
                      <span class="ms-time mono">{timeLabel}</span>
                      <span class="ms-course">{s.courses?.name}</span>
                    </div>
                    <div class="ms-line-2">
                      <span class="ms-status ms-st-{s.status}">
                        {s.status === 'open' ? '🟢 受付中' : s.status === 'closed' ? '🟡 停止' : '🔴 中止'}
                      </span>
                      <span class="ms-cap">定員 {s.capacity}</span>
                      {rc.active > 0 && <span class="ms-res">予約 {rc.active} 件</span>}
                      {rc.total > rc.active && <span class="ms-res-cancel">キャンセル履歴 {rc.total - rc.active} 件</span>}
                    </div>
                  </div>
                  <div class="ms-actions">
                    <a class="ms-view" href={`/admin/slots/${s.id}`}>詳細 →</a>
                    {canDelete ? (
                      <button type="button" class="ms-del"
                              data-slot-id={s.id}
                              data-slot-label={`${s.date} ${timeLabel} ${s.courses?.name}`}>
                        🗑 削除
                      </button>
                    ) : (
                      <span class="ms-locked-badge" title="予約履歴あり">🔒 削除不可</span>
                    )}
                  </div>
                </li>
              );
            })}
          </ul>
        </form>
      )}
    </section>

    <details class="help">
      <summary>ヘルプ</summary>
      <ul>
        <li><strong>プレビュー</strong>: DB を変更せず、生成される予定のスロットを表で確認。</li>
        <li><strong>生成</strong>: プレビュー内容を実際に <code>slots</code> に INSERT。既存重複は自動スキップ。</li>
        <li><strong>祝日一括追加</strong>: 表示中の月の日本の祝日を <code>closure</code>（休業日）として一括登録。すでに登録済みの祝日はスキップ。</li>
        <li>例外の種別:
          <ul>
            <li><strong>休業日</strong> → 終日スロット生成なし</li>
            <li><strong>チャレンジ日</strong> → 午前ミニ枠を抑止 + チャレンジ枠を追加</li>
            <li><strong>特別イベント</strong> → イベント枠を追加（サマースクール等）</li>
            <li><strong>追加枠</strong> → 通常日に追加スロット</li>
          </ul>
        </li>
        <li>例外設定を変更したら、<strong>プレビュー</strong>を再実行して反映を確認してから生成してください。</li>
      </ul>
    </details>
  </main>
</Base>

<script>
  // Progressive disclosure: hide course / time / capacity fields when
  // type = closure (休業日) since those columns are unused for that type.
  const form = document.getElementById('addExForm') as HTMLFormElement | null;
  if (form) {
    const typeInputs = form.querySelectorAll<HTMLInputElement>('input[name="type"]');
    const conditional = form.querySelectorAll<HTMLElement>('[data-conditional="hide-on-closure"]');
    const courseSelect = form.querySelector<HTMLSelectElement>('#ex-course');
    const timeInput = form.querySelector<HTMLInputElement>('#ex-time');

    const sync = () => {
      const selected = form.querySelector<HTMLInputElement>('input[name="type"]:checked')?.value;
      const isClosure = selected === 'closure';
      conditional.forEach((el) => {
        el.style.display = isClosure ? 'none' : '';
      });
      if (courseSelect) courseSelect.required = !isClosure;
      if (timeInput) timeInput.required = !isClosure;
    };

    typeInputs.forEach((r) => r.addEventListener('change', sync));
    sync();
  }

  // -----------------------------------------------------------------
  // まとめて追加: 日付・時間のマルチセレクト + 送信ボタン動的更新
  // -----------------------------------------------------------------
  const bulkForm = document.getElementById('bulkForm') as HTMLFormElement | null;
  if (bulkForm) {
    const selectedDates = new Set<string>();
    const selectedTimes = new Set<string>();
    const datesInput = document.getElementById('bulkDates') as HTMLInputElement;
    const timesInput = document.getElementById('bulkTimes') as HTMLInputElement;
    const datesCount = document.getElementById('datesCount') as HTMLElement;
    const timesCount = document.getElementById('timesCount') as HTMLElement;
    const bulkSubmit = document.getElementById('bulkSubmit') as HTMLButtonElement;
    const capacityInput = document.getElementById('bulkCapacity') as HTMLInputElement;
    const timeChips = document.getElementById('timeChips') as HTMLElement;

    const update = () => {
      const courseInput = bulkForm.querySelector<HTMLInputElement>('input[name="course_id"]:checked');
      const dCount = selectedDates.size;
      const tCount = selectedTimes.size;
      datesCount.textContent = dCount > 0 ? `${dCount}日選択中` : '未選択';
      timesCount.textContent = tCount > 0 ? `${tCount}時間選択中` : '未選択';

      if (!courseInput) {
        bulkSubmit.disabled = true;
        bulkSubmit.textContent = 'コースを選んでください';
      } else if (dCount === 0) {
        bulkSubmit.disabled = true;
        bulkSubmit.textContent = '日付を選んでください';
      } else if (tCount === 0) {
        bulkSubmit.disabled = true;
        bulkSubmit.textContent = '時間を選んでください';
      } else {
        bulkSubmit.disabled = false;
        bulkSubmit.textContent = `✅ ${dCount}日 × ${tCount}時間 = ${dCount * tCount}枠を作成`;
      }
      datesInput.value = Array.from(selectedDates).sort().join(',');
      timesInput.value = Array.from(selectedTimes).sort().join(',');
    };

    // Date cells
    document.querySelectorAll<HTMLButtonElement>('.cal-day').forEach((btn) => {
      if (btn.disabled) return;
      btn.addEventListener('click', () => {
        const date = btn.dataset.date;
        if (!date) return;
        if (selectedDates.has(date)) {
          selectedDates.delete(date);
          btn.classList.remove('is-selected');
        } else {
          selectedDates.add(date);
          btn.classList.add('is-selected');
        }
        update();
      });
    });

    // Time chips
    const toggleTime = (time: string, chip: HTMLElement) => {
      if (selectedTimes.has(time)) {
        selectedTimes.delete(time);
        chip.classList.remove('is-selected');
      } else {
        selectedTimes.add(time);
        chip.classList.add('is-selected');
      }
      update();
    };
    document.querySelectorAll<HTMLButtonElement>('.time-chip').forEach((btn) => {
      const time = btn.dataset.time;
      if (!time) return;
      btn.addEventListener('click', () => toggleTime(time, btn));
    });

    // Custom time add
    const customTimeInput = document.getElementById('customTime') as HTMLInputElement;
    const addCustomBtn = document.getElementById('addCustomTime') as HTMLButtonElement;
    addCustomBtn?.addEventListener('click', () => {
      const raw = (customTimeInput.value ?? '').trim();
      if (!raw) return;
      // Already exists as a chip? just toggle
      const existing = timeChips.querySelector<HTMLElement>(`.time-chip[data-time="${raw}"]`);
      if (existing) {
        if (!selectedTimes.has(raw)) toggleTime(raw, existing);
        customTimeInput.value = '';
        return;
      }
      const chip = document.createElement('button');
      chip.type = 'button';
      chip.className = 'time-chip is-selected';
      chip.dataset.time = raw;
      chip.textContent = raw;
      chip.addEventListener('click', () => toggleTime(raw, chip));
      timeChips.appendChild(chip);
      selectedTimes.add(raw);
      customTimeInput.value = '';
      update();
    });

    // Course radio → auto-hint capacity placeholder
    bulkForm.querySelectorAll<HTMLInputElement>('input[name="course_id"]').forEach((r) => {
      r.addEventListener('change', () => {
        const def = r.dataset.defaultCapacity;
        if (def) capacityInput.placeholder = `${def} (${r.dataset.name} 既定値)`;
        update();
      });
    });

    // Guard against accidental submit without confirm on big batches
    bulkForm.addEventListener('submit', (e) => {
      const dCount = selectedDates.size;
      const tCount = selectedTimes.size;
      const total = dCount * tCount;
      if (total >= 20) {
        const ok = confirm(`${total} 枠を一括で追加します。よろしいですか？`);
        if (!ok) e.preventDefault();
      }
    });

    update();
  }

  // -----------------------------------------------------------------
  // 月次スロット一覧: 個別「🗑 削除」ボタンと一括削除フォーム
  // - 個別ボタン: click で hidden form を組み立てて POST (op=delete_slot)
  // - 一括: checkbox を選択 → 「まとめて削除」ボタン (op=bulk_delete_slots)
  // - 「全て選択」チェックで削除可能スロットのみをまとめてオン/オフ
  // -----------------------------------------------------------------
  const msBulkForm = document.getElementById('msBulkForm') as HTMLFormElement | null;
  if (msBulkForm) {
    const selAll = document.getElementById('msSelAll') as HTMLInputElement | null;
    const bulkCount = document.getElementById('msBulkCount') as HTMLElement | null;
    const bulkDel = document.getElementById('msBulkDel') as HTMLButtonElement | null;
    const checks = msBulkForm.querySelectorAll<HTMLInputElement>('.ms-check-input');

    const updateBulk = () => {
      const selected = Array.from(checks).filter((c) => c.checked).length;
      const total = checks.length;
      if (bulkCount) {
        bulkCount.textContent = selected > 0 ? `${selected} 枠選択中` : '未選択';
      }
      if (bulkDel) {
        bulkDel.disabled = selected === 0;
      }
      if (selAll) {
        selAll.checked = total > 0 && selected === total;
        selAll.indeterminate = selected > 0 && selected < total;
      }
    };

    checks.forEach((c) => c.addEventListener('change', updateBulk));
    if (selAll) {
      selAll.addEventListener('change', () => {
        const target = selAll.checked;
        checks.forEach((c) => { c.checked = target; });
        updateBulk();
      });
    }

    msBulkForm.addEventListener('submit', (e) => {
      const selected = Array.from(checks).filter((c) => c.checked).length;
      if (selected === 0) {
        e.preventDefault();
        return;
      }
      const ok = confirm(`選択した ${selected} 枠を削除します。よろしいですか？\n\n※ 予約履歴のある枠は自動でスキップされます。`);
      if (!ok) e.preventDefault();
    });

    // 個別「🗑 削除」ボタン (checkbox とは独立、単発 delete_slot POST)
    msBulkForm.querySelectorAll<HTMLButtonElement>('.ms-del').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const slotId = btn.dataset.slotId;
        const label = btn.dataset.slotLabel || 'このスロット';
        if (!slotId) return;
        if (!confirm(`${label} を削除します。よろしいですか？`)) return;
        // Build a dedicated form and submit
        const yearInput = msBulkForm.querySelector<HTMLInputElement>('input[name="year"]');
        const monthInput = msBulkForm.querySelector<HTMLInputElement>('input[name="month"]');
        const soloForm = document.createElement('form');
        soloForm.method = 'post';
        soloForm.style.display = 'none';
        const mk = (name: string, value: string) => {
          const i = document.createElement('input');
          i.type = 'hidden';
          i.name = name;
          i.value = value;
          soloForm.appendChild(i);
        };
        mk('op', 'delete_slot');
        mk('slot_id', slotId);
        if (yearInput) mk('year', yearInput.value);
        if (monthInput) mk('month', monthInput.value);
        document.body.appendChild(soloForm);
        soloForm.submit();
      });
    });

    updateBulk();
  }
</script>

