---
import Base from '@layouts/Base.astro';
import { envFrom, getSupabaseAdmin } from '@lib/supabase';
import {
  SKILL_LEVELS,
  SYSTEM_ADMIN_UUID,
  ageOn,
  attendanceClass,
  attendanceLabel,
  formatMs,
  jaDateLabel,
  jaDateShort,
  skillLabel,
} from '@lib/admin';

const env = envFrom(Astro.locals);
const supabase = getSupabaseAdmin(env);

const { id } = Astro.params;
if (!id) return new Response('missing id', { status: 400 });

// POST — inline handlers for karte edits. PRG pattern with ?msg=/?err=
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const op = form.get('op') as string;

  const back = (msg = '', err = '') => {
    const q = new URLSearchParams();
    if (msg) q.set('msg', msg);
    if (err) q.set('err', err);
    return Astro.redirect(`/admin/customers/${id}${q.toString() ? '?' + q.toString() : ''}`);
  };
  const fmt = (e: any) =>
    `${e?.code ?? ''} ${e?.message ?? ''} ${e?.details ?? ''}`.trim();

  if (op === 'update_notes') {
    const notes = ((form.get('staff_notes') as string) || '').trim() || null;
    const rec = ((form.get('next_recommendation') as string) || '').trim() || null;
    const { error } = await supabase
      .from('customers')
      .update({ staff_notes: notes, next_recommendation: rec })
      .eq('id', id);
    return error ? back('', fmt(error)) : back('メモを更新しました');
  }

  if (op === 'set_team_member') {
    const raw = ((form.get('team_member_since') as string) || '').trim();
    const dateVal = raw && /^\d{4}-\d{2}-\d{2}$/.test(raw) ? raw : null;
    const { error } = await supabase
      .from('customers')
      .update({ team_member_since: dateVal })
      .eq('id', id);
    return error ? back('', fmt(error)) : back(dateVal ? `チーム加入日を ${dateVal} に設定` : 'チーム加入日を解除しました');
  }

  if (op === 'add_progression') {
    const toLevel = form.get('to_level') as string;
    const fromLevel = ((form.get('from_level') as string) || '') || null;
    const reason = ((form.get('reason') as string) || '').trim() || null;
    if (!toLevel) return back('', 'to_level は必須です');

    const { error: pErr } = await supabase.from('customer_progressions').insert({
      customer_id: id,
      from_level: fromLevel,
      to_level: toLevel,
      reason,
      changed_by: SYSTEM_ADMIN_UUID,
    });
    if (pErr) return back('', fmt(pErr));

    const { error: cErr } = await supabase
      .from('customers')
      .update({ current_skill_level: toLevel })
      .eq('id', id);
    if (cErr) return back('', fmt(cErr));

    return back(`習熟度を「${skillLabel(toLevel)}」に更新しました`);
  }

  if (op === 'add_best') {
    const recordType = ((form.get('record_type') as string) || '').trim();
    const seconds = parseFloat((form.get('seconds') as string) || '0');
    const vehicle = ((form.get('vehicle_name') as string) || '').trim() || null;
    const note = ((form.get('note') as string) || '').trim() || null;
    if (!recordType) return back('', '記録種別は必須です');
    const totalMs = Math.round(seconds * 1000);
    if (totalMs <= 0) return back('', 'タイムは 0 より大きい値を入力してください');

    const { error } = await supabase.from('customer_bests').insert({
      customer_id: id,
      record_type: recordType,
      value_ms: totalMs,
      vehicle_name: vehicle,
      note,
      recorded_by: SYSTEM_ADMIN_UUID,
    });
    return error ? back('', fmt(error)) : back('ベストタイムを追加しました');
  }

  if (op === 'delete_best') {
    const bestId = form.get('best_id') as string;
    if (!bestId) return back('', 'best_id が指定されていません');
    const { error } = await supabase.from('customer_bests').delete().eq('id', bestId);
    return error ? back('', fmt(error)) : back('ベストタイムを削除しました');
  }

  if (op === 'merge_into') {
    const targetId = form.get('target_id') as string;
    if (!targetId) return back('', '統合先が指定されていません');
    if (targetId === id) return back('', '自分自身には統合できません');

    // Verify target exists and is not itself deleted
    const { data: target } = await supabase
      .from('customers')
      .select('id, is_deleted')
      .eq('id', targetId)
      .maybeSingle();
    if (!target) return back('', '統合先のカルテが見つかりません');
    if (target.is_deleted) return back('', '統合先のカルテは既に削除されています');

    // Move all history to target
    const moves = [
      supabase.from('reservation_participants').update({ customer_id: targetId }).eq('customer_id', id),
      supabase.from('customer_progressions').update({ customer_id: targetId }).eq('customer_id', id),
      supabase.from('customer_bests').update({ customer_id: targetId }).eq('customer_id', id),
      supabase.from('guardian_customer_links').update({ customer_id: targetId }).eq('customer_id', id),
    ];
    for (const p of moves) {
      const { error } = await p;
      if (error) return back('', `統合中にエラー: ${fmt(error)}`);
    }

    // Mark source as merged + deleted
    const { error: mErr } = await supabase
      .from('customers')
      .update({ merged_into_id: targetId, is_deleted: true })
      .eq('id', id);
    if (mErr) return back('', `統合フラグ更新に失敗: ${fmt(mErr)}`);

    // Best-effort: recompute target's total_participations from
    // reservation_participants (the recalc trigger only fires on
    // participant UPDATE, and we just re-parented rows). One touch
    // triggers the recalc.
    const { data: anyPart } = await supabase
      .from('reservation_participants')
      .select('id, attendance_status')
      .eq('customer_id', targetId)
      .limit(1)
      .maybeSingle();
    if (anyPart) {
      await supabase
        .from('reservation_participants')
        .update({ attendance_status: anyPart.attendance_status })
        .eq('id', anyPart.id);
    }

    // Redirect to the target's karte
    const q = new URLSearchParams();
    q.set('msg', `統合完了：このカルテは統合先へ移動されました`);
    return Astro.redirect(`/admin/customers/${targetId}?${q.toString()}`);
  }

  return back('', `未対応の操作: ${op}`);
}

const url = new URL(Astro.request.url);
const msg = url.searchParams.get('msg');
const err = url.searchParams.get('err');

// Load the customer
const { data: customer, error: cErr } = await supabase
  .from('customers')
  .select('*')
  .eq('id', id)
  .maybeSingle();

if (!customer) {
  return new Response(null, { status: 302, headers: { Location: '/admin/customers' } });
}

// Guardians via link table
const { data: linkRows } = await supabase
  .from('guardian_customer_links')
  .select('relation, is_primary, guardians(id, name, kana, phone, email, address)')
  .eq('customer_id', id);
const guardians = (linkRows ?? [])
  .map((l: any) => ({ ...l.guardians, relation: l.relation, is_primary: l.is_primary }))
  .filter((g: any) => g.id);

// Progression timeline (newest first)
const { data: progressions } = await supabase
  .from('customer_progressions')
  .select('id, from_level, to_level, reason, changed_at')
  .eq('customer_id', id)
  .order('changed_at', { ascending: false })
  .limit(50);

// Best times
const { data: bests } = await supabase
  .from('customer_bests')
  .select('id, record_type, value_ms, vehicle_name, note, recorded_at')
  .eq('customer_id', id)
  .order('recorded_at', { ascending: false })
  .limit(50);

// Participation history (via reservation_participants)
const { data: participations } = await supabase
  .from('reservation_participants')
  .select(`
    id, attendance_status, height_cm, age_at_booking, created_at,
    reservations(id, reservation_number, status,
                 slots(id, date, start_time, courses(name, code)))
  `)
  .eq('customer_id', id)
  .order('created_at', { ascending: false })
  .limit(100);

const genderJa = (g: string) => ({ male: '男', female: '女', other: 'その他' } as any)[g] ?? g;

// Merge candidates: other alive customers with same name OR same kana
// OR same birth_date. Same-birth-date alone is a weaker signal but
// still worth surfacing (typos in name / kana).
const { data: candidatesRaw } = await supabase
  .from('customers')
  .select('id, customer_number, name, kana, birth_date, gender, current_skill_level, total_participations, last_participation_at')
  .eq('is_deleted', false)
  .neq('id', id)
  .or(`name.eq.${customer.name},kana.eq.${customer.kana},birth_date.eq.${customer.birth_date}`)
  .limit(20);
const candidates = (candidatesRaw ?? []) as any[];

// Manual search: 任意のカルテを検索して統合できる。ilike で name / kana /
// customer_number をあいまい検索、20 件まで、自動候補と重複する ID は除外。
const searchQ = (url.searchParams.get('search') || '').trim();
let searchResults: any[] = [];
if (searchQ.length >= 1) {
  const excludeIds = [id, ...candidates.map((c) => c.id)];
  const escaped = searchQ.replace(/[%_]/g, (c) => `\\${c}`);
  const like = `%${escaped}%`;
  const { data: hits } = await supabase
    .from('customers')
    .select('id, customer_number, name, kana, birth_date, gender, current_skill_level, total_participations, last_participation_at')
    .eq('is_deleted', false)
    .not('id', 'in', `(${excludeIds.join(',')})`)
    .or(`name.ilike.${like},kana.ilike.${like},customer_number.ilike.${like}`)
    .limit(20);
  searchResults = (hits ?? []) as any[];
}
---
<Base title={`${customer.name} — カルテ · ASMS`}>
  <main>
    <header class="hd">
      <div class="hd-nav">
        <a class="back" href="javascript:history.back()">← 前の画面に戻る</a>
        <a class="back back-alt" href="/admin/customers">顧客一覧へ</a>
      </div>
      <div class="hd-name">
        <h1>{customer.name}</h1>
        <span class="hd-kana">（{customer.kana}）</span>
      </div>
      <div class="hd-meta">
        <span class="hd-num">{customer.customer_number}</span>
        <span>{customer.birth_date} · {ageOn(customer.birth_date)}歳 · {genderJa(customer.gender)}</span>
      </div>
    </header>

    {msg && <div class="ok-banner">{msg}</div>}
    {err && <div class="err">{err}</div>}

    <section class="card level-card">
      <div class="card-h">
        <h2>🎯 現在の習熟度</h2>
        <div class="cur-level">{skillLabel(customer.current_skill_level)}</div>
      </div>

      <details>
        <summary>➕ 習熟度を変更</summary>
        <form method="post" class="prog-form">
          <input type="hidden" name="op" value="add_progression" />
          <input type="hidden" name="from_level" value={customer.current_skill_level} />
          <div class="field">
            <label>新しい習熟度 *</label>
            <select name="to_level" required>
              <option value="">— 選択 —</option>
              {SKILL_LEVELS.map((s) => (
                <option value={s.code} disabled={s.code === customer.current_skill_level}>
                  {s.emoji} {s.label}
                </option>
              ))}
            </select>
          </div>
          <div class="field">
            <label>理由（任意）</label>
            <input type="text" name="reason" maxlength="200"
              placeholder="例: 単独走行 5 周ミス無し達成、コーナリング安定" />
          </div>
          <button type="submit" class="btn btn-primary">習熟度を更新</button>
        </form>
      </details>

      {progressions && progressions.length > 0 && (
        <details class="prog-history">
          <summary>📈 習熟度履歴（{progressions.length}件）</summary>
          <ul class="timeline">
            {progressions.map((p: any) => (
              <li>
                <span class="tl-date mono">{p.changed_at?.slice(0, 10)}</span>
                <span class="tl-arrow">
                  {p.from_level ? <span class="tl-from">{skillLabel(p.from_level)}</span> : <span class="tl-from">（新規）</span>}
                  →
                  <span class="tl-to">{skillLabel(p.to_level)}</span>
                </span>
                {p.reason && <div class="tl-reason">{p.reason}</div>}
              </li>
            ))}
          </ul>
        </details>
      )}
    </section>

    <section class="card team-card">
      <h2>🏆 チーム加入 (funnel 最終段)</h2>
      <form method="post" class="team-form">
        <input type="hidden" name="op" value="set_team_member" />
        <div class="team-row">
          <label class="team-label">加入日 (空欄で解除)</label>
          <input type="date" name="team_member_since" value={(customer as any).team_member_since ?? ''} />
          <button type="submit" class="btn btn-primary">保存</button>
        </div>
        {(customer as any).team_member_since && (
          <p class="team-note">✅ チーム所属中 (加入: {(customer as any).team_member_since})</p>
        )}
      </form>
    </section>

    <section class="card">
      <h2>📝 スタッフメモ · 次回おすすめ</h2>
      <form method="post" class="notes-form">
        <input type="hidden" name="op" value="update_notes" />
        <div class="field">
          <label>スタッフメモ（体調・性格・注意事項など）</label>
          <textarea name="staff_notes" maxlength="1000" rows="3">{customer.staff_notes ?? ''}</textarea>
        </div>
        <div class="field">
          <label>次回おすすめ（当日申し送り）</label>
          <textarea name="next_recommendation" maxlength="500" rows="2">{customer.next_recommendation ?? ''}</textarea>
        </div>
        <button type="submit" class="btn btn-primary">メモを保存</button>
      </form>
    </section>

    <section class="card">
      <div class="card-h">
        <h2>⏱ ベストタイム</h2>
        <span class="c-sub">{bests?.length ?? 0}件</span>
      </div>

      {bests && bests.length > 0 && (
        <ul class="best-list">
          {bests.map((b: any) => (
            <li>
              <div class="best-l">
                <div class="best-type">{b.record_type}</div>
                <div class="best-time mono">{formatMs(b.value_ms)}</div>
              </div>
              <div class="best-r">
                {b.vehicle_name && <span class="best-vehicle">🚙 {b.vehicle_name}</span>}
                <span class="best-date mono">{b.recorded_at?.slice(0, 10)}</span>
                {b.note && <div class="best-note">{b.note}</div>}
              </div>
              <form method="post" class="best-del" onsubmit="return confirm('このタイム記録を削除しますか？');">
                <input type="hidden" name="op" value="delete_best" />
                <input type="hidden" name="best_id" value={b.id} />
                <button type="submit" class="del-btn" aria-label="削除">×</button>
              </form>
            </li>
          ))}
        </ul>
      )}

      <details>
        <summary>➕ タイムを追加</summary>
        <form method="post" class="best-form">
          <input type="hidden" name="op" value="add_best" />
          <div class="grid-2">
            <div class="field">
              <label>記録種別 *</label>
              <input type="text" name="record_type" required maxlength="40"
                placeholder="例: ベストラップ、5周合計" />
            </div>
            <div class="field">
              <label>車両（任意）</label>
              <input type="text" name="vehicle_name" maxlength="40"
                placeholder="例: ミニカート 3号車" />
            </div>
            <div class="field">
              <label>タイム（秒・小数点以下 3 桁）</label>
              <div class="time-row">
                <input type="number" name="seconds" min="0" max="999.999" step="0.001"
                  placeholder="例: 23.958" required />
                <span class="time-unit">秒</span>
              </div>
            </div>
            <div class="field">
              <label>メモ（任意）</label>
              <input type="text" name="note" maxlength="120" />
            </div>
          </div>
          <button type="submit" class="btn btn-primary">タイムを追加</button>
        </form>
      </details>
    </section>

    <section class="card">
      <div class="card-h">
        <h2>🏁 参加履歴</h2>
        <span class="c-sub">{participations?.length ?? 0}件</span>
      </div>

      {(!participations || participations.length === 0) ? (
        <p class="empty-inline">まだ参加履歴がありません。</p>
      ) : (
        <ul class="part-list">
          {participations.map((p: any) => {
            const r = p.reservations ?? {};
            const s = r.slots ?? {};
            const c = s.courses ?? {};
            return (
              <li>
                {s.id ? (
                  <a class="part-link" href={`/admin/slots/${s.id}`}>
                    <div class="part-l">
                      <div class="part-date mono">
                        {s.date ? jaDateShort(s.date) : '?'} {s.start_time?.slice(0, 5) ?? ''}
                      </div>
                      <div class="part-course">{c.name ?? ''}</div>
                    </div>
                    <div class="part-r">
                      <span class={`badge badge-${attendanceClass(p.attendance_status)}`}>
                        {attendanceLabel(p.attendance_status)}
                      </span>
                      <span class="part-meta mono">
                        {p.height_cm}cm · {p.age_at_booking}歳
                      </span>
                    </div>
                  </a>
                ) : (
                  <div class="part-link part-link-nolink">
                    <div class="part-l">
                      <div class="part-date mono">
                        {s.date ? jaDateShort(s.date) : '?'} {s.start_time?.slice(0, 5) ?? ''}
                      </div>
                      <div class="part-course">{c.name ?? ''}</div>
                    </div>
                    <div class="part-r">
                      <span class={`badge badge-${attendanceClass(p.attendance_status)}`}>
                        {attendanceLabel(p.attendance_status)}
                      </span>
                      <span class="part-meta mono">
                        {p.height_cm}cm · {p.age_at_booking}歳
                      </span>
                    </div>
                  </div>
                )}
              </li>
            );
          })}
        </ul>
      )}
    </section>

    <section class="card merge-search-card">
      <div class="card-h">
        <h2>🔍 別のカルテを検索して統合</h2>
        <span class="c-sub">自動候補に無い場合はここから探す</span>
      </div>
      <p class="merge-hint">
        自動候補（同姓・同カナ・同誕生日）に出てこない相手を、名前・カナ・顧客番号のあいまい検索で探して統合できます。
      </p>
      <form method="get" class="search-form">
        <input type="text" name="search" value={searchQ} maxlength="60"
               placeholder="名前 / カナ / 顧客番号（部分一致）"
               autocomplete="off" />
        <button type="submit" class="btn-search">検索</button>
        {searchQ && <a class="btn-clear" href={`/admin/customers/${id}`}>クリア</a>}
      </form>
      {searchQ && (
        searchResults.length === 0 ? (
          <p class="empty-inline">「{searchQ}」に一致するカルテは見つかりませんでした（自動候補と削除済みは除外）。</p>
        ) : (
          <ul class="cand-list">
            {searchResults.map((c: any) => (
              <li>
                <div class="cand-head">
                  <a class="cand-link" href={`/admin/customers/${c.id}`}>
                    <span class="cand-name">{c.name}</span>
                    <span class="cand-kana">（{c.kana}）</span>
                    <span class="cand-num">{c.customer_number}</span>
                  </a>
                </div>
                <div class="cand-meta">
                  <span>{c.birth_date} · {ageOn(c.birth_date)}歳 · {genderJa(c.gender)}</span>
                  <span class="mono">🏁 {c.total_participations}回</span>
                  <span>{skillLabel(c.current_skill_level)}</span>
                </div>
                <form method="post"
                      onsubmit={`return confirm('このカルテ (${customer.name} ${customer.customer_number}) を「${c.name} ${c.customer_number}」に統合します。よろしいですか？（元は削除フラグが立ちます）');`}>
                  <input type="hidden" name="op" value="merge_into" />
                  <input type="hidden" name="target_id" value={c.id} />
                  <button type="submit" class="btn-merge">← このカルテに統合</button>
                </form>
              </li>
            ))}
          </ul>
        )
      )}
    </section>

    {candidates.length > 0 && (
      <section class="card merge-card">
        <div class="card-h">
          <h2>🔗 統合候補（{candidates.length}件）</h2>
          <span class="c-sub">同姓・同カナ・同誕生日で自動抽出</span>
        </div>
        <p class="merge-hint">同一人物が複数のカルテに分かれている場合、下から「このカルテに統合」を選ぶと、参加履歴・習熟度履歴・ベストタイム・保護者リンクが統合先に集約されます。<strong>元のカルテは削除フラグが立ちます</strong>。</p>
        <ul class="cand-list">
          {candidates.map((c: any) => {
            const matches = [
              c.name === customer.name && '名前一致',
              c.kana === customer.kana && 'カナ一致',
              c.birth_date === customer.birth_date && '誕生日一致',
            ].filter(Boolean);
            return (
              <li>
                <div class="cand-head">
                  <a class="cand-link" href={`/admin/customers/${c.id}`}>
                    <span class="cand-name">{c.name}</span>
                    <span class="cand-kana">（{c.kana}）</span>
                    <span class="cand-num">{c.customer_number}</span>
                  </a>
                  <div class="cand-matches">
                    {matches.map((m) => <span class="match">{m}</span>)}
                  </div>
                </div>
                <div class="cand-meta">
                  <span>{c.birth_date} · {ageOn(c.birth_date)}歳 · {genderJa(c.gender)}</span>
                  <span class="mono">🏁 {c.total_participations}回</span>
                  <span>{skillLabel(c.current_skill_level)}</span>
                </div>
                <form method="post"
                      onsubmit={`return confirm('このカルテ (${customer.name} ${customer.customer_number}) を「${c.name} ${c.customer_number}」に統合します。よろしいですか？（元は削除フラグが立ちます）');`}>
                  <input type="hidden" name="op" value="merge_into" />
                  <input type="hidden" name="target_id" value={c.id} />
                  <button type="submit" class="btn-merge">← このカルテに統合</button>
                </form>
              </li>
            );
          })}
        </ul>
      </section>
    )}

    <section class="card">
      <div class="card-h">
        <h2>👤 保護者</h2>
      </div>
      {guardians.length === 0 ? (
        <p class="empty-inline">保護者情報が登録されていません。</p>
      ) : (
        <ul class="g-list">
          {guardians.map((g: any) => (
            <li>
              <div class="g-hd">
                <span class="g-name">{g.name}</span>
                <span class="g-kana">（{g.kana}）</span>
                {g.relation && <span class="g-rel">{g.relation}</span>}
                {g.is_primary && <span class="g-primary">主連絡先</span>}
              </div>
              <div class="g-contact">
                {g.phone && <span>📞 {g.phone}</span>}
                {g.email && <span>✉️ {g.email}</span>}
              </div>
              {g.address && <div class="g-addr">{g.address}</div>}
            </li>
          ))}
        </ul>
      )}
    </section>
  </main>
</Base>

