---
import Base from '@layouts/Base.astro';
import { envFrom, getSupabaseAdmin } from '@lib/supabase';

const env = envFrom(Astro.locals);
const supabase = getSupabaseAdmin(env);

// 各 cron の直近実行 1 件を取得。無ければ null。
// window.postgres がまだ 0028 で終わってれば cron_runs テーブルが無い可能性
// があるので、エラーは silently 握って cronStatus は空扱い。
type CronRow = {
  cron_name: string;
  started_at: string;
  finished_at: string | null;
  status: string;
  summary: any;
  error_message: string | null;
  duration_ms: number | null;
};
type CronMeta = {
  displayName: string;
  scheduleLabel: string;
  expectedIntervalHours: number; // 直近発火からこれ以上経ってたら赤
};
const CRON_LIST: Array<{ name: string; meta: CronMeta }> = [
  { name: 'thankyou-mail', meta: { displayName: '当日サンキュー', scheduleLabel: '毎日 18:00 JST', expectedIntervalHours: 30 } },
  { name: 'reminder-mail', meta: { displayName: '前日リマインド', scheduleLabel: '毎日 18:30 JST', expectedIntervalHours: 30 } },
  { name: 'followup-mail', meta: { displayName: '1ヶ月後フォロー', scheduleLabel: '毎日 19:00 JST', expectedIntervalHours: 30 } },
];

const latestByName = new Map<string, CronRow>();
try {
  const { data: rows } = await supabase
    .from('cron_runs')
    .select('cron_name, started_at, finished_at, status, summary, error_message, duration_ms')
    .in('cron_name', CRON_LIST.map((c) => c.name))
    .order('started_at', { ascending: false })
    .limit(50);
  for (const r of (rows ?? []) as CronRow[]) {
    if (!latestByName.has(r.cron_name)) latestByName.set(r.cron_name, r);
  }
} catch (_e) {
  // migration 未適用時などは無視 (cronStatus セクションが空表示になる)
}

function relTime(iso: string): string {
  const diffMs = Date.now() - new Date(iso).getTime();
  const diffMin = Math.floor(diffMs / 60000);
  if (diffMin < 1) return 'たった今';
  if (diffMin < 60) return `${diffMin} 分前`;
  const diffH = Math.floor(diffMin / 60);
  if (diffH < 24) return `${diffH} 時間前`;
  const diffD = Math.floor(diffH / 24);
  return `${diffD} 日前`;
}

function jstTime(iso: string): string {
  const d = new Date(iso);
  return new Intl.DateTimeFormat('ja-JP', {
    timeZone: 'Asia/Tokyo',
    month: '2-digit', day: '2-digit',
    hour: '2-digit', minute: '2-digit',
  }).format(d);
}
---
<Base title="管理 — 福岡キッズカートアカデミー">
  <main>
    <header class="hd">
      <h1>管理画面</h1>
      <p class="sub">福岡キッズカートアカデミー · ASMS</p>
    </header>

    <section class="cron-panel">
      <h2 class="cron-h">🤖 自動メールの動作状況</h2>
      <ul class="cron-list">
        {CRON_LIST.map(({ name, meta }) => {
          const last = latestByName.get(name);
          const hoursAgo = last ? (Date.now() - new Date(last.started_at).getTime()) / 3600000 : Infinity;
          const isStale = !last || hoursAgo > meta.expectedIntervalHours;
          const isError = last?.status === 'error';
          const state: 'ok' | 'warn' | 'err' = isError ? 'err' : (isStale ? 'warn' : 'ok');
          const sent = last?.summary?.sent ?? null;
          const total = last?.summary?.total ?? null;
          const failed = last?.summary?.failed ?? null;
          const note = last?.summary?.note ?? null;
          return (
            <li class={`cron-item cron-${state}`}>
              <div class="cron-line-1">
                <span class="cron-dot" aria-hidden="true" />
                <span class="cron-name">{meta.displayName}</span>
                <span class="cron-schedule">{meta.scheduleLabel}</span>
              </div>
              <div class="cron-line-2">
                {last ? (
                  <>
                    <span class="cron-when" title={jstTime(last.started_at)}>
                      最終実行 <strong>{relTime(last.started_at)}</strong>
                      <span class="cron-when-abs">（{jstTime(last.started_at)}）</span>
                    </span>
                    {last.status === 'success' && (
                      <span class="cron-summary">
                        {sent != null && <>送信 <strong>{sent}</strong>件</>}
                        {total != null && total > 0 && <> / 対象 {total}</>}
                        {failed != null && failed > 0 && <span class="cron-failed"> / 失敗 {failed}</span>}
                        {note && <span class="cron-note"> — {note}</span>}
                      </span>
                    )}
                    {last.status === 'error' && (
                      <span class="cron-err-msg">エラー: {last.error_message || '不明'}</span>
                    )}
                    {last.status === 'running' && (
                      <span class="cron-running">実行中...</span>
                    )}
                  </>
                ) : (
                  <span class="cron-never">まだ実行されていません</span>
                )}
              </div>
              <div class="cron-line-3">
                <button type="button" class="cron-retry" data-cron={name}
                        title="この cron を今すぐ手動実行 (?date=YYYY-MM-DD 指定可)">
                  ▶ 手動実行
                </button>
              </div>
            </li>
          );
        })}
      </ul>
      <p class="cron-help">
        <strong class="cron-ok">🟢 緑</strong>= 正常 ·
        <strong class="cron-warn">🟡 黄</strong>= 半日以上動いていない ·
        <strong class="cron-err">🔴 赤</strong>= 前回エラー
      </p>
    </section>

    <script>
      // 「手動実行」ボタン: /api/admin/cron-retry を叩いて cron を即実行。
      // 日付未指定なら「今日」扱い。事故時の再送 (?date=YYYY-MM-DD) にも対応。
      document.querySelectorAll<HTMLButtonElement>('button.cron-retry').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const cron = btn.dataset.cron || '';
          if (!cron) return;
          const dateInput = prompt(
            `${cron} を手動実行します。\n` +
            `対象日を YYYY-MM-DD 形式で入力 (空欄=今日)。\n` +
            `例: 2026-08-29`,
            ''
          );
          if (dateInput === null) return; // cancel
          const date = dateInput.trim();
          if (date && !/^\d{4}-\d{2}-\d{2}$/.test(date)) {
            alert('日付形式が不正です (YYYY-MM-DD)');
            return;
          }
          btn.disabled = true;
          const orig = btn.textContent;
          btn.textContent = '実行中...';
          try {
            const r = await fetch('/api/admin/cron-retry', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ cron, date: date || undefined }),
            });
            const body = await r.json().catch(() => ({}));
            if (r.ok) {
              alert(
                `✅ ${cron} 実行完了\n\n` +
                JSON.stringify(body, null, 2).slice(0, 800)
              );
              location.reload();
            } else {
              alert(`❌ 失敗 (${r.status}):\n${body?.error || JSON.stringify(body).slice(0, 300)}`);
            }
          } catch (e: any) {
            alert(`❌ 通信エラー: ${e?.message || e}`);
          } finally {
            btn.disabled = false;
            btn.textContent = orig;
          }
        });
      });
    </script>

    <div class="grid">
      <a class="card" href="/admin/schedule">
        <div class="ico">📅</div>
        <div class="ct">
          <h2>スケジュール管理</h2>
          <p>月次スロット生成・例外日設定</p>
        </div>
        <div class="arrow">→</div>
      </a>
      <a class="card" href="/admin/reservations">
        <div class="ico">📋</div>
        <div class="ct">
          <h2>予約一覧</h2>
          <p>直近・今日の予約 · 参加者チェックイン</p>
        </div>
        <div class="arrow">→</div>
      </a>
      <a class="card" href="/admin/customers">
        <div class="ico">👥</div>
        <div class="ct">
          <h2>顧客カルテ</h2>
          <p>参加履歴・習熟度・ベストタイム・スタッフメモ</p>
        </div>
        <div class="arrow">→</div>
      </a>
      <a class="card" href="/admin/sales">
        <div class="ico">💰</div>
        <div class="ct">
          <h2>売上集計</h2>
          <p>月次売上・支払い方法別内訳・明細</p>
        </div>
        <div class="arrow">→</div>
      </a>
      <a class="card" href="/admin/courses">
        <div class="ico">⚙️</div>
        <div class="ct">
          <h2>コース設定</h2>
          <p>料金・時間・定員・車両・表示順を編集</p>
        </div>
        <div class="arrow">→</div>
      </a>
    </div>

    <footer class="ft">
      <a href="/">← サイトトップへ</a>
    </footer>
  </main>
</Base>

<style>
  main { max-width: 640px; margin: 0 auto; padding: 1.5rem 1.25rem 3rem; }
  .hd {
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
    margin-bottom: 1.5rem;
  }
  h1 { margin: 0 0 .3rem; font-size: 1.6rem; font-weight: 800; }
  .sub { margin: 0; color: var(--ink-2); font-size: .82rem; }

  .grid { display: flex; flex-direction: column; gap: .7rem; }
  .card {
    display: flex;
    align-items: center;
    gap: .9rem;
    padding: 1rem 1.2rem;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 12px;
    text-decoration: none;
    color: var(--ink);
    transition: transform .1s, box-shadow .15s;
  }
  a.card:hover { transform: translateY(-1px); box-shadow: 0 4px 12px rgba(58,169,232,.15); }
  a.card:active { transform: translateY(1px); }
  .card.disabled { opacity: .5; cursor: not-allowed; }
  .ico { font-size: 1.6rem; }
  .ct { flex: 1; }
  .ct h2 { margin: 0; font-size: .95rem; font-weight: 800; }
  .ct p { margin: .2rem 0 0; color: var(--ink-3); font-size: .75rem; }
  .ct .soon {
    font-family: var(--mono);
    font-size: .58rem;
    padding: 1px 6px;
    background: var(--bg-3);
    color: var(--ink-3);
    border-radius: 4px;
    margin-left: .4rem;
    vertical-align: 2px;
    font-weight: 700;
  }
  .arrow { color: var(--ink-3); font-size: 1.1rem; }
  .ft { margin-top: 2rem; text-align: center; font-size: .74rem; }
  .ft a { color: var(--sky-deep); text-decoration: none; }

  /* --- Cron status panel ---------------------------------------------- */
  .cron-panel {
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 1rem 1.15rem;
    margin-bottom: 1.5rem;
  }
  .cron-h {
    margin: 0 0 .8rem;
    font-size: .8rem;
    font-weight: 800;
    color: var(--sky-deep);
    letter-spacing: .04em;
    text-transform: uppercase;
  }
  .cron-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: .5rem; }
  .cron-item {
    padding: .6rem .8rem;
    border-radius: 8px;
    border-left: 4px solid var(--line);
    background: var(--bg-2);
  }
  .cron-item.cron-ok { border-left-color: var(--lime-deep); background: rgba(164,214,94,.08); }
  .cron-item.cron-warn { border-left-color: var(--sun); background: rgba(255,201,67,.12); }
  .cron-item.cron-err { border-left-color: var(--rose-deep); background: rgba(229,85,111,.12); }
  .cron-line-1 { display: flex; align-items: baseline; gap: .5rem; flex-wrap: wrap; }
  .cron-dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; }
  .cron-ok .cron-dot { background: var(--lime-deep); }
  .cron-warn .cron-dot { background: var(--sun); }
  .cron-err .cron-dot { background: var(--rose-deep); }
  .cron-name { font-weight: 800; font-size: .85rem; }
  .cron-schedule { font-size: .68rem; color: var(--ink-3); font-family: var(--mono); }
  .cron-line-2 { margin-top: .3rem; font-size: .74rem; color: var(--ink-2); display: flex; flex-wrap: wrap; gap: .4rem; align-items: baseline; }
  .cron-when strong { color: var(--ink); }
  .cron-when-abs { color: var(--ink-4); font-size: .68rem; font-family: var(--mono); }
  .cron-summary { color: var(--ink-2); }
  .cron-summary strong { color: var(--ink); font-family: var(--mono); }
  .cron-failed { color: var(--rose-deep); font-weight: 700; }
  .cron-note { color: var(--ink-3); font-style: italic; }
  .cron-line-3 { margin-top: .4rem; }
  .cron-retry {
    padding: .3rem .7rem; font-size: .72rem; font-weight: 700;
    background: var(--bg); color: var(--ink-2);
    border: 1px solid var(--line); border-radius: 100px;
    cursor: pointer; font-family: var(--jp);
  }
  .cron-retry:hover:not(:disabled) {
    background: var(--sky-mist); color: var(--sky-deep);
    border-color: var(--sky);
  }
  .cron-retry:disabled { opacity: .5; cursor: wait; }
  .cron-err-msg { color: var(--rose-deep); font-weight: 700; font-size: .72rem; }
  .cron-running { color: var(--sky-deep); font-weight: 700; }
  .cron-never { color: var(--ink-3); font-style: italic; }
  .cron-help {
    margin: .8rem 0 0;
    font-size: .68rem;
    color: var(--ink-3);
    line-height: 1.6;
  }
  .cron-help .cron-ok { color: var(--lime-deep); background: none; padding: 0; }
  .cron-help .cron-warn { color: var(--orange-deep); background: none; padding: 0; }
  .cron-help .cron-err { color: var(--rose-deep); background: none; padding: 0; }
</style>
