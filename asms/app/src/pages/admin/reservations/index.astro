---
import Base from '@layouts/Base.astro';
import { envFrom, getSupabaseAdmin } from '@lib/supabase';
import { jaDateShort, attendanceLabel, attendanceClass } from '@lib/admin';

const env = envFrom(Astro.locals);
const supabase = getSupabaseAdmin(env);

const url = new URL(Astro.request.url);
const scope = url.searchParams.get('scope') ?? 'upcoming'; // upcoming | today | past
const search = (url.searchParams.get('q') ?? '').trim();
const dateFilter = (url.searchParams.get('date') ?? '').trim(); // YYYY-MM-DD
const ymParam = (url.searchParams.get('ym') ?? '').trim();     // YYYY-MM (calendar month)

// JST の「今日」を取る。UTC ベースの toISOString だと 00:00-08:59 JST の
// あいだ「昨日」の日付になり、カレンダーの「本日」ハイライトが 1 日ずれる。
const today = new Intl.DateTimeFormat('en-CA', {
  timeZone: 'Asia/Tokyo',
  year: 'numeric', month: '2-digit', day: '2-digit',
}).format(new Date());

// Determine which month to show in calendar (default = current month,
// or the month containing dateFilter, or ymParam).
function ymOf(iso: string) { return iso.slice(0, 7); }
const now = new Date();
const defaultYm = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}`;
const calYm = /^\d{4}-\d{2}$/.test(ymParam) ? ymParam
  : (dateFilter ? ymOf(dateFilter) : defaultYm);
const [calYearS, calMonthS] = calYm.split('-');
const calYear = parseInt(calYearS, 10);
const calMonth = parseInt(calMonthS, 10);

// Fetch reservation counts per day for the calendar month
const monthStart = `${calYm}-01`;
const nextMonth = new Date(calYear, calMonth, 1);
const monthEndExcl = `${nextMonth.getFullYear()}-${String(nextMonth.getMonth() + 1).padStart(2, '0')}-01`;

// スロット情報 (全ステータス) + 予約参加者数を日別集計
const { data: monthSlotRows } = await supabase
  .from('slots')
  .select('id, date, capacity, status, weather_condition')
  .gte('date', monthStart)
  .lt('date', monthEndExcl);

const slotIdsForMonth = (monthSlotRows ?? []).map((s: any) => s.id);
const monthResBySlot = new Map<string, number>(); // slot_id → active participant count
if (slotIdsForMonth.length > 0) {
  const { data: resRows } = await supabase
    .from('reservations')
    .select('id, slot_id, status, reservation_participants(id, attendance_status)')
    .in('slot_id', slotIdsForMonth)
    .neq('status', 'cancelled');
  for (const r of (resRows ?? []) as any[]) {
    const activeParts = ((r.reservation_participants as any[]) ?? [])
      .filter((p) => p.attendance_status !== 'cancelled');
    const cur = monthResBySlot.get(r.slot_id) ?? 0;
    monthResBySlot.set(r.slot_id, cur + activeParts.length);
  }
}

// 日別サマリー: {slots数, 合計定員, 合計予約, 天候, 状態別スロット数}
type DailySummary = {
  slotCount: number;
  totalCapacity: number;
  totalReserved: number;
  openCount: number;
  closedCount: number;
  cancelledCount: number;
  weathers: string[]; // sunny/cloudy/... の集合
};
const dailySummary = new Map<string, DailySummary>();
for (const s of (monthSlotRows ?? []) as any[]) {
  const d = s.date;
  if (!d) continue;
  const cur = dailySummary.get(d) ?? {
    slotCount: 0, totalCapacity: 0, totalReserved: 0,
    openCount: 0, closedCount: 0, cancelledCount: 0, weathers: [],
  };
  cur.slotCount++;
  cur.totalCapacity += Number(s.capacity ?? 0);
  cur.totalReserved += monthResBySlot.get(s.id) ?? 0;
  if (s.status === 'open') cur.openCount++;
  else if (s.status === 'closed') cur.closedCount++;
  else if (s.status === 'cancelled') cur.cancelledCount++;
  if (s.weather_condition && !cur.weathers.includes(s.weather_condition)) {
    cur.weathers.push(s.weather_condition);
  }
  dailySummary.set(d, cur);
}

function weatherEmoji(cond: string): string {
  return ({
    sunny: '☀️',
    cloudy: '☁️',
    cloudy_then_rain: '☁️🌧',
    rain: '🌧',
    rain_then_cloudy: '🌧☁️',
    other: '⚡',
  } as Record<string, string>)[cond] ?? '';
}

// 日付絞込中なら、その日のスロット一覧を取得 (時刻順・コース情報付き)
type DaySlot = {
  id: string;
  start_time: string;
  end_time: string | null;
  capacity: number;
  status: string;
  weather_condition: string | null;
  temperature_c: number | null;
  weather_note: string | null;
  course_name: string;
  activeReserved: number;
  cancelledReserved: number;
};
let daySlots: DaySlot[] = [];
if (dateFilter) {
  const { data: rawSlots } = await supabase
    .from('slots')
    .select('id, start_time, end_time, capacity, status, weather_condition, temperature_c, weather_note, courses(name)')
    .eq('date', dateFilter)
    .order('start_time');
  const idsToday = (rawSlots ?? []).map((s: any) => s.id);
  const activeMap = new Map<string, number>();
  const cancelMap = new Map<string, number>();
  if (idsToday.length > 0) {
    const { data: rows } = await supabase
      .from('reservations')
      .select('slot_id, status, reservation_participants(id, attendance_status)')
      .in('slot_id', idsToday)
      .neq('status', 'cancelled');
    for (const r of (rows ?? []) as any[]) {
      const parts = ((r.reservation_participants as any[]) ?? []);
      const active = parts.filter((p) => p.attendance_status !== 'cancelled').length;
      const cancelled = parts.filter((p) => p.attendance_status === 'cancelled').length;
      activeMap.set(r.slot_id, (activeMap.get(r.slot_id) ?? 0) + active);
      cancelMap.set(r.slot_id, (cancelMap.get(r.slot_id) ?? 0) + cancelled);
    }
  }
  daySlots = ((rawSlots ?? []) as any[]).map((s) => ({
    id: s.id,
    start_time: s.start_time,
    end_time: s.end_time,
    capacity: s.capacity,
    status: s.status,
    weather_condition: s.weather_condition,
    temperature_c: s.temperature_c,
    weather_note: s.weather_note,
    course_name: s.courses?.name ?? '',
    activeReserved: activeMap.get(s.id) ?? 0,
    cancelledReserved: cancelMap.get(s.id) ?? 0,
  }));
}

// Build calendar cells (月曜始まり)
const firstDay = new Date(calYear, calMonth - 1, 1);
// getDay() は Sun=0..Sat=6。(+6)%7 で Mon=0..Sun=6 にシフト。
const startPad = (firstDay.getDay() + 6) % 7;
const daysInMonth = new Date(calYear, calMonth, 0).getDate();
type CalCell = {
  date: string | null;
  day: number | null;
  isToday: boolean;
  summary: DailySummary | null;
};
const cells: CalCell[] = [];
for (let i = 0; i < startPad; i++) cells.push({ date: null, day: null, isToday: false, summary: null });
for (let d = 1; d <= daysInMonth; d++) {
  const iso = `${calYm}-${String(d).padStart(2, '0')}`;
  cells.push({
    date: iso,
    day: d,
    isToday: iso === today,
    summary: dailySummary.get(iso) ?? null,
  });
}
while (cells.length % 7 !== 0) cells.push({ date: null, day: null, isToday: false, summary: null });

const prevMonthDate = new Date(calYear, calMonth - 2, 1);
const nextMonthDate = new Date(calYear, calMonth, 1);
const prevYm = `${prevMonthDate.getFullYear()}-${String(prevMonthDate.getMonth() + 1).padStart(2, '0')}`;
const nextYm = `${nextMonthDate.getFullYear()}-${String(nextMonthDate.getMonth() + 1).padStart(2, '0')}`;

// Query reservations. Join to slot for date + course, guardian for name,
// and count participants via a nested select.
let query = supabase
  .from('reservations')
  .select(`
    id, reservation_number, status, price_tier, total_amount, created_at,
    slots(id, date, start_time, end_time, courses(name, code)),
    guardians(name, kana, phone, email),
    reservation_participants(id, name_snapshot, age_at_booking, height_cm, attendance_status)
  `)
  .order('created_at', { ascending: false })
  .limit(200);

// Search overrides scope entirely
if (search) {
  // Look for guardian name/phone/email or reservation_number match
  const like = `%${search}%`;
  query = query.or(`reservation_number.ilike.${like}`);
}

const { data: reservationsRaw, error } = await query;
type Reservation = NonNullable<typeof reservationsRaw>[number];
let reservations = (reservationsRaw ?? []) as Reservation[];

// Client-side filtering for guardian/participant name (Supabase doesn't
// easily support joined-table ilike in a single query without RPCs).
if (search) {
  const q = search.toLowerCase();
  reservations = reservations.filter((r: any) =>
    r.reservation_number?.toLowerCase().includes(q) ||
    r.guardians?.name?.toLowerCase().includes(q) ||
    r.guardians?.kana?.toLowerCase().includes(q) ||
    r.guardians?.phone?.replace(/[^0-9]/g, '').includes(q.replace(/[^0-9]/g, '')) ||
    r.guardians?.email?.toLowerCase().includes(q) ||
    (r.reservation_participants ?? []).some((p: any) =>
      p.name_snapshot?.toLowerCase().includes(q))
  );
} else if (dateFilter) {
  reservations = reservations.filter((r: any) => (r.slots as any)?.date === dateFilter);
} else if (scope === 'today') {
  reservations = reservations.filter((r: any) => (r.slots as any)?.date === today);
} else if (scope === 'upcoming') {
  reservations = reservations.filter((r: any) => (r.slots as any)?.date >= today);
} else if (scope === 'past') {
  reservations = reservations.filter((r: any) => (r.slots as any)?.date < today);
}

const statusLabel: Record<string, string> = {
  draft: '下書き',
  pending_approval: '承認待ち',
  confirmed: '確定',
  attended: '出席済み',
  no_show: '無断欠席',
  cancelled: 'キャンセル',
};
const statusColor: Record<string, string> = {
  pending_approval: 'pending',
  confirmed: 'confirmed',
  attended: 'attended',
  no_show: 'noshow',
  cancelled: 'cancelled',
  draft: 'muted',
};
---
<Base title="予約一覧 — ASMS">
  <main>
    <header class="hd">
      <a class="back" href="/admin">← 管理トップ</a>
      <h1>予約一覧</h1>
      <p class="sub">全予約 · 直近200件</p>
    </header>

    <section class="cal-card">
      <div class="cal-hd">
        <a class="cal-nav" href={`/admin/reservations?ym=${prevYm}`}>← {prevYm}</a>
        <span class="cal-title">{calYear}年{calMonth}月</span>
        <a class="cal-nav" href={`/admin/reservations?ym=${nextYm}`}>{nextYm} →</a>
      </div>
      <div class="cal-grid">
        <div class="cal-dow">月</div>
        <div class="cal-dow">火</div>
        <div class="cal-dow">水</div>
        <div class="cal-dow">木</div>
        <div class="cal-dow">金</div>
        <div class="cal-dow dow-sat">土</div>
        <div class="cal-dow dow-sun">日</div>
        {cells.map((c) => {
          if (!c.date) return <div class="cal-cell empty"></div>;
          const s = c.summary;
          const hasSlots = !!s && s.slotCount > 0;
          const allCancelled = hasSlots && s.cancelledCount === s.slotCount;
          const fillPct = hasSlots && s.totalCapacity > 0
            ? Math.round((s.totalReserved / s.totalCapacity) * 100)
            : 0;
          const isFull = hasSlots && fillPct >= 100;
          const classes = [
            'cal-cell',
            hasSlots && s.totalReserved > 0 ? 'has-res' : '',
            hasSlots ? 'has-slots' : 'no-slots',
            allCancelled ? 'all-cancelled' : '',
            isFull ? 'is-full' : '',
            c.isToday ? 'today' : '',
            dateFilter === c.date ? 'selected' : '',
          ].filter(Boolean).join(' ');
          return (
            <a class={classes} href={`/admin/reservations?date=${c.date}&ym=${calYm}`}>
              <span class="cal-day">{c.day}</span>
              {hasSlots && (
                <>
                  <span class="cal-slots">{s.slotCount}枠</span>
                  {allCancelled ? (
                    <span class="cal-badge cancelled">中止</span>
                  ) : (
                    <>
                      <span class={`cal-fill ${isFull ? 'full' : fillPct >= 80 ? 'high' : fillPct >= 50 ? 'mid' : 'low'}`}>
                        {s.totalReserved}/{s.totalCapacity}
                      </span>
                      {s.weathers.length > 0 && (
                        <span class="cal-weather">{s.weathers.map(weatherEmoji).join('')}</span>
                      )}
                    </>
                  )}
                </>
              )}
            </a>
          );
        })}
      </div>
      <div class="cal-legend">
        <span><span class="lg-dot lg-low"></span>空きあり</span>
        <span><span class="lg-dot lg-mid"></span>半分</span>
        <span><span class="lg-dot lg-high"></span>残少</span>
        <span><span class="lg-dot lg-full"></span>満席</span>
        <span><span class="lg-dot lg-cancel"></span>中止</span>
      </div>
      {dateFilter && (
        <div class="cal-filter-info">
          📌 <strong>{dateFilter}</strong> の予約を表示中
          <a href={`/admin/reservations?scope=${scope}&ym=${calYm}`} class="cal-clear">絞込解除</a>
        </div>
      )}
    </section>

    {dateFilter && daySlots.length > 0 && (
      <section class="day-slots">
        <h2>📆 {dateFilter} のスロット ({daySlots.length}枠)</h2>
        {daySlots.some((s) => s.weather_condition || s.temperature_c || s.weather_note) && (
          <div class="ds-weather-line">
            🌤 {daySlots.map((s) => {
              const parts: string[] = [];
              if (s.weather_condition) {
                const emoji = ({
                  sunny: '☀️', cloudy: '☁️', cloudy_then_rain: '☁️🌧',
                  rain: '🌧', rain_then_cloudy: '🌧☁️', other: '⚡',
                } as any)[s.weather_condition] ?? '';
                const label = ({
                  sunny: '晴れ', cloudy: '曇り', cloudy_then_rain: '曇りのち雨',
                  rain: '雨', rain_then_cloudy: '雨のち曇り', other: 'その他',
                } as any)[s.weather_condition] ?? '';
                parts.push(`${emoji}${label}`);
              }
              if (s.temperature_c != null) parts.push(`${s.temperature_c}°C`);
              return parts.length > 0 ? `${s.start_time.slice(0,5)} ${parts.join(' ')}` : null;
            }).filter(Boolean).join(' · ')}
          </div>
        )}
        <ul class="ds-list">
          {daySlots.map((s) => {
            const isCancelled = s.status === 'cancelled';
            const isClosed = s.status === 'closed';
            const isOpen = s.status === 'open';
            const remaining = Math.max(0, s.capacity - s.activeReserved);
            const fillPct = s.capacity > 0 ? Math.round((s.activeReserved / s.capacity) * 100) : 0;
            const isFull = remaining === 0 && s.activeReserved > 0;
            return (
              <li class={`ds-item ${isCancelled ? 'is-cancel' : isClosed ? 'is-closed' : ''} ${isFull ? 'is-full' : ''}`}>
                <a class="ds-link" href={`/admin/slots/${s.id}`}>
                  <div class="ds-head">
                    <span class="ds-time mono">{s.start_time.slice(0,5)}{s.end_time ? '–' + s.end_time.slice(0,5) : ''}</span>
                    <span class="ds-course">{s.course_name}</span>
                    <span class={`ds-status ${isOpen ? 'st-open' : isClosed ? 'st-closed' : 'st-cancel'}`}>
                      {isOpen ? '🟢 受付中' : isClosed ? '🟡 停止' : '🔴 中止'}
                    </span>
                  </div>
                  <div class="ds-meta">
                    <span>定員 <strong>{s.capacity}</strong></span>
                    {!isCancelled && (
                      <>
                        <span>予約 <strong>{s.activeReserved}</strong></span>
                        <span class={`ds-fill fill-${isFull ? 'full' : fillPct >= 80 ? 'high' : fillPct >= 50 ? 'mid' : 'low'}`}>
                          残 {remaining}
                        </span>
                        {s.cancelledReserved > 0 && (
                          <span class="ds-cancel-count">キャンセル {s.cancelledReserved}</span>
                        )}
                      </>
                    )}
                    <span class="ds-arrow">詳細 →</span>
                  </div>
                </a>
              </li>
            );
          })}
        </ul>
      </section>
    )}

    {dateFilter && daySlots.length === 0 && (
      <div class="ds-empty">
        📭 {dateFilter} には開催スロットが生成されていません。
      </div>
    )}

    <div class="toolbar">
      <div class="scope-tabs">
        <a class={`tab ${scope === 'upcoming' && !search && !dateFilter ? 'active' : ''}`} href="/admin/reservations?scope=upcoming">📆 今後</a>
        <a class={`tab ${scope === 'today' && !search && !dateFilter ? 'active' : ''}`} href="/admin/reservations?scope=today">🎯 本日</a>
        <a class={`tab ${scope === 'past' && !search && !dateFilter ? 'active' : ''}`} href="/admin/reservations?scope=past">📜 過去</a>
      </div>
      <form class="search" method="get">
        <input type="hidden" name="scope" value={scope} />
        <input type="search" name="q" placeholder="🔍 予約番号・保護者名・電話・参加者名" value={search} />
        <button type="submit" class="btn-search">検索</button>
      </form>
    </div>

    {error && <div class="err">{error.code} {error.message}</div>}

    {reservations.length === 0 ? (
      <p class="empty">
        {search
          ? `「${search}」に一致する予約はありません。`
          : scope === 'today' ? '本日の予約はありません。'
          : scope === 'upcoming' ? '今後の予約はありません。'
          : '過去の予約はありません。'}
      </p>
    ) : (
      <ul class="res-list">
        {reservations.map((r: any) => {
          const slot = r.slots ?? {};
          const guardian = r.guardians ?? {};
          const parts = r.reservation_participants ?? [];
          return (
            <li class="res-card">
              <a class="res-link" href={`/admin/slots/${slot.id}`}>
                <div class="res-row-1">
                  <span class={`badge badge-${statusColor[r.status] ?? 'muted'}`}>
                    {statusLabel[r.status] ?? r.status}
                  </span>
                  <span class="res-num">{r.reservation_number}</span>
                </div>
                <div class="res-row-2">
                  <span class="res-date">{slot.date ? jaDateShort(slot.date) : '?'}</span>
                  <span class="res-time">{slot.start_time?.slice(0, 5) ?? ''}</span>
                  <span class="res-course">{slot.courses?.name ?? ''}</span>
                </div>
                <div class="res-row-3">
                  <span class="res-guardian">👤 {guardian.name}</span>
                  <span class="res-parts">
                    {parts.map((p: any, i: number) => {
                      const bits: string[] = [];
                      if (p.age_at_booking != null) bits.push(`${p.age_at_booking}歳`);
                      if (p.height_cm != null) bits.push(`${p.height_cm}cm`);
                      const meta = bits.length ? ` (${bits.join(' / ')})` : '';
                      return `${p.name_snapshot}${meta}${i < parts.length - 1 ? '・' : ''}`;
                    }).join('')} ({parts.length}名)
                  </span>
                </div>
                <div class="res-row-4">
                  <span class="res-amount">¥{(r.total_amount ?? 0).toLocaleString()}</span>
                  <span class="res-tier">{r.price_tier === 'member' ? '会員' : '一般'}</span>
                </div>
              </a>
            </li>
          );
        })}
      </ul>
    )}
  </main>
</Base>

<style>
  main { max-width: 900px; margin: 0 auto; padding: 1.5rem 1.25rem 3rem; }
  .hd { padding-bottom: 1rem; border-bottom: 1px solid var(--line); margin-bottom: 1.2rem; }
  .back { display: inline-block; font-size: .78rem; color: var(--ink-3); text-decoration: none; margin-bottom: .4rem; }
  h1 { margin: 0 0 .3rem; font-size: 1.5rem; font-weight: 800; }
  .sub { margin: 0; color: var(--ink-2); font-size: .82rem; }

  .cal-card {
    background: var(--bg); border: 1px solid var(--line);
    border-radius: 12px; padding: .8rem 1rem;
    margin-bottom: 1rem;
  }
  .cal-hd {
    display: flex; justify-content: space-between; align-items: center;
    margin-bottom: .6rem;
  }
  .cal-title { font-weight: 800; font-size: .95rem; }
  .cal-nav {
    padding: .3rem .7rem; font-size: .74rem; font-weight: 700;
    color: var(--sky-deep); text-decoration: none;
    border: 1px solid var(--line); border-radius: 6px;
  }
  .cal-nav:hover { background: var(--sky-mist); }
  .cal-grid {
    display: grid; grid-template-columns: repeat(7, 1fr);
    gap: 2px;
  }
  .cal-dow {
    text-align: center; font-size: .68rem; font-weight: 700;
    color: var(--ink-3); padding: .3rem 0;
  }
  .cal-dow.dow-sun { color: var(--rose-deep); }
  .cal-dow.dow-sat { color: var(--sky-deep); }
  .cal-cell {
    min-height: 68px;
    display: flex; flex-direction: column; align-items: stretch; justify-content: flex-start;
    padding: 3px 2px;
    background: var(--bg-2); border: 1px solid transparent;
    border-radius: 6px; text-decoration: none; color: var(--ink);
    font-size: .68rem;
    position: relative;
    transition: background .1s;
    overflow: hidden;
  }
  .cal-cell:hover { background: var(--bg-3); }
  .cal-cell.empty { background: transparent; pointer-events: none; }
  .cal-day {
    font-weight: 800; font-family: var(--mono);
    font-size: .8rem; text-align: center;
  }
  .cal-slots {
    text-align: center; font-size: .6rem;
    color: var(--ink-3); font-family: var(--mono);
    margin-top: 1px;
  }
  .cal-fill {
    text-align: center; font-size: .6rem; font-weight: 800;
    font-family: var(--mono); margin-top: 1px;
    padding: 1px 4px; border-radius: 100px;
  }
  .cal-fill.low { background: rgba(164,214,94,.2); color: var(--lime-deep); }
  .cal-fill.mid { background: rgba(58,169,232,.2); color: var(--sky-deep); }
  .cal-fill.high { background: rgba(255,201,67,.25); color: var(--orange-deep); }
  .cal-fill.full { background: rgba(229,85,111,.2); color: var(--rose-deep); }
  .cal-badge {
    text-align: center; font-size: .58rem; font-weight: 800;
    padding: 1px 5px; border-radius: 100px; margin-top: 1px;
  }
  .cal-badge.cancelled { background: var(--bg-3); color: var(--ink-3); }
  .cal-weather { text-align: center; font-size: .7rem; line-height: 1; }
  .cal-cell.no-slots { opacity: .5; }
