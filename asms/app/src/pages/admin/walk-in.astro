---
import Base from '@layouts/Base.astro';
import { envFrom, getSupabaseAdmin } from '@lib/supabase';
import { getLocaleFromRequest, type Locale } from '@lib/i18n';

export const prerender = false;

// =============================================================================
// /admin/walk-in
// -----------------------------------------------------------------------------
// 当日飛び込み来場者の予約を作る前段。今日のスロット一覧を大きなボタンで出し、
// どこに追加するかスタッフが選ぶ。選ぶと /admin/walk-in/[slotId] に遷移。
//
// 対象スロット: 今日の開催 (status != 'cancelled')。
// 空席が無くてもリスト表示だけはする (稀に追加枠を切るケースあり)。
// =============================================================================

const env = envFrom(Astro.locals);
const supabase = getSupabaseAdmin(env);
const locale: Locale = getLocaleFromRequest(Astro.request);
const isEn = locale === 'en';
const tr = (jp: string, en: string) => isEn ? en : jp;

// 今日の日付 (JST)
const nowJst = new Date(Date.now() + 9 * 3600 * 1000);
const todayStr = `${nowJst.getUTCFullYear()}-${String(nowJst.getUTCMonth() + 1).padStart(2, '0')}-${String(nowJst.getUTCDate()).padStart(2, '0')}`;

// クエリで日付指定可 (?date=YYYY-MM-DD)
const url = new URL(Astro.request.url);
const dateParam = url.searchParams.get('date') || '';
const targetDate = /^\d{4}-\d{2}-\d{2}$/.test(dateParam) ? dateParam : todayStr;

const { data: slots, error } = await supabase
  .from('slots')
  .select(`
    id, date, start_time, end_time, capacity, status,
    courses(code, name, price_regular, price_member),
    reservation_participants:reservations(reservation_participants(id, attendance_status))
  `)
  .eq('date', targetDate)
  .neq('status', 'cancelled')
  .order('start_time', { ascending: true });

if (error) {
  return new Response(`slots fetch error: ${error.message}`, { status: 500 });
}

// 参加者数集計
function countActive(slot: any): number {
  const nests: any[] = slot.reservation_participants ?? [];
  let n = 0;
  for (const r of nests) {
    const parts = r.reservation_participants ?? [];
    for (const p of parts) {
      if (p.attendance_status !== 'cancelled') n++;
    }
  }
  return n;
}

// 日付ナビ
function shiftDate(iso: string, days: number): string {
  const d = new Date(iso + 'T00:00:00');
  d.setDate(d.getDate() + days);
  return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
}
const prevDate = shiftDate(targetDate, -1);
const nextDate = shiftDate(targetDate, +1);

const weekdayJa = ['日','月','火','水','木','金','土'];
const weekdayEn = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
const d = new Date(targetDate + 'T00:00:00');
const dateLabel = isEn
  ? `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')} (${weekdayEn[d.getDay()]})`
  : `${d.getFullYear()}年${d.getMonth()+1}月${d.getDate()}日 (${weekdayJa[d.getDay()]})`;
---
<Base
  title={tr(`飛び込み受付 — ${dateLabel}`, `Walk-in — ${dateLabel}`)}
  lang={locale}
  showLocaleSwitch={true}
>
  <main class="wi">
    <nav class="back">
      <a href="/admin">← {tr('管理トップ', 'Admin')}</a>
    </nav>

    <h1>{tr('🏃 飛び込み受付', '🏃 Walk-in Check-in')}</h1>

    <section class="date-nav">
      <a class="d-btn" href={`/admin/walk-in?date=${prevDate}`}>← {tr('前日', 'Prev')}</a>
      <div class="d-cur">{dateLabel}</div>
      <a class="d-btn" href={`/admin/walk-in?date=${nextDate}`}>{tr('翌日', 'Next')} →</a>
    </section>

    {targetDate !== todayStr && (
      <p class="warn">
        ⚠️ {tr('今日以外の日付を表示しています', 'Showing a day other than today')}
        · <a href={`/admin/walk-in?date=${todayStr}`}>{tr('今日に戻る', 'Jump to today')}</a>
      </p>
    )}

    <h2>{tr('スロットを選んで追加する', 'Pick a slot to add a reservation')}</h2>

    {(!slots || slots.length === 0) ? (
      <p class="empty">{tr('この日は開催スロットがありません', 'No slots on this date')}</p>
    ) : (
      <ul class="slot-list">
        {slots.map((s: any) => {
          const count = countActive(s);
          const cap = s.capacity ?? 0;
          const avail = Math.max(0, cap - count);
          const course = s.courses ?? {};
          return (
            <li>
              <a class={`slot-btn ${avail === 0 ? 'full' : ''}`} href={`/admin/walk-in/${s.id}`}>
                <div class="s-time">⏰ {s.start_time?.slice(0,5)}{s.end_time ? '〜' + s.end_time.slice(0,5) : ''}</div>
                <div class="s-course">{course.name ?? '—'}</div>
                <div class="s-avail">
                  {avail === 0
                    ? <span class="chip full">{tr('満席', 'Full')}</span>
                    : <span class="chip ok">{tr('空き', 'Open')} {avail}/{cap}</span>}
                </div>
              </a>
            </li>
          );
        })}
      </ul>
    )}

    <p class="note">
      {tr(
        'ボタンをタップすると、入力画面に遷移します。満席でも追加予約を作れます (スタッフ判断)。',
        'Tap a button to open the entry form. Even a full slot can accept a walk-in (staff judgment).'
      )}
    </p>
  </main>
</Base>

<style>
  main.wi {
    max-width: 760px; margin: 0 auto; padding: 1rem 1rem 3rem;
  }
  .back a {
    color: var(--ink-3); text-decoration: none; font-size: .85rem;
  }
  h1 { font-size: 1.6rem; margin: .5rem 0 1rem; }
  h2 { font-size: 1rem; margin: 1.4rem 0 .8rem; color: var(--ink-2); }

  .date-nav {
    display: flex; align-items: center; gap: 1rem; margin-bottom: .5rem;
  }
  .d-btn {
    padding: .5rem 1rem; border: 1px solid var(--line); border-radius: 10px;
    background: #fff; color: var(--ink); text-decoration: none; font-weight: 700;
  }
  .d-cur { flex: 1; text-align: center; font-weight: 800; font-size: 1.1rem; }

  .warn {
    background: #fffcf3; color: #8a5a00;
    padding: .5rem .8rem; border-radius: 8px; font-size: .85rem;
    margin: .5rem 0;
  }
  .warn a { color: #8a5a00; }

  .empty {
    padding: 1.5rem; background: var(--bg-2); border-radius: 10px;
    color: var(--ink-3); text-align: center;
  }

  .slot-list { list-style: none; padding: 0; margin: 0; display: grid; gap: .8rem; }
  .slot-btn {
    display: grid; grid-template-columns: 1fr 2fr auto; gap: 1rem;
    align-items: center;
    background: #fff; border: 2px solid var(--line); border-radius: 14px;
    padding: 1.1rem 1.3rem;
    text-decoration: none; color: var(--ink);
    transition: all .1s;
  }
  .slot-btn:hover { border-color: var(--sky-deep); background: #f0f8fe; }
  .slot-btn.full { opacity: .7; }
  .s-time { font-size: 1.3rem; font-weight: 800; font-family: var(--mono); }
  .s-course { font-size: 1.05rem; font-weight: 600; color: var(--ink-2); }
  .s-avail .chip {
    padding: .3rem .8rem; border-radius: 100px;
    font-size: .82rem; font-weight: 700;
  }
  .chip.ok { background: #e5f8e8; color: var(--lime-deep); }
  .chip.full { background: var(--ink-3); color: #fff; }

  .note { margin-top: 1.5rem; font-size: .82rem; color: var(--ink-3); }
</style>
