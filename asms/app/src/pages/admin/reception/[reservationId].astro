---
import Base from '@layouts/Base.astro';
import { envFrom, getSupabaseAdmin } from '@lib/supabase';
import { getLocaleFromRequest, type Locale } from '@lib/i18n';
import { ageOn, PAYMENT_METHODS, paymentLabel } from '@lib/admin';

export const prerender = false;

// =============================================================================
// /admin/reception/[reservationId]
// -----------------------------------------------------------------------------
// 当日受付用の大画面表示。スタッフが iPad で開き、お客様に見せて確認してもらう。
//
// 動線:
//   1. スタッフが /admin/slots/[id] から該当予約を開く → 「受付画面」リンク
//   2. iPad をお客様に渡す
//   3. お客様が内容確認、「受付完了」をタップ
//   4. 全参加者の attendance_status = 'attended' に更新
//
// 設計方針:
//   - 情報密度は低く、文字は特大 (iPad を少し離して見てもわかる)
//   - 参加者ごとに 名前 / 年齢 / 身長 を大きく表示 (身長はカート適合判定の要)
//   - 保護者情報は補助的に小さく (スタッフが確認する用)
//   - 日英切替あり (トグル右上)
//   - 認証: middleware で /admin/* 全体を守っている
// =============================================================================

const env = envFrom(Astro.locals);
const supabase = getSupabaseAdmin(env);
const locale: Locale = getLocaleFromRequest(Astro.request);
const isEn = locale === 'en';
const tr = (jp: string, en: string) => isEn ? en : jp;

const { reservationId } = Astro.params;
if (!reservationId) return new Response('missing reservationId', { status: 400 });

const { data: res, error } = await supabase
  .from('reservations')
  .select(`
    id, reservation_number, status, price_tier, total_amount, payment_method, paid_at,
    slots(id, date, start_time, end_time, courses(code, name)),
    guardians(id, name, kana, email, phone, address),
    reservation_participants(id, name_snapshot, kana_snapshot, birth_date_snapshot, gender_snapshot, height_cm, age_at_booking, attendance_status),
    consents(id, consented_at, consenter_name, signature_type, signature_typed_name, signature_image_key)
  `)
  .eq('id', reservationId)
  .maybeSingle();

if (error) {
  return new Response(
    tr(`予約取得エラー: ${error.message}`, `Fetch error: ${error.message}`),
    { status: 500, headers: { 'Content-Type': 'text/plain; charset=utf-8' } },
  );
}
if (!res) {
  return new Response(
    tr(`予約が見つかりません: ${reservationId}`, `Reservation not found: ${reservationId}`),
    { status: 404, headers: { 'Content-Type': 'text/plain; charset=utf-8' } },
  );
}

const slot: any = (res as any).slots ?? {};
const course: any = slot.courses ?? {};
const guardian: any = (res as any).guardians ?? {};
const participants: any[] = ((res as any).reservation_participants as any[]) ?? [];
// consents は配列で返るので最新 1 件を取る。
const consentsArr: any[] = ((res as any).consents as any[]) ?? [];
const consent: any = consentsArr.length > 0
  ? [...consentsArr].sort((a, b) => (b.consented_at ?? '').localeCompare(a.consented_at ?? ''))[0]
  : null;

const weekdayJa = ['日', '月', '火', '水', '木', '金', '土'];
const weekdayEn = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
const monthsEn = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];

function fmtDate(iso: string | undefined): string {
  if (!iso) return '—';
  const d = new Date(iso + 'T00:00:00');
  return isEn
    ? `${monthsEn[d.getMonth()]} ${d.getDate()}, ${d.getFullYear()} (${weekdayEn[d.getDay()]})`
    : `${d.getFullYear()}年${d.getMonth() + 1}月${d.getDate()}日 (${weekdayJa[d.getDay()]})`;
}
function fmtTime(t: string | undefined): string {
  if (!t) return '';
  return t.slice(0, 5);
}
function genderIcon(g: string | null): string {
  if (g === 'male') return '👦';
  if (g === 'female') return '👧';
  return '🧒';
}
function genderLabel(g: string | null): string {
  if (g === 'male') return tr('男', 'M');
  if (g === 'female') return tr('女', 'F');
  return tr('その他', 'Other');
}

// 会計状態
const isPaid = !!(res as any).paid_at && !!(res as any).payment_method;
const paidAmount: number = Number((res as any).paid_amount ?? 0);
const totalAmount: number = Number((res as any).total_amount ?? 0);
const paymentMethodCode: string | null = (res as any).payment_method ?? null;

const dateLabel = fmtDate(slot.date);
const timeLabel = slot.start_time
  ? `${fmtTime(slot.start_time)}${slot.end_time ? '〜' + fmtTime(slot.end_time) : ''}`
  : '—';
const courseLabel = course.name ?? '—';

// 出欠状態の全体まとめ
const attendedCount = participants.filter(p => p.attendance_status === 'attended').length;
const anyAttended = attendedCount > 0;
const allCancelled = participants.length > 0 && participants.every(p => p.attendance_status === 'cancelled');
// 予約全体のキャンセル状態 (reservations.status か、全員 cancelled か)
const resCancelled = (res as any).status === 'cancelled' || allCancelled;
---
<Base
  title={tr(`受付 — ${res.reservation_number}`, `Check-in — ${res.reservation_number}`)}
  lang={locale}
  showLocaleSwitch={true}
>
  <main class="rc">
    <nav class="back">
      <div class="back-links">
        <a href="/admin/reception">← {tr('本日の受付一覧', "Today's reception")}</a>
        <a class="back-alt" href={`/admin/slots/${slot.id ?? ''}` }>{tr('スロット画面', 'Slot')} →</a>
      </div>
      <span class="rsv-num">#{res.reservation_number}</span>
    </nav>

    <!-- Course / date / time: 一目でわかる大きさ -->
    <section class={`headline ${resCancelled ? 'is-cancelled' : ''}`}>
      <div class="course">🏁 {courseLabel}</div>
      <div class="when">
        <span class="date">📅 {dateLabel}</span>
        <span class="time">⏰ {timeLabel}</span>
      </div>
    </section>

    <!-- キャンセル予約の警告 + 復活ボタン -->
    {resCancelled && (
      <section class="cancel-banner">
        <div class="cb-title">❌ {tr('この予約はキャンセル済みです', 'This reservation is cancelled')}</div>
        <div class="cb-detail">
          {tr(
            '誤キャンセルの場合は下のボタンで予約を復活できます (ステータス → confirmed、参加者 → expected)。',
            'If cancelled by mistake, you can restore it (status → confirmed, participants → expected).'
          )}
        </div>
        <button type="button" class="btn-restore" data-reservation-id={res.id}>
          ↩️ {tr('予約を復活する', 'Restore this reservation')}
        </button>
      </section>
    )}

    <!-- 参加者カード (特大): 名前 / 年齢 / 身長 -->
    <section class="participants">
      <div class="sect-head">
        <h2>{tr('参加者', 'Participants')} ({participants.length} {tr('名', 'ppl')})</h2>
        <button type="button" class="btn-edit" data-target="participants">
          ✏️ {tr('編集', 'Edit')}
        </button>
      </div>
      <div class="p-grid">
        {participants.map((p) => {
          const birthDate = p.birth_date_snapshot;
          const age = birthDate ? ageOn(birthDate, slot.date) : p.age_at_booking;
          const h = p.height_cm;
          const isCancel = p.attendance_status === 'cancelled';
          const isAttended = p.attendance_status === 'attended';
          const isNoShow = p.attendance_status === 'no_show';
          return (
            <div class={`p-card ${isCancel ? 'is-cancel' : ''} ${isAttended ? 'is-attended' : ''} ${isNoShow ? 'is-noshow' : ''}`} data-participant-id={p.id}>
              <div class="p-icon">{genderIcon(p.gender_snapshot)}</div>
              <div class="p-main">
                <!-- 表示モード -->
                <div class="view-only">
                  <div class="p-name">{p.name_snapshot}</div>
                  {p.kana_snapshot && <div class="p-kana">{p.kana_snapshot}</div>}
                  <div class="p-info">
                    <span class="p-chip">{age} {tr('歳', 'yr')}</span>
                    <span class="p-chip">{genderLabel(p.gender_snapshot)}</span>
                    {h && <span class="p-chip hi">📏 {h} cm</span>}
                  </div>
                  {birthDate && (
                    <div class="p-birth">🎂 {birthDate}</div>
                  )}
                </div>
                <!-- 編集モード (hidden) -->
                <div class="edit-only" hidden>
                  <div class="e-field">
                    <label>{tr('名前', 'Name')}</label>
                    <input type="text" data-field="name_snapshot" value={p.name_snapshot ?? ''} />
                  </div>
                  <div class="e-field">
                    <label>{tr('フリガナ', 'Kana')}</label>
                    <input type="text" data-field="kana_snapshot" value={p.kana_snapshot ?? ''} />
                  </div>
                  <div class="e-field">
                    <label>{tr('生年月日', 'Birth date')}</label>
                    <input type="date" data-field="birth_date_snapshot" value={birthDate ?? ''} />
                  </div>
                  <div class="e-field">
                    <label>{tr('身長 (cm)', 'Height (cm)')}</label>
                    <input type="number" min="50" max="220" data-field="height_cm" value={h ?? ''} />
                  </div>
                </div>
              </div>
              {isAttended && <div class="p-badge ok">✅ {tr('出席', 'Attended')}</div>}
              {isCancel && <div class="p-badge cancel">❌ {tr('キャンセル', 'Cancelled')}</div>}
              {isNoShow && <div class="p-badge noshow">⚠️ {tr('無断欠席', 'No show')}</div>}
            </div>
          );
        })}
      </div>
    </section>

    <!-- 保護者情報 (大きい文字で見やすく、編集可能) -->
    <section class="guardian" data-guardian-id={guardian.id ?? ''}>
      <div class="sect-head">
        <h2>{tr('保護者情報', 'Guardian')}</h2>
        <button type="button" class="btn-edit" data-target="guardian">
          ✏️ {tr('編集', 'Edit')}
        </button>
      </div>

      <!-- 表示モード -->
      <dl class="view-only">
        <dt>{tr('お名前', 'Name')}</dt>
        <dd class="g-name">
          {guardian.name ?? '—'}
          {guardian.kana && <span class="kana"> ({guardian.kana})</span>}
        </dd>
        <dt>{tr('電話', 'Phone')}</dt>
        <dd class="g-phone"><a href={`tel:${guardian.phone ?? ''}`}>{guardian.phone ?? '—'}</a></dd>
        <dt>{tr('メール', 'Email')}</dt>
        <dd class="g-email">{guardian.email || '—'}</dd>
        <dt>{tr('住所', 'Address')}</dt>
        <dd class="g-addr">{guardian.address || '—'}</dd>
      </dl>

      <!-- 編集モード (hidden) -->
      <div class="edit-only" hidden>
        <div class="e-field">
          <label>{tr('お名前', 'Name')}</label>
          <input type="text" data-field="name" value={guardian.name ?? ''} />
        </div>
        <div class="e-field">
          <label>{tr('フリガナ', 'Kana')}</label>
          <input type="text" data-field="kana" value={guardian.kana ?? ''} />
        </div>
        <div class="e-field">
          <label>{tr('電話', 'Phone')}</label>
          <input type="tel" data-field="phone" value={guardian.phone ?? ''} />
        </div>
        <div class="e-field">
          <label>{tr('メール', 'Email')}</label>
          <input type="email" data-field="email" value={guardian.email ?? ''} />
        </div>
        <div class="e-field">
          <label>{tr('住所', 'Address')}</label>
          <input type="text" data-field="address" value={guardian.address ?? ''} />
        </div>
      </div>
    </section>

    <!-- 電子署名 (予約時に受領済み) -->
    {consent && (
      <section class="signature">
        <h2>{tr('電子署名', 'Signature')}</h2>
        <div class="sig-wrap">
          {consent.signature_type === 'drawn' && consent.signature_image_key ? (
            <img class="sig-img" src={consent.signature_image_key} alt={tr('電子署名', 'Signature')} />
          ) : consent.signature_type === 'typed' && consent.signature_typed_name ? (
            <div class="sig-typed">⌨️ {consent.signature_typed_name}</div>
          ) : (
            <div class="sig-none">{tr('(署名データなし)', '(no signature data)')}</div>
          )}
        </div>
        <div class="sig-meta">
          {tr('署名者', 'Signed by')}: <strong>{consent.consenter_name ?? '—'}</strong>
          {' · '}
          {consent.consented_at && (
            <span>
              {tr('同意日時', 'at')}:{' '}
              {new Date(consent.consented_at).toLocaleString(isEn ? 'en-US' : 'ja-JP', { timeZone: 'Asia/Tokyo' })}
            </span>
          )}
        </div>
      </section>
    )}

    <!-- 編集モード中のみ表示される保存/キャンセル -->
    <section class="edit-actions" id="editActions" hidden>
      <button type="button" class="btn-save" data-reservation-id={res.id}>
        💾 {tr('変更を保存', 'Save changes')}
      </button>
      <button type="button" class="btn-cancel-edit">
        {tr('キャンセル', 'Cancel')}
      </button>
    </section>

    <!-- 💰 会計セクション (受付完了と同じ画面で記録) -->
    {!resCancelled && (
      <section class="payment" data-reservation-id={res.id}>
        <div class="sect-head">
          <h2>💰 {tr('会計', 'Payment')}</h2>
          {isPaid && paidAmount > 0 && (
            <span class="pay-done">
              ✅ {paymentLabel(paymentMethodCode)} ¥{paidAmount.toLocaleString('ja-JP')}
            </span>
          )}
          {isPaid && paidAmount === 0 && (
            <span class="pay-zero-warn" title={tr(
              '支払い方法は記録されていますが入金額が ¥0 です。実際に受け取った金額を下で修正してください。',
              'Method recorded but amount is ¥0. Enter the actual amount below.'
            )}>
              ⚠️ {tr('¥0 で記録 / 要修正', '¥0 recorded / fix below')}
            </span>
          )}
        </div>

        <div class="pay-total-row">
          <span class="pay-total-label">{tr('合計金額', 'Total')}</span>
          <span class="pay-total-value">¥{totalAmount.toLocaleString('ja-JP')}</span>
        </div>

        <div class="pay-methods">
          {PAYMENT_METHODS.map((m) => (
            <label class={`pay-method ${paymentMethodCode === m.code ? 'active' : ''}`}>
              <input type="radio" name="pay_method"
                     value={m.code}
                     checked={paymentMethodCode === m.code} />
              <span class="pm-emoji">{m.emoji}</span>
              <span class="pm-label">{m.label}</span>
            </label>
          ))}
        </div>

        <div class="pay-amount-row">
          <label>
            {tr('入金額', 'Received')}
            <input type="number" id="payAmount" min="0" step="1"
                   value={isPaid && paidAmount > 0 ? paidAmount : totalAmount} />
            <span class="pay-unit">円</span>
          </label>
          <button type="button" class="btn-record-pay" data-reservation-id={res.id}>
            {isPaid ? tr('💾 会計を更新', '💾 Update payment') : tr('💾 会計を記録', '💾 Record payment')}
          </button>
        </div>
      </section>
    )}

    <!-- アクションボタン (特大) -->
    {!resCancelled && (
      <section class="actions">
        <button
          type="button"
          class="btn-primary"
          data-action="attend_and_pay"
          data-reservation-id={res.id}
          disabled={anyAttended && isPaid && paidAmount > 0}
        >
          {anyAttended && isPaid && paidAmount > 0
            ? tr('✅ 受付・会計 済み', '✅ Checked in & paid')
            : anyAttended
            ? (isPaid && paidAmount === 0
                ? tr('💰 ¥0 を正しい金額に修正', '💰 Fix the ¥0 amount')
                : tr('💰 会計を記録して完了', '💰 Record payment & finish'))
            : isPaid && paidAmount > 0
            ? tr('✅ 受付完了 (全員出席)', '✅ Check in all')
            : tr('✅ 受付+会計 完了', '✅ Check in & pay')}
        </button>
        <button
          type="button"
          class="btn-secondary"
          data-action="no_show"
          data-reservation-id={res.id}
        >
          {tr('⚠️ 無断欠席にする', '⚠️ Mark no-show')}
        </button>
      </section>
    )}

    <div id="toast" class="toast" hidden></div>
  </main>
</Base>

<script>
  // 「受付完了」ボタン: /api/admin/reservation-attendance を叩いて全員 attended に。
  // 「無断欠席」も同じ API で status を変える。
  const toast = document.getElementById('toast')!;
  function showToast(msg: string, ok = true) {
    toast.textContent = msg;
    toast.className = 'toast ' + (ok ? 'ok' : 'err');
    toast.hidden = false;
    setTimeout(() => { toast.hidden = true; }, 3000);
  }
  const isEn = document.documentElement.lang === 'en';
  const tr = (jp: string, en: string) => isEn ? en : jp;

  // ---- 編集モード -----------------------------------------------------
  // ✏️ 編集ボタンで in-place に inputs に差し替え → 💾 保存 で API に送信。
  // ホールド状態 (view/edit) はドキュメント全体で 1 つ (保護者 or 参加者 どちら
  // を押しても全体を edit mode に切り替える)。
  const editActions = document.getElementById('editActions')!;
  function setEditMode(on: boolean) {
    document.querySelectorAll('.view-only').forEach((el) => { (el as HTMLElement).hidden = on; });
    document.querySelectorAll('.edit-only').forEach((el) => { (el as HTMLElement).hidden = !on; });
    document.querySelectorAll('.btn-edit').forEach((el) => { (el as HTMLElement).hidden = on; });
    editActions.hidden = !on;
  }

  document.querySelectorAll<HTMLButtonElement>('.btn-edit').forEach((btn) => {
    btn.addEventListener('click', () => setEditMode(true));
  });
  document.querySelector<HTMLButtonElement>('.btn-cancel-edit')?.addEventListener('click', () => {
    if (!confirm(tr('編集内容を破棄しますか?', 'Discard changes?'))) return;
    location.reload();  // 元に戻す簡単な方法: リロード
  });

  const saveBtn = document.querySelector<HTMLButtonElement>('.btn-save');
  saveBtn?.addEventListener('click', async () => {
    const reservationId = saveBtn.dataset.reservationId!;
    // 保護者情報
    const gSection = document.querySelector<HTMLElement>('section.guardian');
    const guardian: Record<string, string> = {};
    gSection?.querySelectorAll<HTMLInputElement>('.edit-only input[data-field]').forEach((el) => {
      guardian[el.dataset.field!] = el.value.trim();
    });
    // 参加者情報
    const participants: Array<Record<string, any>> = [];
    document.querySelectorAll<HTMLElement>('.p-card[data-participant-id]').forEach((card) => {
      const id = card.dataset.participantId!;
      const upd: Record<string, any> = { id };
      card.querySelectorAll<HTMLInputElement>('.edit-only input[data-field]').forEach((el) => {
        const field = el.dataset.field!;
        if (field === 'height_cm') {
          const n = parseInt(el.value, 10);
          if (!isNaN(n)) upd.height_cm = n;
        } else {
          upd[field] = el.value.trim();
        }
      });
      participants.push(upd);
    });

    saveBtn.disabled = true;
    const originalText = saveBtn.textContent;
    saveBtn.textContent = tr('保存中…', 'Saving...');
    try {
      const r = await fetch('/api/admin/reservation-update', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ reservation_id: reservationId, guardian, participants }),
      });
      const body = await r.json() as { ok?: boolean; error?: string };
      if (!r.ok) {
        showToast(tr('エラー: ', 'Error: ') + (body.error ?? `HTTP ${r.status}`), false);
        saveBtn.disabled = false;
        saveBtn.textContent = originalText;
        return;
      }
      showToast(tr('保存しました', 'Saved'), true);
      setTimeout(() => { location.reload(); }, 800);
    } catch (e) {
      showToast(tr('通信エラー: ', 'Network error: ') + (e as Error).message, false);
      saveBtn.disabled = false;
      saveBtn.textContent = originalText;
    }
  });

  // ---- 予約の復活 (キャンセル取消) --------------------------------------
  document.querySelector<HTMLButtonElement>('.btn-restore')?.addEventListener('click', async (ev) => {
    const btn = ev.currentTarget as HTMLButtonElement;
    const reservationId = btn.dataset.reservationId!;
    if (!confirm(tr(
      'この予約を復活します。\n・ステータスを confirmed に戻します\n・参加者を expected に戻します\nよろしいですか?',
      'Restore this reservation?\n- Status → confirmed\n- Participants → expected\nContinue?',
    ))) return;

    btn.disabled = true;
    const original = btn.textContent;
    btn.textContent = tr('復活中…', 'Restoring...');
    try {
      const r = await fetch('/api/admin/reservation-restore', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ reservation_id: reservationId }),
      });
      const body = await r.json() as { ok?: boolean; participants_restored?: number; error?: string };
      if (!r.ok) {
        showToast(tr('エラー: ', 'Error: ') + (body.error ?? `HTTP ${r.status}`), false);
        btn.disabled = false;
        btn.textContent = original;
        return;
      }
      showToast(tr(`復活しました (参加者 ${body.participants_restored ?? 0} 名)`, `Restored (${body.participants_restored ?? 0} participants)`), true);
      setTimeout(() => { location.reload(); }, 1000);
    } catch (e) {
      showToast(tr('通信エラー: ', 'Network error: ') + (e as Error).message, false);
      btn.disabled = false;
      btn.textContent = original;
    }
  });

  // ---- 💰 会計の記録のみ (「会計を記録」ボタン) ------------------------
  async function recordPayment(reservationId: string): Promise<{ ok: boolean; error?: string }> {
    const methodEl = document.querySelector<HTMLInputElement>('input[name="pay_method"]:checked');
    const amountEl = document.getElementById('payAmount') as HTMLInputElement | null;
    if (!methodEl) return { ok: false, error: tr('支払い方法を選んでください', 'Select payment method') };
    const method = methodEl.value;
    const amount = parseInt((amountEl?.value || '0').replace(/[^\d]/g, ''), 10);
    if (!Number.isFinite(amount) || amount < 0) {
      return { ok: false, error: tr('入金額が不正です', 'Invalid amount') };
    }
    // ¥0 は誤操作である可能性が高いので確認を取る (無料券/割引 100% なら OK を押させる)
    if (amount === 0) {
      const ok = confirm(tr(
        '入金額が ¥0 です。本当に ¥0 で記録しますか?\n(通常は体験料金を入力してください)',
        'Amount is ¥0. Really record as ¥0?\n(Usually enter the experience fee)'
      ));
      if (!ok) return { ok: false, error: tr('キャンセルしました', 'Cancelled') };
    }
    const r = await fetch('/api/admin/reservation-payment', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ reservation_id: reservationId, payment_method: method, paid_amount: amount }),
    });
    const b = await r.json() as { ok?: boolean; error?: string };
    if (!r.ok) return { ok: false, error: b.error ?? `HTTP ${r.status}` };
    return { ok: true };
  }

  document.querySelectorAll<HTMLButtonElement>('.btn-record-pay').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const reservationId = btn.dataset.reservationId!;
      btn.disabled = true;
      const original = btn.textContent;
      btn.textContent = tr('記録中…', 'Recording...');
      const r = await recordPayment(reservationId);
      if (!r.ok) {
        showToast(tr('エラー: ', 'Error: ') + (r.error ?? ''), false);
        btn.disabled = false;
        btn.textContent = original;
        return;
      }
      showToast(tr('会計を記録しました', 'Payment recorded'), true);
      setTimeout(() => { location.reload(); }, 900);
    });
  });

  document.querySelectorAll<HTMLButtonElement>('[data-action]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const action = btn.dataset.action!;
      const reservationId = btn.dataset.reservationId!;

      // 「受付+会計 完了」の合体ボタン: 出欠を attended にし、会計も同時に記録する
      if (action === 'attend_and_pay') {
        const methodEl = document.querySelector<HTMLInputElement>('input[name="pay_method"]:checked');
        if (!methodEl) {
          showToast(tr('支払い方法を選んでください', 'Select payment method'), false);
          return;
        }
        const confirmMsg = tr(
          '全員を「出席」として記録し、会計も同時に確定します。よろしいですか?',
          'Mark all attended and record payment. Continue?'
        );
        if (!confirm(confirmMsg)) return;

        btn.disabled = true;
        const original = btn.textContent;
        btn.textContent = tr('処理中…', 'Processing...');
        try {
          // 1) 出欠を attended に (既に attended なら API は no-op)
          const attRes = await fetch('/api/admin/reservation-attendance', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ reservation_id: reservationId, status: 'attended' }),
          });
          const attBody = await attRes.json() as { ok?: boolean; updated?: number; error?: string };
          if (!attRes.ok) {
            showToast(tr('出欠エラー: ', 'Attendance error: ') + (attBody.error ?? `HTTP ${attRes.status}`), false);
            btn.disabled = false;
            btn.textContent = original;
            return;
          }
          // 2) 会計を記録
          const payRes = await recordPayment(reservationId);
          if (!payRes.ok) {
            showToast(tr('会計エラー: ', 'Payment error: ') + (payRes.error ?? ''), false);
            btn.disabled = false;
            btn.textContent = original;
            return;
          }
          showToast(tr('受付・会計を記録しました', 'Check-in & payment recorded'), true);
          setTimeout(() => { location.reload(); }, 1200);
        } catch (e) {
          showToast(tr('通信エラー: ', 'Network error: ') + (e as Error).message, false);
          btn.disabled = false;
          btn.textContent = original;
        }
        return;
      }

      // 無断欠席ボタン (既存ロジック)
      const status = 'no_show';
      const confirmMsg = tr('全員を「無断欠席」として記録します。よろしいですか?', 'Mark all as no-show. Continue?');
      if (!confirm(confirmMsg)) return;

      btn.disabled = true;
      try {
        const res = await fetch('/api/admin/reservation-attendance', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ reservation_id: reservationId, status }),
        });
        const body = await res.json() as { ok?: boolean; updated?: number; error?: string };
        if (!res.ok) {
          showToast(tr('エラー: ', 'Error: ') + (body.error ?? `HTTP ${res.status}`), false);
          btn.disabled = false;
          return;
        }
        showToast(tr(`${body.updated} 名の出欠を更新しました`, `Updated ${body.updated} participant(s)`), true);
        setTimeout(() => { location.reload(); }, 1200);
      } catch (e) {
        showToast(tr('通信エラー: ', 'Network error: ') + (e as Error).message, false);
        btn.disabled = false;
      }
    });
  });

  // ---- 支払い方法ラジオの active スタイル同期 ----
  document.querySelectorAll<HTMLInputElement>('input[name="pay_method"]').forEach((el) => {
    el.addEventListener('change', () => {
      document.querySelectorAll('.pay-method').forEach((lab) => lab.classList.remove('active'));
      el.closest('.pay-method')?.classList.add('active');
    });
  });
</script>

