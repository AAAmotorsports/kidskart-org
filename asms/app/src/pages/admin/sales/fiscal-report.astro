---
import Base from '@layouts/Base.astro';
import { envFrom, getSupabaseAdmin } from '@lib/supabase';
import {
  fetchAllPaidAttendedParticipations, fetchPreAsmsMap,
  aggregate, fiscalYearRange,
} from '@lib/fiscalReport';

export const prerender = false;

const env = envFrom(Astro.locals);
const supabase = getSupabaseAdmin(env);

// パラメータ: ?from=YYYY-MM&to=YYYY-MM か ?year=YYYY (会計年度 4-3 月)
// デフォルト: 2026-09 (新システム稼働月) 〜 今月 (JST)
const url = new URL(Astro.request.url);
const yearParam = url.searchParams.get('year');
const fromParam = url.searchParams.get('from');
const toParam = url.searchParams.get('to');

const nowJst = new Date(Date.now() + 9 * 3600 * 1000);
const curYearJst = nowJst.getUTCFullYear();
const curMonthJst = nowJst.getUTCMonth() + 1;
const pad2 = (n: number) => String(n).padStart(2, '0');

let fromYm: string, toYm: string, periodLabel: string;
if (yearParam && /^\d{4}$/.test(yearParam)) {
  const r = fiscalYearRange(parseInt(yearParam, 10));
  fromYm = r.fromYm;
  toYm = r.toYm;
  periodLabel = r.label;
} else if (fromParam && toParam && /^\d{4}-\d{2}$/.test(fromParam) && /^\d{4}-\d{2}$/.test(toParam)) {
  fromYm = fromParam;
  toYm = toParam;
  periodLabel = `${fromYm} 〜 ${toYm}`;
} else {
  fromYm = '2026-09';
  toYm = `${curYearJst}-${pad2(curMonthJst)}`;
  periodLabel = `${fromYm} 〜 ${toYm} (新システム稼働後)`;
}

const allRows = await fetchAllPaidAttendedParticipations(supabase);
const custIds = Array.from(new Set(allRows.map((r) => r.customer_id).filter((x): x is string => !!x)));
const preAsmsMap = await fetchPreAsmsMap(supabase, custIds);
const { months, buckets, total } = aggregate(allRows, fromYm, toYm, preAsmsMap);

function pct(num: number, denom: number): string {
  if (denom === 0) return '—';
  return `${(num / denom * 100).toFixed(1)}%`;
}

// CSV 出力の URL (同じ期間)
const csvQuery = yearParam && /^\d{4}$/.test(yearParam)
  ? `year=${yearParam}`
  : `from=${fromYm}&to=${toYm}`;
const csvUrl = `/api/admin/sales/fiscal-report?${csvQuery}`;

// 年度選択プリセット: 現在の会計年度 + 直近 2 年
const nowFiscalYear = (curMonthJst >= 4 ? curYearJst : curYearJst - 1);
const fiscalPresets = [nowFiscalYear, nowFiscalYear - 1, nowFiscalYear - 2];
---
<Base title={`年度報告用集計 ${periodLabel} — ASMS`}>
  <main>
    <header class="hd">
      <a class="back" href="/admin/sales">← 売上・分析</a>
      <h1>📊 年度報告用集計</h1>
      <p class="sub">{periodLabel}</p>
      <p class="sub-note">福岡トヨペット向け年次レポート用。会計済 + キャンセル以外の参加者で集計。PII (氏名/カナ/電話/メール) は出しません。</p>
    </header>

    <section class="period-form">
      <form method="get" class="pf">
        <label class="pf-label">会計年度 (4-3 月):</label>
        {fiscalPresets.map((y) => (
          <a class={`btn-preset ${String(y) === yearParam ? 'active' : ''}`} href={`?year=${y}`}>
            {y}年度
          </a>
        ))}
        <a class="btn-preset" href="/admin/sales/fiscal-report">新システム稼働後</a>
      </form>
      <form method="get" class="pf range-form">
        <label class="pf-label">期間指定:</label>
        <input type="month" name="from" value={fromYm} />
        <span>〜</span>
        <input type="month" name="to" value={toYm} />
        <button type="submit" class="btn-jump">表示</button>
      </form>
    </section>

    <section class="csv-dl">
      <a class="btn-csv" href={csvUrl}>📥 この集計を CSV で出力 (UTF-8 BOM)</a>
    </section>

    <section class="report-table">
      <h2>月別集計</h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th rowspan="2">月</th>
              <th rowspan="2">参加<br>人数</th>
              <th colspan="3">男女比率</th>
              <th colspan="3">年齢 (3 区分)</th>
              <th colspan="2">リピート (a) 厳格</th>
              <th colspan="2">リピート (b) 広め</th>
            </tr>
            <tr>
              <th>男</th>
              <th>女</th>
              <th>その他</th>
              <th>6歳以下</th>
              <th>7-9歳</th>
              <th>10歳以上</th>
              <th>初回</th>
              <th>リピート</th>
              <th>初回</th>
              <th>リピート</th>
            </tr>
          </thead>
          <tbody>
            {months.map((ym) => {
              const b = buckets.get(ym)!;
              return (
                <tr>
                  <td class="mono">{ym}</td>
                  <td class="num total-col">{b.count}</td>
                  <td class="num">{b.male} <small>({pct(b.male, b.count)})</small></td>
                  <td class="num">{b.female} <small>({pct(b.female, b.count)})</small></td>
                  <td class="num">{b.other} <small>({pct(b.other, b.count)})</small></td>
                  <td class="num">{b.under6} <small>({pct(b.under6, b.count)})</small></td>
                  <td class="num">{b.age7to9} <small>({pct(b.age7to9, b.count)})</small></td>
                  <td class="num">{b.over10} <small>({pct(b.over10, b.count)})</small></td>
                  <td class="num">{b.firstA} <small>({pct(b.firstA, b.count)})</small></td>
                  <td class="num">{b.repeatA} <small>({pct(b.repeatA, b.count)})</small></td>
                  <td class="num">{b.firstB} <small>({pct(b.firstB, b.count)})</small></td>
                  <td class="num">{b.repeatB} <small>({pct(b.repeatB, b.count)})</small></td>
                </tr>
              );
            })}
            <tr class="total-row">
              <td class="mono"><strong>合計</strong></td>
              <td class="num total-col"><strong>{total.count}</strong></td>
              <td class="num">{total.male} <small>({pct(total.male, total.count)})</small></td>
              <td class="num">{total.female} <small>({pct(total.female, total.count)})</small></td>
              <td class="num">{total.other} <small>({pct(total.other, total.count)})</small></td>
              <td class="num">{total.under6} <small>({pct(total.under6, total.count)})</small></td>
              <td class="num">{total.age7to9} <small>({pct(total.age7to9, total.count)})</small></td>
              <td class="num">{total.over10} <small>({pct(total.over10, total.count)})</small></td>
              <td class="num">{total.firstA} <small>({pct(total.firstA, total.count)})</small></td>
              <td class="num">{total.repeatA} <small>({pct(total.repeatA, total.count)})</small></td>
              <td class="num">{total.firstB} <small>({pct(total.firstB, total.count)})</small></td>
              <td class="num">{total.repeatB} <small>({pct(total.repeatB, total.count)})</small></td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="notes">
      <h3>集計の条件</h3>
      <ul>
        <li>対象期間: <strong>{periodLabel}</strong> (slots.date = 参加日 基準)</li>
        <li>実際に参加した人のみ: reservations.status != cancelled かつ reservation_participants.attendance_status != cancelled かつ reservations.paid_at IS NOT NULL</li>
        <li>数え方: 参加者 1 人 × 1 回 = 1 (兄弟は 2)。/admin/sales の月別 CSV (basis=slot) の「商品数」合計と一致</li>
        <li>リピート (a) 厳格: 同 customer_id に当日より前の ASMS 参加履歴がある</li>
        <li>リピート (b) 広め: (a) OR customers.pre_asms_visit_count &gt; 0 OR pre_asms_first_visit_date IS NOT NULL (エアレジ時代の来店歴)</li>
        <li>CSV は (b) 広めの初回/リピート数を採用 (報告書向け)。(a) との差は画面テーブルで確認可能</li>
      </ul>
    </section>
  </main>
</Base>

<style>
  main { max-width: 1100px; margin: 0 auto; padding: 1rem; }
  .hd { padding-bottom: 1rem; border-bottom: 1px solid var(--line); margin-bottom: 1.2rem; }
  .back { display: inline-block; font-size: .78rem; color: var(--ink-3); text-decoration: none; margin-bottom: .4rem; }
  h1 { margin: 0 0 .3rem; font-size: 1.4rem; }
  .sub { margin: 0; color: var(--ink-2); font-size: .9rem; font-weight: 700; }
  .sub-note { margin: .3rem 0 0; color: var(--ink-3); font-size: .72rem; line-height: 1.5; }

  .period-form { background: var(--bg-2); border-radius: 10px; padding: .7rem 1rem; margin-bottom: 1rem; }
  .pf { display: flex; flex-wrap: wrap; gap: .5rem; align-items: center; margin-bottom: .5rem; }
  .pf-label { font-size: .78rem; font-weight: 700; color: var(--ink-2); }
  .btn-preset {
    padding: .35rem .8rem; background: #fff; border: 1px solid var(--line);
    border-radius: 100px; font-size: .82rem; color: var(--ink-2);
    text-decoration: none; font-weight: 600;
  }
  .btn-preset.active { background: var(--sky-deep); color: #fff; border-color: var(--sky-deep); }
  .btn-preset:hover { border-color: var(--sky-deep); }
  .range-form { margin-bottom: 0; }
  .range-form input[type="month"] {
    padding: .3rem .5rem; border: 1px solid var(--line); border-radius: 6px;
  }
  .btn-jump {
    padding: .35rem .9rem; background: var(--sky-deep); color: #fff;
    border: none; border-radius: 6px; font-weight: 700; cursor: pointer;
  }

  .csv-dl { margin: 0 0 1rem; }
  .btn-csv {
    display: inline-block; padding: .6rem 1.1rem;
    background: linear-gradient(135deg, #42ab49, #318436); color: #fff;
    border-radius: 10px; font-weight: 700; text-decoration: none;
    box-shadow: 0 2px 6px rgba(66,171,73,.25);
  }
  .btn-csv:hover { filter: brightness(1.05); }

  .report-table h2 { font-size: 1.1rem; margin: 0 0 .6rem; }
  .table-wrap { overflow-x: auto; }
  table { border-collapse: collapse; width: 100%; font-size: .78rem; background: #fff; }
  thead th {
    background: var(--bg-2); color: var(--ink-2); font-weight: 700;
    padding: .4rem .5rem; border: 1px solid var(--line); text-align: center;
    white-space: nowrap;
  }
  tbody td {
    padding: .35rem .5rem; border: 1px solid var(--line);
    vertical-align: middle;
  }
  td.num { text-align: right; font-family: var(--mono); white-space: nowrap; }
  td.num small { color: var(--ink-3); font-size: .7rem; }
  td.mono { font-family: var(--mono); font-weight: 700; }
  td.total-col { background: rgba(58,169,232,.08); font-weight: 700; }
  .total-row { background: rgba(255,201,67,.08); }
  .total-row td { font-weight: 700; }

  .notes { margin-top: 1.5rem; background: var(--bg-2); border-radius: 10px; padding: .8rem 1.2rem; }
  .notes h3 { margin: 0 0 .5rem; font-size: .9rem; color: var(--ink-2); }
  .notes ul { margin: 0; padding-left: 1.2rem; color: var(--ink-2); font-size: .78rem; line-height: 1.7; }
</style>
