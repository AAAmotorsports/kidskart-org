---
import Base from '@layouts/Base.astro';
import { envFrom, getSupabaseAdmin } from '@lib/supabase';
import { PAYMENT_METHODS, jaDateShort, paymentLabel } from '@lib/admin';

const env = envFrom(Astro.locals);
const supabase = getSupabaseAdmin(env);

// ---------- 対象月の決定 ----------
const url = new URL(Astro.request.url);
const ymParam = (url.searchParams.get('ym') || '').trim();
const now = new Date();
const defaultYm = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}`;
const ym = /^\d{4}-\d{2}$/.test(ymParam) ? ymParam : defaultYm;
const [yearStr, monthStr] = ym.split('-');
const year = parseInt(yearStr, 10);
const month = parseInt(monthStr, 10);

// 月初〜翌月初 (JST)。paid_at は timestamptz なので UTC 換算で幅を取る
const monthStartJst = new Date(Date.UTC(year, month - 1, 1, -9, 0, 0)); // JST 00:00 = UTC 前日 15:00
const monthEndJst = new Date(Date.UTC(year, month, 1, -9, 0, 0));

// ---------- クエリ ----------
const { data: paidRows, error } = await supabase
  .from('reservations')
  .select(`
    id, reservation_number, payment_method, paid_at, paid_amount, payment_note,
    total_amount, price_tier, status,
    guardians(name, phone),
    slots(date, start_time, courses(name)),
    reservation_participants(id, name_snapshot)
  `)
  .not('paid_at', 'is', null)
  .gte('paid_at', monthStartJst.toISOString())
  .lt('paid_at', monthEndJst.toISOString())
  .order('paid_at', { ascending: false });

const rows = (paidRows ?? []) as any[];

// ---------- 集計 ----------
type Bucket = { count: number; total: number };
const byMethod: Record<string, Bucket> = {};
for (const m of PAYMENT_METHODS) byMethod[m.code] = { count: 0, total: 0 };
let grandTotal = 0;
let grandCount = 0;
for (const r of rows) {
  const m = r.payment_method as string;
  const amt = Number(r.paid_amount ?? 0);
  if (byMethod[m]) {
    byMethod[m].count++;
    byMethod[m].total += amt;
  }
  grandTotal += amt;
  grandCount++;
}

// 日別集計
type DayBucket = { date: string; total: number; count: number };
const byDayMap = new Map<string, DayBucket>();
for (const r of rows) {
  const d = new Date(r.paid_at);
  // JST 日付キー
  const jstMs = d.getTime() + 9 * 60 * 60 * 1000;
  const jstDate = new Date(jstMs);
  const key = `${jstDate.getUTCFullYear()}-${String(jstDate.getUTCMonth() + 1).padStart(2, '0')}-${String(jstDate.getUTCDate()).padStart(2, '0')}`;
  const cur = byDayMap.get(key) ?? { date: key, total: 0, count: 0 };
  cur.total += Number(r.paid_amount ?? 0);
  cur.count++;
  byDayMap.set(key, cur);
}
const byDay = [...byDayMap.values()].sort((a, b) => b.date.localeCompare(a.date));

// ---------- 月移動リンク ----------
const prevMonth = new Date(year, month - 2, 1);
const nextMonth = new Date(year, month, 1);
const prevYm = `${prevMonth.getFullYear()}-${String(prevMonth.getMonth() + 1).padStart(2, '0')}`;
const nextYm = `${nextMonth.getFullYear()}-${String(nextMonth.getMonth() + 1).padStart(2, '0')}`;

// paid_at を JST HH:mm で表示
function jstHm(iso: string): string {
  const d = new Date(iso);
  const jstMs = d.getTime() + 9 * 60 * 60 * 1000;
  const j = new Date(jstMs);
  return `${String(j.getUTCHours()).padStart(2, '0')}:${String(j.getUTCMinutes()).padStart(2, '0')}`;
}

const yen = (n: number) => `¥${n.toLocaleString('ja-JP')}`;
---
<Base title={`${year}年${month}月 売上 — ASMS`}>
  <main>
    <header class="hd">
      <a class="back" href="/admin">← 管理トップへ</a>
      <h1>💰 売上集計</h1>
      <p class="sub">支払い記録のある予約を月次で集計</p>
    </header>

    {error && <div class="err">{error.message ?? String(error)}</div>}

    <section class="nav">
      <a class="nav-btn" href={`/admin/sales?ym=${prevYm}`}>← {prevYm}</a>
      <form method="get" class="nav-form">
        <input type="month" name="ym" value={ym} />
        <button type="submit" class="btn-jump">表示</button>
      </form>
      <a class="nav-btn" href={`/admin/sales?ym=${nextYm}`}>{nextYm} →</a>
    </section>

    <section class="hero">
      <div class="hero-ym">{year}年{month}月</div>
      <div class="hero-total">{yen(grandTotal)}</div>
      <div class="hero-count">{grandCount} 件</div>
    </section>

    <section class="method-grid">
      {PAYMENT_METHODS.map((m) => {
        const b = byMethod[m.code];
        const pct = grandTotal > 0 ? Math.round((b.total / grandTotal) * 100) : 0;
        return (
          <div class="method-card">
            <div class="mc-hd">
              <span class="mc-emoji">{m.emoji}</span>
              <span class="mc-name">{m.label}</span>
            </div>
            <div class="mc-total">{yen(b.total)}</div>
            <div class="mc-meta">
              <span>{b.count} 件</span>
              <span class="mc-pct">{pct}%</span>
            </div>
            <div class="mc-bar">
              <div class="mc-bar-fill" style={`width: ${pct}%`}></div>
            </div>
          </div>
        );
      })}
    </section>

    {byDay.length > 0 && (
      <section class="day-list">
        <h2>日別内訳</h2>
        <ul>
          {byDay.map((d) => (
            <li>
              <span class="day-date">{jaDateShort(d.date)}</span>
              <span class="day-count">{d.count} 件</span>
              <span class="day-total mono">{yen(d.total)}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="tx">
      <h2>明細 ({rows.length} 件)</h2>
      {rows.length === 0 ? (
        <p class="empty">この月の会計記録はまだありません。</p>
      ) : (
        <ul class="tx-list">
          {rows.map((r) => {
            const slot = r.slots ?? {};
            const g = r.guardians ?? {};
            const parts = (r.reservation_participants ?? []).map((p: any) => p.name_snapshot);
            return (
              <li class="tx-item">
                <div class="tx-hd">
                  <span class="tx-when mono">
                    {slot.date ? jaDateShort(slot.date) : '?'} {slot.start_time?.slice(0, 5) ?? ''}
                  </span>
                  <span class="tx-num mono">{r.reservation_number}</span>
                </div>
                <div class="tx-body">
                  <div class="tx-course">{slot.courses?.name ?? '(コース不明)'}</div>
                  <div class="tx-parties">
                    <span>👤 {g.name}</span>
                    <span class="tx-parts">🏁 {parts.join('・')}</span>
                  </div>
                  {r.payment_note && <div class="tx-note">📝 {r.payment_note}</div>}
                </div>
                <div class="tx-pay">
                  <span class="tx-method">{paymentLabel(r.payment_method)}</span>
                  <span class="tx-amount mono">{yen(Number(r.paid_amount ?? 0))}</span>
                  <span class="tx-paid mono">{jstHm(r.paid_at)}</span>
                </div>
              </li>
            );
          })}
        </ul>
      )}
    </section>
  </main>
</Base>

<style>
  main { max-width: 900px; margin: 0 auto; padding: 1.5rem 1.25rem 3rem; }
  .hd { padding-bottom: 1rem; border-bottom: 1px solid var(--line); margin-bottom: 1.2rem; }
  .back { display: inline-block; font-size: .78rem; color: var(--ink-3); text-decoration: none; margin-bottom: .4rem; }
  h1 { margin: 0 0 .3rem; font-size: 1.4rem; font-weight: 800; }
  .sub { margin: 0; color: var(--ink-3); font-size: .78rem; }

  .err {
    background: rgba(229,85,111,.08); border: 1px solid rgba(229,85,111,.3);
    color: var(--rose-deep);
    padding: .8rem 1rem; border-radius: 8px; margin-bottom: 1rem; font-size: .82rem;
  }

  .nav {
    display: flex; align-items: center; gap: .5rem; justify-content: center;
    margin-bottom: 1rem; flex-wrap: wrap;
  }
  .nav-btn {
    padding: .4rem .9rem; font-size: .82rem; font-weight: 700;
    border: 1.5px solid var(--line); border-radius: 8px;
    background: var(--bg); color: var(--ink-2); text-decoration: none;
  }
  .nav-btn:hover { background: var(--bg-2); }
  .nav-form { display: flex; gap: .3rem; }
  .nav-form input[type="month"] {
    padding: .35rem .5rem; font-size: .82rem;
    border: 1.5px solid var(--line); border-radius: 6px;
    background: var(--bg); font-family: var(--mono);
  }
  .btn-jump {
    padding: .4rem .8rem; font-size: .78rem; font-weight: 700;
    border: none; border-radius: 6px; cursor: pointer;
    background: var(--sky); color: #fff; font-family: var(--jp);
  }

  .hero {
    background: linear-gradient(135deg, var(--sun), var(--orange-deep));
    color: #fff; text-align: center; padding: 1.4rem 1rem;
    border-radius: 14px; margin-bottom: 1rem;
    box-shadow: 0 4px 14px rgba(229,131,26,.25);
  }
  .hero-ym { font-size: .82rem; opacity: .85; margin-bottom: .3rem; font-weight: 700; }
  .hero-total { font-family: var(--mono); font-size: 2.2rem; font-weight: 900; letter-spacing: -.02em; }
  .hero-count { font-size: .82rem; opacity: .9; margin-top: .2rem; }

  .method-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: .6rem; margin-bottom: 1.4rem;
  }
  .method-card {
    background: var(--bg); border: 1px solid var(--line); border-radius: 10px;
    padding: .8rem .9rem;
  }
  .mc-hd { display: flex; align-items: center; gap: .4rem; margin-bottom: .3rem; }
  .mc-emoji { font-size: 1.2rem; }
  .mc-name { font-size: .82rem; font-weight: 700; color: var(--ink-2); }
  .mc-total { font-family: var(--mono); font-size: 1.2rem; font-weight: 800; color: var(--ink); }
  .mc-meta {
    display: flex; justify-content: space-between;
    font-size: .72rem; color: var(--ink-3); margin: .2rem 0;
  }
  .mc-pct { font-family: var(--mono); font-weight: 700; }
  .mc-bar {
    height: 6px; background: var(--bg-3); border-radius: 100px; overflow: hidden;
  }
  .mc-bar-fill {
    height: 100%; background: linear-gradient(90deg, var(--sky), var(--sky-deep));
    border-radius: 100px; transition: width .3s;
  }

  h2 { font-size: 1rem; margin: 1.4rem 0 .6rem; font-weight: 800; }

  .day-list ul {
    list-style: none; margin: 0; padding: 0;
    background: var(--bg); border: 1px solid var(--line); border-radius: 10px;
    overflow: hidden;
  }
  .day-list li {
    display: flex; align-items: baseline; gap: .8rem;
    padding: .6rem 1rem; border-bottom: 1px solid var(--line);
    font-size: .84rem;
  }
  .day-list li:last-child { border-bottom: none; }
  .day-date { font-weight: 700; min-width: 5rem; }
  .day-count { color: var(--ink-3); font-size: .74rem; }
  .day-total { margin-left: auto; font-weight: 800; }

  .empty {
    text-align: center; padding: 2rem 1rem; color: var(--ink-3);
    font-size: .88rem; background: var(--bg-2); border-radius: 10px;
  }

  .tx-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: .5rem; }
  .tx-item {
    background: var(--bg); border: 1px solid var(--line); border-radius: 10px;
    padding: .7rem .9rem;
  }
  .tx-hd {
    display: flex; justify-content: space-between; gap: .5rem;
    font-size: .74rem; color: var(--ink-3); margin-bottom: .3rem;
  }
  .tx-when { font-weight: 700; color: var(--ink-2); }
  .tx-body { margin-bottom: .4rem; }
  .tx-course { font-size: .9rem; font-weight: 700; margin-bottom: .2rem; }
  .tx-parties { display: flex; gap: .8rem; flex-wrap: wrap; font-size: .78rem; color: var(--ink-2); }
  .tx-parts { color: var(--ink-3); }
  .tx-note {
    margin-top: .3rem; padding: .3rem .5rem;
    background: var(--bg-2); border-radius: 6px;
    font-size: .74rem; color: var(--ink-2);
  }
  .tx-pay {
    display: flex; align-items: baseline; gap: .5rem; flex-wrap: wrap;
    padding-top: .4rem; border-top: 1px dashed var(--line);
  }
  .tx-method {
    padding: 2px 8px; border-radius: 100px;
    background: rgba(255,201,67,.15); color: var(--orange-deep);
    font-size: .74rem; font-weight: 700;
  }
  .tx-amount { font-size: .95rem; font-weight: 800; margin-left: auto; }
  .tx-paid { font-size: .68rem; color: var(--ink-3); }

  .mono { font-family: var(--mono); }
</style>