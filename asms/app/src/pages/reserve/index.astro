---
import Base from '@layouts/Base.astro';
import { envFrom, getSupabase, getSupabaseAdmin } from '@lib/supabase';
import { getLocaleFromRequest, t, type Locale } from '@lib/i18n';

const env = envFrom(Astro.locals);
const supabase = getSupabase(env);
const admin = getSupabaseAdmin(env);
const locale: Locale = getLocaleFromRequest(Astro.request);
const isEn = locale === 'en';

// Always load the course menu — customers should see what we offer
// even when no dates are on the calendar yet.
const { data: courses } = await supabase
  .from('courses')
  .select('id, code, name, description, duration_min, price_regular, price_member, vehicle')
  .eq('is_active', true)
  .order('display_order');

// Load open upcoming slots (up to 4 months out).
// JST の「今日」を取る。UTC ベースの toISOString だと 00:00-08:59 JST の
// あいだ「昨日」の日付になり、カレンダーに前日のスロットが残ってしまう。
const today = new Intl.DateTimeFormat('en-CA', {
  timeZone: 'Asia/Tokyo',
  year: 'numeric', month: '2-digit', day: '2-digit',
}).format(new Date());
const { data: slots } = await supabase
  .from('slots')
  .select('id, date, start_time, end_time, capacity, course_id, courses(name, code)')
  .eq('status', 'open')
  .gte('date', today)
  .order('date')
  .order('start_time')
  .limit(400);

type Slot = NonNullable<typeof slots>[number];

// Compute remaining seats per slot. reservations is staff-only under
// RLS so we go through the service_role client for the join; we only
// return counts, no PII.
const slotIds = (slots ?? []).map((s) => s.id);
const reservedBySlot = new Map<string, number>();
if (slotIds.length > 0) {
  const { data: resWithParts } = await admin
    .from('reservations')
    .select('slot_id, reservation_participants(id, attendance_status)')
    .in('slot_id', slotIds)
    .neq('status', 'cancelled');
  for (const r of (resWithParts ?? []) as any[]) {
    // 個別参加者キャンセル (attendance_status='cancelled') は席を返している
    // ので残席計算から除外する。
    const activeParts = ((r.reservation_participants as any[]) ?? [])
      .filter((p) => p.attendance_status !== 'cancelled');
    const cnt = activeParts.length;
    reservedBySlot.set(r.slot_id, (reservedBySlot.get(r.slot_id) ?? 0) + cnt);
  }
}
const remainingFor = (s: Slot): number =>
  Math.max(0, s.capacity - (reservedBySlot.get(s.id) ?? 0));

// URL params: ?course=CODE filters the calendar/list to one course only,
// so hard-to-spot offerings (challenge classes run twice a month) surface
// on their own. ?month=YYYY-MM navigates the calendar view.
const url = new URL(Astro.request.url);
const courseFilter = url.searchParams.get('course') ?? '';
const activeCourse = courses?.find((c) => c.code === courseFilter) ?? null;

const filteredSlots = activeCourse
  ? (slots ?? []).filter((s) => (s.courses as any)?.code === activeCourse.code)
  : (slots ?? []);

const byDate = new Map<string, Slot[]>();
for (const s of filteredSlots) {
  const arr = byDate.get(s.date) ?? [];
  arr.push(s);
  byDate.set(s.date, arr);
}
const hasSlots = byDate.size > 0;

// Which month to render the calendar for
const urlMonth = url.searchParams.get('month');
let visYear: number;
let visMonth: number;
if (urlMonth && /^\d{4}-\d{2}$/.test(urlMonth)) {
  const [y, m] = urlMonth.split('-').map(Number);
  visYear = y; visMonth = m;
} else if (filteredSlots.length > 0) {
  const d = new Date(filteredSlots[0].date + 'T00:00:00');
  visYear = d.getFullYear();
  visMonth = d.getMonth() + 1;
} else {
  const n = new Date();
  visYear = n.getFullYear();
  visMonth = n.getMonth() + 1;
}

const monthStart = `${visYear}-${String(visMonth).padStart(2, '0')}-01`;
const daysInMonth = new Date(visYear, visMonth, 0).getDate();
const monthEnd = `${visYear}-${String(visMonth).padStart(2, '0')}-${String(daysInMonth).padStart(2, '0')}`;

const visSlots = filteredSlots.filter((s) => s.date >= monthStart && s.date <= monthEnd);
const visByDate = new Map<string, Slot[]>();
for (const s of visSlots) {
  const arr = visByDate.get(s.date) ?? [];
  arr.push(s);
  visByDate.set(s.date, arr);
}

const monthKey = (y: number, m: number) => `${y}-${String(m).padStart(2, '0')}`;
const monthsWithSlots = new Set<string>();
for (const s of filteredSlots) {
  monthsWithSlots.add(s.date.slice(0, 7));
}
const prevM = visMonth === 1 ? { y: visYear - 1, m: 12 } : { y: visYear, m: visMonth - 1 };
const nextM = visMonth === 12 ? { y: visYear + 1, m: 1 } : { y: visYear, m: visMonth + 1 };
const hasPrev = monthsWithSlots.has(monthKey(prevM.y, prevM.m));
const hasNext = monthsWithSlots.has(monthKey(nextM.y, nextM.m));

// Build URLs preserving the current course filter.
function makeUrl(params: Record<string, string | number>): string {
  const p = new URLSearchParams();
  if (activeCourse) p.set('course', activeCourse.code);
  for (const [k, v] of Object.entries(params)) p.set(k, String(v));
  const q = p.toString();
  return q ? `/reserve/?${q}` : '/reserve/';
}
function courseHref(code: string): string {
  return activeCourse?.code === code ? '/reserve/#dates' : `/reserve/?course=${code}#dates`;
}

// Calendar cells: leading blanks then day entries. Monday-start (ISO 8601)
// を採用。JS の getDay() は Sun=0..Sat=6 なので (+6)%7 で Mon=0..Sun=6 に
// シフトして padding 個数として使う。
// `count` = number of slots on this day with at least 1 seat remaining
// (fully-booked slots are excluded so the cell reflects real availability).
type Cell = { date: string; dayNum: number; count: number; dow: number } | null;
const jsFirstDow = new Date(visYear, visMonth - 1, 1).getDay();
const firstDow = (jsFirstDow + 6) % 7; // Monday-start padding
const cells: Cell[] = [];
for (let i = 0; i < firstDow; i++) cells.push(null);
for (let dnum = 1; dnum <= daysInMonth; dnum++) {
  const iso = `${visYear}-${String(visMonth).padStart(2, '0')}-${String(dnum).padStart(2, '0')}`;
  const daySlots = visByDate.get(iso) ?? [];
  const openCount = daySlots.filter((s) => remainingFor(s) > 0).length;
  cells.push({
    date: iso,
    dayNum: dnum,
    count: openCount,
    dow: new Date(visYear, visMonth - 1, dnum).getDay(),
  });
}
while (cells.length % 7 !== 0) cells.push(null);

// Next-schedule messaging: publish window is around the 25th of each month
// for the following month.
const now = new Date();
const day = now.getDate();
const thisMonth = now.getMonth() + 1;
const nextMonthNum = thisMonth === 12 ? 1 : thisMonth + 1;
const monthAfterNext = nextMonthNum === 12 ? 1 : nextMonthNum + 1;
const scheduleNoticeMonth = day < 25 ? nextMonthNum : monthAfterNext;
const scheduleNoticeReleaseMonth = day < 25 ? thisMonth : nextMonthNum;
const scheduleNotice = day < 25
  ? `${nextMonthNum}月分のスケジュールは ${thisMonth}/25 頃に公開予定です。`
  : `${monthAfterNext}月分のスケジュールは ${nextMonthNum}/25 頃に公開予定です。`;
const scheduleNoticeEn = `The schedule for ${new Date(2000, scheduleNoticeMonth - 1).toLocaleString('en-US', { month: 'long' })} will be released around the 25th of ${new Date(2000, scheduleNoticeReleaseMonth - 1).toLocaleString('en-US', { month: 'long' })}.`;

// getDay() (Sun=0..Sat=6) から曜日名を引くための配列
const weekdayJa = ['日', '月', '火', '水', '木', '金', '土'];
const weekdayEn = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
// カレンダーグリッドのヘッダーは月曜始まり
const calHeaderJa = ['月', '火', '水', '木', '金', '土', '日'];
const calHeaderEn = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
function formatDate(iso: string): string {
  const d = new Date(iso + 'T00:00:00');
  if (isEn) {
    const monthsEn = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
    return `${monthsEn[d.getMonth()]} ${d.getDate()} (${weekdayEn[d.getDay()]})`;
  }
  return `${d.getMonth() + 1}月${d.getDate()}日 (${weekdayJa[d.getDay()]})`;
}
// 英語版ではトヨピー会員価格を非表示 (外国人観光客はメンバー対象外)。
function priceLabel(regular: number, member: number): string {
  if (isEn) return `¥${regular.toLocaleString()}`;
  if (regular === member) return `¥${regular.toLocaleString()}`;
  return `¥${regular.toLocaleString()} / 会員 ¥${member.toLocaleString()}`;
}
function vehicleLabel(v: string): string {
  switch (v) {
    case 'toyopet_kart': return isEn ? 'Toyopet Kart' : 'トヨピーカート';
    case 'rotax_micro': return 'Rotax Micro';
    default: return '';
  }
}

const visSortedDates = Array.from(visByDate.keys()).sort();

// Magic Link auth config for client-side sign-in state display
const supabaseUrl = env.PUBLIC_SUPABASE_URL;
const supabaseAnonKey = env.PUBLIC_SUPABASE_ANON_KEY;
---
<Base
  title={isEn ? 'Book Now — Fukuoka Kids Kart Academy' : '予約 — 福岡キッズカートアカデミー'}
  lang={locale}
  showLocaleSwitch={true}
>
  <main>
    <header class="hd">
      <a class="back" href="/">← {isEn ? 'Home' : 'ホーム'}</a>
      <h1>{t(locale, 'landing.title')} <span class="beta">β</span></h1>
      <p class="sub">{t(locale, 'landing.subtitle')}</p>
      <div id="signedInBadge" class="signedin-badge" hidden>
        <span class="sb-icon">🔑</span>
        <span class="sb-text">
          {isEn ? 'Signed in as: ' : 'サインイン中: '}
          <span id="signedInEmail" class="sb-email"></span>
        </span>
        <button type="button" id="signOutBtn" class="sb-signout">{isEn ? 'Sign out' : 'サインアウト'}</button>
      </div>
    </header>

    <section class="info-card">
      <details>
        <summary>
          <span class="ic-icon">📖</span>
          {isEn ? (
            <span class="ic-title">First time here? <small>(Age, what to bring, dress code, cancellation policy)</small></span>
          ) : (
            <span class="ic-title">初めての方へ <small>（対象年齢・持ち物・服装・キャンセル規定）</small></span>
          )}
          <span class="ic-chev">▼</span>
        </summary>
        {isEn ? (
          <div class="ic-body">
            <div class="ic-item">
              <div class="ic-h">👶 Age Requirement</div>
              <div>Ages 4 and up (course-specific size and experience requirements may apply).</div>
            </div>
            <div class="ic-item">
              <div class="ic-h">👟 What to Bring</div>
              <div><strong>Sneakers only</strong> — jumpsuit and helmet provided free. Gloves gifted on first visit, please bring your own from the 2nd visit onward.</div>
            </div>
            <div class="ic-item">
              <div class="ic-h">👨‍👩‍👧 Guardian Attendance</div>
              <div>A guardian must accompany the child. Non-participants may not enter designated driving areas.</div>
            </div>
            <div class="ic-item">
              <div class="ic-h">🌦 Rainy Weather</div>
              <div>Light rain: we operate under sheltered sections. Thunder, typhoon, or strong wind: we notify you of cancellation by the morning of the event.</div>
            </div>
            <div class="ic-item">
              <div class="ic-h">💰 Cancellation Policy</div>
              <ul>
                <li><strong>Until 2 hours before start</strong>: no cancellation fee</li>
                <li><strong>Within 2 hours of start / no-show</strong>: 100% cancellation fee</li>
                <li>No fee if we cancel for operational/weather reasons</li>
              </ul>
            </div>
            <div class="ic-item">
              <div class="ic-h">💰 Payment</div>
              <div><strong>Cash or PayPay</strong> accepted. Please pay on-site on the day of your booking.</div>
            </div>
            <div class="ic-item">
              <div class="ic-h">🏥 Health Conditions / Allergies</div>
              <div>Please tell us in advance for safety. There's a field on the booking form for participant health notes.</div>
            </div>
          </div>
        ) : (
          <div class="ic-body">
            <div class="ic-item">
              <div class="ic-h">👶 対象年齢</div>
              <div>4 歳以上（コースにより体格・経験条件あり）</div>
            </div>
            <div class="ic-item">
              <div class="ic-h">👟 持ち物・服装</div>
              <div><strong>運動靴のみ必須</strong>。つなぎ・ヘルメットは無料貸出。軍手は初回プレゼント、2 回目以降ご持参。</div>
            </div>
            <div class="ic-item">
              <div class="ic-h">👨‍👩‍👧 保護者の同伴</div>
              <div>原則、保護者の同伴が必要です。走行中は指定エリア外への立ち入り不可。</div>
            </div>
            <div class="ic-item">
              <div class="ic-h">🌦 雨天時</div>
              <div>小雨なら屋根のあるコース区画で実施。雷・台風・強風など安全に走行できないと判断した場合は当日朝までにキャンセル連絡します。</div>
            </div>
            <div class="ic-item">
              <div class="ic-h">💰 キャンセル規定</div>
              <ul>
                <li><strong>開始 2 時間前まで</strong>: キャンセル料なし</li>
                <li><strong>開始 2 時間前以降・無連絡不参加</strong>: キャンセル料 100%</li>
                <li>運営都合による中止の場合、キャンセル料なし</li>
              </ul>
            </div>
            <div class="ic-item">
              <div class="ic-h">💰 お支払い</div>
              <div><strong>現金・PayPay</strong> でのお支払いを承ります。当日現地でお支払いください。</div>
            </div>
            <div class="ic-item">
              <div class="ic-h">🏥 持病・アレルギー・配慮事項</div>
              <div>安全のため事前にお知らせください。予約フォームの参加者情報欄にご記入いただけます。</div>
            </div>
          </div>
        )}
      </details>
    </section>

    <section class="courses">
      <div class="section-h">
        <h2>{isEn ? 'Course List' : 'コース一覧'}</h2>
        <p>{isEn
          ? 'Tap "Book this course" to filter the calendar to just this course.'
          : '「このコースで予約する」で開催カレンダーが絞り込まれます'}</p>
      </div>
      <div class="course-grid">
        {courses?.map((c) => (
          <div class={`course c-${c.code} ${activeCourse?.code === c.code ? 'active' : ''}`}>
            <div class="course-head">
              <div class="course-name">
                <span class="course-name-text">{c.name}</span>
                {c.code === 'taiken' && (
                  <span class="course-star">
                    {isEn ? '⭐️ Recommended for first-timers' : '⭐️ 初めての方はこちら'}
                  </span>
                )}
                {c.vehicle !== 'mini_default' && (
                  <span class="course-veh">{vehicleLabel(c.vehicle)}</span>
                )}
                {activeCourse?.code === c.code && (
                  <span class="course-active">{isEn ? '✓ Now viewing' : '✓ 表示中'}</span>
                )}
              </div>
              <div class="course-meta">
                <span class="course-dur">{c.duration_min}{isEn ? ' min' : '分'}</span>
                <span class="course-price">{priceLabel(c.price_regular, c.price_member)}</span>
              </div>
            </div>
            {c.description && !isEn && (
              <details class="course-details">
                <summary>📖 コース内容を見る</summary>
                <div class="course-desc-body">
                  {c.description.split('\n').filter(Boolean).map((line) => (
                    <p>{line}</p>
                  ))}
                </div>
              </details>
            )}
            <a class="course-cta" href={courseHref(c.code)}>
              {activeCourse?.code === c.code
                ? (isEn ? '✓ Currently showing this course' : '✓ このコースで表示中')
                : (isEn ? 'Book this course →' : 'このコースで予約する →')}
            </a>
          </div>
        ))}
      </div>
      {!isEn && (
        <p class="member-note">💡 <strong>トヨピー会員価格</strong>は当日受付での会員登録でも適用可能。LINE 友達とは別プログラムです。<br>
          <a class="toyopet-link" href="https://family-fukuoka-toyopet.com/pre-regist.html" target="_blank" rel="noopener">🚗 事前登録はこちら</a>
          <a class="toyopet-link" href="https://fukuoka-toyopet.jp/file/special/18101/21013/kids_membership/index.html" target="_blank" rel="noopener">ℹ️ トヨピー会員について</a>
        </p>
      )}
    </section>

    {hasSlots ? (
      <section class="dates" id="dates">
        <div class="section-h">
          <h2>{isEn ? 'Choose a Date' : '開催予定日を選ぶ'}</h2>
          {activeCourse ? (
            <div class="filter-chip">
              <span>🔍 <strong>{activeCourse.name}</strong> {isEn ? 'filter active' : 'で絞り込み中'}</span>
              <a href="/reserve/" class="clear-filter">{isEn ? '✕ Show all' : '✕ 全て表示'}</a>
            </div>
          ) : (
            <p>{isEn
              ? 'Tap a highlighted day on the calendar to see available time slots.'
              : 'カレンダーの緑の日をタップして時間帯を選んでください'}</p>
          )}
        </div>

        <div class="cal-wrap">
          <div class="cal-hd">
            {hasPrev ? (
              <a class="cal-nav" href={makeUrl({ month: monthKey(prevM.y, prevM.m) })}>
                {isEn ? '← Prev' : `← ${prevM.m}月`}
              </a>
            ) : (
              <span class="cal-nav disabled">{isEn ? '← Prev' : `← ${prevM.m}月`}</span>
            )}
            <div class="cal-title">
              {isEn
                ? new Date(visYear, visMonth - 1, 1).toLocaleString('en-US', { month: 'long', year: 'numeric' })
                : `${visYear}年 ${visMonth}月`}
            </div>
            {hasNext ? (
              <a class="cal-nav" href={makeUrl({ month: monthKey(nextM.y, nextM.m) })}>
                {isEn ? 'Next →' : `${nextM.m}月 →`}
              </a>
            ) : (
              <span class="cal-nav disabled">{isEn ? 'Next →' : `${nextM.m}月 →`}</span>
            )}
          </div>

          <p class="cal-legend">
            {isEn
              ? 'Tap a green day → time slots will appear below'
              : '緑の日をタップ → 下に時間帯一覧が表示されます'}
          </p>
          <div class="cal-grid">
            {(isEn ? calHeaderEn : calHeaderJa).map((w, i) => (
              <div class={`cal-dow ${i === 6 ? 'sun' : ''} ${i === 5 ? 'sat' : ''}`}>{w}</div>
            ))}
            {cells.map((cell) => (
              cell === null
                ? <div class="cal-cell blank" />
                : (cell.count > 0
                    ? (
                      <a class={`cal-cell has ${cell.dow === 0 ? 'sun' : ''} ${cell.dow === 6 ? 'sat' : ''}`}
                         href={`#day-${cell.date}`}>
                        <span class="cal-day">{cell.dayNum}</span>
                        <span class="cal-count">{cell.count}{isEn ? '' : '枠'}</span>
                      </a>
                    )
                    : (
                      <div class={`cal-cell muted ${cell.dow === 0 ? 'sun' : ''} ${cell.dow === 6 ? 'sat' : ''}`}>
                        <span class="cal-day">{cell.dayNum}</span>
                      </div>
                    )
                )
            ))}
          </div>
        </div>

        {visSortedDates.length === 0 ? (
          <p class="no-in-month">
            {isEn ? (
              activeCourse
                ? `No ${activeCourse.name} sessions scheduled for this month.`
                : 'No sessions scheduled for this month.'
            ) : (
              activeCourse
                ? `${activeCourse.name} の ${visYear}年${visMonth}月 開催予定はありません。`
                : `${visYear}年${visMonth}月は開催予定がありません。`
            )}
            {(hasPrev || hasNext) && (isEn ? ' Please try previous / next month.' : '前月/翌月をお試しください。')}
          </p>
        ) : (
          <div class="day-list">
            {visSortedDates.map((date) => (
              <div class="day-card" id={`day-${date}`}>
                <div class="day-head">{formatDate(date)}</div>
                <ul class="slot-list">
                  {visByDate.get(date)!.map((s) => {
                    const remaining = remainingFor(s);
                    const isFull = remaining === 0;
                    return (
                      <li class={isFull ? 'is-full' : ''}>
                        {isFull ? (
                          <div class="slot-link">
                            <span class="slot-time">{s.start_time.slice(0, 5)}</span>
                            <span class="slot-course">{(s.courses as any)?.name ?? ''}</span>
                            <span class="slot-cap slot-cap-full">{isEn ? 'Full' : '満席'}</span>
                            <span class="slot-arrow" aria-hidden="true">×</span>
                          </div>
                        ) : (
                          <a class="slot-link" href={`/reserve/${s.id}`}>
                            <span class="slot-time">{s.start_time.slice(0, 5)}</span>
                            <span class="slot-course">{(s.courses as any)?.name ?? ''}</span>
                            {remaining <= 3 && (
                              <span class="slot-cap slot-cap-low">{isEn ? 'Few left' : '残りわずか'}</span>
                            )}
                            <span class="slot-arrow">→</span>
                          </a>
                        )}
                      </li>
                    );
                  })}
                </ul>
              </div>
            ))}
          </div>
        )}
      </section>
    ) : (
      <section class="empty">
        <div class="empty-card">
          <div class="empty-icon">📅</div>
          {activeCourse ? (
            <>
              <h2>
                {isEn
                  ? `No sessions of ${activeCourse.name} scheduled`
                  : `${activeCourse.name} の開催予定はありません`}
              </h2>
              <p class="notice">
                {isEn
                  ? 'No dates are currently registered. Please check back later.'
                  : '現時点で予定登録がありません。次回開催をお待ちください。'}
              </p>
              <p class="policy">
                <a href="/reserve/">{isEn ? '← See all course schedules' : '← 全てのコースの開催予定を見る'}</a>
              </p>
            </>
          ) : (
            <>
              <h2>{isEn ? 'No upcoming sessions available' : '現在、公開中の開催予定はありません'}</h2>
              <p class="notice">{isEn ? scheduleNoticeEn : scheduleNotice}</p>
              <p class="policy">
                {isEn
                  ? 'Schedules are typically updated around the 25th of each month.'
                  : (<>スケジュール更新は原則毎月 <strong>25 日頃</strong>です。</>)}
              </p>
            </>
          )}
        </div>

        <div class="cta-card">
