<script is:inline define:vars={{ supabaseUrl, supabaseAnonKey }}>
  window.__ASMS_AUTH_CFG = { supabaseUrl, supabaseAnonKey };
</script>

<script>
  // Show signed-in badge and hide the "sign in" invite when a Supabase
  // session exists. Fast-path localStorage check avoids loading the
  // supabase-js bundle on every calendar view.
  const signedInBadge = document.getElementById('signedInBadge');
  const signedInEmail = document.getElementById('signedInEmail');
  const signOutBtn = document.getElementById('signOutBtn');

  const hasSessionHint = (() => {
    try { return !!localStorage.getItem('asms:auth'); } catch { return false; }
  })();

  if (hasSessionHint) {
    (async () => {
      const cfg = (window as any).__ASMS_AUTH_CFG;
      if (!cfg?.supabaseUrl) return;
      try {
        const { getAuthClient, currentSession, hardSignOut } = await import('@lib/authWrapper');
        const client = getAuthClient(cfg.supabaseUrl, cfg.supabaseAnonKey);
        const session = await currentSession(client);
        // Safety: only show badge if we actually have an email.
        // If session exists but email is missing, treat as signed-out state.
        if (!session?.user?.email) {
          // Stale session hint — clear it so badge doesn't flash next reload.
          try { localStorage.removeItem('asms:auth'); } catch {}
          return;
        }
        if (signedInEmail) signedInEmail.textContent = session.user.email;
        if (signedInBadge) signedInBadge.hidden = false;
        signOutBtn?.addEventListener('click', async () => {
          if (!confirm('サインアウトしますか？')) return;
          await hardSignOut(client, '/reserve/');
        });
      } catch (e) {
        console.warn('[signin-state] failed', e);
      }
    })();
  }
</script>

