---
import Base from '@layouts/Base.astro';
import { envFrom, getSupabase, getSupabaseAdmin } from '@lib/supabase';
import { getLocaleFromRequest, type Locale } from '@lib/i18n';

const env = envFrom(Astro.locals);
const supabase = getSupabase(env);
const admin = getSupabaseAdmin(env);
const locale: Locale = getLocaleFromRequest(Astro.request);
const isEn = locale === 'en';

const { slotId } = Astro.params;

const { data: slot } = await supabase
  .from('slots')
  .select('id, date, start_time, end_time, capacity, status, course_id, courses(id, code, name, description, duration_min, price_regular, price_member, vehicle, requires_approval)')
  .eq('id', slotId)
  .maybeSingle();

if (!slot || slot.status !== 'open') {
  return new Response(null, { status: 302, headers: { Location: '/reserve/' } });
}

// Count participants already reserved on this slot (admin so nothing is
// hidden by RLS — reservations are staff-only otherwise).
const { data: existingRes } = await admin
  .from('reservations')
  .select('id')
  .eq('slot_id', slot.id)
  .neq('status', 'cancelled');
const resIds = (existingRes ?? []).map((r: any) => r.id);
let reservedCount = 0;
if (resIds.length > 0) {
  // 個別参加者キャンセル (attendance_status='cancelled') は席を返しているので除外
  const { count } = await admin
    .from('reservation_participants')
    .select('*', { count: 'exact', head: true })
    .in('reservation_id', resIds)
    .neq('attendance_status', 'cancelled');
  reservedCount = count ?? 0;
}
const remaining = Math.max(0, slot.capacity - reservedCount);

const { data: terms } = await supabase
  .from('terms')
  .select('id, version, body_markdown, body_summary, weather_policy_md, cancel_policy_md, safety_items')
  .eq('is_current', true)
  .maybeSingle();

const course = (slot.courses as any) ?? {};
const weekdayJa = ['日', '月', '火', '水', '木', '金', '土'];
const d = new Date(slot.date + 'T00:00:00');
const dateLabel = `${d.getFullYear()}年${d.getMonth() + 1}月${d.getDate()}日 (${weekdayJa[d.getDay()]})`;
const timeLabel = `${slot.start_time.slice(0, 5)}${slot.end_time ? '–' + slot.end_time.slice(0, 5) : ''}`;

const priceRegular = course.price_regular ?? 0;
const priceMember = course.price_member ?? 0;
const requiresApproval = !!course.requires_approval;
const maxParticipants = Math.min(3, remaining);
const safetyItems = (terms?.safety_items as Array<{ id: number; text: string }>) ?? [];

// Turnstile: only render the widget if a site key is configured. This
// lets local/dev deploys work without a Turnstile account, and lets
// the site owner opt in later without a code change.
const turnstileSiteKey = env.PUBLIC_TURNSTILE_SITE_KEY ?? '';
const turnstileEnabled = !!turnstileSiteKey;

// Magic Link auth config (Phase 2 #6): passed to client-side JS so it
// can (a) detect an existing auth session and pull prefill from
// /api/me/prefill, and (b) send users to /reserve/signin?next= for
// cross-device sign-in.
const supabaseUrl = env.PUBLIC_SUPABASE_URL;
const supabaseAnonKey = env.PUBLIC_SUPABASE_ANON_KEY;
const signinUrl = `/reserve/signin?next=${encodeURIComponent(Astro.request.url ? new URL(Astro.request.url).pathname : '/reserve/')}`;

// Tiny markdown → HTML for the seeded terms. Covers only what the seed
// uses: ATX headings, unordered lists, bold, paragraphs. Escapes HTML
// input, so it's safe to feed the raw terms body straight in.
function renderMarkdown(src: string): string {
  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => (
    { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' } as Record<string, string>
  )[c]);
  const lines = esc(src).split(/\r?\n/);
  const out: string[] = [];
  let inList = false;
  const closeList = () => { if (inList) { out.push('</ul>'); inList = false; } };
  for (const raw of lines) {
    const line = raw.trimEnd();
    if (!line) { closeList(); continue; }
    const h = line.match(/^(#{1,3})\s+(.*)$/);
    if (h) {
      closeList();
      const level = h[1].length;
      out.push(`<h${level}>${h[2]}</h${level}>`);
      continue;
    }
    if (line.startsWith('- ')) {
      if (!inList) { out.push('<ul>'); inList = true; }
      out.push(`<li>${inlineFormat(line.slice(2))}</li>`);
      continue;
    }
    closeList();
    out.push(`<p>${inlineFormat(line)}</p>`);
  }
  closeList();
  return out.join('\n');

  function inlineFormat(s: string): string {
    return s.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
  }
}

const termsHtml = terms
  ? [terms.body_markdown, terms.cancel_policy_md, terms.weather_policy_md]
      .map(renderMarkdown)
      .join('<hr />')
  : '';
---
<Base
  title={isEn
    ? `Booking — ${course.name} · ${dateLabel}`
    : `予約フロー — ${course.name} · ${dateLabel}`}
  lang={locale}
  showLocaleSwitch={true}
>
  <main class="wizard">
    <header class="wz-hd">
      <a class="back" href="/reserve/">
        {isEn ? '← Back to schedule' : '← 予約枠一覧へ戻る'}
      </a>
      <h1>{isEn ? 'Booking' : '予約フロー'}</h1>
      <div class="slot-summary">
        <div class="ss-course">{course.name}</div>
        <div class="ss-meta">
          <span class="mono">{dateLabel}</span>
          <span class="sep">·</span>
          <span class="mono">{timeLabel}</span>
        </div>
        <div class="ss-price">
          {isEn ? (
            <>Price: <strong>¥{priceRegular.toLocaleString()}</strong> / person</>
          ) : (
            <>
              料金: <strong>¥{priceRegular.toLocaleString()}</strong> / 会員 ¥{priceMember.toLocaleString()}
              {priceRegular === priceMember && <span class="ss-note">（一般・会員同額）</span>}
            </>
          )}
        </div>
        <div class="ss-remaining">
          {isEn
            ? (<><strong>{remaining}</strong> seat(s) left</>)
            : (<>残 <strong>{remaining}</strong> 名</>)}
        </div>
      </div>
    </header>

    {remaining === 0 && (
      <div class="err">
        {isEn
          ? (<><strong>Fully booked.</strong> Please choose another date.</>)
          : (<><strong>満席です。</strong> 他の日程からお選びください。</>)}
      </div>
    )}

    {!terms && (
      <div class="err">
        {isEn
          ? (<><strong>Terms of service not configured.</strong> Please contact the operator.</>)
          : (<><strong>利用規約が未登録です。</strong> 管理者にお問い合わせください。</>)}
      </div>
    )}

    {remaining > 0 && terms && (
      <>
        <div class="progress-wrap" aria-label={isEn ? 'Progress' : '進行状況'}>
          <ol class="progress">
            <li data-step="1"><span>1</span>{isEn ? 'Details' : '予約内容'}</li>
            <li data-step="2"><span>2</span>{isEn ? 'Participants' : '参加者'}</li>
            <li data-step="3"><span>3</span>{isEn ? 'Guardian' : '保護者'}</li>
            <li data-step="4"><span>4</span>{isEn ? 'Emergency' : '緊急連絡先'}</li>
            <li data-step="5"><span>5</span>{isEn ? 'Terms' : '規約'}</li>
            <li data-step="6"><span>6</span>{isEn ? 'Safety' : '安全確認'}</li>
            <li data-step="7"><span>7</span>{isEn ? 'Signature' : '署名'}</li>
            <li data-step="8"><span>8</span>{isEn ? 'Confirm' : '確認'}</li>
          </ol>
        </div>

        <form id="wz" novalidate
              data-slot-id={slot.id}
              data-term-id={terms.id}
              data-max-participants={maxParticipants}
              data-price-regular={priceRegular}
              data-price-member={priceMember}
              data-course-name={course.name}
              data-slot-label={`${dateLabel} ${timeLabel}`}
              data-requires-approval={requiresApproval ? '1' : '0'}>

          <section class="step" data-step="1">
            <h2>{isEn ? '1. Booking Details' : '1. 予約内容の確認'}</h2>

            <div id="prefillPanel" hidden class="prefill-panel">
              <div class="pp-h" id="prefillHeading">
                {isEn
                  ? '🔁 Previous booking info found on this browser'
                  : '🔁 このブラウザに前回のご予約情報が保存されています'}
              </div>
              <div class="pp-actions">
                <button type="button" id="prefillApply" class="btn btn-primary">
                  {isEn ? 'Use previous info' : '前回の情報を使う'}
                </button>
                <button type="button" id="prefillClear" class="btn btn-ghost">
                  {isEn ? 'Clear' : '情報を削除'}
                </button>
              </div>
              <p class="hint" id="prefillHint">
                {isEn
                  ? '* Stored only in this browser. Not visible from other devices. Signature is required each time.'
                  : '※ この端末のブラウザ内にのみ保存されています。他の端末や他人のブラウザからは見えません。署名は毎回必要です。'}
              </p>
            </div>

            <div id="signinInvite" hidden class="signin-invite">
              <div class="si-h">
                {isEn
                  ? '📧 Booked with us before from another device?'
                  : '📧 以前、別端末でご予約したことがある方は'}
              </div>
              <p class="si-hint">
                {isEn
                  ? 'Sign in with your email to auto-fill previous booking info.'
                  : 'メールでサインインすると、前回のご予約情報が自動でフォームに入ります（機種変更・PC 利用など）。'}
              </p>
              <a class="btn btn-ghost" href={signinUrl}>
                {isEn ? 'Sign in with email' : 'メールでサインイン'}
              </a>
            </div>

            <div id="signedInEmpty" hidden class="signedin-empty">
              <div class="se-h">
                {isEn ? '🔑 Signed in as ' : '🔑 サインイン中 '}
                <span id="seEmail" class="se-email"></span>
              </div>
              <p class="se-hint">
                {isEn
                  ? 'No previous booking history found for this account. Please fill in the form below.'
                  : 'このアカウントで過去の予約履歴が見つかりませんでした。フォームを入力してご予約ください。'}
              </p>
              <button type="button" id="seSignOut" class="btn-signout-small">
                {isEn ? 'Sign out' : 'サインアウト'}
              </button>
            </div>

            <div class="field">
              <label>{isEn ? 'Number of participants' : '参加人数'}</label>
              <div class="count-picker">
                {Array.from({ length: maxParticipants }, (_, i) => i + 1).map((n) => (
                  <label class="cp-choice">
                    <input type="radio" name="participant_count" value={n} checked={n === 1} />
                    <span>{isEn ? `${n} person${n > 1 ? 's' : ''}` : `${n} 名`}</span>
                  </label>
                ))}
              </div>
            </div>

            {isEn ? (
              // 英語版: 会員種別 UI 全体非表示、常に regular で確定
              <input type="hidden" name="price_tier" value="regular" />
            ) : (
              <div class="field">
                <label>会員種別</label>
                <div class="count-picker">
                  <label class="cp-choice">
                    <input type="radio" name="price_tier" value="regular" checked />
                    <span>一般 ¥{priceRegular.toLocaleString()}/名</span>
                  </label>
                  <label class="cp-choice">
                    <input type="radio" name="price_tier" value="member" />
                    <span>会員 ¥{priceMember.toLocaleString()}/名</span>
                  </label>
                </div>
                <p class="hint">会員未登録の方でも当日受付で会員登録可能です。</p>

                <div id="memberConfirm" hidden class="member-confirm">
                  <label>
                    <input type="checkbox" id="memberConfirmChk" />
                    <span>✅ <strong>トヨピー会員に登録済み</strong>です</span>
                  </label>
                  <p class="hint">会員価格でのご予約には、当日または事前にトヨピー会員登録が必要です。</p>
                  <div class="toyopet-links">
                    <a class="toyopet-regist-link" href="https://family-fukuoka-toyopet.com/pre-regist.html" target="_blank" rel="noopener">🚗 事前登録はこちら</a>
                    <a class="toyopet-regist-link" href="https://fukuoka-toyopet.jp/file/special/18101/21013/kids_membership/index.html" target="_blank" rel="noopener">ℹ️ トヨピー会員について</a>
                  </div>
                </div>
              </div>
            )}

            <div class="total-preview">
              {isEn ? 'Total: ' : '合計: '}<strong id="totalPreview">¥{priceRegular.toLocaleString()}</strong>
            </div>

            {requiresApproval && (
              <div class="notice">
                {isEn
                  ? (<>💡 This course requires <strong>approval</strong>. We'll confirm your booking after review.</>)
                  : (<>💡 このコースは<strong>承認制</strong>です。予約送信後、当社確認後に確定通知をお送りします。</>)}
              </div>
            )}

            <div class="nav-btns">
              <button type="button" class="btn btn-primary" data-goto="2">
                {isEn ? 'Next →' : '次へ →'}
              </button>
            </div>
          </section>

          <section class="step" data-step="2" hidden>
            <h2>{isEn ? '2. Participant Info' : '2. 参加者情報'}</h2>
            <p class="hint">
              {isEn ? 'Please fill in details for everyone who will drive.' : '走行される全員の情報をご入力ください。'}
            </p>

            <div id="participantsHost"></div>

            <template id="participantTpl">
              <div class="participant" data-p-index="">
                <h3 class="p-hd">{isEn ? 'Participant ' : '参加者 '}<span class="p-num"></span></h3>
                <div class="grid-2">
                  <div class="field">
                    <label>{isEn ? 'Name *' : 'お名前 *'}</label>
                    <input type="text" name="p_name" required maxlength="40" />
                  </div>
                  <div class="field">
                    <label>{isEn ? 'Name (phonetic) *' : 'フリガナ *'}</label>
                    <input type="text" name="p_kana" required maxlength="40" placeholder={isEn ? 'e.g. YAMADA TARO' : 'ヤマダタロウ'} />
                  </div>
                  <div class="field">
                    <label>{isEn ? 'Date of birth *' : '生年月日 *'}</label>
                    <input type="date" name="p_birth" required />
                  </div>
                  <div class="field">
                    <label>{isEn ? 'Gender *' : '性別 *'}</label>
                    <select name="p_gender" required>
                      <option value="">{isEn ? '— Select —' : '— 選択 —'}</option>
                      <option value="male">{isEn ? 'Male' : '男'}</option>
                      <option value="female">{isEn ? 'Female' : '女'}</option>
                      <option value="other">{isEn ? 'Other' : 'その他'}</option>
                    </select>
                  </div>
                  <div class="field">
                    <label>{isEn ? 'Height (cm) *' : '身長 (cm) *'}</label>
                    <input type="number" name="p_height" required min="80" max="200" step="1" />
                  </div>
                </div>
                <div class="field">
                  <label>{isEn ? 'Kart experience (optional)' : 'カート経験（任意）'}</label>
                  <input type="text" name="p_experience" maxlength="120" placeholder={isEn ? 'e.g. First time / Xx times at ...' : '例: 初めて／〇〇でN回'} />
                </div>
                <div class="field">
                  <label>{isEn ? 'Photo consent *' : '写真撮影同意 *'}</label>
                  <div class="radio-row">
                    <label class="cp-choice small">
                      <input type="radio" name="p_photo" value="allow" checked />
                      <span>{isEn ? 'OK' : 'OK'}</span>
                    </label>
                    <label class="cp-choice small">
                      <input type="radio" name="p_photo" value="face_blur_only" />
                      <span>{isEn ? 'Blur face only' : '顔ぼかしのみ OK'}</span>
                    </label>
                    <label class="cp-choice small">
                      <input type="radio" name="p_photo" value="deny" />
                      <span>{isEn ? 'No photos' : '不可'}</span>
                    </label>
                  </div>
                </div>
              </div>
            </template>

            <div class="nav-btns">
              <button type="button" class="btn btn-ghost" data-goto="1">{isEn ? '← Back' : '← 戻る'}</button>
              <button type="button" class="btn btn-primary" data-goto="3">{isEn ? 'Next →' : '次へ →'}</button>
            </div>
          </section>

          <section class="step" data-step="3" hidden>
            <h2>{isEn ? '3. Guardian Info' : '3. 保護者情報'}</h2>
            <div class="grid-2">
              <div class="field">
                <label>{isEn ? 'Name *' : 'お名前 *'}</label>
                <input type="text" name="g_name" required maxlength="40" />
              </div>
              <div class="field">
                <label>{isEn ? 'Name (phonetic) *' : 'フリガナ *'}</label>
                <input type="text" name="g_kana" required maxlength="40" />
              </div>
              <div class="field">
                <label>{isEn ? 'Phone number *' : '電話番号 *'}</label>
                <input type="tel" name="g_phone" required maxlength="20" placeholder={isEn ? '+81 90-1234-5678' : '09012345678'} />
              </div>
              <div class="field">
                <label>{isEn ? 'Email *' : 'メールアドレス *'}</label>
                <input type="email" name="g_email" required maxlength="120" />
              </div>
              <div class="field">
                <label>{isEn ? 'Postal code' : '郵便番号'}</label>
                <input type="text" id="g_postal" name="g_postal" maxlength="10" placeholder="8110011"
                  inputmode="numeric" autocomplete="postal-code" />
                <p class="hint zip-hint" id="zipHint">
                  {isEn ? 'Enter 7 digits and address will auto-fill (Japan only)' : '7桁入力で住所が自動入力されます'}
                </p>
              </div>
              <div class="field field-wide">
                <label>{isEn ? 'Address' : '住所'}</label>
                <input type="text" id="g_address" name="g_address" maxlength="200"
                  placeholder={isEn ? 'e.g. Fukuoka, Fukuoka-shi…' : '福岡県福岡市…'}
                  autocomplete="street-address" />
              </div>
            </div>
            <div class="nav-btns">
              <button type="button" class="btn btn-ghost" data-goto="2">{isEn ? '← Back' : '← 戻る'}</button>
              <button type="button" class="btn btn-primary" data-goto="4">{isEn ? 'Next →' : '次へ →'}</button>
            </div>
          </section>

          <section class="step" data-step="4" hidden>
            <h2>{isEn ? '4. Emergency Contact' : '4. 緊急連絡先'}</h2>
            <p class="hint">
              {isEn
                ? 'A contact reachable on the day if the guardian is unreachable.'
                : '当日、保護者ご本人と連絡が取れない場合の連絡先です。'}
            </p>

            <div class="same-as-guardian">
              <label>
                <input type="checkbox" id="sameAsGuardian" checked />
                <span>
                  {isEn
                    ? (<>👤 <strong>Same as guardian</strong> (use guardian info as emergency contact)</>)
                    : (<>👤 <strong>保護者と同じ</strong>（保護者情報を緊急連絡先として使用）</>)}
                </span>
              </label>
            </div>

            <div id="emergencyFields" hidden>
              <div class="grid-2">
                <div class="field">
                  <label>{isEn ? 'Name *' : 'お名前 *'}</label>
                  <input type="text" name="e_name" maxlength="40" />
                </div>
                <div class="field">
                  <label>{isEn ? 'Relationship *' : '続柄 *'}</label>
                  <input type="text" name="e_relation" maxlength="20"
                    placeholder={isEn ? 'e.g. Grandparent / Spouse' : '祖父母／配偶者 など'} />
                </div>
                <div class="field field-wide">
                  <label>{isEn ? 'Phone number *' : '電話番号 *'}</label>
                  <input type="tel" name="e_phone" maxlength="20" />
                </div>
              </div>
            </div>
            <div class="nav-btns">
              <button type="button" class="btn btn-ghost" data-goto="3">{isEn ? '← Back' : '← 戻る'}</button>
              <button type="button" class="btn btn-primary" data-goto="5">{isEn ? 'Next →' : '次へ →'}</button>
            </div>
          </section>

          <section class="step" data-step="5" hidden>
            <h2>{isEn ? '5. Terms of Service · Cancellation · Weather Policy' : '5. 利用規約 · キャンセルポリシー · 天候対応'}</h2>
            {isEn && (
              <div class="notice" style="margin-bottom:.8rem">
                ℹ️ The full terms below are provided in Japanese. Please have a Japanese-speaking companion review, or contact us at info@kidskart.org if you need an English summary.
              </div>
            )}
            <div class="terms-scroll" id="termsScroll" tabindex="0" set:html={termsHtml}></div>
            <p class="hint scroll-hint" id="scrollHint">
              {isEn ? '📄 Please scroll to the bottom to continue' : '📄 最後までスクロールして次へお進みください'}
            </p>
            <div class="nav-btns">
              <button type="button" class="btn btn-ghost" data-goto="4">{isEn ? '← Back' : '← 戻る'}</button>
              <button type="button" class="btn btn-primary" data-goto="6" id="agreeBtn" disabled>
                {isEn ? 'Agree and continue →' : '同意して次へ →'}
              </button>
            </div>
          </section>

          <section class="step" data-step="6" hidden>
            <h2>{isEn ? '6. Safety Rules Confirmation' : '6. 安全ルール確認'}</h2>
            <p class="hint">
              {isEn ? 'Please check all items to acknowledge.' : '全ての項目にご同意ください。'}
            </p>
            <ul class="safety-list">
              {safetyItems.map((it) => (
                <li>
                  <label>
                    <input type="checkbox" name="safety" value={it.id} />
                    <span>{it.text}</span>
                  </label>
                </li>
              ))}
            </ul>
            <div class="nav-btns">
              <button type="button" class="btn btn-ghost" data-goto="5">{isEn ? '← Back' : '← 戻る'}</button>
              <button type="button" class="btn btn-primary" data-goto="7">{isEn ? 'Next →' : '次へ →'}</button>
            </div>
          </section>

          <section class="step" data-step="7" hidden>
            <h2>{isEn ? '7. Electronic Signature' : '7. 電子署名'}</h2>
            <p class="hint">
              {isEn
                ? "Please sign the guardian's name in the box below (works on PC and mobile)."
                : '下の枠内に保護者様のお名前を署名してください（PC・スマホ共に対応）。'}
            </p>

            <div class="sig-mode">
              <label class="cp-choice small">
                <input type="radio" name="sig_mode" value="drawn" checked />
                <span>{isEn ? '✍️ Draw' : '✍️ 手書き'}</span>
              </label>
              <label class="cp-choice small">
                <input type="radio" name="sig_mode" value="typed" />
                <span>{isEn ? '⌨ Type' : '⌨ タイプ入力'}</span>
              </label>
            </div>

            <div class="sig-drawn" id="sigDrawn">
              <canvas id="sigCanvas"></canvas>
              <div class="sig-actions">
                <button type="button" id="sigClear" class="btn btn-ghost">
                  {isEn ? '🗑 Clear' : '🗑 クリア'}
                </button>
              </div>
            </div>

            <div class="sig-typed" id="sigTyped" hidden>
              <div class="field">
                <label>{isEn ? 'Type your name *' : 'お名前をタイプ *'}</label>
                <input type="text" name="sig_typed_name" maxlength="40"
                  placeholder={isEn ? 'e.g. Taro Yamada' : '山田 太郎'} />
              </div>
            </div>

            <div class="nav-btns">
              <button type="button" class="btn btn-ghost" data-goto="6">{isEn ? '← Back' : '← 戻る'}</button>
              <button type="button" class="btn btn-primary" data-goto="8">{isEn ? 'Next →' : '次へ →'}</button>
            </div>
          </section>

          <section class="step" data-step="8" hidden>
            <h2>{isEn ? '8. Review & Submit' : '8. 内容確認 → 予約確定'}</h2>
            <div id="reviewHost"></div>

            {turnstileEnabled && (
              <div class="turnstile-wrap">
                <p class="hint">
                  {isEn
                    ? '🤖 Please complete the check below to prevent spam bookings'
                    : '🤖 悪戯予約防止のため、下のチェックを完了してください'}
                </p>
                <div class="cf-turnstile"
                     data-sitekey={turnstileSiteKey}
                     data-callback="onTurnstileSuccess"
                     data-error-callback="onTurnstileError"
                     data-expired-callback="onTurnstileExpired"
                     data-theme="light"
                     data-language={isEn ? 'en' : 'ja'}></div>
              </div>
            )}

            <div id="submitError" class="err" hidden></div>

            <div class="nav-btns">
              <button type="button" class="btn btn-ghost" data-goto="7">{isEn ? '← Back' : '← 戻る'}</button>
              <button type="button" class="btn btn-primary btn-big" id="submitBtn"
                      disabled={turnstileEnabled}>
                {isEn
                  ? (requiresApproval ? '📩 Submit approval request' : '✅ Confirm booking')
                  : (requiresApproval ? '📩 承認依頼を送信する' : '✅ 予約を確定する')}
              </button>
            </div>
          </section>
        </form>

        {turnstileEnabled && (
          <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
        )}

        <div id="submitOverlay" hidden>
          <div class="overlay-card">
            <div class="spinner"></div>
            <p>{isEn ? 'Submitting your booking…' : '予約を送信しています…'}</p>
          </div>
        </div>
      </>
    )}
  </main>
</Base>

<script is:inline define:vars={{ supabaseUrl, supabaseAnonKey, isEn }}>
  window.__ASMS_AUTH_CFG = { supabaseUrl, supabaseAnonKey };
  window.__ASMS_LOCALE = { isEn };
</script>

<script>
  const form = document.getElementById('wz') as HTMLFormElement | null;
  if (form) initWizard(form);

  function initWizard(form: HTMLFormElement) {
    const slotId = form.dataset.slotId!;
    const termId = form.dataset.termId!;
    const priceRegular = parseInt(form.dataset.priceRegular || '0', 10);
    const priceMember = parseInt(form.dataset.priceMember || '0', 10);
    const courseName = form.dataset.courseName || '';
    const slotLabel = form.dataset.slotLabel || '';
    // ロケール (Base で window.__ASMS_LOCALE にセット済み)
    const isEn = !!(window as any).__ASMS_LOCALE?.isEn;
    const tr = (jp: string, en: string) => isEn ? en : jp;

    const steps = Array.from(form.querySelectorAll<HTMLElement>('section.step'));
    const progressItems = Array.from(document.querySelectorAll<HTMLElement>('.progress li'));
    let currentStep = 1;

    const showStep = (n: number) => {
      const prev = currentStep;
      currentStep = n;
      steps.forEach((s) => {
        const st = parseInt(s.dataset.step || '0', 10);
        s.hidden = st !== n;
      });
      progressItems.forEach((li) => {
        const st = parseInt(li.dataset.step || '0', 10);
        li.classList.toggle('done', st < n);
        li.classList.toggle('active', st === n);
      });
      window.scrollTo({ top: 0, behavior: 'smooth' });
      history.replaceState({ step: n }, '', `#step-${n}`);
      // GA4 funnel: 前進した時だけ発火 (戻る時は数えない)
      if (n > prev) {
        (window as any).asmsTrack?.('wizard_step', { step: n });
      }
    };

    form.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      const gotoAttr = t.getAttribute('data-goto');
      if (!gotoAttr) return;
      const next = parseInt(gotoAttr, 10);
      if (next > currentStep && !validateStep(currentStep)) return;
      if (next === 2) renderParticipants();
      if (next === 8) renderReview();
      showStep(next);
    });

    const totalPreviewEl = document.getElementById('totalPreview')!;
    // 英語版では会員種別 UI 自体を出していないので null 許容にする
    const memberConfirm = document.getElementById('memberConfirm') as HTMLElement | null;
    const memberConfirmChk = document.getElementById('memberConfirmChk') as HTMLInputElement | null;
    const updateTotal = () => {
      const count = getRadioValue('participant_count') || '1';
      const tier = getRadioValue('price_tier') || 'regular';
      const per = tier === 'member' ? priceMember : priceRegular;
      totalPreviewEl.textContent = `¥${(per * parseInt(count, 10)).toLocaleString()}`;
      if (memberConfirm) memberConfirm.hidden = tier !== 'member';
      if (memberConfirmChk && tier !== 'member') memberConfirmChk.checked = false;
    };
    form.querySelectorAll<HTMLInputElement>('input[name="participant_count"], input[name="price_tier"]')
      .forEach((el) => el.addEventListener('change', updateTotal));

    function getRadioValue(name: string): string {
      const el = form.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`);
      return el ? el.value : '';
    }

    const host = document.getElementById('participantsHost')!;
    const tpl = document.getElementById('participantTpl') as HTMLTemplateElement;
    // Default birthday = today − 6 years (typical target age for 体験教室).
    const defaultBirthdate = (() => {
      const t = new Date();
      t.setFullYear(t.getFullYear() - 6);
      return t.toISOString().slice(0, 10);
    })();
    const renderParticipants = () => {
      const count = parseInt(getRadioValue('participant_count') || '1', 10);
      const captured: Record<string, string>[] = [];
      host.querySelectorAll<HTMLElement>('.participant').forEach((el) => {
        const idx = parseInt(el.dataset.pIndex || '0', 10);
        captured[idx] = {};
        el.querySelectorAll<HTMLInputElement | HTMLSelectElement>('input, select').forEach((f) => {
          if ((f as HTMLInputElement).type === 'radio') {
            if ((f as HTMLInputElement).checked) captured[idx][f.name] = f.value;
          } else {
            captured[idx][f.name] = f.value;
          }
        });
      });
      host.innerHTML = '';
      for (let i = 0; i < count; i++) {
        const frag = tpl.content.cloneNode(true) as DocumentFragment;
        const wrap = frag.querySelector('.participant') as HTMLElement;
        wrap.dataset.pIndex = String(i);
        (frag.querySelector('.p-num') as HTMLElement).textContent = String(i + 1);
        // Pre-fill birthday default if none captured
        const birth = wrap.querySelector<HTMLInputElement>('input[name="p_birth"]');
        if (birth && !captured[i]?.p_birth) birth.value = defaultBirthdate;
        wrap.querySelectorAll<HTMLInputElement | HTMLSelectElement>('input, select').forEach((f) => {
          const prev = captured[i]?.[f.name];
          if (prev == null) return;
          if ((f as HTMLInputElement).type === 'radio') {
            if ((f as HTMLInputElement).value === prev) (f as HTMLInputElement).checked = true;
          } else {
            f.value = prev;
          }
        });
        host.appendChild(frag);
      }
    };

    const scroll = document.getElementById('termsScroll')!;
    const scrollHint = document.getElementById('scrollHint')!;
    const agreeBtn = document.getElementById('agreeBtn') as HTMLButtonElement;
    const enableAgree = () => {
      agreeBtn.disabled = false;
      scrollHint.textContent = isEn
        ? '✅ Thanks for reviewing. You can now agree and continue.'
        : '✅ ご確認ありがとうございました。同意して次へ進めます。';
      scrollHint.classList.add('ok');
    };
    scroll.addEventListener('scroll', () => {
      if (scroll.scrollTop + scroll.clientHeight >= scroll.scrollHeight - 6) enableAgree();
    });
    const termsStep = steps.find((s) => s.dataset.step === '5')!;
    new MutationObserver(() => {
      if (!termsStep.hidden && scroll.scrollHeight <= scroll.clientHeight + 4) enableAgree();
    }).observe(termsStep, { attributes: true, attributeFilter: ['hidden'] });

    const canvas = document.getElementById('sigCanvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    let sigDrawn = false;
    let sigSetupDone = false;
    const setupCanvas = () => {
      const ratio = window.devicePixelRatio || 1;
      const rect = canvas.getBoundingClientRect();
      if (rect.width === 0 || rect.height === 0) return false;
      canvas.width = Math.round(rect.width * ratio);
      canvas.height = Math.round(rect.height * ratio);
      ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
      ctx.strokeStyle = '#0a2540';
      ctx.lineWidth = 2.5;
      ctx.lineCap = 'round';
      ctx.lineJoin = 'round';
      ctx.fillStyle = '#ffffff';
      ctx.fillRect(0, 0, rect.width, rect.height);
      sigSetupDone = true;
      return true;
    };
    // Set up whenever the signature step becomes visible AND on the
    // first pointerdown if the observer missed the first time (older
    // browsers, race conditions). Also re-setup on window resize
    // — but preserve the drawn image so the user doesn't lose their
    // signature.
    const sigStep = steps.find((s) => s.dataset.step === '7')!;
    const trySetup = () => { if (!sigSetupDone) requestAnimationFrame(() => setupCanvas()); };
    new MutationObserver(() => {
      if (!sigStep.hidden) trySetup();
    }).observe(sigStep, { attributes: true, attributeFilter: ['hidden'] });
    let resizeTimer: any = null;
    window.addEventListener('resize', () => {
      if (sigStep.hidden || !sigSetupDone) return;
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        // Preserve existing image before reset
        const snap = canvas.toDataURL('image/png');
        setupCanvas();
        const img = new Image();
        img.onload = () => {
          const rect = canvas.getBoundingClientRect();
          ctx.drawImage(img, 0, 0, rect.width, rect.height);
        };
        img.src = snap;
      }, 150);
    });

    let drawing = false;
    let lastX = 0, lastY = 0;
    const pointerPos = (e: PointerEvent) => {
      const rect = canvas.getBoundingClientRect();
      return { x: e.clientX - rect.left, y: e.clientY - rect.top };
    };
    canvas.addEventListener('pointerdown', (e) => {
      // Emergency setup — if the observer didn't fire (rare timing bug)
      // this ensures the canvas has real dimensions before we draw.
      if (!sigSetupDone) setupCanvas();
      e.preventDefault();
      try { canvas.setPointerCapture(e.pointerId); } catch {}
      drawing = true;
      sigDrawn = true;
      const p = pointerPos(e);
      lastX = p.x; lastY = p.y;
      ctx.beginPath();
      ctx.arc(p.x, p.y, 1.2, 0, Math.PI * 2);
      ctx.fillStyle = '#0a2540';
      ctx.fill();
    });
    canvas.addEventListener('pointermove', (e) => {
      if (!drawing) return;
      e.preventDefault();
      const p = pointerPos(e);
      ctx.beginPath();
      ctx.moveTo(lastX, lastY);
      ctx.lineTo(p.x, p.y);
      ctx.stroke();
      lastX = p.x; lastY = p.y;
    });
    const endStroke = (e: PointerEvent) => {
      if (!drawing) return;
      drawing = false;
      try { canvas.releasePointerCapture(e.pointerId); } catch {}
    };
    canvas.addEventListener('pointerup', endStroke);
    canvas.addEventListener('pointercancel', endStroke);
    // NOTE: intentionally NO pointerleave handler here. With
    // setPointerCapture the pointer never really "leaves" the canvas
    // — but on some browsers pointerleave still fires when the finger
    // just barely crosses the edge, which would end the stroke early.

    // Extra belt-and-suspenders touch handling for stubborn mobile
    // browsers where `touch-action: none` alone doesn't suppress
    // scrolling. Attach to the CANVAS only, not the wrapper — the
    // wrapper also contains the クリア button and preventDefault on
    // its touchstart would swallow the button tap on touch devices.
    const suppress = (e: TouchEvent) => e.preventDefault();
    canvas.addEventListener('touchstart', suppress, { passive: false });
    canvas.addEventListener('touchmove', suppress, { passive: false });

    document.getElementById('sigClear')!.addEventListener('click', () => {
      const rect = canvas.getBoundingClientRect();
      ctx.fillStyle = '#ffffff';
      ctx.fillRect(0, 0, rect.width, rect.height);
      sigDrawn = false;
    });

    // Prefill has two sources with the same shape:
    //   1. localStorage 'asms:lastReservation' — set on successful
    //      submission on this device (fast, zero server calls).
    //   2. Server /api/me/prefill — if the user is signed in via
    //      Magic Link (Supabase Auth), pull their guardian info from
    //      the DB. This is the cross-device path.
    // Whichever is present wins; if both, server takes precedence
    // (a signed-in user's DB state is authoritative).
    const LS_KEY = 'asms:lastReservation';
    const prefillPanel = document.getElementById('prefillPanel');
    const prefillApply = document.getElementById('prefillApply') as HTMLButtonElement | null;
    const prefillClear = document.getElementById('prefillClear') as HTMLButtonElement | null;
    const prefillHeading = document.getElementById('prefillHeading');
    const prefillHint = document.getElementById('prefillHint');
    const signinInvite = document.getElementById('signinInvite');
    const signedInEmpty = document.getElementById('signedInEmpty');
    const seEmail = document.getElementById('seEmail');
    const seSignOut = document.getElementById('seSignOut') as HTMLButtonElement | null;

    let savedPrefill: any = null;
    let prefillSource: 'local' | 'auth' = 'local';
    try {
      const raw = localStorage.getItem(LS_KEY);
      if (raw) savedPrefill = JSON.parse(raw);
    } catch {}
    if (savedPrefill && prefillPanel) prefillPanel.hidden = false;

    // Async: check Supabase auth session and, if signed in, fetch
    // server-side prefill. If found, override local prefill.
    (async () => {
      const cfg = (window as any).__ASMS_AUTH_CFG;
      // Fast path: if there's no auth session in localStorage, skip
      // loading the 217KB supabase-js bundle entirely. Storage key
      // matches authWrapper's `storageKey: 'asms:auth'` config.
      const hasSessionHint = (() => {
        try { return !!localStorage.getItem('asms:auth'); } catch { return false; }
      })();
      if (!cfg?.supabaseUrl || !hasSessionHint) {
        if (!savedPrefill && signinInvite) signinInvite.hidden = false;
        return;
      }
      try {
        const { getAuthClient, currentSession, hardSignOut } = await import('@lib/authWrapper');
        const client = getAuthClient(cfg.supabaseUrl, cfg.supabaseAnonKey);
        const session = await currentSession(client);
        if (!session?.user?.email) {
          // Stale session hint — clear + show sign-in invite
          try { localStorage.removeItem('asms:auth'); } catch {}
          if (!savedPrefill && signinInvite) signinInvite.hidden = false;
          return;
        }
        const r = await fetch('/api/me/prefill', {
          headers: { Authorization: `Bearer ${session.access_token}` },
        });
        if (!r.ok) return;
        const data = await r.json();
        if (data?.ok && data.guardian) {
          savedPrefill = {
            guardian: data.guardian,
            sameAsGuardian: data.sameAsGuardian,
            emergency: data.emergency,
            participants: data.participants ?? [],
          };
          prefillSource = 'auth';
          const emailShort = session.user?.email ?? '';
          if (prefillHeading) prefillHeading.textContent = `🔑 サインイン中 (${emailShort}): 前回のご予約情報を呼び出せます`;
          if (prefillHint) prefillHint.textContent = isEn
            ? '* Loaded from your signed-in account. Signature is required each time.'
            : '※ サインイン済みアカウントの前回情報です。署名は毎回必要です。';
          if (prefillPanel) prefillPanel.hidden = false;
          if (signinInvite) signinInvite.hidden = true;
        } else {
          // Signed in but no matching guardian in DB (never booked with this email).
          // Show a clear empty-state panel so the user knows sign-in worked.
          if (seEmail) seEmail.textContent = `(${session.user?.email ?? ''})`;
          if (signedInEmpty) signedInEmpty.hidden = false;
          if (signinInvite) signinInvite.hidden = true;
          seSignOut?.addEventListener('click', async () => {
            if (!confirm('サインアウトしますか？')) return;
            await hardSignOut(client, '/reserve/');
          });
        }
      } catch (e) {
        console.warn('[prefill] auth fetch failed', e);
      }
    })();

    const setFieldValue = (name: string, value: string | null | undefined) => {
      const el = form.querySelector<HTMLInputElement | HTMLSelectElement>(`[name="${name}"]`);
      if (el) el.value = value ?? '';
    };

    prefillApply?.addEventListener('click', () => {
      if (!savedPrefill) return;
      const g = savedPrefill.guardian || {};
      setFieldValue('g_name', g.name);
      setFieldValue('g_kana', g.kana);
      setFieldValue('g_phone', g.phone);
      setFieldValue('g_email', g.email);
      setFieldValue('g_postal', g.postal_code);
      setFieldValue('g_address', g.address);

      // Emergency contact
      if (savedPrefill.sameAsGuardian || !savedPrefill.emergency) {
        // handled in the sameChk block below
      } else {
        const e = savedPrefill.emergency;
        setFieldValue('e_name', e.name);
        setFieldValue('e_phone', e.phone);
        setFieldValue('e_relation', e.relation);
      }

      // Wait for sameChk to be defined; it's declared later in the same
      // function scope. Retry once on next tick if not yet available.
      const applySame = () => {
        const same = !!savedPrefill.sameAsGuardian;
        // @ts-ignore closure over sameChk declared later
        if (typeof sameChk !== 'undefined' && sameChk) {
          sameChk.checked = same;
          // @ts-ignore
          syncSame();
        } else {
          setTimeout(applySame, 0);
        }
      };
      applySame();

      // Participants
      const parts = savedPrefill.participants || [];
      if (parts.length > 0) {
        const maxP = parseInt(form.dataset.maxParticipants || '1', 10);
        const desiredCount = Math.min(parts.length, maxP);
        const countRadio = form.querySelector<HTMLInputElement>(`input[name="participant_count"][value="${desiredCount}"]`);
        if (countRadio) {
          countRadio.checked = true;
          updateTotal();
        }
        renderParticipants();
        const pEls = host.querySelectorAll<HTMLElement>('.participant');
        parts.slice(0, desiredCount).forEach((p: any, i: number) => {
          const el = pEls[i];
          if (!el) return;
          const setP = (name: string, v: string | null | undefined) => {
            const f = el.querySelector<HTMLInputElement | HTMLSelectElement>(`[name="${name}"]`);
            if (f && v != null && v !== '') f.value = String(v);
          };
          setP('p_name', p.name);
          setP('p_kana', p.kana);
          setP('p_birth', p.birth_date);
          setP('p_gender', p.gender);
          if (p.height_cm) setP('p_height', String(p.height_cm));
          setP('p_experience', p.kart_experience_note);
          const photoRadio = el.querySelector<HTMLInputElement>(`input[name="p_photo"][value="${p.photo_consent || 'allow'}"]`);
          if (photoRadio) photoRadio.checked = true;
        });
      }

      if (prefillPanel) prefillPanel.hidden = true;
    });

    prefillClear?.addEventListener('click', async () => {
      if (prefillSource === 'auth') {
        if (!confirm('サインアウトして、予約情報の呼び出しを解除しますか？')) return;
        try {
          const cfg = (window as any).__ASMS_AUTH_CFG;
          if (cfg?.supabaseUrl) {
            const { getAuthClient, hardSignOut } = await import('@lib/authWrapper');
            const client = getAuthClient(cfg.supabaseUrl, cfg.supabaseAnonKey);
            await hardSignOut(client, window.location.href.split('?')[0]);
            return; // hardSignOut navigates, no need to fall through
          }
        } catch (e) { console.warn('[signout] failed', e); }
      } else {
        if (!confirm('このブラウザに保存されている予約情報を削除しますか？')) return;
        try { localStorage.removeItem(LS_KEY); } catch {}
      }
      savedPrefill = null;
      if (prefillPanel) prefillPanel.hidden = true;
    });

    // "緊急連絡先は保護者と同じ" toggle: reveal / hide the emergency
    // form and skip its required validation when checked.
    const sameChk = document.getElementById('sameAsGuardian') as HTMLInputElement | null;
    const emerFields = document.getElementById('emergencyFields');
    const emerInputs = emerFields ? Array.from(emerFields.querySelectorAll<HTMLInputElement>('input')) : [];
    const syncSame = () => {
      const same = !!sameChk?.checked;
      if (emerFields) emerFields.hidden = same;
      emerInputs.forEach((i) => { i.required = !same; });
    };
    sameChk?.addEventListener('change', syncSame);
    syncSame();

    // Postal code → address auto-fill via zipcloud (free public JP API).
    // Only fills the address field when it's empty so we don't blow away
    // a manually-typed value.
    const zipInput = document.getElementById('g_postal') as HTMLInputElement | null;
    const addrInput = document.getElementById('g_address') as HTMLInputElement | null;
    const zipHint = document.getElementById('zipHint');
    if (zipInput && addrInput) {
      const lookup = async () => {
        const zip = zipInput.value.replace(/[^0-9]/g, '');
        if (zip.length !== 7) return;
        if (zipHint) { zipHint.textContent = '住所を検索中…'; }
        try {
          const r = await fetch(`https://zipcloud.ibsnet.co.jp/api/search?zipcode=${zip}`);
          const d = await r.json();
          if (d.status === 200 && d.results?.[0]) {
            const a = d.results[0];
            const addr = `${a.address1}${a.address2}${a.address3}`;
            if (!addrInput.value.trim()) addrInput.value = addr;
            if (zipHint) { zipHint.textContent = `✅ ${addr}`; zipHint.style.color = 'var(--lime-deep)'; }
          } else {
            if (zipHint) { zipHint.textContent = '該当する住所が見つかりませんでした'; zipHint.style.color = 'var(--rose-deep)'; }
          }
        } catch {
          if (zipHint) { zipHint.textContent = '住所検索に失敗しました（手動で入力してください）'; zipHint.style.color = 'var(--rose-deep)'; }
        }
      };
      zipInput.addEventListener('blur', lookup);
      zipInput.addEventListener('input', () => {
        const zip = zipInput.value.replace(/[^0-9]/g, '');
        if (zip.length === 7) lookup();
      });
    }

    const modeInputs = form.querySelectorAll<HTMLInputElement>('input[name="sig_mode"]');
    const drawnHost = document.getElementById('sigDrawn')!;
    const typedHost = document.getElementById('sigTyped')!;
    modeInputs.forEach((r) => r.addEventListener('change', () => {
      const mode = getRadioValue('sig_mode');
      drawnHost.hidden = mode !== 'drawn';
      typedHost.hidden = mode !== 'typed';
    }));

    const reviewHost = document.getElementById('reviewHost')!;
    const renderReview = () => {
      const data = collect();
      const rows: string[] = [];
      const tierLabel = data.priceTier === 'member'
        ? tr('会員', 'Member')
        : tr('一般', 'Regular');
      const nameFmt = (n: string, k: string) => isEn ? escapeHtml(n) : `${escapeHtml(n)}（${escapeHtml(k)}）`;
      rows.push(`<div class="rv-block"><div class="rv-h">${tr('予約枠', 'Booking')}</div><div>${escapeHtml(slotLabel)}</div><div>${escapeHtml(courseName)}</div><div class="rv-price">${tr('合計', 'Total')}: <strong>¥${data.totalAmount.toLocaleString()}</strong>${isEn ? ` (${data.participants.length} × ${tierLabel})` : `（${tierLabel} × ${data.participants.length}名）`}</div></div>`);
      data.participants.forEach((p: any, i: number) => {
        rows.push(`<div class="rv-block"><div class="rv-h">${tr('参加者', 'Participant')} ${i + 1}</div><div>${nameFmt(p.name, p.kana)}</div><div>${escapeHtml(p.birth_date)} · ${genderLabel(p.gender)} · ${p.height_cm}cm</div>${p.kart_experience_note ? `<div>${tr('経験', 'Experience')}: ${escapeHtml(p.kart_experience_note)}</div>` : ''}<div>${tr('写真同意', 'Photo consent')}: ${photoLabel(p.photo_consent)}</div></div>`);
      });
      rows.push(`<div class="rv-block"><div class="rv-h">${tr('保護者', 'Guardian')}</div><div>${nameFmt(data.guardian.name, data.guardian.kana)}</div><div>📞 ${escapeHtml(data.guardian.phone)}</div><div>✉️ ${escapeHtml(data.guardian.email)}</div>${data.guardian.address ? `<div>${escapeHtml(data.guardian.postal_code || '')} ${escapeHtml(data.guardian.address)}</div>` : ''}</div>`);
      rows.push(`<div class="rv-block"><div class="rv-h">${tr('緊急連絡先', 'Emergency Contact')}</div><div>${escapeHtml(data.emergency.name)}${isEn ? '' : `（${escapeHtml(data.emergency.relation)}）`}${isEn && data.emergency.relation ? ` (${escapeHtml(data.emergency.relation)})` : ''}</div><div>📞 ${escapeHtml(data.emergency.phone)}</div></div>`);
      rows.push(`<div class="rv-block"><div class="rv-h">${tr('署名', 'Signature')}</div><div>${data.signature.type === 'drawn' ? tr('✍️ 手書き署名済み', '✍️ Signed') : '⌨ ' + escapeHtml(data.signature.typed_name || '')}</div></div>`);
      reviewHost.innerHTML = rows.join('');
    };

    function genderLabel(g: string) {
      const dict = isEn
        ? { male: 'Male', female: 'Female', other: 'Other' }
        : { male: '男', female: '女', other: 'その他' };
      return (dict as Record<string, string>)[g] ?? g;
    }
    function photoLabel(p: string) {
      const dict = isEn
        ? { allow: 'OK', face_blur_only: 'Blur face only', deny: 'No photos' }
        : { allow: 'OK', face_blur_only: '顔ぼかしのみ', deny: '不可' };
      return (dict as Record<string, string>)[p] ?? p;
    }
    function escapeHtml(s: string) {
      return String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' } as Record<string, string>)[c]);
    }

    const collect = () => {
      const gd = (n: string) => (form.elements.namedItem(n) as HTMLInputElement)?.value?.trim() ?? '';
      const count = parseInt(getRadioValue('participant_count') || '1', 10);
      const tier = getRadioValue('price_tier') || 'regular';
      const participants: any[] = [];
      host.querySelectorAll<HTMLElement>('.participant').forEach((el) => {
        const get = (n: string) => (el.querySelector(`[name="${n}"]`) as HTMLInputElement | HTMLSelectElement)?.value?.trim() ?? '';
        const getR = (n: string) => (el.querySelector(`input[name="${n}"]:checked`) as HTMLInputElement)?.value ?? '';
        participants.push({
          name: get('p_name'),
          kana: get('p_kana'),
          birth_date: get('p_birth'),
          gender: get('p_gender'),
          height_cm: parseInt(get('p_height') || '0', 10),
          kart_experience_note: get('p_experience') || null,
          photo_consent: getR('p_photo') || 'allow',
        });
      });
      const safety = Array.from(form.querySelectorAll<HTMLInputElement>('input[name="safety"]:checked')).map((c) => parseInt(c.value, 10));
      const sigMode = getRadioValue('sig_mode') || 'drawn';
      const signature = sigMode === 'drawn'
        ? { type: 'drawn', image_data: sigDrawn ? canvas.toDataURL('image/png') : null }
        : { type: 'typed', typed_name: gd('sig_typed_name') };
      const per = tier === 'member' ? priceMember : priceRegular;
      const guardian = {
        name: gd('g_name'), kana: gd('g_kana'), phone: gd('g_phone'),
        email: gd('g_email'), postal_code: gd('g_postal'), address: gd('g_address'),
      };
      const sameAsGuardian = !!sameChk?.checked;
      const emergency = sameAsGuardian
        ? { name: guardian.name, phone: guardian.phone, relation: '本人' }
        : { name: gd('e_name'), phone: gd('e_phone'), relation: gd('e_relation') };
      return {
        slot_id: slotId,
        term_id: termId,
        price_tier: tier,
        totalAmount: per * count,
        participants,
        guardian,
        emergency,
        signature,
        checked_safety_items: safety,
      };
    };

    function validateStep(step: number): boolean {
      const stepEl = steps.find((s) => parseInt(s.dataset.step || '0', 10) === step);
      if (!stepEl) return true;
      const invalid: (HTMLInputElement | HTMLSelectElement)[] = [];
      stepEl.querySelectorAll<HTMLInputElement | HTMLSelectElement>('input, select').forEach((f) => {
        if (!f.required) return;
        if ((f as HTMLInputElement).type === 'radio') {
          if (!stepEl.querySelector(`input[name="${f.name}"]:checked`)) invalid.push(f);
        } else if (!f.value.trim()) invalid.push(f);
      });
      if (step === 1) {
        // English 版では price_tier=member 選択 UI 自体が無いので memberConfirmChk も存在しない
        if (!isEn && getRadioValue('price_tier') === 'member' && memberConfirmChk && !memberConfirmChk.checked) {
          alert(tr('会員価格をご選択の場合、「トヨピー会員に登録済み」のチェックが必要です。',
                   'To use member price, please check the "Registered Toyopet Member" box.'));
          memberConfirmChk.focus();
          return false;
        }
      }
      if (step === 6) {
        const checked = stepEl.querySelectorAll('input[name="safety"]:checked');
        const all = stepEl.querySelectorAll('input[name="safety"]');
        if (checked.length !== all.length) {
          alert(tr('全ての安全ルールにチェックしてください。', 'Please check all safety rules.'));
          return false;
        }
      }
      if (step === 7) {
        const mode = getRadioValue('sig_mode');
        if (mode === 'drawn' && !sigDrawn) {
          alert(tr('署名を入力してください。', 'Please provide a signature.'));
          return false;
        }
        if (mode === 'typed' && !(form.elements.namedItem('sig_typed_name') as HTMLInputElement)?.value.trim()) {
          alert(tr('お名前を入力してください。', 'Please enter your name.'));
          return false;
        }
      }
      if (invalid.length) {
        invalid[0].focus();
        invalid[0].scrollIntoView({ behavior: 'smooth', block: 'center' });
        alert(tr('未入力の項目があります。', 'Some required fields are missing.'));
        return false;
      }
      return true;
    }

    const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement;
    const submitOverlay = document.getElementById('submitOverlay')!;
    const submitError = document.getElementById('submitError')!;

    // Turnstile: store the token from the widget callback so we can send
    // it in the payload. The widget is only rendered when a site key is
    // configured; if absent, `turnstileToken` stays null and the button
    // is enabled from the server render.
    let turnstileToken: string | null = null;
    (window as any).onTurnstileSuccess = (token: string) => {
      turnstileToken = token;
      submitBtn.disabled = false;
    };
    (window as any).onTurnstileError = () => {
      turnstileToken = null;
      submitBtn.disabled = true;
    };
    (window as any).onTurnstileExpired = () => {
      turnstileToken = null;
      submitBtn.disabled = true;
    };

    submitBtn.addEventListener('click', async () => {
      submitError.hidden = true;
      submitOverlay.hidden = false;
      submitBtn.disabled = true;
      // GA4: 送信ボタン押下 (成功/失敗は問わない)。CV は complete ページ側で計測。
      (window as any).asmsTrack?.('booking_submit', {
        slot_id: slotId,
        course: courseName,
        participants: parseInt(getRadioValue('participant_count') || '1', 10),
      });
      try {
        const payload = collect();
        if (turnstileToken) (payload as any).turnstile_token = turnstileToken;
        const res = await fetch('/api/reserve/create', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const body = await res.json();
        if (!res.ok) {
          const e: any = new Error(body?.error || 'unknown');
          e.detail = body?.detail;
          throw e;
        }
        // On success, save non-sensitive form data for next-time prefill
        // on this browser only. Signature is intentionally NOT saved —
        // each booking requires a fresh consent.
        try {
          const toSave = {
            guardian: payload.guardian,
            emergency: payload.emergency,
            sameAsGuardian: !!sameChk?.checked,
            participants: payload.participants,
            savedAt: new Date().toISOString(),
          };
          localStorage.setItem(LS_KEY, JSON.stringify(toSave));
        } catch {}
        window.location.href = `/reserve/complete/${body.reservation_id}`;
      } catch (err: any) {
        submitOverlay.hidden = true;
        submitBtn.disabled = false;
        submitError.innerHTML = '';
        const p = document.createElement('div');
        p.textContent = `送信に失敗しました: ${err.message || err}`;
        submitError.appendChild(p);
        if (err.detail) {
          const small = document.createElement('code');
          small.style.fontSize = '.7rem';
          small.style.opacity = '.7';
          small.style.display = 'block';
          small.style.marginTop = '.4rem';
          small.textContent = err.detail;
          submitError.appendChild(small);
        }
        submitError.hidden = false;
      }
    });

    renderParticipants();
    updateTotal();
    showStep(1);
    // GA4: ウィザードに到達した瞬間 (=予約意欲があった訪問)。
    // showStep(1) は prev=1 で発火しないので、ここで明示的に打つ。
    (window as any).asmsTrack?.('wizard_start', {
      slot_id: slotId,
      course: courseName,
    });
  }
</script>

