---
import Base from '@layouts/Base.astro';
import { envFrom, getSupabaseAdmin } from '@lib/supabase';
import { getLocaleFromRequest, type Locale } from '@lib/i18n';

const env = envFrom(Astro.locals);
const supabase = getSupabaseAdmin(env);
const locale: Locale = getLocaleFromRequest(Astro.request);
const isEn = locale === 'en';

const { reservationId } = Astro.params;

const { data: res } = await supabase
  .from('reservations')
  .select(`
    id, reservation_number, status, price_tier, total_amount, cancel_token, created_at,
    slots(date, start_time, end_time, courses(code, name)),
    guardians(name, email, phone),
    reservation_participants(name_snapshot, kana_snapshot, age_at_booking)
  `)
  .eq('id', reservationId)
  .maybeSingle();

if (!res) {
  return new Response(null, { status: 302, headers: { Location: '/reserve/' } });
}

const slot: any = res.slots ?? {};
const course: any = slot.courses ?? {};
const guardian: any = res.guardians ?? {};
const participants: any[] = (res.reservation_participants as any[]) ?? [];

const weekdayJa = ['日', '月', '火', '水', '木', '金', '土'];
const weekdayEn = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
const monthsEn = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
const d = new Date(slot.date + 'T00:00:00');
const dateLabel = isEn
  ? `${monthsEn[d.getMonth()]} ${d.getDate()}, ${d.getFullYear()} (${weekdayEn[d.getDay()]})`
  : `${d.getFullYear()}年${d.getMonth() + 1}月${d.getDate()}日 (${weekdayJa[d.getDay()]})`;
const timeLabel = `${slot.start_time?.slice(0, 5) ?? ''}${slot.end_time ? '–' + slot.end_time.slice(0, 5) : ''}`;

// 受付開始 = 開始時刻の 15 分前
function checkInLabel(startTime: string): string {
  const [h, m] = startTime.split(':').map(Number);
  let total = h * 60 + m - 15;
  if (total < 0) total = 0;
  const hh = Math.floor(total / 60);
  const mm = total % 60;
  return `${String(hh).padStart(2, '0')}:${String(mm).padStart(2, '0')}`;
}
const checkIn = slot.start_time ? checkInLabel(slot.start_time) : '';

const isPending = res.status === 'pending_approval';

// 体験教室予約が完了したときは、続けて「リピート練習も追加予約」する導線を出す。
// 実装は最小: /reserve?course=repeat_60 (or repeat_30) に遷移させるだけで、
// ウィザード側の localStorage プリフィルが保護者・お子さま情報を自動で復元する。
const isTaiken = course.code === 'taiken';
---
<Base
  title={isEn
    ? `Booking ${isPending ? 'received' : 'confirmed'} — ${res.reservation_number}`
    : `予約${isPending ? '受付' : '完了'} — ${res.reservation_number}`}
  lang={locale}
  showLocaleSwitch={true}
>
  <main>
    <header class="hd">
      <div class={`status-icon ${isPending ? 'pending' : 'ok'}`}>
        {isPending ? '⏳' : '✅'}
      </div>
      <h1>
        {isEn
          ? (isPending ? 'Booking received' : 'Booking confirmed')
          : (isPending ? 'ご予約を受付ました' : 'ご予約が確定しました')}
      </h1>
      <p class="sub">
        {isEn
          ? (isPending
              ? "We'll send a confirmation after review. Please wait a moment."
              : (<>Please arrive by <strong>15 minutes before the start time</strong>.</>))
          : (isPending
              ? '当社確認後、確定通知をお送りします。しばらくお待ちください。'
              : (<>当日は <strong>開始時刻の 15 分前</strong> までにお越しください。</>))}
      </p>
    </header>

    <section class="card">
      <div class="row">
        <span class="k">{isEn ? 'Booking number' : '予約番号'}</span>
        <span class="v mono big">{res.reservation_number}</span>
      </div>
      <div class="row">
        <span class="k">{isEn ? 'Status' : '状態'}</span>
        <span class={`v badge ${isPending ? 'badge-pending' : 'badge-confirmed'}`}>
          {isEn
            ? (isPending ? 'Awaiting approval' : 'Confirmed')
            : (isPending ? '承認待ち' : '確定')}
        </span>
      </div>
    </section>

    <section class="card">
      <h2>{isEn ? 'Session' : '予約枠'}</h2>
      <div class="row"><span class="k">{isEn ? 'Course' : 'コース'}</span><span class="v">{course.name}</span></div>
      <div class="row"><span class="k">{isEn ? 'Date' : '日付'}</span><span class="v mono">{dateLabel}</span></div>
      <div class="row"><span class="k">{isEn ? 'Time' : '時間'}</span><span class="v mono">{timeLabel}</span></div>
      <div class="row highlight">
        <span class="k">{isEn ? 'Check-in from' : '受付開始'}</span>
        <span class="v mono">{checkIn} <span class="v-note">{isEn ? '(15 min before start)' : '（開始15分前）'}</span></span>
      </div>
      <div class="row">
        <span class="k">{isEn ? 'Total' : '料金'}</span>
        <span class="v mono">
          ¥{res.total_amount.toLocaleString()}
          {isEn
            ? ` (${participants.length} × ${res.price_tier === 'member' ? 'Member' : 'Regular'})`
            : `（${res.price_tier === 'member' ? '会員' : '一般'} × ${participants.length}名）`}
        </span>
      </div>
    </section>

    <section class="card">
      <h2>{isEn ? `Participants (${participants.length})` : `参加者（${participants.length}名）`}</h2>
      <ul class="p-list">
        {participants.map((p, i) => (
          <li>
            <span class="p-idx">{i + 1}.</span>
            <span class="p-name">{p.name_snapshot}</span>
            {!isEn && <span class="p-kana">（{p.kana_snapshot}）</span>}
            <span class="p-age">{isEn ? `Age ${p.age_at_booking}` : `${p.age_at_booking}歳`}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="card">
      <h2>{isEn ? 'Guardian contact' : '保護者連絡先'}</h2>
      <div class="row"><span class="k">{isEn ? 'Name' : 'お名前'}</span><span class="v">{guardian.name}</span></div>
      <div class="row"><span class="k">{isEn ? 'Email' : 'メール'}</span><span class="v mono">{guardian.email}</span></div>
      <div class="row"><span class="k">{isEn ? 'Phone' : '電話'}</span><span class="v mono">{guardian.phone}</span></div>
    </section>

    <div class="notice">
      {isEn ? (
        <>💌 A confirmation email has been sent to your registered address. If you don't see it, please check your spam folder or contact <a href="mailto:info@kidskart.org">info@kidskart.org</a>.</>
      ) : (
        <>💌 ご登録のメールアドレスに確認メールをお送りしました。届かない場合は迷惑メールフォルダをご確認いただくか、<a href="mailto:info@kidskart.org">info@kidskart.org</a> までお問い合わせください。</>
      )}
    </div>

    {isTaiken && !isPending && (
      <section class="upsell">
        <div class="upsell-badge">
          {isEn ? '🏁 Book your next session too!' : '🏁 続けてご予約もどうぞ'}
        </div>
        <h2 class="upsell-title">
          {isEn ? 'Add a Repeat Practice booking?' : 'リピート練習も追加予約しませんか？'}
        </h2>
        <p class="upsell-lead">
          {isEn ? (
            <>Continuing with <strong>Repeat Practice</strong> after the trial helps kids improve faster.<br />Choose <strong>25 min / 50 min</strong> per child.<br /><span class="upsell-hint">* Your guardian and participant info will be pre-filled.</span></>
          ) : (
            <>体験の後に <strong>リピート練習</strong> を続けると、上達が早くなります。<br />お子さまごとに <strong>25 分 / 50 分</strong> からお選びいただけます。<br /><span class="upsell-hint">※ ご入力いただいた保護者・お子さまの情報はそのままご利用いただけます。</span></>
          )}
        </p>
        <div class="upsell-cta">
          <a class="btn btn-primary" href="/reserve/?course=repeat_60#dates" data-repeat-cta="repeat_60">
            {isEn ? (
              <>Book Repeat Practice <strong>50 min</strong><span class="btn-sub">¥6,500</span></>
            ) : (
              <>リピート練習 <strong>50 分</strong> を予約する<span class="btn-sub">¥6,500 / 会員 ¥4,500</span></>
            )}
          </a>
          <a class="btn btn-secondary" href="/reserve/?course=repeat_30#dates" data-repeat-cta="repeat_30">
            {isEn ? (
              <>Book Repeat Practice <strong>25 min</strong><span class="btn-sub">¥3,500</span></>
            ) : (
              <>リピート練習 <strong>25 分</strong> を予約する<span class="btn-sub">¥3,500 / 会員 ¥3,000</span></>
            )}
          </a>
        </div>
      </section>
    )}

    <div class="cta">
      <a class="btn btn-ghost" href="/reserve/">
        {isEn ? 'Book another date / course' : '別の日程・別のコースを予約する'}
      </a>
      <a class="btn btn-ghost" href="https://kidskart.org/">
        {isEn ? 'Back to kidskart.org' : 'kidskart.org へ戻る'}
      </a>
    </div>
  </main>

  <script is:inline define:vars={{
    reservationId,
    courseCode: course.code || '',
    priceTier: res.price_tier,
    total: res.total_amount,
    participants: participants.length,
    isPending,
  }}>
    // GA4: 予約完了 (最重要 CV)。GA 側で Key Event としてマークする。
    // 承認待ちのケース (isPending=true) はまだ確定していないので送らない。
    //
    // 二重発火防止: complete ページはリロード・ブラウザバック・ブックマーク
    // からの再訪問等で複数回開かれ得るため、reservationId 単位で localStorage
    // に送信フラグを持ち、同一予約では 1 回だけ発火する。
    // localStorage が読めない環境 (private mode 等) は 1 回目相当として
    // 発火させる (計測欠損の方が二重より痛いため)。
    if (!isPending && typeof window.asmsTrack === 'function') {
      const dedupKey = 'asms:bc_sent:' + reservationId;
      let alreadySent = false;
      try { alreadySent = !!localStorage.getItem(dedupKey); } catch (_e) { /* private mode */ }
      if (!alreadySent) {
        window.asmsTrack('booking_complete', {
          course: courseCode,
          price_tier: priceTier,
          participants: participants,
          value: total,
          currency: 'JPY',
        });
        try { localStorage.setItem(dedupKey, String(Date.now())); } catch (_e) { /* noop */ }
      }
    }
    // リピート追加予約 CTA クリック計測。href が別ページなので、
    // GA が飛ぶ前に beacon で送るために sendBeacon 経由ではなく
    // gtag デフォルトの transport で十分 (fetch keepalive)。
    document.querySelectorAll('[data-repeat-cta]').forEach((el) => {
      el.addEventListener('click', () => {
        const which = el.getAttribute('data-repeat-cta') || '';
        if (typeof window.asmsTrack === 'function') {
          window.asmsTrack('repeat_book_click', { target_course: which });
        }
      });
    });
  </script>
</Base>

<style>
  main { max-width: 640px; margin: 0 auto; padding: 1.5rem 1.25rem 3rem; }

  .hd { text-align: center; margin-bottom: 1.5rem; }
  .status-icon {
    font-size: 3rem; margin-bottom: .3rem;
  }
  .status-icon.ok { color: var(--lime-deep); }
  .status-icon.pending { color: var(--sun); }
  h1 { margin: 0 0 .4rem; font-size: 1.4rem; font-weight: 800; }
  .sub { margin: 0; color: var(--ink-2); font-size: .82rem; line-height: 1.6; }

  .card {
    background: var(--bg); border: 1px solid var(--line); border-radius: 12px;
    padding: 1rem 1.15rem; margin-bottom: .8rem;
  }
  .card h2 {
    margin: 0 0 .5rem; font-size: .82rem; font-weight: 800; color: var(--sky-deep);
    letter-spacing: .05em; text-transform: uppercase;
  }
  .row {
    display: flex; justify-content: space-between; align-items: baseline;
    gap: .5rem; padding: .35rem 0;
    border-bottom: 1px dashed var(--line);
    font-size: .84rem;
  }
  .row:last-child { border-bottom: none; }
  .row.highlight {
    background: rgba(255,201,67,.12);
    margin: 0 -.5rem; padding: .5rem .5rem; border-radius: 6px;
    border-bottom: none;
  }
  .row.highlight .v { color: var(--orange-deep); font-weight: 800; }
  .v-note { font-size: .68rem; color: var(--ink-3); font-weight: 400; font-family: var(--jp); margin-left: .3rem; }
  .k { color: var(--ink-3); font-size: .74rem; font-weight: 700; }
  .v { color: var(--ink); }
  .mono { font-family: var(--mono); }
  .big { font-size: 1.15rem; font-weight: 800; color: var(--sky-deep); }
  .badge {
    padding: 3px 10px; border-radius: 100px;
    font-size: .72rem; font-weight: 800;
  }
  .badge-confirmed { background: rgba(164,214,94,.2); color: var(--lime-deep); }
  .badge-pending { background: rgba(255,201,67,.2); color: var(--orange-deep); }

  .p-list { list-style: none; margin: 0; padding: 0; }
  .p-list li {
    display: flex; gap: .5rem; align-items: baseline;
    padding: .35rem 0; border-bottom: 1px dashed var(--line);
    font-size: .84rem;
  }
  .p-list li:last-child { border-bottom: none; }
  .p-idx { font-family: var(--mono); color: var(--ink-3); }
  .p-name { font-weight: 700; }
  .p-kana { color: var(--ink-3); font-size: .74rem; }
  .p-age { margin-left: auto; font-family: var(--mono); font-size: .74rem; color: var(--ink-2); }

  .notice {
    background: rgba(255,201,67,.1); border: 1px solid rgba(255,201,67,.35);
    padding: .8rem .95rem; border-radius: 10px;
    font-size: .78rem; line-height: 1.7;
    margin-top: 1.2rem; color: var(--ink);
  }
  .notice a { color: var(--sky-deep); text-decoration: none; font-weight: 700; }

  .cta { margin-top: 1.5rem; display: flex; flex-direction: column; gap: .5rem; }
  .btn {
    display: block; text-align: center; text-decoration: none;
    padding: .85rem 1.2rem; border-radius: 10px;
    font-weight: 800; font-size: .9rem;
    transition: transform .1s;
  }
  .btn:active { transform: translateY(1px); }
  .btn-primary {
    background: linear-gradient(135deg, var(--orange), var(--orange-deep));
    color: #fff; box-shadow: 0 4px 12px rgba(229,99,26,.3);
  }
  .btn-ghost {
    background: var(--bg-2); color: var(--ink);
    border: 1.5px solid var(--line);
  }
  .btn-secondary {
    background: linear-gradient(135deg, #4aa8e8, var(--sky-deep));
    color: #fff; box-shadow: 0 4px 12px rgba(26,127,184,.25);
  }
  .btn-sub {
    display: block; font-size: .72rem; font-weight: 600;
    opacity: .9; margin-top: .2rem;
  }

  /* --- 体験教室完了時のみ表示するリピート追加予約セクション ---------- */
  .upsell {
    margin: 1.5rem 0 .5rem;
    padding: 1.15rem 1.15rem 1.25rem;
    background: linear-gradient(135deg, rgba(255,138,61,.08), rgba(255,201,67,.08));
    border: 2px solid rgba(255,138,61,.35);
    border-radius: 14px;
    position: relative;
  }
  .upsell-badge {
    display: inline-block;
    background: linear-gradient(135deg, var(--orange), var(--orange-deep));
    color: #fff;
    padding: .3rem .8rem;
    border-radius: 100px;
    font-size: .72rem;
    font-weight: 800;
    margin-bottom: .6rem;
    box-shadow: 0 3px 8px rgba(229,99,26,.25);
  }
  .upsell-title {
    margin: 0 0 .5rem;
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--ink);
    letter-spacing: 0;
    text-transform: none;
  }
  .upsell-lead {
    margin: 0 0 1rem;
    font-size: .84rem;
    line-height: 1.7;
    color: var(--ink);
  }
  .upsell-hint {
    display: inline-block;
    margin-top: .3rem;
    font-size: .72rem;
    color: var(--ink-3);
    line-height: 1.55;
  }
  .upsell-cta {
    display: flex; flex-direction: column; gap: .55rem;
  }
</style>
