---
import Base from '@layouts/Base.astro';
import { envFrom, getSupabaseAdmin } from '@lib/supabase';
import { getLocaleFromRequest, type Locale } from '@lib/i18n';

const env = envFrom(Astro.locals);
const admin = getSupabaseAdmin(env);
const { token } = Astro.params;
const locale: Locale = getLocaleFromRequest(Astro.request);
const isEn = locale === 'en';

if (!token) return new Response(null, { status: 302, headers: { Location: '/reserve/' } });

// Load reservation by cancel token
const { data: res } = await admin
  .from('reservations')
  .select(`
    id, reservation_number, status, price_tier, total_amount,
    cancelled_at, cancelled_reason,
    slots(date, start_time, end_time, courses(name, price_regular, price_member)),
    guardians(name, email, phone),
    reservation_participants(id, name_snapshot, attendance_status)
  `)
  .eq('cancel_token', token)
  .maybeSingle();

const slot: any = res?.slots ?? {};
const course: any = slot.courses ?? {};
const guardian: any = res?.guardians ?? {};
type Part = { id: string; name_snapshot: string; attendance_status: string };
const allParticipants: Part[] = (((res as any)?.reservation_participants as any[]) ?? []) as Part[];
const activeParticipants = allParticipants.filter((p) => p.attendance_status !== 'cancelled');
const perPersonPrice = res?.price_tier === 'member' ? (course.price_member ?? 0) : (course.price_regular ?? 0);
const parts = activeParticipants.map((p) => p.name_snapshot);

const weekdayJa = ['日', '月', '火', '水', '木', '金', '土'];
const weekdayEn = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
const monthsEn = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
function fmtDate(iso: string): string {
  if (!iso) return '';
  const d = new Date(iso + 'T00:00:00');
  return isEn
    ? `${monthsEn[d.getMonth()]} ${d.getDate()}, ${d.getFullYear()} (${weekdayEn[d.getDay()]})`
    : `${d.getFullYear()}年${d.getMonth() + 1}月${d.getDate()}日 (${weekdayJa[d.getDay()]})`;
}
const dateLabel = slot.date ? fmtDate(slot.date) : '';
const timeLabel = slot.start_time ? `${slot.start_time.slice(0, 5)}${slot.end_time ? '–' + slot.end_time.slice(0, 5) : ''}` : '';

// Cancellation-fee guidance based on how close the slot is.
// 2026-08-20 (v1.0.3): 中間段階 (50%) を廃止。開始 2 時間前まで無料 / 以降 100%。
function feeGuidance(dateIso: string, startTime: string): { level: 'free' | 'full' | 'past'; text: string } {
  if (!dateIso || !startTime) return { level: 'free', text: '' };
  const slotDt = new Date(`${dateIso}T${startTime}`);
  const now = new Date();
  const hoursUntil = (slotDt.getTime() - now.getTime()) / 36e5;
  if (hoursUntil < 0) return { level: 'past', text: isEn ? 'The session date has already passed.' : '既に開催日時を過ぎています' };
  if (hoursUntil < 2) return { level: 'full', text: isEn ? 'Within 2 hours of start — 100% cancellation fee may apply.' : '開始 2 時間前以降のためキャンセル料 100% が発生する場合があります' };
  return { level: 'free', text: isEn ? 'More than 2 hours until start — no cancellation fee.' : '開始 2 時間前より前のためキャンセル料はかかりません' };
}
const fee = res && slot.date ? feeGuidance(slot.date, slot.start_time) : { level: 'free' as const, text: '' };

const notFound = !res;
const isCancelled = res?.status === 'cancelled';
const isTerminal = res?.status === 'attended' || res?.status === 'no_show';
---
<Base
  title={notFound
    ? (isEn ? 'Cancel — Reservation not found' : 'キャンセル — 予約が見つかりません')
    : (isEn ? `Cancel — ${res!.reservation_number}` : `キャンセル — ${res!.reservation_number}`)}
  lang={locale}
  showLocaleSwitch={true}
>
  <main>
    <header class="hd">
      <a class="back" href="/reserve/">{isEn ? '← Back to booking' : '← 予約トップへ'}</a>
      <h1>{isEn ? 'Cancel Reservation' : '予約のキャンセル'}</h1>
    </header>

    {notFound && (
      <div class="card err-card">
        <div class="err-icon">🔍</div>
        <h2>{isEn ? 'Reservation not found' : '該当する予約が見つかりません'}</h2>
        <p>
          {isEn
            ? 'Please check the URL, or access via the link in your confirmation email.'
            : 'URL が正しいかご確認いただくか、確認メールに記載のリンクから再度アクセスしてください。'}
        </p>
        <p class="hint">
          {isEn
            ? (<>For questions, please call <a href="tel:0929271177">+81-92-927-1177</a>.</>)
            : (<>ご不明な点は <a href="tel:0929271177">092-927-1177</a> までお問い合わせください。</>)}
        </p>
      </div>
    )}

    {res && (
      <>
        <section class="card">
          <div class="row">
            <span class="k">{isEn ? 'Reservation number' : '予約番号'}</span>
            <span class="v mono big">{res.reservation_number}</span>
          </div>
          <div class="row"><span class="k">{isEn ? 'Status' : '状態'}</span>
            {isCancelled ? (
              <span class="v badge badge-cancelled">{isEn ? 'Cancelled' : 'キャンセル済み'}</span>
            ) : isTerminal ? (
              <span class="v badge badge-terminal">
                {isEn
                  ? (res.status === 'attended' ? 'Attended' : 'No-show')
                  : (res.status === 'attended' ? '出席済み' : '無断欠席')}
              </span>
            ) : (
              <span class="v badge badge-active">{isEn ? 'Confirmed' : '確定'}</span>
            )}
          </div>
        </section>

        <section class="card">
          <h2>{isEn ? 'Session' : '予約枠'}</h2>
          <div class="row"><span class="k">{isEn ? 'Course' : 'コース'}</span><span class="v">{course.name}</span></div>
          <div class="row"><span class="k">{isEn ? 'Date' : '日付'}</span><span class="v mono">{dateLabel}</span></div>
          <div class="row"><span class="k">{isEn ? 'Time' : '時間'}</span><span class="v mono">{timeLabel}</span></div>
          <div class="row">
            <span class="k">{isEn ? 'Total' : '料金'}</span>
            <span class="v mono">
              ¥{(res.total_amount ?? 0).toLocaleString()}
              {isEn
                ? ` (${parts.length} × ${res.price_tier === 'member' ? 'Member' : 'Regular'})`
                : `（${res.price_tier === 'member' ? '会員' : '一般'} × ${parts.length}名）`}
            </span>
          </div>
        </section>

        <section class="card">
          <h2>{isEn ? 'Participants (check those to cancel)' : '参加者 (キャンセルする人にチェック)'}</h2>
          <p class="p-hint">
            {isEn
              ? (activeParticipants.length >= 2
                  ? 'To cancel only some participants, uncheck those who will still attend.'
                  : 'Single-person booking — cancelling cancels the whole reservation.')
              : (activeParticipants.length >= 2
                  ? '一部の方だけキャンセルする場合、残る方のチェックを外してください。'
                  : '1 名予約のため、キャンセルすると予約全体がキャンセルになります。')}
          </p>
          <ul class="p-list checks">
            {activeParticipants.map((p, i) => (
              <li>
                <label class="p-check">
                  <input type="checkbox" class="p-cb" data-part-id={p.id} data-part-name={p.name_snapshot} checked />
                  <span class="p-num">{i + 1}.</span>
                  <span class="p-name">{p.name_snapshot}</span>
                </label>
              </li>
            ))}
          </ul>
        </section>

        {isCancelled && (
          <div class="banner banner-info">
            {isEn ? (
              <>This reservation was cancelled on <strong>{res.cancelled_at?.slice(0, 10)}</strong>.
                {res.cancelled_reason && <><br />Reason: {res.cancelled_reason}</>}</>
            ) : (
              <>この予約は <strong>{res.cancelled_at?.slice(0, 10)}</strong> にキャンセル済みです。
                {res.cancelled_reason && <><br />理由: {res.cancelled_reason}</>}</>
            )}
          </div>
        )}

        {isTerminal && (
          <div class="banner banner-info">
            {isEn
              ? `This reservation is already recorded as "${res.status === 'attended' ? 'attended' : 'no-show'}" and cannot be cancelled.`
              : `この予約は既に「${res.status === 'attended' ? '出席済み' : '無断欠席'}」として記録されているため、キャンセルできません。`}
          </div>
        )}

        {!isCancelled && !isTerminal && (
          <>
            <div class={`banner banner-${fee.level === 'free' ? 'ok' : fee.level === 'past' ? 'muted' : 'warn'}`}>
              <strong>{fee.level === 'free' ? '✅ ' : '⚠️ '}{isEn ? 'Cancellation Fee' : 'キャンセル料について'}</strong>
              <br />{fee.text}
            </div>

            <div class="card cta-card">
              <div id="summaryBox" class="summary-box">
                <div class="sm-row"><span>{isEn ? 'To cancel' : 'キャンセル人数'}</span><span id="cancelCountLabel" class="mono">—</span></div>
                <div class="sm-row"><span>{isEn ? 'Remaining' : '残り参加'}</span><span id="remainCountLabel" class="mono">—</span></div>
                <div class="sm-row sm-total"><span>{isEn ? 'New total' : '変更後の料金'}</span><span id="newTotalLabel" class="mono">—</span></div>
              </div>
              <p class="hint">
                {isEn
                  ? (<>Cancellation is final the moment you press the button. Cannot be undone.<br />If a cancellation fee applies, we'll contact you separately.</>)
                  : (<>押した瞬間にキャンセルが確定します。取り消せません。<br />キャンセル料が発生する場合は別途ご連絡いたします。</>)}
              </p>
              <form id="cancelForm">
                <input type="hidden" name="token" value={token} />
                <input type="hidden" name="perPersonPrice" value={perPersonPrice} />
                <div class="field">
                  <label for="reason">{isEn ? 'Reason for cancellation (optional)' : 'キャンセル理由（任意）'}</label>
                  <input type="text" id="reason" name="reason" maxlength="120"
                    placeholder={isEn ? 'e.g. Illness, schedule change' : '例: 体調不良、予定変更 など'} />
                </div>
                <button type="submit" class="btn btn-danger" id="submitBtn">
                  {isEn ? '🚫 Confirm cancellation' : '🚫 キャンセルを確定する'}
                </button>
              </form>
              <div id="cancelResult" hidden></div>
            </div>
          </>
        )}
      </>
    )}
  </main>
</Base>

<script is:inline define:vars={{ isEn }}>
  window.__ASMS_LOCALE = { isEn };
</script>

<script>
  const form = document.getElementById('cancelForm') as HTMLFormElement | null;
  const result = document.getElementById('cancelResult');
  const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement | null;
  const checkboxes = Array.from(document.querySelectorAll<HTMLInputElement>('.p-cb'));
  const cancelCountLabel = document.getElementById('cancelCountLabel');
  const remainCountLabel = document.getElementById('remainCountLabel');
  const newTotalLabel = document.getElementById('newTotalLabel');
  const summaryBox = document.getElementById('summaryBox');

  const perPersonPrice = Number(
    (document.querySelector<HTMLInputElement>('input[name="perPersonPrice"]')?.value) || 0
  );
  const totalCount = checkboxes.length;
  const yen = (n: number) => `¥${n.toLocaleString('ja-JP')}`;
  const isEn = !!(window as any).__ASMS_LOCALE?.isEn;
  const tr = (jp: string, en: string) => isEn ? en : jp;

  function updateSummary() {
    if (!submitBtn) return;
    const checkedIds = checkboxes.filter((c) => c.checked).map((c) => c.dataset.partId!);
    const remainCount = totalCount - checkedIds.length;
    const isWholeCancel = remainCount === 0;
    const isNoop = checkedIds.length === 0;

    if (cancelCountLabel) cancelCountLabel.textContent = isEn
      ? `${checkedIds.length} / ${totalCount}`
      : `${checkedIds.length} / ${totalCount} 名`;
    if (remainCountLabel) remainCountLabel.textContent = isEn ? `${remainCount}` : `${remainCount} 名`;
    if (newTotalLabel) newTotalLabel.textContent = isWholeCancel
      ? (isEn ? '¥0 (whole booking cancelled)' : '¥0（予約全体キャンセル）')
      : yen(remainCount * perPersonPrice);

    if (isNoop) {
      submitBtn.disabled = true;
      submitBtn.textContent = tr('キャンセルする方を選択してください', 'Please select participant(s) to cancel');
      return;
    }
    submitBtn.disabled = false;
    if (isWholeCancel) {
      submitBtn.textContent = totalCount === 1
        ? tr('🚫 キャンセルを確定する', '🚫 Confirm cancellation')
        : (isEn
            ? `🚫 Cancel all ${totalCount} participants`
            : `🚫 全員（${totalCount}名）をキャンセルする`);
    } else {
      submitBtn.textContent = isEn
        ? `🚫 Cancel ${checkedIds.length} selected participant(s)`
        : `🚫 選択した ${checkedIds.length} 名をキャンセルする`;
    }
  }

  checkboxes.forEach((cb) => cb.addEventListener('change', updateSummary));
  updateSummary();

  if (form && result && submitBtn) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const checkedIds = checkboxes.filter((c) => c.checked).map((c) => c.dataset.partId!);
      const checkedNames = checkboxes.filter((c) => c.checked).map((c) => c.dataset.partName!);
      if (checkedIds.length === 0) return;
      const isWholeCancel = checkedIds.length === totalCount;

      const confirmMsg = isWholeCancel
        ? tr('予約全体をキャンセルします。取り消せません。よろしいですか？',
             'This will cancel the entire booking. Cannot be undone. Continue?')
        : (isEn
            ? `Cancel ${checkedNames.join(', ')}? Cannot be undone.`
            : `${checkedNames.join('・')} をキャンセルします。取り消せません。よろしいですか？`);
      if (!confirm(confirmMsg)) return;

      submitBtn.disabled = true;
      submitBtn.textContent = tr('キャンセル中…', 'Cancelling…');
      const fd = new FormData(form);
      const payload: any = {
        token: fd.get('token'),
        reason: fd.get('reason') || tr('お客様都合（Web からキャンセル）', 'Customer request (web cancellation)'),
      };
      // 一部キャンセルのときだけ participant_ids を送る (全員なら省略 = whole cancel)
      if (!isWholeCancel) payload.participant_ids = checkedIds;

      try {
        const r = await fetch('/api/reserve/cancel', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const body = await r.json();
        if (!r.ok) throw new Error(body?.error || tr('キャンセル失敗', 'Cancellation failed'));
        form.hidden = true;
        if (summaryBox) summaryBox.hidden = true;
        const msg = body.partial
          ? (isEn
              ? `✅ Cancellation confirmed for ${checkedNames.join(', ')}.<br>${body.remaining_count} participant(s) remain booked.<br>New total: ${yen(Number(body.new_total || 0))}`
              : `✅ ${checkedNames.join('・')} のキャンセルを承りました。<br>残り ${body.remaining_count} 名は予約継続中です。<br>新しい合計: ${yen(Number(body.new_total || 0))}`)
          : tr('✅ 予約全体のキャンセルを承りました。', '✅ Your entire booking has been cancelled.');
        const notifyMsg = tr('ご登録のメールアドレスに通知メールをお送りします。',
                              'A confirmation email will be sent to your registered address.');
        const backLabel = tr('別の日程を予約する', 'Book another date');
        result.innerHTML =
          `<div class="banner banner-ok">${msg}<br>${notifyMsg}</div>` +
          `<p style="text-align:center;margin-top:1rem"><a href="/reserve/" class="btn btn-primary">${backLabel}</a></p>`;
        result.hidden = false;
      } catch (err: any) {
        updateSummary();
        alert(tr('エラー: ', 'Error: ') + (err.message || err));
      }
    });
  }
</script>

<style>
  main { max-width: 640px; margin: 0 auto; padding: 1.5rem 1.25rem 3rem; }
  .hd { padding-bottom: 1rem; border-bottom: 1px solid var(--line); margin-bottom: 1.2rem; }
  .back { display: inline-block; font-size: .78rem; color: var(--ink-3); text-decoration: none; margin-bottom: .4rem; }
  h1 { margin: 0; font-size: 1.4rem; font-weight: 800; }

  .card {
    background: var(--bg); border: 1px solid var(--line); border-radius: 12px;
    padding: 1rem 1.15rem; margin-bottom: .8rem;
  }
  .card h2 { margin: 0 0 .5rem; font-size: .82rem; font-weight: 800; color: var(--sky-deep); letter-spacing: .05em; text-transform: uppercase; }
  .row { display: flex; justify-content: space-between; gap: .5rem; padding: .35rem 0; border-bottom: 1px dashed var(--line); font-size: .84rem; }
  .row:last-child { border-bottom: none; }
  .k { color: var(--ink-3); font-size: .74rem; font-weight: 700; }
  .v { color: var(--ink); }
  .mono { font-family: var(--mono); }
  .big { font-size: 1.15rem; font-weight: 800; color: var(--sky-deep); }
  .badge { padding: 3px 10px; border-radius: 100px; font-size: .72rem; font-weight: 800; }
  .badge-active { background: rgba(164,214,94,.2); color: var(--lime-deep); }
  .badge-cancelled { background: rgba(160,160,160,.2); color: var(--ink-3); }
  .badge-terminal { background: rgba(58,169,232,.15); color: var(--sky-deep); }

  .p-list { list-style: none; margin: 0; padding: 0; }
  .p-list li { padding: .3rem 0; font-size: .84rem; border-bottom: 1px dashed var(--line); }
  .p-list li:last-child { border-bottom: none; }
  .p-hint {
    margin: 0 0 .7rem; font-size: .74rem; color: var(--ink-3);
    line-height: 1.5;
  }
  .p-list.checks li { padding: 0; }
  .p-check {
    display: flex; align-items: center; gap: .6rem;
    padding: .6rem .3rem; cursor: pointer;
    font-size: .9rem;
    transition: background .1s;
  }
  .p-check:hover { background: var(--bg-2); }
  .p-cb {
    width: 20px; height: 20px; flex-shrink: 0;
    accent-color: var(--rose);
    cursor: pointer;
  }
  .p-num { color: var(--ink-3); font-family: var(--mono); font-size: .78rem; min-width: 1.5em; }
  .p-name { flex: 1; color: var(--ink); font-weight: 700; }

  .summary-box {
    background: var(--bg-2); border-radius: 8px;
    padding: .7rem .9rem; margin-bottom: .8rem;
    border: 1px solid var(--line);
  }
  .sm-row {
    display: flex; justify-content: space-between; align-items: baseline;
    padding: .25rem 0; font-size: .8rem; color: var(--ink-2);
  }
  .sm-row .mono { font-family: var(--mono); font-weight: 700; color: var(--ink); }
  .sm-total {
    border-top: 1px dashed var(--line); margin-top: .3rem; padding-top: .5rem;
    font-weight: 700; color: var(--rose-deep);
  }
  .sm-total .mono { color: var(--rose-deep); font-size: 1rem; }

  .banner {
    padding: .8rem 1rem; border-radius: 8px; margin: 1rem 0;
    font-size: .82rem; line-height: 1.7;
  }
  .banner-info { background: var(--sky-mist); border: 1px solid var(--sky-light); color: var(--ink); }
  .banner-ok { background: rgba(164,214,94,.15); border: 1px solid var(--lime-deep); color: var(--lime-deep); font-weight: 700; text-align: center; }
  .banner-warn { background: rgba(255,201,67,.12); border: 1px solid rgba(255,201,67,.5); color: var(--ink); }
  .banner-muted { background: var(--bg-2); border: 1px solid var(--line); color: var(--ink-3); }

  .cta-card { border-color: var(--rose); background: rgba(229,85,111,.02); }
  .cta-card h2 { color: var(--rose-deep); }
  .cta-card .hint { margin: 0 0 .8rem; font-size: .78rem; color: var(--ink-2); }

  .field { display: flex; flex-direction: column; gap: .3rem; margin-bottom: .8rem; }
  .field label { font-size: .72rem; font-weight: 700; color: var(--ink-2); }
  .field input {
    padding: .55rem .7rem; font-size: .9rem;
    border: 1.5px solid var(--line); border-radius: 8px;
    background: var(--bg);
  }

  .btn {
    display: block; width: 100%; text-align: center;
    padding: .85rem 1.2rem; border-radius: 10px;
    font-family: var(--jp); font-size: .95rem; font-weight: 800;
    border: none; cursor: pointer; text-decoration: none;
  }
  .btn:disabled { opacity: .5; cursor: not-allowed; }
  .btn-danger {
    background: linear-gradient(135deg, var(--rose), var(--rose-deep));
    color: #fff; box-shadow: 0 4px 12px rgba(229, 85, 111, .3);
  }
  .btn-primary {
    background: linear-gradient(135deg, var(--orange), var(--orange-deep));
    color: #fff; box-shadow: 0 4px 12px rgba(229, 99, 26, .3);
  }

  .err-card { text-align: center; padding: 2rem 1.5rem; }
  .err-icon { font-size: 2.5rem; margin-bottom: .5rem; }
  .err-card h2 { color: var(--ink); font-size: 1.05rem; margin: 0 0 .5rem; text-transform: none; letter-spacing: 0; }
  .err-card p { font-size: .84rem; color: var(--ink-2); }
  .err-card .hint { font-size: .78rem; color: var(--ink-3); margin-top: 1rem; }
  .err-card a { color: var(--sky-deep); }
</style>
