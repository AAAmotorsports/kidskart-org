/**
 * Cloudflare Workers deployment config for the ASMS Astro app.
 *
 * The Astro build (via @astrojs/cloudflare) emits a Worker entry at
 * ./dist/_worker.js/index.js and static assets under ./dist.
 * Wrangler serves both from a single Worker deployment.
 *
 * Environment variables:
 * - `vars`: plain text runtime bindings, committed to git. Only put
 *   non-sensitive values here (Supabase URL/anon key are safe — anon
 *   key is meant to be public and RLS keeps it honest).
 * - Secrets (SUPABASE_SERVICE_ROLE_KEY, ADMIN_PASSWORD): NEVER commit.
 *   Set them with `wrangler secret put NAME` or via the Cloudflare
 *   Dashboard → this Worker → Settings → Variables and Secrets →
 *   "Add secret". Values entered as "Build environment variables"
 *   under Workers Builds are ONLY visible during the build; they do
 *   not reach the running Worker.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kidskart-asms",
  // Astro が生成する dist/_worker.js/index.js は fetch handler のみ。
  // scheduled (Cron Triggers) を扱うために worker-entry.mjs で薄くラップし、
  // そちらを main にしている。詳細は worker-entry.mjs 冒頭コメント参照。
  "main": "./worker-entry.mjs",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // ---- Cron Triggers ------------------------------------------------------
  // GitHub Actions cron から Cloudflare Workers Cron Triggers に移行 (2026-08-29)。
  // GitHub Actions は数時間規模の遅延があるが、Cloudflare は秒〜分レベル。
  // 二重送信は各 API の DB フラグ (thankyou_email_sent_at 等) で防止済み。
  //
  // 対応する endpoint は worker-entry.mjs の CRON_TO_ENDPOINT を参照。
  //   09:00 UTC = 18:00 JST  → thankyou-mail  (前日分キャッチアップ含む)
  //   09:30 UTC = 18:30 JST  → reminder-mail  (翌日開催の予約)
  //   10:00 UTC = 19:00 JST  → followup-mail  (30 日前参加者)
  "triggers": {
    "crons": [
      "0 9 * * *",
      "30 9 * * *",
      "0 10 * * *"
    ]
  },
  // ---- Environment variables --------------------------------------------
  // Non-secret runtime env lives HERE (single source of truth). Dashboard
  // holds only the two real secrets.
  //
  // Learned (3 wipe accidents on 2026-08-11):
  //   - `vars: {A: "x", ...}` here → gets pushed to runtime AND survives
  //     deploys ✅
  //   - `vars: {}` (empty)      → wipes all Dashboard non-secret vars ❌
  //   - No `vars` key at all    → ALSO wipes Dashboard non-secret vars ❌
  //     (contrary to what Cloudflare docs suggest — empirically confirmed
  //     on this project's Workers Builds setup)
  //   - Dashboard シークレット (SUPABASE_SERVICE_ROLE_KEY, RESEND_API_KEY)
  //     always survive deploys, regardless of this file
  //
  // Therefore: NEVER remove or empty this `vars` block. Every deploy
  // rewrites the Worker's non-secret env to match what's here.
  //
  // ADMIN_PASSWORD_HASH is a SHA-256 digest, not the password itself.
  // Rotating the password:
  //   printf '<newpass>' | sha256sum
  //   → replace ADMIN_PASSWORD_HASH below, commit, push.
  "vars": {
    "PUBLIC_SUPABASE_URL": "https://qwwrhesgbytefxufeiwj.supabase.co",
    "PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_AOF1nIQsQ0gnufgX-nRnlA_tPpfOsoq",
    "ADMIN_USERNAME": "masaaki0820",
    "ADMIN_PASSWORD_HASH": "9b9ec86a6ab45c37ab17b86a2fa8b054b330db8f29d10d2f714a607732466a88",
    "MAIL_FROM_ADDRESS": "noreply@kidskart.org",
    "MAIL_FROM_NAME": "福岡キッズカートアカデミー",
    "MAIL_REPLY_TO": "info@kidskart.org",
    // 新規予約が入ったとき運営に通知するメール宛先
    "MAIL_ADMIN_TO": "info@kidskart.org",
    // Cloudflare Turnstile (CAPTCHA) — site key は公開して OK、
    // TURNSTILE_SECRET_KEY のみ Dashboard シークレット。
    // 未設定なら wizard で CAPTCHA を出さず、API 側でも検証をスキップ
    // (graceful degradation)。有効化手順は README / CLAUDE.md 参照。
    "PUBLIC_TURNSTILE_SITE_KEY": "",
    // 予約当日サンキューメール内の「ご感想アンケート」リンク先
    // (Google Form)。空文字ならメール本文からアンケートセクションを
    // 省略する。差し替え時はここを編集 → PR → deploy。
    "PUBLIC_SURVEY_URL": "https://forms.gle/xvV4x1XrjQ3mrp6VA",
    // GA4 測定 ID。kidskart.org (静的サイト) と同一のデータストリームで
    // 計測し、集客 → 予約完了までの単一ファネルとして測る。空文字なら
    // タグを一切吐かない (dev / preview 用)。
    "PUBLIC_GA4_MEASUREMENT_ID": "G-W3HB0DT0Y3",
    // Google Business Profile の口コミ投稿 URL。サンキューメールで
    // 「初回参加 & 未依頼」の保護者に 1 度だけ CTA として出す。
    // 空文字なら口コミセクションを丸ごと省略。
    "PUBLIC_GOOGLE_REVIEW_URL": "https://g.page/r/CfMucc5k_k0vEBM/review"
  }
  //
  // Secrets (stay in Cloudflare Dashboard, encrypted):
  //   SUPABASE_SERVICE_ROLE_KEY
  //   RESEND_API_KEY
  //   CRON_SECRET         ← /api/cron/thankyou-mail を GitHub Actions
  //                         から叩くときの共有シークレット
}
