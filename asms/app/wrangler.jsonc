/**
 * Cloudflare Workers deployment config for the ASMS Astro app.
 *
 * The Astro build (via @astrojs/cloudflare) emits a Worker entry at
 * ./dist/_worker.js/index.js and static assets under ./dist.
 * Wrangler serves both from a single Worker deployment.
 *
 * Environment variables:
 * - `vars`: plain text runtime bindings, committed to git. Only put
 *   non-sensitive values here (Supabase URL/anon key are safe — anon
 *   key is meant to be public and RLS keeps it honest).
 * - Secrets (SUPABASE_SERVICE_ROLE_KEY, ADMIN_PASSWORD): NEVER commit.
 *   Set them with `wrangler secret put NAME` or via the Cloudflare
 *   Dashboard → this Worker → Settings → Variables and Secrets →
 *   "Add secret". Values entered as "Build environment variables"
 *   under Workers Builds are ONLY visible during the build; they do
 *   not reach the running Worker.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kidskart-asms",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    // Public/anon values — safe to commit. RLS on Supabase enforces access.
    "PUBLIC_SUPABASE_URL": "https://qwwrhesgbytefxufeiwj.supabase.co",
    "PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_AOF1nIQsQ0gnufgX-nRnlA_tPpfOsoq",
    // Admin gate — the password itself is NEVER stored, only its SHA-256
    // digest. The middleware hashes whatever the client sends and compares
    // to this value, so committing the hash to a public repo leaks nothing
    // beyond the fact that the site has admin auth. To rotate: pick a new
    // password, `printf '<pw>' | sha256sum` on any Unix box, replace here.
    "ADMIN_USERNAME": "masaaki0820",
    "ADMIN_PASSWORD_HASH": "9b9ec86a6ab45c37ab17b86a2fa8b054b330db8f29d10d2f714a607732466a88",
    // Outbound mail. The FROM / NAME / REPLY-TO are non-sensitive so they
    // live in git; the RESEND_API_KEY itself must be added as a proper
    // Cloudflare secret (Dashboard → 変数とシークレット → シークレット追加).
    // Adding it in git would let anyone with repo access send mail as us.
    "MAIL_FROM_ADDRESS": "noreply@kidskart.org",
    "MAIL_FROM_NAME": "福岡キッズカートアカデミー",
    "MAIL_REPLY_TO": "info@kidskart.org"
    // SUPABASE_SERVICE_ROLE_KEY and RESEND_API_KEY must be added as
    // Cloudflare secrets — write endpoints that bypass RLS need the
    // former and outbound Resend calls need the latter. Dashboard-added
    // secrets bind on the next code deploy, not on manual re-deploy of
    // an existing version; push a commit to force a rebind if a new
    // secret isn't visible at runtime.
  }
}
