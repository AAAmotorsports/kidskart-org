/**
 * Cloudflare Workers deployment config for the ASMS Astro app.
 *
 * The Astro build (via @astrojs/cloudflare) emits a Worker entry at
 * ./dist/_worker.js/index.js and static assets under ./dist.
 * Wrangler serves both from a single Worker deployment.
 *
 * Environment variables:
 * - `vars`: plain text runtime bindings, committed to git. Only put
 *   non-sensitive values here (Supabase URL/anon key are safe — anon
 *   key is meant to be public and RLS keeps it honest).
 * - Secrets (SUPABASE_SERVICE_ROLE_KEY, ADMIN_PASSWORD): NEVER commit.
 *   Set them with `wrangler secret put NAME` or via the Cloudflare
 *   Dashboard → this Worker → Settings → Variables and Secrets →
 *   "Add secret". Values entered as "Build environment variables"
 *   under Workers Builds are ONLY visible during the build; they do
 *   not reach the running Worker.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kidskart-asms",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // ---- Environment variables --------------------------------------------
  // Intentionally NO `vars` key in this file.
  //
  // Empirically, on this project's Cloudflare Workers Builds setup:
  //   - `vars: {...}` values do NOT reach `env.XXX` at runtime
  //   - `vars: {}` (empty) DELETES existing Dashboard variables on deploy
  //   - Omitting the `vars` key entirely leaves Dashboard variables untouched
  //
  // So the ONLY reliable place for env config is the Cloudflare Dashboard:
  //   Workers & Pages → kidskart-asms → 設定 → 変数とシークレット
  //
  // ==== VARIABLES THAT MUST EXIST IN THE DASHBOARD ====
  //
  // Type: 変数 (plain text)
  //   ADMIN_USERNAME           = masaaki0820
  //   ADMIN_PASSWORD_HASH      = 9b9ec86a6ab45c37ab17b86a2fa8b054b330db8f29d10d2f714a607732466a88
  //   PUBLIC_SUPABASE_URL      = https://qwwrhesgbytefxufeiwj.supabase.co
  //   PUBLIC_SUPABASE_ANON_KEY = sb_publishable_AOF1nIQsQ0gnufgX-nRnlA_tPpfOsoq
  //   MAIL_FROM_ADDRESS        = noreply@kidskart.org
  //   MAIL_FROM_NAME           = 福岡キッズカートアカデミー
  //   MAIL_REPLY_TO            = info@kidskart.org
  //
  // Type: シークレット (encrypted)
  //   SUPABASE_SERVICE_ROLE_KEY = sb_secret_...     (never commit)
  //   RESEND_API_KEY            = re_...            (never commit)
  //
  // To rotate the admin password:
  //   printf '<newpass>' | sha256sum
  //   → paste hex into ADMIN_PASSWORD_HASH in the Dashboard
  //
  // When adding a new variable:
  //   1. Add to Dashboard (変数 or シークレット)
  //   2. Add to `Env` interface in src/env.d.ts
  //   3. If secret: Dashboard → デプロイ → 最新版「⋯」→ このバージョンを展開する
  //      (new secrets don't auto-bind to existing deployments)
}
