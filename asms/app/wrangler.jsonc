/**
 * Cloudflare Workers deployment config for the ASMS Astro app.
 *
 * The Astro build (via @astrojs/cloudflare) emits a Worker entry at
 * ./dist/_worker.js/index.js and static assets under ./dist.
 * Wrangler serves both from a single Worker deployment.
 *
 * Environment variables:
 * - `vars`: plain text runtime bindings, committed to git. Only put
 *   non-sensitive values here (Supabase URL/anon key are safe — anon
 *   key is meant to be public and RLS keeps it honest).
 * - Secrets (SUPABASE_SERVICE_ROLE_KEY, ADMIN_PASSWORD): NEVER commit.
 *   Set them with `wrangler secret put NAME` or via the Cloudflare
 *   Dashboard → this Worker → Settings → Variables and Secrets →
 *   "Add secret". Values entered as "Build environment variables"
 *   under Workers Builds are ONLY visible during the build; they do
 *   not reach the running Worker.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kidskart-asms",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // ---- Environment variables --------------------------------------------
  // NOTE: this project's runtime env is managed **entirely in the
  // Cloudflare Dashboard** (Workers & Pages → kidskart-asms → 設定 →
  // 変数とシークレット), NOT in this file's `vars` section.
  //
  // Reason: with the Workers Builds deploy path (`npx wrangler deploy`
  // from CI), `vars` declared here weren't reliably reaching runtime —
  // we spent an afternoon chasing that (see git history around
  // 2026-08-11). Dashboard-added variables persist across deploys and
  // bind reliably, so we standardized on that as the single source of
  // truth.
  //
  // ==== VARIABLES THAT MUST EXIST IN THE DASHBOARD ====
  //
  // Type: 変数 (plain text)
  //   ADMIN_USERNAME           = masaaki0820
  //   ADMIN_PASSWORD_HASH      = <sha256 hex of the admin password>
  //   PUBLIC_SUPABASE_URL      = https://<project>.supabase.co
  //   PUBLIC_SUPABASE_ANON_KEY = sb_publishable_...
  //   MAIL_FROM_ADDRESS        = noreply@kidskart.org
  //   MAIL_FROM_NAME           = 福岡キッズカートアカデミー
  //   MAIL_REPLY_TO            = info@kidskart.org
  //
  // Type: シークレット (encrypted)
  //   SUPABASE_SERVICE_ROLE_KEY = sb_secret_...
  //   RESEND_API_KEY            = re_...
  //
  // To rotate the admin password: pick a new one, run
  //   printf '<pw>' | sha256sum
  // on any Unix box, then update ADMIN_PASSWORD_HASH in the Dashboard.
  //
  // Intentionally leaving `vars` OUT of this file so wrangler deploy
  // doesn't try to override the dashboard-managed values.
  "vars": {}
}
