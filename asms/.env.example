# =========================================================================
# ASMS Environment Variables
# =========================================================================
# Copy this file to `.env.local` (never commit .env.local — .gitignore'd).
# All keys below are REQUIRED for the app to boot.
# =========================================================================

# ---- Supabase ----
# Get from: Supabase Dashboard > Project Settings > API
PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
PUBLIC_SUPABASE_ANON_KEY="eyJhbG..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbG..."   # SERVER SIDE ONLY, bypasses RLS

# ---- Encryption for PII columns ----
# 32-byte random hex string. Generate with: openssl rand -hex 32
PGCRYPTO_SECRET_KEY=""

# ---- Resend (email) ----
# Get from: https://resend.com/api-keys
RESEND_API_KEY="re_..."
MAIL_FROM_ADDRESS="noreply@kidskart.org"
MAIL_FROM_NAME="福岡キッズカートアカデミー"
MAIL_REPLY_TO="info@kidskart.org"

# ---- Cloudflare Turnstile (CAPTCHA) ----
# Get from: Cloudflare Dashboard > Turnstile > Add site
PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ---- Cloudflare R2 (signature/PDF storage) ----
# Get from: Cloudflare Dashboard > R2 > Manage R2 API Tokens
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="asms-signatures"

# ---- App ----
PUBLIC_APP_URL="https://kidskart.org"
PUBLIC_RESERVE_PATH="/reserve"
